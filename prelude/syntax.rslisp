(use prelude/bindings let)

(use prelude/macros defmacro defrule docstring-before-body?
                    docstring-before-parameters document
                    header-shape map-list note-docstring
                    template value-doc-key whole-pairs?)

(use code closest-name concat declare-definition drop empty?
          fail field-keyword first keyword-field
          keyword-name keyword-trim-end keyword? len list
          list? nth number-sub prepend rest string string?
          symbol symbol-name symbol? take value-eq)

(export -> ->> call-signature comment declared-forms
        declared-name default-bindings default-pairs
        defaults-clause? definition defn has-argument?
        let-try loop pair-keys read-call signature-defaults
        signature-name the try-> type-missing?)

(defmacro defn (name parameters body ...)
  "Defines a function: (defn name (parameter ...) body ...).

  A string before at least one more body form is the docstring."
  (declare-definition name)
  (if (string? parameters)
    (docstring-before-parameters parameters)
    (if (docstring-before-body? body)
      (do
        (note-docstring (value-doc-key name) (first body))
        (function-definition name parameters (rest body)))
      (function-definition name parameters body))))

(header-shape (defn name parameters) :docstring)

(def function-definition
  (fn (name parameters body)
    (if (keyword-parameters? parameters)
      (keyword-function name parameters body)
      (template (def (unquote name)
                  (fn (unquote parameters) (splice body)))))))

(def keyword-parameters?
  (fn (parameters)
    (if (list? parameters)
      (if (empty? parameters)
        false
        (keyword? (first parameters)))
      false)))

(def keyword-function
  (fn (name parameters body)
    (local declared (declared-forms parameters))
    (local binders (parameter-binders declared))
    (local names (map-list binder-name binders))
    (check-distinct-parameters (parameter-keywords declared))
    (local defaults
      (default-bindings (default-pairs parameters)
                        (parameter-definition name)
                        names))
    (local signature (call-signature name names defaults))
    (local positional
      (symbol (quote function) (symbol-name name)))
    (template (do
                (def (unquote positional)
                  (fn (unquote binders) (splice body)))
                (def (unquote name)
                  (macro (form)
                    (keyword-call-expansion form
                                            (quote (unquote positional))
                                            (quote (unquote signature)))))))))

(def definition
  (fn (name noun spell code)
    (fn (read) (read name noun spell code))))

(def definition-name
  (fn (owner)
    (owner (fn (name noun spell code) name))))

(def definition-noun
  (fn (owner)
    (owner (fn (name noun spell code) noun))))

(def definition-spelling
  (fn (owner)
    (owner (fn (name noun spell code) spell))))

(def definition-code
  (fn (owner)
    (owner (fn (name noun spell code) code))))

(def parameter-definition
  (fn (name)
    (definition name "parameter" field-keyword
                (quote unknown-parameter))))

(def call-signature
  (fn (name names defaults) (list name names defaults)))

(def signature-name
  (fn (signature) (first signature)))

(def signature-names
  (fn (signature) (nth signature 1)))

(def signature-defaults
  (fn (signature) (nth signature 2)))

(def ends-with-defaults?
  (fn (forms)
    (if (empty? forms)
      false
      (defaults-clause? (nth forms (number-sub (len forms) 1))))))

(def defaults-clause?
  (fn (form)
    (if (list? form)
      (if (empty? form)
        false
        (defaults-head? (first form)))
      false)))

(def defaults-head?
  (fn (head)
    (if (symbol? head)
      (value-eq (symbol-name head) "defaults")
      false)))

(def declared-forms
  (fn (forms)
    (if (ends-with-defaults? forms)
      (take (number-sub (len forms) 1) forms)
      forms)))

(def default-pairs
  (fn (forms)
    (if (ends-with-defaults? forms)
      (rest (nth forms (number-sub (len forms) 1)))
      (list))))

(def type-missing?
  (fn (more)
    (if (empty? more)
      true
      (if (keyword? (first more))
        true
        (defaults-clause? (first more))))))

(def parameter-binders
  (fn (forms)
    (if (empty? forms)
      (list)
      (prepend (parameter-binder (first forms) (rest forms))
               (parameter-binders (drop (parameter-width (rest forms))
                                        forms))))))

(def parameter-binder
  (fn (keyword more)
    (local name (parameter-name keyword))
    (if (type-missing? more)
      name
      (list name (first more)))))

(def parameter-name
  (fn (keyword)
    (if (keyword? keyword)
      (declared-name keyword "parameter")
      (parameter-start-error keyword))))

(def declared-name
  (fn (keyword noun)
    (local trimmed (keyword-trim-end keyword))
    (if (keyword? trimmed)
      (named-declaration keyword trimmed noun)
      (fail (string "a " noun " name cannot be only `:`")
        keyword
        "write a name after the first `:`, as in `:email`"
        (template (:code trailing-colon :label "has no name"))))))

(def named-declaration
  (fn (keyword trimmed noun)
    (if (value-eq (keyword-name keyword) (keyword-name trimmed))
      (keyword-field keyword)
      (fail (string "a " noun " name cannot end with `:`")
        keyword
        (string "write `" (symbol-name trimmed) "`")
        (template (:code trailing-colon
                         :label "ends with `:`"
                         :suggest (unquote trimmed)))))))

(def parameter-start-error
  (fn (form)
    (if (defaults-clause? form)
      (fail "a function takes one `defaults` clause, after its parameters"
        form "move the defaults to the end")
      (fail "a parameter must start with `:`"
        form
        (string "write each parameter as `:name type` or `:name`, as in "
                "(defn add (:x i64 :y i64) (+ x y))")))))

(def parameter-width
  (fn (more)
    (if (type-missing? more) 1 2)))

(def binder-name
  (fn (binder)
    (if (list? binder) (first binder) binder)))

(def parameter-keywords
  (fn (forms)
    (if (empty? forms)
      (list)
      (prepend (first forms)
               (parameter-keywords (drop (parameter-width (rest forms))
                                         forms))))))

(def check-distinct-parameters
  (fn (keywords)
    (if (empty? keywords)
      keywords
      (do
        (check-declared-once (first keywords) (rest keywords))
        (check-distinct-parameters (rest keywords))))))

(def check-declared-once
  (fn (keyword later-keywords)
    (local repeated (find-keyword keyword later-keywords))
    (if (empty? repeated)
      keyword
      (fail (string "`" (keyword-name keyword) "` is declared twice")
        (first repeated)
        "give each parameter its own name"))))

(def find-keyword
  (fn (keyword keywords)
    (if (empty? keywords)
      keywords
      (if (same-keyword? keyword (first keywords))
        keywords
        (find-keyword keyword (rest keywords))))))

(def same-keyword?
  (fn (left right)
    (if (keyword? right)
      (value-eq (keyword-name left) (keyword-name right))
      false)))

(def default-bindings
  (fn (pairs owner names)
    (given-default-bindings pairs owner names
                            (if (whole-pairs? pairs)
                              (pair-keys pairs)
                              (list)))))

(def given-default-bindings
  (fn (pairs owner names given-keys)
    (if (empty? pairs)
      (list)
      (prepend (default-binding pairs owner names given-keys)
               (given-default-bindings (drop 2 pairs)
                                       owner names
                                       given-keys)))))

(def default-binding
  (fn (pairs owner names given-keys)
    (local key (first pairs))
    (check-default-key key owner names given-keys)
    (check-default-value pairs)
    (check-single-default key (pair-keys (drop 2 pairs)))
    (list (name-of-key key names) (nth pairs 1))))

(def check-default-key
  (fn (key owner names given-keys)
    (if (keyword? key)
      (if (key-names-one-of? key names)
        key
        (unknown-default-error key owner names given-keys))
      (fail "a default must start with `:`"
        key
        (string "write each default as `:"
                (definition-noun owner)
                " value`, as in (defaults :admin? false)")))))

(def unknown-default-error
  (fn (key owner names given-keys)
    (unknown-key-error key owner names given-keys)))

(def unknown-key-error
  (fn (key owner names given-keys)
    (local noun (definition-noun owner))
    (local name (definition-name owner))
    (local spelling (definition-spelling owner))
    (local code (definition-code owner))
    (local closest
      (closest-name (keyword-field key)
                    (names-without-argument names given-keys)))
    (local message
      (string "`" name "` has no " noun " `"
              (symbol-name (spelling (keyword-field key)))
              "`"))
    (fail message
      key
      (if (empty? closest)
        (if (empty? names)
          (string "`" name "` has no " noun "s")
          (string "the " noun "s of `" name "` are "
                  (joined-names (map-list spelling names) "")))
        (string "a " noun " with a similar name exists"))
      (if (empty? closest)
        (template (:code (unquote code)))
        (template (:code (unquote code)
                         :suggest (unquote (field-keyword (first
                                                            closest)))))))))

(def check-default-value
  (fn (pairs)
    (if (empty? (rest pairs))
      (fail "this default has no value"
        (first pairs)
        (string "write a value after it, as in "
                (symbol-name (first pairs))
                " false"))
      pairs)))

(def check-single-default
  (fn (key later-keys)
    (local repeated (find-keyword key later-keys))
    (if (empty? repeated)
      key
      (fail (string "`" (keyword-name key) "` has two defaults")
        (first repeated)
        "keep one"))))

(def joined-names
  (fn (names quote-mark)
    (if (empty? names)
      ""
      (joined-nonempty-names names quote-mark))))

(def joined-nonempty-names
  (fn (names quote-mark)
    (local quoted
      (string quote-mark (symbol-name (first names)) quote-mark))
    (if (empty? (rest names))
      quoted
      (string quoted ", "
              (joined-nonempty-names (rest names) quote-mark)))))

(def keyword-of?
  (fn (key name)
    (if (keyword? key)
      (value-eq (keyword-name key) (symbol-name name))
      false)))

(def key-names-one-of?
  (fn (key names)
    (if (empty? names)
      false
      (if (keyword-of? key (first names))
        true
        (key-names-one-of? key (rest names))))))

(def name-of-key
  (fn (key names)
    (if (keyword-of? key (first names))
      (first names)
      (name-of-key key (rest names)))))

(def pair-keys
  (fn (arguments)
    (if (empty? arguments)
      (list)
      (prepend (first arguments)
               (pair-keys (drop 2 arguments))))))

(def has-argument?
  (fn (name keys)
    (if (empty? keys)
      false
      (if (keyword-of? (first keys) name)
        true
        (has-argument? name (rest keys))))))

(def keyword-pairs?
  (fn (arguments)
    (if (whole-pairs? arguments)
      (every-keyword? (pair-keys arguments))
      false)))

(def every-keyword?
  (fn (forms)
    (if (empty? forms)
      true
      (if (keyword? (first forms))
        (every-keyword? (rest forms))
        false))))

(def required-names
  (fn (signature)
    (names-without-default (signature-names signature)
                           (signature-defaults signature))))

(def names-without-default
  (fn (names defaults)
    (if (empty? names)
      (list)
      (if (empty? (default-of (first names) defaults))
        (prepend (first names)
                 (names-without-default (rest names) defaults))
        (names-without-default (rest names) defaults)))))

(def names-without-argument
  (fn (names keys)
    (if (empty? names)
      (list)
      (if (has-argument? (first names) keys)
        (names-without-argument (rest names) keys)
        (prepend (first names)
                 (names-without-argument (rest names) keys))))))

(def default-of
  (fn (name defaults)
    (if (empty? defaults)
      defaults
      (if (value-eq (symbol-name (first (first defaults)))
                    (symbol-name name))
        (first defaults)
        (default-of name (rest defaults))))))

(def keyword-call-expansion
  (fn (form positional signature)
    (if (symbol? form)
      positional
      (keyword-call form positional signature))))

(def keyword-call
  (fn (form positional signature)
    (local owner
      (parameter-definition (signature-name signature)))
    (read-call form positional signature owner
               (fn (form) (named-call form positional signature owner)))))

(def read-call
  (fn (form positional signature owner by-name)
    (local arguments (rest form))
    (if (keyword-pairs? arguments)
      (by-name form)
      (if (any-keyword? arguments)
        (partly-labeled-error form signature)
        (if (value-eq (len arguments)
                      (len (signature-names signature)))
          (prepend positional arguments)
          (call-arity-error form signature owner))))))

(def any-keyword?
  (fn (forms)
    (if (empty? forms)
      false
      (if (keyword? (first forms))
        true
        (any-keyword? (rest forms))))))

(def partly-labeled-error
  (fn (form signature)
    (local unpaired (first-unpaired (rest form)))
    (fail (string "`"
                  (symbol-name (first form))
                  "` takes a label on every argument or on none")
      unpaired
      (labeled-call-help (signature-names signature))
      (template (:code partly-labeled-call
                       :label (unquote (unpaired-label unpaired)))))))

(def labeled-call-help
  (fn (names)
    (if (empty? names)
      "remove the arguments"
      (string "a keyword argument is always a label: write `"
              (labeled-values names)
              "`"))))

(def labeled-values
  (fn (names)
    (local labeled
      (string (symbol-name (field-keyword (first names)))
              " value"))
    (if (empty? (rest names))
      labeled
      (string labeled " " (labeled-values (rest names))))))

(def first-unpaired
  (fn (arguments)
    (if (empty? (rest arguments))
      (first arguments)
      (if (keyword? (first arguments))
        (first-unpaired (drop 2 arguments))
        (first arguments)))))

(def unpaired-label
  (fn (argument)
    (if (keyword? argument)
      "this label has no value"
      "this argument has no label")))

(def call-arity-error
  (fn (form signature owner)
    (local noun (definition-noun owner))
    (fail (string "`"
                  (symbol-name (first form))
                  "` takes "
                  (len (signature-names signature))
                  " arguments, one per " noun ", or a `:"
                  noun " value` pair for each " noun
                  " without a default")
      form
      (string "write it as `"
              (prepend (first form) (signature-names signature))
              "`"))))

(def named-call
  (fn (form positional signature owner)
    (local pairs (rest form))
    (local keys (pair-keys pairs))
    (check-call-keys keys keys signature owner)
    (check-required-parameters form keys signature)
    (if (needs-temporaries? pairs (signature-names signature))
      (call-through-temporaries pairs positional signature)
      (prepend positional (positional-arguments pairs signature)))))

(def check-call-keys
  (fn (keys given-keys signature owner)
    (if (empty? keys)
      keys
      (do
        (check-call-key (first keys) given-keys signature owner)
        (check-given-once (first keys) (rest keys) signature)
        (check-call-keys (rest keys) given-keys signature owner)))))

(def check-call-key
  (fn (key keys signature owner)
    (if (key-names-one-of? key (signature-names signature))
      key
      (unknown-parameter-error key keys signature owner))))

(def unknown-parameter-error
  (fn (key keys signature owner)
    (unknown-key-error key owner
                       (signature-names signature)
                       keys)))

(def check-given-once
  (fn (key later-keys signature)
    (local repeated (find-keyword key later-keys))
    (if (empty? repeated)
      key
      (fail (string "`"
                    (symbol-name key)
                    "` is given twice in `"
                    (signature-name signature)
                    "`")
        (first repeated)
        (string "remove the second `"
                (symbol-name key)
                "` and its value")
        (template (:code repeated-parameter
                         :earlier (unquote key)
                         :label "given again here"
                         :earlier-label "first given here"))))))

(def check-required-parameters
  (fn (form keys signature)
    (local missing
      (names-without-argument (required-names signature) keys))
    (if (empty? missing)
      missing
      (fail (string (if (value-eq (len missing) 1)
                      "missing parameter "
                      "missing parameters ")
                    (joined-names missing "`")
                    " in `"
                    (signature-name signature)
                    "`")
        form
        (string "name every parameter without a default: "
                (joined-names missing ""))))))

(def positional-arguments
  (fn (pairs signature)
    (map-list (fn (name)
                (argument-for name pairs (signature-defaults signature)))
              (signature-names signature))))

(def argument-for
  (fn (name pairs defaults)
    (local given (pair-of name pairs))
    (if (empty? given)
      (nth (default-of name defaults) 1)
      (nth given 1))))

(def pair-of
  (fn (name pairs)
    (if (empty? pairs)
      pairs
      (if (keyword-of? (first pairs) name)
        pairs
        (pair-of name (drop 2 pairs))))))

(def needs-temporaries?
  (fn (pairs names)
    (if (keys-in-order? (pair-keys pairs) names)
      false
      (any-compound-value? pairs))))

(def keys-in-order?
  (fn (keys names)
    (if (empty? keys)
      true
      (if (empty? names)
        false
        (if (keyword-of? (first keys) (first names))
          (keys-in-order? (rest keys) (rest names))
          (keys-in-order? keys (rest names)))))))

(def any-compound-value?
  (fn (pairs)
    (if (empty? pairs)
      false
      (if (list? (nth pairs 1))
        true
        (any-compound-value? (drop 2 pairs))))))

(def call-through-temporaries
  (fn (pairs positional signature)
    (local call
      (prepend positional
               (positional-arguments (bound-pairs pairs) signature)))
    (prepend (quote do)
             (concat (temporary-bindings pairs) (list call)))))

(def bound-pairs
  (fn (pairs)
    (if (empty? pairs)
      (list)
      (concat (list (first pairs) (bound-value pairs))
              (bound-pairs (drop 2 pairs))))))

(def bound-value
  (fn (pairs)
    (if (list? (nth pairs 1))
      (temporary (first pairs))
      (nth pairs 1))))

(def temporary
  (fn (key)
    (symbol (quote temporary) (keyword-name key))))

(def temporary-bindings
  (fn (pairs)
    (if (empty? pairs)
      (list)
      (if (list? (nth pairs 1))
        (prepend (list (quote local)
                       (temporary (first pairs))
                       (nth pairs 1))
                 (temporary-bindings (drop 2 pairs)))
        (temporary-bindings (drop 2 pairs))))))

(defrule loop
  ((((name value) ...) body ...)
   ((fn (name ...) body ...) value ...)))

(header-shape (loop bindings))

(defrule the
  ((type-expression value)
   (let ((result type-expression) value) result)))

(defrule comment ((form ...) (do)))

(header-shape (comment))

(defrule ->
  ((value) value)
  ((value (head arguments ...) more ...)
   (-> (head value arguments ...) more ...))
  ((value head more ...) (-> (head value) more ...)))

(defrule ->>
  ((value) value)
  ((value (head arguments ...) more ...)
   (->> (head arguments ... value) more ...))
  ((value head more ...) (->> (head value) more ...)))

(defrule let-try
  ((((name value) ...) body ...)
   (do (local name (try value)) ... body ...)))

(header-shape (let-try bindings))

(defrule try->
  ((value) value)
  ((value head) (head value))
  ((value head more ...) (try-> (try (head value)) more ...)))

(document (->> value form ...)
  "Threads a value through each form as its last argument.

  `(->> 3 (- 10) (* 2))` is `(* 2 (- 10 3))`. A bare name in place of a form
  is called with the value alone.")

(document (the type value)
  "Gives a value a written type.

  It binds the value with an annotated `local` and returns it, so a literal is
  checked against the type and a value that is not `copy` moves. A value of
  another type is an error, except that a borrowed `string`, `(ref name)`,
  passes as a `(ref str)`.")

(document (loop ((name value) ...) body ...)
  "Binds names to values and runs a body that `recur` repeats.

  `(recur new-value ...)` in tail position runs the body again with each name
  bound to its new value. The call returns the body's last value.

  The body is a function, so `try`, `let-try` and `try->` in it leave the loop
  with the failure, not the enclosing function.")

(document (let-try ((name value) ...) body ...)
  "Binds each name to the value inside a `result` or an `option`, in order.

  Each value goes through `try`, so the first `err` or `none` returns from the
  enclosing function, or leaves the enclosing `loop`. That function must
  return a `result` or an `option` of the same kind.")

(document (try-> value function ...)
  "Calls each function on the result of the one before, through `try`.

  `(try-> x f g)` is `(g (try (f x)))`, so the first `err` or `none` returns
  from the enclosing function, or leaves the enclosing `loop`, and the last
  result is returned as it is. With no function, the call returns the value.

  Unlike `->`, a step takes no extra arguments: a call form is a call whose
  result is the function, so `(try-> x (make-step))` is `((make-step) x)`.")

(document (call-signature name names defaults types)
  "Builds the signature of a keyword function from its parts.

  A prelude helper for definers such as `defstruct`.")

(document (signature-name signature)
  "Returns the name of a signature that `call-signature` built.")

(document (signature-defaults signature)
  "Returns the defaults of a signature that `call-signature` built.")

(document (declared-forms forms)
  "Returns a definer's forms without a trailing `(defaults ...)` clause.")

(document (default-pairs forms)
  "Returns the pairs of a trailing `(defaults ...)` clause.

  It returns an empty list when the forms end with no such clause.")

(document (defaults-clause? form)
  "Returns whether a form is a list headed by `defaults`.")

(document (declared-name keyword noun)
  "Returns the name that a keyword such as `:email` declares.

  A keyword with no name, or one that ends with `:`, is an error that names
  the `noun`, such as `field`.")

(document (default-bindings pairs owner names)
  "Returns the bindings of a `(defaults ...)` clause, after checking it.

  Each key must name one of `names`, once, and each needs a value.")

(document (definition name noun spell code)
  "Describes a name that a definer declares, for its error messages.")

(document (has-argument? name keys)
  "Returns whether a call's keys hold the keyword of a name.")

(document (pair-keys arguments)
  "Returns the keys of a list of key and value pairs.

  It takes the first form and every other form after it.")

(document (read-call form positional signature owner by-name)
  "Reads a keyword function's call as a call by name or by position.

  A call by position needs one argument per name of the signature, and any
  other count is an error.")

(document (type-missing? more)
  "Returns whether the forms after a field keyword start with no type.")

(document (comment form ...)
  "Keeps forms in the source that never expand, check or run.

  The call is unit, so a file can hold scratch expressions to evaluate one at
  a time from an editor.")

(document (-> value form ...)
  "Threads a value through each form as its first argument.

  `(-> 3 (- 10) (* 2))` is `(* (- 3 10) 2)`. A bare name in place of a form is
  called with the value alone.")
