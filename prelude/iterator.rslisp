(use prelude/types iterator option)
(use prelude/pair pair)
(use prelude/number + integer number ord)
(use prelude/syntax defn)
(use prelude/macros defrule document)
(use prelude/vec iter)
(use prelude/sequence len)

(use code empty? first list list? prepend rest same-binding?
          symbol?)

(export any? count enumerate every? filter find for-each map
        max max-by-key min range reduce sum take take-while
        zip)

(rust-trait step "std::ops::Range<{0}>: Iterator<Item = {0}>"
  i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize)

(def range
  (rust "{0}..{1}"
    (where ((n integer step))
      (fn (n n) (iterator n)))))

(def map
  (rust "{0}.map({1})"
    (where (a b)
      (fn ((iterator a) (fn-mut (a) b))
        (iterator b)))))

(def filter
  (rust "{0}.filter({1})"
    (where (a)
      (fn ((iterator a) (fn-mut ((ref a)) bool))
        (iterator a)))))

(def reduce-items
  (rust "{0}.reduce({1})"
    (where (a)
      (fn ((iterator a) (fn-mut (a a) a))
        (option a)))))

(def fold-items
  (rust "{0}.fold({1}, {2})"
    (where (a b)
      (fn ((iterator a) b (fn-mut (b a) b)) b))))

(defrule reduce
  ((items step) (reduce-items items step))
  ((items initial step) (fold-items items initial step)))

(def for-each
  (rust "{0}.for_each({1})"
    (where (a)
      (fn ((iterator a) (fn-mut (a) unit))
        unit))))

(def enumerate
  (rust "{0}.enumerate()"
    (where (a)
      (fn ((iterator a))
        (iterator (pair usize a))))))

(def zip
  (rust "{0}.zip({1})"
    (where (a b)
      (fn ((iterator a) (iterator b))
        (iterator (pair a b))))))

(type sum
  (where ((n number))
    (fn ((iterator n)) n)))

(defn sum (values)
  "Adds the items of an iterator from left to right.

  An empty iterator gives 0. An overflow panics in a debug build, as `+`
  does. A vector passes and yields copies of its numbers. `(iter items)` is an
  error, as its items are borrows, and so is a map."
  (reduce values 0 +))

(def count-items
  (rust "{0}.count()"
    (where (a) (fn ((iterator a)) usize))))

(def count-function
  (rust "Iterator::count"
    (where (a) (fn ((iterator a)) usize))))

(def iter-form?
  (fn (form)
    (if (list? form)
      (if (empty? form)
        false
        (if (symbol? (first form))
          (same-binding? (first form) (quote iter))
          false))
      false)))

(def counts-one-collection?
  (fn (arguments)
    (if (empty? arguments)
      false
      (if (empty? (rest arguments))
        (iter-form? (first arguments))
        false))))

(def count
  (macro (form)
    (if (symbol? form)
      (quote count-function)
      (if (counts-one-collection? (rest form))
        (prepend (quote len)
                 (rest (first (rest form))))
        (prepend (quote count-items) (rest form))))))

(def max
  (rust "{0}.max()"
    (where ((a ord))
      (fn ((iterator a)) (option a)))))

(def min
  (rust "{0}.min()"
    (where ((a ord))
      (fn ((iterator a)) (option a)))))

(def max-by-key
  (rust "{0}.max_by_key({1})"
    (where (a (k ord))
      (fn ((iterator a) (fn-mut ((ref a)) k))
        (option a)))))

(def any?
  (rust "{owned 0}.any({1})"
    (where (a)
      (fn ((iterator a) (fn-mut (a) bool))
        bool))))

(def every?
  (rust "{owned 0}.all({1})"
    (where (a)
      (fn ((iterator a) (fn-mut (a) bool))
        bool))))

(def find
  (rust "{owned 0}.find({1})"
    (where (a)
      (fn ((iterator a) (fn-mut ((ref a)) bool))
        (option a)))))

(def take
  (rust "{0}.take({1})"
    (where (a)
      (fn ((iterator a) usize) (iterator a)))))

(def take-while
  (rust "{0}.take_while({1})"
    (where (a)
      (fn ((iterator a) (fn-mut ((ref a)) bool))
        (iterator a)))))

(document (range start end)
  "Returns an iterator over the integers from `start` up to but not `end`.

  It is empty when `start` is not below `end`.")

(document (map items function)
  "Returns an iterator over a function's result for each item.

  It is lazy: the function runs when a later call reads the item. A vector or
  a map passes as its `iter`. A keyword such as `:age` reads that field.")

(document (filter items test)
  "Returns an iterator over the items that pass a test.

  `test` takes a `(ref a)`. It is lazy: the test runs when a later call reads
  the item. A vector or a map passes as its `iter`.")

(document (reduce items step)
  "Combines the items into one value with a function of two arguments.

  `step` takes the value so far and the next item. The first item starts the
  value, and the call returns an `option`, `none` for no items.

  `(reduce items initial step)` starts from `initial` and returns the value
  itself. A vector or a map passes as its `iter`. Its items are borrows, so
  the first form takes `(copied items)` for a step such as `+`.")

(document (for-each items function)
  "Calls a function on each item, in order.

  The function must return unit, and so does the call. A vector or a map
  passes as its `iter`.")

(document (enumerate items)
  "Returns an iterator that pairs each item's index with the item.

  Each result is a `(pair usize a)`, and the index starts at 0. A vector or a
  map passes as its `iter`.")

(document (zip left right)
  "Returns an iterator over pairs of items from two iterators.

  It ends when the shorter iterator ends. A vector or a map passes as its
  `iter`.")

(document (count items)
  "Returns the number of items of an iterator as a `usize`.

  `(count (iter collection))` emits the collection's `len`, and any other call
  runs through the items. A vector or a map passes as its `iter`.")

(document (max items)
  "Returns the largest item as an `option`.

  It returns `none` for no items, and the last of equal items. The items
  implement `ord`, so a float is an error. A vector or a map passes as its
  `iter`.")

(document (min items)
  "Returns the smallest item as an `option`.

  It returns `none` for no items, and the first of equal items. The items
  implement `ord`, so a float is an error. A vector or a map passes as its
  `iter`.")

(document (max-by-key items key)
  "Returns the item with the largest key as an `option`.

  `key` takes a `(ref a)` and returns a value that implements `ord`. The call
  returns `none` for no items, and the last of equal keys. A vector or a map
  passes as its `iter`. A keyword such as `:age` reads that field.")

(document (any? items test)
  "Returns whether any item passes a test.

  It stops at the first item that passes, and no items give `false`. `test`
  takes the item itself. A vector or a map passes as its `iter`.")

(document (every? items test)
  "Returns whether every item passes a test.

  It stops at the first item that fails, and no items give `true`. `test`
  takes the item itself. A vector or a map passes as its `iter`.")

(document (find items test)
  "Returns the first item that passes a test as an `option`.

  It returns `none` when no item passes. `test` takes a `(ref a)`. A vector or
  a map passes as its `iter`.")

(document (take items limit)
  "Returns an iterator over at most the first `limit` items.

  `limit` is a `usize`, so an `i64` is an error. A vector or a map passes as
  its `iter`.")

(document (take-while items test)
  "Returns an iterator over the items before the first that fails a test.

  `test` takes a `(ref a)`. A vector or a map passes as its `iter`.")
