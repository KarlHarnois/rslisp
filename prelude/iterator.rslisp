(use prelude/types iterator option)
(use prelude/pair pair)
(use prelude/number integer number ord add)
(use prelude/syntax defn)

(export range map filter fold for-each enumerate zip
        sum count max min max-by-key any all find take take-while)

(def range (rust "{0}..{1}" (where ((n integer)) (fn (n n) (iterator n)))))
(def map (rust "{0}.map({1})" (where (a b) (fn ((iterator a) (fn (a) b)) (iterator b)))))
(def filter (rust "{0}.filter({1})" (where (a) (fn ((iterator a) (fn ((ref a)) bool)) (iterator a)))))
(def fold (rust "{0}.fold({1}, {2})" (where (a b) (fn ((iterator a) b (fn (b a) b)) b))))
(def for-each (rust "{0}.for_each({1})" (where (a) (fn ((iterator a) (fn (a) unit)) unit))))
(def enumerate (rust "{0}.enumerate()" (where (a) (fn ((iterator a)) (iterator (pair usize a))))))
(def zip (rust "{0}.zip({1})" (where (a b) (fn ((iterator a) (iterator b)) (iterator (pair a b))))))
(type sum (where ((n number)) (fn ((iterator n)) n)))
(defn sum (values) (fold values 0 add))
(def count (rust "{0}.count()" (where (a) (fn ((iterator a)) usize))))
(def max (rust "{0}.max()" (where ((a ord)) (fn ((iterator a)) (option a)))))
(def min (rust "{0}.min()" (where ((a ord)) (fn ((iterator a)) (option a)))))
(def max-by-key (rust "{0}.max_by_key({1})" (where (a (k ord)) (fn ((iterator a) (fn ((ref a)) k)) (option a)))))
(def any (rust "{0}.any({1})" (where (a) (fn ((iterator a) (fn (a) bool)) bool))))
(def all (rust "{0}.all({1})" (where (a) (fn ((iterator a) (fn (a) bool)) bool))))
(def find (rust "{0}.find({1})" (where (a) (fn ((iterator a) (fn ((ref a)) bool)) (option a)))))
(def take (rust "{0}.take({1})" (where (a) (fn ((iterator a) usize) (iterator a)))))
(def take-while (rust "{0}.take_while({1})" (where (a) (fn ((iterator a) (fn ((ref a)) bool)) (iterator a)))))
