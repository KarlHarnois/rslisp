(use prelude/macros defmacro defrule document module)
(use prelude/types iterator option slice vec)
(use prelude/number < > ord partial-eq)
(use prelude/ownership copy)

(use code concat empty? len list number-add number-lt
          number-sub prepend rest string symbol?)

(module "Builds, reads and reorders vectors.")

(export at collect copied dedup! first iter last pop! push!
        remove-at! reverse reverse! sort! sort-by! vec
        windows)

(def element-placeholders
  (fn (count) (element-placeholders-onto "" 0 count)))

(def element-placeholders-onto
  (fn (text index count)
    (if (number-lt index count)
      (recur (string text (if (number-lt 0 index) ", " "") "{" index "}")
             (number-add index 1)
             count)
      text)))

(def repeated-item
  (fn (count)
    (repeated-item-onto (list) count)))

(def repeated-item-onto
  (fn (items count)
    (if (number-lt 0 count)
      (recur (concat items (list (quote item)))
             (number-sub count 1))
      items)))

(def elements-type
  (fn (count)
    (list (quote where)
          (list (quote item))
          (list (quote fn)
                (repeated-item count)
                (list (quote vec) (quote item))))))

(defmacro vec (elements ...)
  "Builds a vector from its elements, which all have one type.

  `(vec)` is empty. `vec` is also the type `(vec a)`, Rust's `Vec<A>`."
  (local count (len elements))
  (if (empty? elements)
    (list (quote rust)
          "Vec::new()"
          (quote (where (item) (vec item))))
    (prepend (list (quote rust)
                   (string "vec![" (element-placeholders count) "]")
                   (elements-type count))
             elements)))

(def push!
  (macro (form)
    (if (symbol? form)
      (quote vec-push!)
      (concat (list (quote map-at) (quote push))
              (rest form)))))

(document (push! target item)
  "Adds an item to a vector or a string.

  A vector takes an element, and a `string` takes a `char` or a
  `(ref str)`. `push!` as a value is the vector push.")

(def vec-push!
  (rust "{0}.push({1})"
    (where (a) (fn ((mut (vec a)) a) unit))))

(defrule iter
  ((collection) (map-at iter collection)))

(def copied
  (rust "{0}.iter().copied()"
    (where ((a copy))
      (fn ((ref (slice a))) (iterator a)))))

(def collect
  (rust "{0}.collect::<Vec<_>>()"
    (where (a) (fn ((iterator a)) (vec a)))))

(def pop!
  (rust "{0}.pop()"
    (where (a)
      (fn ((mut (vec a))) (option a)))))

(def remove-at!
  (rust "{0}.remove({1})"
    (where (a) (fn ((mut (vec a)) usize) a))))

(def sort-ascending!
  (rust "{0}.sort()"
    (where ((a ord))
      (fn ((mut (vec a))) unit))))

(def sort-with!
  (rust "{0}.sort_by(|{!left}, {!right}| {1}({!left}, {!right}).cmp(&0))"
    (where (a)
      (fn ((mut (vec a))
           (fn ((ref a) (ref a)) i64))
        unit))))

(defrule sort!
  ((items) (sort-ascending! items))
  ((items (quote <)) (sort-ascending! items))
  ((items (quote >)) (sort-descending! items))
  ((items compare) (sort-with! items compare)))

(def sort-by!
  (rust "{0}.sort_by_key({1})"
    (where (a (k ord))
      (fn ((mut (vec a)) (fn-mut ((ref a)) k))
        unit))))

(def windows
  (rust "{0}.windows({1})"
    (where (a)
      (fn ((ref (slice a)) usize)
        (iterator (ref (slice a)))))))

(def at
  (rust "&{0}[{1}]"
    (where (a)
      (fn ((ref (slice a)) usize) (ref a)))))

(def first
  (rust "{0}.first()"
    (where (item)
      (fn ((ref (slice item)))
        (option (ref item))))))

(def last
  (rust "{0}.last()"
    (where (item)
      (fn ((ref (slice item)))
        (option (ref item))))))

(def reverse
  (rust "{0}.iter().rev()"
    (where (item)
      (fn ((ref (slice item)))
        (iterator (ref item))))))

(def reverse!
  (rust "{0}.reverse()"
    (where (item)
      (fn ((mut (vec item))) unit))))

(def sort-descending!
  (rust "{0}.sort_by(|{!left}, {!right}| {!right}.cmp({!left}))"
    (where ((item ord))
      (fn ((mut (vec item))) unit))))

(def dedup!
  (rust "{0}.dedup()"
    (where ((a partial-eq))
      (fn ((mut (vec a))) unit))))

(document (iter collection)
  "Returns an iterator over borrows of a collection's items.

  A vector or a slice yields `(ref a)`, and a map yields
  `(pair (ref key) (ref value))`. Where a call expects an `iterator`, a vector,
  a slice or a map passes without `iter`.")

(document (copied items)
  "Returns an iterator over copies of a slice's items.

  The items implement `copy`. It takes a vector or a slice, not an iterator.")

(document (collect items)
  "Collects the items of an iterator into a vector.")

(document (pop! items)
  "Removes a vector's last item and returns it as an `option`.

  It returns `none` for an empty vector.")

(document (remove-at! items index)
  "Removes the item at an index and returns it.

  `index` is a `usize`, so an `i64` is an error. Each later item moves down by
  one. It panics when `index` is not below the vector's length.")

(document (sort! items)
  "Sorts a vector in place, in ascending order.

  `(sort! items <)` does the same, and `(sort! items >)` sorts in descending
  order. Both need items that implement `ord`.

  `(sort! items compare)` orders by a function of two `(ref a)` that returns
  an `i64`. A negative result puts the first item first, a positive result
  puts it last, and zero keeps the two in order. Rust's `sort_by` may panic
  when `compare` is not a consistent order.")

(document (sort-by! items key)
  "Sorts a vector in place by the key of each item.

  `key` takes a `(ref a)` and returns a value that implements `ord`. Items
  with equal keys keep their order. A keyword such as `:age` reads that field.
  Rust's `sort_by_key` may panic when `key` is not consistent between calls.")

(document (windows items size)
  "Returns an iterator over each run of `size` neighboring items of a slice.

  Each run is a `(ref (slice a))`. `size` is a `usize`, so an `i64` is an
  error. A slice shorter than `size` gives no run. It panics when `size` is
  zero. A vector passes as its slice.")

(document (at items index)
  "Returns a borrow of the item at an index.

  `index` is a `usize`, so an `i64` is an error. It panics when `index` is not
  below the length. `get` returns an `option` in place of the panic. A vector
  passes as its slice.")

(document (first items)
  "Returns a borrow of a slice's first item as an `option`.

  It returns `none` for an empty slice. A vector passes as its slice.")

(document (last items)
  "Returns a borrow of a slice's last item as an `option`.

  It returns `none` for an empty slice. A vector passes as its slice.")

(document (reverse items)
  "Returns an iterator over borrows of a slice's items, last item first.

  It takes a vector or a slice, not an iterator, and leaves the items in
  place. Use `reverse!` to reverse a vector itself.")

(document (reverse! items) "Reverses a vector in place.")

(document (dedup! items)
  "Removes from a vector each item equal to the one before it.

  Only neighbors count, so sort the vector first to remove every repeat. The
  items implement `partial-eq`.")
