(use prelude/macros defmacro defrule)
(use prelude/types vec option iterator slice sequence)
(use prelude/number ord partial-eq)
(use prelude/ownership copy)
(use code list prepend concat length empty? string number-add number-sub number-lt)

(export vec push! len iter values collect get pop! remove-at! sort! sort-by-key! windows at dedup!
        first last reverse reverse! sort-descending!)

(def element-placeholders
  (fn (count)
    (element-placeholders-onto "" 0 count)))

(def element-placeholders-onto
  (fn (text index count)
    (if (number-lt index count)
        (recur (string text (if (number-lt 0 index) ", " "") "{" index "}") (number-add index 1) count)
        text)))

(def repeated-item
  (fn (count)
    (repeated-item-onto (list) count)))

(def repeated-item-onto
  (fn (items count)
    (if (number-lt 0 count)
        (recur (concat items (list (quote item))) (number-sub count 1))
        items)))

(def elements-type
  (fn (count)
    (list (quote where) (list (quote item))
          (list (quote fn) (repeated-item count) (list (quote vec) (quote item))))))

(defmacro vec (elements ...)
  (let count (length elements))
  (if (empty? elements)
      (list (quote rust) "Vec::new()" (quote (where (item) (vec item))))
      (prepend (list (quote rust) (string "vec![" (element-placeholders count) "]")
                     (elements-type count))
               elements)))

(def push! (rust "{0}.push({1})" (where (a) (fn ((mut (vec a)) a) unit))))
(def len (rust "{0}.len()" (where ((a sequence)) (fn ((ref a)) usize))))
(defrule iter
  ((collection) (map-at iter collection)))
(def values (rust "{0}.iter().copied()" (where ((a copy)) (fn ((ref (slice a))) (iterator a)))))
(def collect (rust "{0}.collect::<Vec<_>>()" (where (a) (fn ((iterator a)) (vec a)))))
(def get (rust "{0}.get({1})" (where (a) (fn ((ref (slice a)) usize) (option (ref a))))))
(def pop! (rust "{0}.pop()" (where (a) (fn ((mut (vec a))) (option a)))))
(def remove-at! (rust "{0}.remove({1})" (where (a) (fn ((mut (vec a)) usize) a))))
(def sort-ascending! (rust "{0}.sort()" (where ((a ord)) (fn ((mut (vec a))) unit))))
(def sort-with! (rust "{0}.sort_by(|{!left}, {!right}| {1}({!left}, {!right}).cmp(&0))"
                     (where (a) (fn ((mut (vec a)) (fn ((ref a) (ref a)) i64)) unit))))
(defrule sort!
  ((items) (sort-ascending! items))
  ((items compare) (sort-with! items compare)))
(def sort-by-key! (rust "{0}.sort_by_key({1})" (where (a (k ord)) (fn ((mut (vec a)) (fn-mut ((ref a)) k)) unit))))
(def windows (rust "{0}.windows({1})" (where (a) (fn ((ref (slice a)) usize) (iterator (ref (slice a)))))))
(def at (rust "&{0}[{1}]" (where (a) (fn ((ref (slice a)) usize) (ref a)))))
(def first (rust "{0}.first()" (where (item) (fn ((ref (slice item))) (option (ref item))))))
(def last (rust "{0}.last()" (where (item) (fn ((ref (slice item))) (option (ref item))))))
(def reverse (rust "{0}.iter().rev()" (where (item) (fn ((ref (slice item))) (iterator (ref item))))))
(def reverse! (rust "{0}.reverse()" (where (item) (fn ((mut (vec item))) unit))))
(def sort-descending! (rust "{0}.sort_by(|{!left}, {!right}| {!right}.cmp({!left}))"
                          (where ((item ord)) (fn ((mut (vec item))) unit))))
(def dedup! (rust "{0}.dedup()" (where ((a partial-eq)) (fn ((mut (vec a))) unit))))
