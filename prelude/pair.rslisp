(use prelude/macros defrule)

(export pair let-pair let-fields)

(enum (pair a b) (rust "({0}, {1})") (pair a b))

(def pair (rust "({0}, {1})" (where (a b) (fn (a b) (pair a b)))))

(defrule let-pair
  (((first second) value body ...)
   (match value ((pair first second) (do body ...)))))

(defrule let-fields
  (((type-name (name ...)) value body ...)
   (match value ((type-name name ...) (do body ...)))))
