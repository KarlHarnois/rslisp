(use prelude/macros document)
(use prelude/types iterator option result vec)

(export command-line-args exit io-error line-seq read-line
        slurp source stdin)

(rust-type io-error "std::io::Error")

(rust-type stdin "std::io::Stdin")

(def stdin (rust "std::io::stdin()" stdin))

(rust-trait source "crate::rt::Source" str string stdin)

(def slurp
  (rust "crate::rt::Source::slurp({0})"
    (where ((s source))
      (fn ((ref s)) (result string io-error)))
    (str "std::fs::read_to_string({0})")
    (string "std::fs::read_to_string({0})")
    (stdin "std::io::Write::flush(&mut std::io::stdout()).and_then(|()| std::io::read_to_string({0}))")))

(def line-seq
  (rust "crate::rt::lines({0})"
    (fn ((ref stdin))
      (iterator (result string io-error)))))

(def read-line
  (rust "crate::rt::read_line()"
    (fn ()
      (result (option string) io-error))))

(def command-line-args
  (rust "std::env::args().skip(1).collect::<Vec<String>>()"
    (fn () (vec string))))

(def exit
  (rust "crate::rt::exit({0})" (fn (i32) unit)))

(document io-error
  "Names the error of an input or output call, Rust's `std::io::Error`.

  It implements `display`, `debug` and `show`.")

(document stdin
  "Holds the program's standard input.

  `stdin` is also its type, Rust's `std::io::Stdin`.")

(document source
  "Marks what `slurp` reads: a path as a `str` or a `string`, or `stdin`.")

(document (slurp source)
  "Reads all of a file or of standard input into a `string`.

  It returns `(result string io-error)`. It takes its source by reference, so
  an owned path stays usable. Reading `stdin` flushes standard output first.")

(document (line-seq stdin)
  "Returns an iterator over the lines of standard input, one read at a time.

  Each item is a `(result string io-error)` without its line ending. A failed
  read yields one `err` and ends the iterator.")

(document (read-line)
  "Reads one line of standard input.

  It returns `(result (option string) io-error)`, with `none` at the end of
  input, and drops the line ending. It flushes standard output first.")

(document (command-line-args)
  "Returns the program's arguments, after its name, as a `(vec string)`.")

(document (exit code)
  "Stops the process with an `i32` exit code.

  It runs no destructor of a live value.")
