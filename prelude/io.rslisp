(use prelude/types iterator option result vec)

(export command-line-args exit io-error line-seq read-line
        slurp source stdin)

(rust-type io-error "std::io::Error")

(rust-type stdin "std::io::Stdin")

(def stdin (rust "std::io::stdin()" stdin))

(rust-trait source "crate::rt::Source" str string stdin)

(def slurp
  (rust "crate::rt::Source::slurp({0})"
    (where ((s source))
      (fn ((ref s)) (result string io-error)))
    (str "std::fs::read_to_string({0})")
    (string "std::fs::read_to_string({0})")
    (stdin "std::io::Write::flush(&mut std::io::stdout()).and_then(|()| std::io::read_to_string({0}))")))

(def line-seq
  (rust "crate::rt::lines({0})"
    (fn ((ref stdin))
      (iterator (result string io-error)))))

(def read-line
  (rust "crate::rt::read_line()"
    (fn ()
      (result (option string) io-error))))

(def command-line-args
  (rust "std::env::args().skip(1).collect::<Vec<String>>()"
    (fn () (vec string))))

(def exit
  (rust "std::process::exit({0})" (fn (i32) unit)))
