(use prelude/macros defmacro whole-pairs?)
(use code first rest list prepend concat length empty? list? nth drop number-sub symbol?
          string fail keyword? keyword-name field-keyword value-eq symbol
          bool-not)

(export assoc assoc-in)

(defmacro assoc (value key more ...)
  (let arguments (prepend key more))
  (if (keyword? key)
      (struct-update value arguments)
      (if (whole-pairs? arguments)
          (collection-updates value arguments)
          (unpaired-key-error value arguments))))

(def struct-update
  (fn (value pairs)
    (concat (list (quote new) (quote _) value) (field-initializers pairs))))

(def field-initializers
  (fn (pairs)
    (if (empty? pairs)
        (list)
        (prepend (field-initializer (first pairs) (rest pairs))
                 (field-initializers (drop 2 pairs))))))

(def field-initializer
  (fn (key more)
    (if (keyword? key)
        (if (empty? more)
            (fail "this field has no value" key
                  "write `:field value` pairs, as in (assoc leaf :year 2025)")
            (list key (first more)))
        (fail "a struct update takes only `:field value` pairs" key
              "update the collection in a separate `assoc`"))))

(def collection-updates
  (fn (value pairs)
    (if (empty? pairs)
        value
        (collection-updates (list (quote assoc-at) value (list (first pairs)) (nth pairs 1))
                            (drop 2 pairs)))))

(def unpaired-key-error
  (fn (value arguments)
    (let message "a collection update takes keys and values in pairs")
    (let unpaired-key (nth arguments (number-sub (length arguments) 1)))
    (if (every-field-group? arguments)
        (fail message unpaired-key
              (string "to update a field, write "
                      (concat (list (quote assoc) value) (keyword-arguments arguments))))
        (fail message unpaired-key))))

(def every-field-group?
  (fn (arguments)
    (if (empty? arguments)
        true
        (if (field-group? (first arguments)) (every-field-group? (rest arguments)) false))))

(def field-group?
  (fn (form)
    (if (list? form)
        (if (value-eq (length form) 2) (field-name? (first form)) false)
        false)))

(def field-name?
  (fn (form)
    (if (symbol? form) (bool-not (keyword? form)) false)))

(def keyword-arguments
  (fn (arguments)
    (if (empty? arguments)
        (list)
        (concat (keyword-pair (first arguments)) (keyword-arguments (rest arguments))))))

(def keyword-pair
  (fn (argument)
    (if (field-group? argument)
        (list (field-keyword (first argument)) (nth argument 1))
        (list argument))))

(defmacro assoc-in (value (step ...) item)
  (let root (read-root value))
  (if (symbol? root)
      (path-update value step item)
      (if (empty? (keyword-steps step))
          (path-update value step item)
          (list (quote do) (list (quote let) (quote base) root)
                (path-update (rebased-read value root) step item)))))

(def read-root
  (fn (form)
    (if (list? form)
        (if (value-eq (length form) 2)
            (if (keyword? (first form)) (read-root (nth form 1)) form)
            form)
        form)))

(def rebased-read
  (fn (form root)
    (if (value-eq form root) (quote base) (list (first form) (rebased-read (nth form 1) root)))))

(def keyword-steps
  (fn (path)
    (if (empty? path)
        path
        (if (keyword? (first path)) path (keyword-steps (rest path))))))

(def path-update
  (fn (base path item)
    (let fields (keyword-steps path))
    (if (empty? fields)
        (list (quote assoc-at) base path item)
        (if (keyword? (first path))
            (field-step base (first path) (rest path) item)
            (fail "a field step cannot follow an index step" (first fields))))))

(def field-step
  (fn (base key path item)
    (let field (symbol (quote base) (keyword-name key)))
    (if (empty? path)
        (list (quote assoc) base key item)
        (list (quote do)
              (list (quote let) field (path-update (list key base) path item))
              (list (quote assoc) base key field)))))
