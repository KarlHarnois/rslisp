(use code first rest list prepend concat length empty? nth take drop
          symbol? list? string? symbol-name symbol string same-binding? fail
          value-eq number-add number-sub number-lt
          string-lines string-trim-start string-length string-drop string-strip-suffix)

(export defrule defmacro template map-list whole-pairs? documented doc-entry docstring-before-body?)

(def map-list
  (fn (function items)
    (map-onto (list) function items)))

(def map-onto
  (fn (mapped function items)
    (if (empty? items)
        mapped
        (recur (concat mapped (list (function (first items)))) function (rest items)))))

(def map-count
  (fn (count function)
    (map-from (list) 0 count function)))

(def map-from
  (fn (mapped index count function)
    (if (number-lt index count)
        (recur (concat mapped (list (function index))) (number-add index 1) count function)
        mapped)))

(def concat-all
  (fn (lists)
    (concat-onto (list) lists)))

(def concat-onto
  (fn (joined lists)
    (if (empty? lists)
        joined
        (recur (concat joined (first lists)) (rest lists)))))

(def headed-by?
  (fn (form name)
    (if (list? form)
        (if (empty? form)
            false
            (if (symbol? (first form)) (same-binding? (first form) name) false))
        false)))

(def ellipsis?
  (fn (form)
    (if (symbol? form) (same-binding? form (quote ...)) false)))

(def literal-pattern?
  (fn (pattern)
    (if (headed-by? pattern (quote quote)) (value-eq (length pattern) 2) false)))

(def followed-by-ellipsis?
  (fn (forms)
    (if (number-lt 1 (length forms)) (ellipsis? (nth forms 1)) false)))

(def entry-kind?
  (fn (entry kind)
    (if (list? entry) (value-eq (symbol-name (first entry)) kind) false)))

(def lookup
  (fn (variable bindings)
    (if (empty? bindings)
        false
        (if (value-eq (symbol-name (nth (first bindings) 1)) (symbol-name variable))
            (first bindings)
            (recur variable (rest bindings))))))

(def entry-value
  (fn (entry)
    (if (entry-kind? entry "one")
        (nth entry 2)
        (map-list entry-value (nth entry 2)))))

(def binding-value
  (fn (bindings variable)
    (entry-value (lookup variable bindings))))

(def pattern-variables
  (fn (pattern)
    (if (literal-pattern? pattern)
        (list)
        (if (symbol? pattern)
            (if (ellipsis? pattern) (list) (list pattern))
            (if (list? pattern) (concat-all (map-list pattern-variables pattern)) (list))))))

(def template-variables
  (fn (template)
    (if (symbol? template)
        (if (ellipsis? template) (list) (list template))
        (if (list? template) (concat-all (map-list template-variables template)) (list)))))

(def join-matches
  (fn (left right)
    (if (list? left) (if (list? right) (concat left right) false) false)))

(def append-match
  (fn (matches match)
    (if (list? match) (concat matches (list match)) false)))

(def match-pattern
  (fn (pattern input)
    (if (literal-pattern? pattern)
        (if (symbol? input) (if (same-binding? input (nth pattern 1)) (list) false) false)
        (if (symbol? pattern)
            (list (list (quote one) pattern input))
            (if (list? pattern)
                (if (list? input) (match-list pattern input) false)
                (if (value-eq pattern input) (list) false))))))

(def match-list
  (fn (patterns inputs)
    (if (empty? patterns)
        (if (empty? inputs) (list) false)
        (if (followed-by-ellipsis? patterns)
            (match-ellipsis (first patterns) (drop 2 patterns) inputs)
            (if (empty? inputs)
                false
                (join-matches (match-pattern (first patterns) (first inputs))
                              (match-list (rest patterns) (rest inputs))))))))

(def match-ellipsis
  (fn (repeated tail inputs)
    (let repeat-count (number-sub (length inputs) (length tail)))
    (if (number-lt repeat-count 0)
        false
        (join-matches (match-repeated repeated (take repeat-count inputs))
                      (match-list tail (drop repeat-count inputs))))))

(def match-repeated
  (fn (repeated inputs)
    (let matches (match-each repeated inputs))
    (if (list? matches)
        (map-list (fn (variable)
                    (list (quote many) variable
                          (map-list (fn (bindings) (lookup variable bindings)) matches)))
                  (pattern-variables repeated))
        false)))

(def match-each
  (fn (pattern inputs)
    (match-each-onto (list) pattern inputs)))

(def match-each-onto
  (fn (matches pattern inputs)
    (if (empty? inputs)
        matches
        (if (list? matches)
            (recur (append-match matches (match-pattern pattern (first inputs))) pattern (rest inputs))
            false))))

(def fill-template
  (fn (template bindings)
    (if (symbol? template)
        (fill-symbol template bindings)
        (if (list? template) (fill-list template bindings) template))))

(def fill-symbol
  (fn (template bindings)
    (let entry (lookup template bindings))
    (if (entry-kind? entry "one")
        (nth entry 2)
        (if (entry-kind? entry "many")
            (fail "this pattern variable needs `...` after it" template)
            template))))

(def fill-list
  (fn (templates bindings)
    (if (empty? templates)
        (list)
        (if (followed-by-ellipsis? templates)
            (concat (fill-repeated (first templates) bindings)
                    (fill-list (drop 2 templates) bindings))
            (prepend (fill-template (first templates) bindings)
                     (fill-list (rest templates) bindings))))))

(def fill-repeated
  (fn (template bindings)
    (let variables (repeated-variables (template-variables template) bindings))
    (if (empty? variables)
        (fail "nothing before this `...` repeats" template)
        (map-count (length (nth (lookup (first variables) bindings) 2))
                   (fn (index) (fill-template template (iteration-bindings variables bindings index)))))))

(def repeated-variables
  (fn (candidates bindings)
    (if (empty? candidates)
        (list)
        (if (entry-kind? (lookup (first candidates) bindings) "many")
            (prepend (first candidates) (repeated-variables (rest candidates) bindings))
            (repeated-variables (rest candidates) bindings)))))

(def iteration-bindings
  (fn (variables bindings index)
    (concat (map-list (fn (variable) (nth (nth (lookup variable bindings) 2) index)) variables)
            bindings)))

(def expand-rules
  (fn (clauses form)
    (try-rules clauses clauses form)))

(def try-rules
  (fn (remaining clauses form)
    (if (empty? remaining)
        (fail (string "no rule of `" (first form) "` matches this form") form
              (string "write it as " (rule-shapes (first form) clauses)))
        (try-clause (first remaining) (rest remaining) clauses form))))

(def try-clause
  (fn (clause others clauses form)
    (let bindings (match-list (first clause) (rest form)))
    (if (list? bindings)
        (fill-template (nth clause 1) bindings)
        (try-rules others clauses form))))

(def rule-shapes
  (fn (name clauses)
    (join-shapes (map-list (fn (clause) (prepend name (first clause))) clauses))))

(def join-shapes
  (fn (shapes)
    (if (empty? (rest shapes))
        (string "`" (first shapes) "`")
        (string "`" (first shapes) "`, or " (join-shapes (rest shapes))))))

(def defrule
  (macro (form)
    (let name (nth form 1))
    (if (string? (nth form 2))
        (documented (rule-definition name (drop 3 form))
                    (doc-entry name (list (quote defrule) name) (nth form 2)))
        (rule-definition name (drop 2 form)))))

(def rule-definition
  (fn (name rules)
    (list (quote def) name
          (list (quote macro) (list (quote rule-form))
                (list (quote expand-rules) (list (quote quote) rules) (quote rule-form))))))

(def build-template
  (fn (template)
    (if (headed-by? template (quote unquote))
        (nth template 1)
        (if (list? template)
            (prepend (quote concat) (map-list build-template-element template))
            (list (quote quote) template)))))

(def build-template-element
  (fn (element)
    (if (headed-by? element (quote splice))
        (nth element 1)
        (list (quote list) (build-template element)))))

(def template
  (macro (form)
    (build-template (nth form 1))))

(def match-or-fail
  (fn (pattern form)
    (let bindings (match-list pattern (rest form)))
    (if (list? bindings)
        bindings
        (fail (string "this use of `" (first form) "` does not match its shape") form
              (string "write it as `" (prepend (first form) pattern) "`")))))

(def pattern-lets
  (fn (pattern)
    (map-list (fn (variable)
                (list (quote let) variable
                      (list (quote binding-value) (quote macro-bindings) (list (quote quote) variable))))
              (pattern-variables pattern))))

(def defmacro
  (macro (form)
    (let name (nth form 1))
    (let pattern (nth form 2))
    (let body (drop 3 form))
    (if (docstring-before-body? body)
        (documented (macro-definition name pattern (rest body))
                    (doc-entry name (list (quote defmacro) name pattern) (first body)))
        (macro-definition name pattern body))))

(def docstring-before-body?
  (fn (body)
    (if (number-lt 1 (length body)) (string? (first body)) false)))

(def macro-definition
  (fn (name pattern body)
    (list (quote def) name
          (concat (list (quote macro) (list (quote macro-form))
                        (list (quote let) (quote macro-bindings)
                              (list (quote match-or-fail) (list (quote quote) pattern) (quote macro-form))))
                  (pattern-lets pattern)
                  body))))

(def documented
  (fn (definition entry)
    (list (quote do) definition entry)))

(def doc-entry
  (fn (name header text)
    (list (quote def) (symbol name "doc/" name)
          (list (quote macro) (list (quote doc-form))
                (list (quote list) (list (quote nth) (quote doc-form) 1)
                      (string header) (clean-docstring text))))))

(def clean-docstring
  (fn (text)
    (let lines (string-lines text))
    (let margin (shared-indentation (rest lines)))
    (let continuation (map-list (fn (line) (unindent margin line)) (rest lines)))
    (without-trailing-newlines
      (join-lines (without-leading-blanks (prepend (string-trim-start (first lines)) continuation))))))

(def shared-indentation
  (fn (lines)
    (smallest (map-list indentation (written-lines lines)))))

(def indentation
  (fn (line)
    (number-sub (string-length line) (string-length (string-trim-start line)))))

(def blank?
  (fn (line)
    (value-eq (string-trim-start line) "")))

(def written-lines
  (fn (lines)
    (if (empty? lines)
        lines
        (if (blank? (first lines))
            (written-lines (rest lines))
            (prepend (first lines) (written-lines (rest lines)))))))

(def smallest
  (fn (numbers)
    (if (empty? numbers) 0 (smallest-from (first numbers) (rest numbers)))))

(def smallest-from
  (fn (least numbers)
    (if (empty? numbers)
        least
        (recur (if (number-lt (first numbers) least) (first numbers) least) (rest numbers)))))

(def unindent
  (fn (margin line)
    (if (blank? line) "" (string-drop margin line))))

(def without-leading-blanks
  (fn (lines)
    (if (empty? lines)
        lines
        (if (blank? (first lines)) (recur (rest lines)) lines))))

(def join-lines
  (fn (lines)
    (if (empty? lines) "" (join-onto (first lines) (rest lines)))))

(def join-onto
  (fn (joined lines)
    (if (empty? lines)
        joined
        (recur (string joined "\n" (first lines)) (rest lines)))))

(def without-trailing-newlines
  (fn (text)
    (let stripped (string-strip-suffix text "\n"))
    (if (value-eq stripped text) text (recur stripped))))

(def whole-pairs?
  (fn (arguments)
    (if (empty? arguments)
        true
        (if (empty? (rest arguments)) false (recur (drop 2 arguments))))))
