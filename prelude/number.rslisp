(use prelude/macros defrule-with-value document)
(use prelude/pair pair)
(use prelude/logic and)
(use prelude/types box option result vec)

(export * + - / < <= = > >= eq float hash integer neg not=
        number ord partial-eq partial-ord pi rem signed
        sqrt)

(rust-trait number "crate::rt::Number"
  i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize f32
  f64)

(rust-trait signed "crate::rt::Signed"
  i8 i16 i32 i64 i128 isize f32 f64)

(rust-trait float "crate::rt::Float" f32 f64)

(rust-trait integer "crate::rt::Integer"
  i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize)

(rust-trait partial-eq "PartialEq"
  bool char str string
  (ref str)
  i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize f32
  f64
  (with string str)
  (with str string)
  (with string (ref str))
  (with (ref str) string)
  (where ((a (partial-eq b)) b)
    (with (ref a) (ref b)))
  (where ((a partial-eq)) (vec a))
  (where ((a partial-eq)) (option a))
  (where ((a partial-eq) (b partial-eq))
    (result a b))
  (where ((a partial-eq)) (box a))
  (where ((a partial-eq) (b partial-eq))
    (pair a b)))

(rust-trait eq "Eq"
  (requires partial-eq)
  bool char str string
  (ref str)
  i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize
  (where ((a eq)) (vec a))
  (where ((a eq)) (option a))
  (where ((a eq) (b eq)) (result a b))
  (where ((a eq)) (box a))
  (where ((a eq) (b eq)) (pair a b)))

(rust-trait hash "std::hash::Hash"
  bool char str string
  (ref str)
  i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize
  (where ((a hash)) (vec a))
  (where ((a hash)) (option a))
  (where ((a hash) (b hash)) (result a b))
  (where ((a hash)) (box a))
  (where ((a hash) (b hash)) (pair a b)))

(rust-trait partial-ord "PartialOrd"
  (requires partial-eq)
  char str string
  (ref str)
  i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize f32
  f64
  (where ((a partial-ord)) (ref a))
  (where ((a partial-ord)) (box a))
  (where ((a partial-ord) (b partial-ord))
    (pair a b)))

(def add
  (rust "{0} + {1}"
    (where ((n number)) (fn (n n) n))))

(def sub
  (rust "{0} - {1}"
    (where ((n number)) (fn (n n) n))))

(def mul
  (rust "{0} * {1}"
    (where ((n number)) (fn (n n) n))))

(def div
  (rust "{0} / {1}"
    (where ((n number)) (fn (n n) n))))

(def rem
  (rust "{0} % {1}"
    (where ((n number)) (fn (n n) n))))

(def neg
  (rust "-{0}"
    (where ((n number signed)) (fn (n) n))))

(def sqrt
  (rust "{0}.sqrt()" (fn (f64) f64)))

(def pi (rust "std::f64::consts::PI" f64))

(def lt
  (rust "{&0} < {&1}"
    (where ((a partial-ord))
      (fn (a a) bool))))

(def le
  (rust "{&0} <= {&1}"
    (where ((a partial-ord))
      (fn (a a) bool))))

(def gt
  (rust "{&0} > {&1}"
    (where ((a partial-ord))
      (fn (a a) bool))))

(def ge
  (rust "{&0} >= {&1}"
    (where ((a partial-ord))
      (fn (a a) bool))))

(def equal
  (rust "{&0} == {&1}"
    (where ((a (partial-eq b)) b)
      (fn (a b) bool))))

(def ne
  (rust "{&0} != {&1}"
    (where ((a (partial-eq b)) b)
      (fn (a b) bool))))

(defrule-with-value + add
  ((a) a)
  ((a b) (add a b))
  ((a b c more ...) (+ (add a b) c more ...)))

(defrule-with-value - sub
  ((a) (neg a))
  ((a b) (sub a b))
  ((a b c more ...) (- (sub a b) c more ...)))

(defrule-with-value * mul
  ((a) a)
  ((a b) (mul a b))
  ((a b c more ...) (* (mul a b) c more ...)))

(defrule-with-value / div
  ((a b) (div a b))
  ((a b c more ...) (/ (div a b) c more ...)))

(defrule-with-value < lt
  ((a b) (lt a b))
  ((a b c more ...)
   (do
     (local left a)
     (local middle b)
     (and (lt left middle) (< middle c more ...)))))

(defrule-with-value <= le
  ((a b) (le a b))
  ((a b c more ...)
   (do
     (local left a)
     (local middle b)
     (and (le left middle) (<= middle c more ...)))))

(defrule-with-value > gt
  ((a b) (gt a b))
  ((a b c more ...)
   (do
     (local left a)
     (local middle b)
     (and (gt left middle) (> middle c more ...)))))

(defrule-with-value >= ge
  ((a b) (ge a b))
  ((a b c more ...)
   (do
     (local left a)
     (local middle b)
     (and (ge left middle) (>= middle c more ...)))))

(defrule-with-value = equal
  ((a b) (equal a b))
  ((a b c more ...)
   (do
     (local left a)
     (local middle b)
     (and (equal left middle) (= middle c more ...)))))

(defrule-with-value not= ne
  ((a b) (ne a b)))

(rust-trait ord "Ord"
  (requires eq partial-ord)
  char string
  (ref str)
  i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize
  (where ((a ord)) (ref a))
  (where ((a ord)) (box a))
  (where ((a ord) (b ord)) (pair a b)))

(document number
  "Marks a type that does arithmetic.

  Every integer and float type implements it, and `+`, `-`, `*`, `/` and `rem`
  take its types.")

(document signed
  "Marks a number type whose values can be negative.

  The signed integer types and the float types implement it, and `neg` takes
  its types.")

(document float
  "Marks a floating-point type.

  `f32` and `f64` implement it.")

(document integer
  "Marks an integer type.

  Every signed and unsigned integer type implements it.")

(document partial-eq
  "Marks a type whose values `=` and `not=` compare, as Rust's `PartialEq` does.

  A bound may name a second type, as in `(a (partial-eq b))`, so a `string`
  compares with a `str`.")

(document eq
  "Marks a type whose equality is total, as Rust's `Eq` does.

  The float types leave it out, and a key of a `hash-map` implements it.")

(document hash
  "Marks a type that a hasher can read, as Rust's `Hash` does.

  A key of a `hash-map` implements it.")

(document partial-ord
  "Marks a type whose values `<` and `>` compare, as Rust's `PartialOrd` does.

  `<=` and `>=` take the same types.")

(document ord
  "Marks a type whose values have a total order, as Rust's `Ord` does.

  A key of a `sorted-map` implements it. The float types do not.")

(document (rem a b)
  "Returns the remainder of dividing the first number by the second.

  It emits `a % b`, so the result takes the sign of the first number.")

(document (neg a)
  "Returns a signed number with its sign flipped.

  It emits `-a`. `(- a)` expands to it, and `neg` as a value is unary minus,
  so `(map (iter v) neg)` negates each item.")

(document (sqrt value)
  "Returns the square root of an `f64`.

  It emits `value.sqrt()`.")

(document pi
  "Holds the ratio of a circle's circumference to its diameter, as an `f64`.

  It emits `std::f64::consts::PI`.")

(document (+ number more ...)
  "Adds its arguments from left to right.

  One argument returns it, and two emit `a + b`. `+` as a value is the function
  of two numbers, so `(reduce (iter v) 0 +)` sums the items.")

(document (- number more ...)
  "Subtracts each later argument from the first.

  One argument negates it with `neg`, and two emit `a - b`. `-` as a value is
  the function of two numbers, and `neg` is unary minus as a value.")

(document (* number more ...)
  "Multiplies its arguments from left to right.

  One argument returns it, and two emit `a * b`. `*` as a value is the function
  of two numbers.")

(document (/ number divisor more ...)
  "Divides the first argument by each later one.

  It takes at least two arguments, and two emit `a / b`, so an integer division
  truncates. `/` as a value is the function of two numbers.")

(document (< value next more ...)
  "Returns whether each argument is less than the next.

  It borrows its arguments. With more than two, each runs at most once, and a
  false comparison ends the chain before the later arguments run. `<` as a
  value is the function of two values.")

(document (<= value next more ...)
  "Returns whether each argument is at most the next.

  It borrows its arguments. With more than two, each runs at most once, and a
  false comparison ends the chain before the later arguments run. `<=` as a
  value is the function of two values.")

(document (> value next more ...)
  "Returns whether each argument is greater than the next.

  It borrows its arguments. With more than two, each runs at most once, and a
  false comparison ends the chain before the later arguments run. `>` as a
  value is the function of two values.")

(document (>= value next more ...)
  "Returns whether each argument is at least the next.

  It borrows its arguments. With more than two, each runs at most once, and a
  false comparison ends the chain before the later arguments run. `>=` as a
  value is the function of two values.")

(document (= value next more ...)
  "Returns whether each argument equals the next.

  It borrows its arguments. With more than two, each runs at most once, and a
  false comparison ends the chain before the later arguments run. `=` as a
  value is the function of two values.")

(document (not= a b)
  "Returns whether its two arguments differ.

  It borrows both values. `not=` as a value is the same function.")
