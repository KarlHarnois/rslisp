(use prelude/macros defrule)
(use prelude/logic and)
(use prelude/types vec option result)

(export number signed float integer partial-eq hash partial-ord
        add sub mul div rem neg sqrt lt le gt ge eq ne
        + - * / < <= > >= = != ord)

(rust-trait number "crate::rt::Number" i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize f32 f64)
(rust-trait signed "crate::rt::Signed" i8 i16 i32 i64 i128 isize f32 f64)
(rust-trait float "crate::rt::Float" f32 f64)
(rust-trait integer "crate::rt::Integer" i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize)
(rust-trait partial-eq "PartialEq"
  bool char str string (ref str) i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize f32 f64
  (where ((a partial-eq)) (vec a))
  (where ((a partial-eq)) (option a))
  (where ((a partial-eq) (b partial-eq)) (result a b)))
(rust-trait eq "Eq"
  bool char str string (ref str) i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize
  (where ((a eq)) (vec a))
  (where ((a eq)) (option a))
  (where ((a eq) (b eq)) (result a b)))
(rust-trait hash "std::hash::Hash"
  bool char str string (ref str) i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize
  (where ((a hash)) (vec a))
  (where ((a hash)) (option a))
  (where ((a hash) (b hash)) (result a b)))
(rust-trait partial-ord "PartialOrd"
  char str string (ref str) i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize f32 f64)

(def add (rust "{0} + {1}" (where ((n number)) (fn (n n) n))))
(def sub (rust "{0} - {1}" (where ((n number)) (fn (n n) n))))
(def mul (rust "{0} * {1}" (where ((n number)) (fn (n n) n))))
(def div (rust "{0} / {1}" (where ((n number)) (fn (n n) n))))
(def rem (rust "{0} % {1}" (where ((n number)) (fn (n n) n))))
(def neg (rust "-{0}" (where ((n number signed)) (fn (n) n))))
(def sqrt (rust "{0}.sqrt()" (fn (f64) f64)))

(def lt (rust "{0} < {1}" (where ((a partial-ord)) (fn (a a) bool))))
(def le (rust "{0} <= {1}" (where ((a partial-ord)) (fn (a a) bool))))
(def gt (rust "{0} > {1}" (where ((a partial-ord)) (fn (a a) bool))))
(def ge (rust "{0} >= {1}" (where ((a partial-ord)) (fn (a a) bool))))
(def eq (rust "{0} == {1}" (where ((a partial-eq)) (fn (a a) bool))))
(def ne (rust "{0} != {1}" (where ((a partial-eq)) (fn (a a) bool))))

(defrule +
  ((a) a)
  ((a b) (add a b))
  ((a b c more ...) (+ (add a b) c more ...)))

(defrule -
  ((a) (neg a))
  ((a b) (sub a b))
  ((a b c more ...) (- (sub a b) c more ...)))

(defrule *
  ((a) a)
  ((a b) (mul a b))
  ((a b c more ...) (* (mul a b) c more ...)))

(defrule /
  ((a b) (div a b))
  ((a b c more ...) (/ (div a b) c more ...)))

(defrule <
  ((a b) (lt a b))
  ((a b c more ...) (do (let left a) (let middle b) (and (lt left middle) (< middle c more ...)))))

(defrule <=
  ((a b) (le a b))
  ((a b c more ...) (do (let left a) (let middle b) (and (le left middle) (<= middle c more ...)))))

(defrule >
  ((a b) (gt a b))
  ((a b c more ...) (do (let left a) (let middle b) (and (gt left middle) (> middle c more ...)))))

(defrule >=
  ((a b) (ge a b))
  ((a b c more ...) (do (let left a) (let middle b) (and (ge left middle) (>= middle c more ...)))))

(defrule =
  ((a b) (eq a b))
  ((a b c more ...) (do (let left a) (let middle b) (and (eq left middle) (= middle c more ...)))))

(defrule !=
  ((a b) (ne a b)))

(rust-trait ord "Ord"
  char string (ref str) i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize)
