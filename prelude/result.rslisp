(use prelude/macros defrule-with-value document)
(use prelude/types option result)
(use prelude/text show)

(export err err? expect-ok map-err map-ok ok ok-or ok?
        then-ok unwrap-err unwrap-ok)

(defrule-with-value ok (fn (value) (result/ok value))
  ((value) (result/ok value)))

(defrule-with-value err (fn (value) (result/err value))
  ((value) (result/err value)))

(def ok-or
  (rust "{0}.ok_or({1})"
    (where (a b)
      (fn ((option a) b) (result a b)))))

(def ok?
  (rust "{0}.is_ok()"
    (where (a b)
      (fn ((ref (result a b))) bool))))

(def err?
  (rust "{0}.is_err()"
    (where (a b)
      (fn ((ref (result a b))) bool))))

(def unwrap-ok
  (rust "crate::rt::unwrap_ok({0})"
    (where (a (b show))
      (fn ((result a b)) a))))

(def unwrap-err
  (rust "crate::rt::unwrap_err({0})"
    (where ((a show) b)
      (fn ((result a b)) b))))

(def expect-ok
  (rust "crate::rt::expect_ok({0}, {1})"
    (where (a (b show))
      (fn ((result a b) (ref str)) a))))

(def map-ok
  (rust "{0}.map({1})"
    (where (a b e)
      (fn ((result a e) (fn-once (a) b))
        (result b e)))))

(def map-err
  (rust "{0}.map_err({1})"
    (where (a b e)
      (fn ((result a e) (fn-once (e) b))
        (result a b)))))

(def then-ok
  (rust "{0}.and_then({1})"
    (where (a b e)
      (fn ((result a e)
           (fn-once (a) (result b e)))
        (result b e)))))

(document (ok value)
  "Wraps a success value in a `result`.

  As a value, it is a function of one argument, as in `(map (iter v) ok)`. In
  a `match`, `(ok x)` is the pattern that binds the value.")

(document (err error)
  "Wraps a failure value in a `result`.

  As a value, it is a function of one argument, as in `(map (iter v) err)`. In
  a `match`, `(err x)` is the pattern that binds the value.")

(document (ok-or option error)
  "Turns an `option` into a `result`, with `error` in place of `none`.

  `error` runs before the call, whether or not the call uses it. The call
  moves an option that is not `copy`.")

(document (ok? result)
  "Returns whether a `result` is `ok`.

  It borrows the result, which stays usable.")

(document (err? result)
  "Returns whether a `result` is `err`.

  It borrows the result, which stays usable.")

(document (unwrap-ok result)
  "Returns a `result`'s `ok` value.

  It panics on `err` with the printed form of the error, so the error type
  implements `show`. It moves a result that is not `copy`.")

(document (unwrap-err result)
  "Returns a `result`'s `err` value.

  It panics on `ok` with the printed form of the value, so the value type
  implements `show`. It moves a result that is not `copy`.")

(document (expect-ok result message)
  "Returns a `result`'s `ok` value, or panics with a message on `err`.

  The panic prints `message`, then the printed form of the error, so the error
  type implements `show`. `message` is a `(ref str)`, so borrow a `string`
  with `as-str`. The call moves a result that is not `copy`.")

(document (map-ok result function)
  "Applies a function to a `result`'s `ok` value.

  It returns the function's result in an `ok`. For `err` the function does not
  run, and the error passes through. A keyword such as `:age` reads that
  field. The call moves a result that is not `copy`.")

(document (map-err result function)
  "Applies a function to a `result`'s `err` value.

  It returns the function's result in an `err`. For `ok` the function does not
  run, and the value passes through. The call moves a result that is not
  `copy`.")

(document (then-ok result function)
  "Calls a function that returns a `result` on a `result`'s `ok` value.

  It returns the function's `result` as it is, which has the same error type.
  For `err` the function does not run, and the error passes through. The call
  moves a result that is not `copy`.")
