(use prelude/macros defrule)
(use prelude/types result option)
(use prelude/text show)

(export ok err ok-or ok? err? unwrap-ok unwrap-err expect-ok map-ok map-err then-ok)

(defrule ok
  ((value) (result/ok value)))

(defrule err
  ((value) (result/err value)))
(def ok-or (rust "{0}.ok_or({1})" (where (a b) (fn ((option a) b) (result a b)))))
(def ok? (rust "{0}.is_ok()" (where (a b) (fn ((ref (result a b))) bool))))
(def err? (rust "{0}.is_err()" (where (a b) (fn ((ref (result a b))) bool))))
(def unwrap-ok (rust "crate::rt::unwrap_ok({0})" (where (a (b show)) (fn ((result a b)) a))))
(def unwrap-err (rust "crate::rt::unwrap_err({0})" (where ((a show) b) (fn ((result a b)) b))))
(def expect-ok (rust "crate::rt::expect_ok({0}, {1})" (where (a (b show)) (fn ((result a b) (ref str)) a))))
(def map-ok (rust "{0}.map({1})" (where (a b e) (fn ((result a e) (fn-once (a) b)) (result b e)))))
(def map-err (rust "{0}.map_err({1})" (where (a b e) (fn ((result a e) (fn-once (e) b)) (result a b)))))
(def then-ok (rust "{0}.and_then({1})" (where (a b e) (fn ((result a e) (fn-once (a) (result b e))) (result b e)))))
