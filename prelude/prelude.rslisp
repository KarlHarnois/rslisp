(use prelude/macros defmacro defrule template)
(use prelude/logic not when unless and or cond)
(use prelude/syntax defn the -> ->> try-> let-try loop)
(use prelude/types vec option result iterator slice sequence box box-new)
(use prelude/pair pair let-pair let-fields)
(use prelude/assoc assoc assoc-in)
(use prelude/map sorted-map hash-map lookup keys vals entries update into-sorted-map into-hash-map)
(use prelude/sequence empty?)
(use prelude/vec vec push! len iter values collect
               get pop! sort! sort-by-key! windows at dedup!
               first last reverse reverse! sort-descending!)
(use prelude/iterator range map filter fold for-each enumerate zip
                      sum count max min max-by-key any all find take take-while)
(use prelude/option some none some? none? unwrap-or unwrap expect map-some then-some)
(use prelude/result ok err ok-or ok? err? unwrap-ok unwrap-err expect-ok map-ok map-err then-ok)
(use prelude/number number signed float integer partial-eq hash partial-ord
                    add sub mul div rem neg sqrt lt le gt ge eq ne
                    + - * / < <= > >= = != ord)
(use prelude/text display debug to-string print println prn pr-str str char
                  chars lines split trim subs as-str parse parse-error from-str
                  lower-case upper-case alphanumeric? whitespace? digit? split-when append! append-char!)
(use prelude/struct defstruct)
(use prelude/ownership clone copy)
(use prelude/io io-error slurp slurp-stdin read-line command-line-args exit)
(use prelude/place set!)

(export fn fn-mut fn-once def let do if type struct enum derive match new field quote macro rust rust-trait rust-type trait impl use export recur try
        ref mut deref where with _ assoc-at map-at set-at
        bool char str string unit
        i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize f32 f64
        defmacro defrule template
        true false not when unless and or cond
        defn the -> ->> try-> let-try loop
        number signed float integer partial-eq hash partial-ord ord
        add sub mul div rem neg sqrt lt le gt ge eq ne
        + - * / < <= > >= = !=
        display debug to-string print println prn pr-str str char
        chars lines split trim subs as-str parse parse-error from-str
        lower-case upper-case alphanumeric? whitespace? digit? split-when append! append-char!
        defstruct
        clone copy set!
        io-error slurp slurp-stdin read-line command-line-args exit
        sorted-map hash-map lookup keys vals entries update into-sorted-map into-hash-map empty?
        pair let-pair let-fields assoc assoc-in
        vec option result iterator slice sequence box box-new push! len iter values collect
        get pop! sort! sort-by-key! windows at dedup!
        first last reverse reverse! sort-descending!
        range map filter fold for-each enumerate zip
        sum count max min max-by-key any all find take take-while
        some none some? none? unwrap-or unwrap expect map-some then-some
        ok err ok-or ok? err? unwrap-ok unwrap-err expect-ok map-ok map-err then-ok)
