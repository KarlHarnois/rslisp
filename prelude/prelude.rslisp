(use prelude/macros defmacro defrule template)
(use prelude/logic not when unless and or cond)
(use prelude/syntax defn the)
(use prelude/types vec option result iterator)
(use prelude/vec vec push len iter values collect)
(use prelude/iterator range map filter fold for-each)
(use prelude/option some none some? none? unwrap-or)
(use prelude/result ok err ok? err?)
(use prelude/number number signed float integer partial-eq partial-ord
                    add sub mul div rem neg sqrt lt le gt ge eq ne
                    + - * / < <= > >= = !=)
(use prelude/text display to-string print println str char)
(use prelude/struct defstruct)
(use prelude/ownership clone copy ref mut)

(export fn def let do if type struct new field quote macro rust rust-trait rust-type use export
        ref mut where _
        bool char str string unit
        i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize f32 f64
        defmacro defrule template
        true false not when unless and or cond
        defn the
        number signed float integer partial-eq partial-ord
        add sub mul div rem neg sqrt lt le gt ge eq ne
        + - * / < <= > >= = !=
        display to-string print println str char
        defstruct
        clone copy
        vec option result iterator push len iter values collect
        range map filter fold for-each
        some none some? none? unwrap-or
        ok err ok? err?)
