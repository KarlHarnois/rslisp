(use code concat empty? len list number-add number-lt
          prepend rest string symbol?)

(use prelude/macros defmacro defrule document)
(use prelude/types hash-map option slice sorted-map vec)
(use prelude/pair pair)
(use prelude/number eq hash ord)

(export get hash-map into-hash-map into-sorted-map keys
        sorted-map update vals)

(rust-trait borrow "std::borrow::Borrow"
  bool char
  (ref str)
  string i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize
  f32 f64
  (with string str)
  (with (ref str) str))

(def map-inserts
  (fn (index count)
    (if (number-lt index count)
      (string "map.insert({" index "}, {"
              (number-add index 1)
              "}); "
              (map-inserts (number-add index 2) count))
      "")))

(def map-parameters
  (fn (index count)
    (if (number-lt index count)
      (concat (list (quote key) (quote value))
              (map-parameters (number-add index 2) count))
      (list))))

(def map-type
  (fn (name bounds count)
    (list (quote where)
          (list (prepend (quote key) bounds)
                (quote value))
          (list (quote fn)
                (map-parameters 0 count)
                (list name (quote key) (quote value))))))

(def map-form
  (fn (rust-type name bounds pairs)
    (if (empty? pairs)
      (list (quote rust)
            (string rust-type "::new()")
            (list (quote where)
                  (list (prepend (quote key) bounds)
                        (quote value))
                  (list name (quote key) (quote value))))
      (do
        (local count (len pairs))
        (prepend (list (quote rust)
                       (string "{{ let mut map = " rust-type
                               "::new(); "
                               (map-inserts 0 count)
                               "map }}")
                       (map-type name bounds count))
                 pairs)))))

(defmacro sorted-map (pairs ...)
  "Builds a sorted map from keys and values given in turn.

  `(sorted-map)` is empty, and an odd number of arguments is an error. Keys
  implement `ord`. `sorted-map` is also the type `(sorted-map key value)`,
  Rust's `std::collections::BTreeMap<K, V>`."
  (map-form "std::collections::BTreeMap"
            (quote sorted-map)
            (quote (ord))
            pairs))

(defmacro hash-map (pairs ...)
  "Builds a hash map from keys and values given in turn.

  `(hash-map)` is empty, and an odd number of arguments is an error. Keys
  implement `hash` and `eq`. `hash-map` is also the type
  `(hash-map key value)`, Rust's `std::collections::HashMap<K, V>`."
  (map-form "std::collections::HashMap"
            (quote hash-map)
            (quote (hash eq))
            pairs))

(def into-sorted-map
  (rust "{0}.into_iter().collect::<std::collections::BTreeMap<_, _>>()"
    (where ((key ord) (value))
      (fn ((vec (pair key value)))
        (sorted-map key value)))))

(def into-hash-map
  (rust "{0}.into_iter().collect::<std::collections::HashMap<_, _>>()"
    (where ((key hash eq) (value))
      (fn ((vec (pair key value)))
        (hash-map key value)))))

(def get
  (macro (form)
    (if (symbol? form)
      (quote slice-get)
      (concat (list (quote map-at) (quote get))
              (rest form)))))

(document (get collection key)
  "Reads a slice by index or a map by key.

  It returns an `option` of a borrow, and `none` for a missing index or
  key. `get` as a value is the slice reader.")

(def slice-get
  (rust "{0}.get({1})"
    (where (a)
      (fn ((ref (slice a)) usize)
        (option (ref a))))))

(defrule keys ((m) (map-at keys m)))

(defrule vals ((m) (map-at vals m)))

(defrule update
  ((m key function default)
   (map-at update m key function default)))

(document (keys map)
  "Returns an iterator over borrows of a map's keys.

  A `sorted-map` yields them in key order, and the order of a `hash-map` is
  not fixed. The map stays usable.")

(document (vals map)
  "Returns an iterator over borrows of a map's values.

  A `sorted-map` yields them in key order, and the order of a `hash-map` is
  not fixed. The map stays usable. Each item is a borrow, so
  `(sum (vals map))` is an error, and `(reduce (vals map) 0 +)` adds them.")

(document (update map key function default)
  "Applies a function to the value at a key and returns the map.

  `function` takes the value at `key`, or `default` when the key is missing,
  and the result is stored at `key`. `default` runs before the call, whether
  or not the call uses it. The call moves the map.

  `key` has the type of the map's keys: a string literal is a `(ref str)`, so
  a `string` key takes `(str \"name\")`, and a `(ref str)` key takes
  `(as-str name)`.")

(document (into-sorted-map pairs)
  "Builds a `sorted-map` from a vector of pairs.

  `pairs` is a `(vec (pair key value))`, and the call moves it. Keys implement
  `ord`, and the last pair of a repeated key wins.")

(document (into-hash-map pairs)
  "Builds a `hash-map` from a vector of pairs.

  `pairs` is a `(vec (pair key value))`, and the call moves it. Keys implement
  `hash` and `eq`, and the last pair of a repeated key wins.")
