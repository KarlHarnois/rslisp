(use prelude/types option)

(export some none some? none? unwrap-or unwrap expect map-some then-some)

(def some (rust "Some({0})" (where (a) (fn (a) (option a)))))
(def none (rust "None" (where (a) (option a))))
(def some? (rust "{0}.is_some()" (where (a) (fn ((ref (option a))) bool))))
(def none? (rust "{0}.is_none()" (where (a) (fn ((ref (option a))) bool))))
(def unwrap-or (rust "{0}.unwrap_or({1})" (where (a) (fn ((option a) a) a))))
(def unwrap (rust "{0}.unwrap()" (where (a) (fn ((option a)) a))))
(def expect (rust "{0}.expect({1})" (where (a) (fn ((option a) (ref str)) a))))
(def map-some (rust "{0}.map({1})" (where (a b) (fn ((option a) (fn (a) b)) (option b)))))
(def then-some (rust "{0}.and_then({1})" (where (a b) (fn ((option a) (fn (a) (option b))) (option b)))))
