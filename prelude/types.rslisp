(export vec option result iterator slice sequence)

(rust-type vec (where (item) "Vec<{0}>"))
(rust-type option (where (value) "Option<{0}>"))
(rust-type result (where (value error) "Result<{0}, {1}>"))
(rust-type iterator (where (item) "impl Iterator<Item = {0}>"))
(rust-type slice (where (item) "[{0}]"))
(rust-trait sequence "crate::rt::Sequence"
  str string
  (where (item) (vec item))
  (where (item) (slice item)))
