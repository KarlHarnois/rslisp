(export vec option result iterator slice sequence box box-new sorted-map)

(rust-type (vec item) "Vec<{0}>")
(rust-type (sorted-map key value) "std::collections::BTreeMap<{0}, {1}>")
(rust-type (box item) "Box<{0}>")
(def box-new (rust "Box::new({0})" (where (a) (fn (a) (box a)))))
(enum (option value) (rust "Option") (some value) none)
(enum (result value error) (rust "Result") (ok value) (err error))
(rust-type (iterator item) "impl Iterator<Item = {0}>")
(rust-type (slice item) "[{0}]")
(rust-trait sequence "crate::rt::Sequence"
  str string
  (where (item) (vec item))
  (where (item) (slice item))
  (where (key value) (sorted-map key value)))
