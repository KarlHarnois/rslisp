(use prelude/macros defmacro template map-list)
(use prelude/logic and)
(use prelude/syntax defn)
(use code first rest list nth drop length empty? list? symbol? symbol symbol-name same-binding?
          value-eq number-lt)

(export defstruct)

(def head-name
  (fn (head)
    (if (list? head) (first head) head)))

(def head-params
  (fn (head)
    (if (list? head) (rest head) (list))))

(def field-initializer
  (fn (field)
    (list (first field) (first field))))

(def accessor-type
  (fn (name params)
    (if (empty? params)
        (template (fn ((ref (unquote name))) _))
        (template (where (unquote params) (fn ((ref ((unquote name) (splice params)))) _))))))

(def accessor
  (fn (name params field)
    (let accessor-name (symbol name (symbol-name name) "-" (first field)))
    (template
      (do (type (unquote accessor-name) (unquote (accessor-type name params)))
          (defn (unquote accessor-name) (instance) (field instance (unquote (first field))))))))

(defmacro defstruct (head body ...)
  (let name (head-name head))
  (let params (head-params head))
  (template
    (do (struct (unquote head) (splice body))
        (defn (unquote (symbol name "make-" name)) (unquote (map-list first body))
          (new (unquote name) (splice (map-list field-initializer body))))
        (splice (map-list (fn (field) (accessor name params field)) body)))))
