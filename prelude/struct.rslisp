(use prelude/macros defmacro template map-list)
(use prelude/syntax defn definition declared-forms default-pairs type-missing? defaults-clause?
                    default-bindings call-signature signature-name signature-defaults
                    read-call has-argument? pair-keys)
(use code first rest list nth drop empty? list? symbol? symbol symbol-name prepend
          concat string fail keyword? keyword-field)

(export defstruct)

(def head-name
  (fn (head)
    (if (list? head) (first head) head)))

(def field-type-form
  (fn (field)
    (nth field 1)))

(def field-initializer
  (fn (field)
    (list (first field) (first field))))

(def field-groups
  (fn (body)
    (if (empty? body)
        (list)
        (prepend (field-group (first body) (rest body))
                 (field-groups (drop 2 body))))))

(def field-group
  (fn (keyword more)
    (if (keyword? keyword)
        (list (keyword-field keyword) (field-type keyword more))
        (field-start-error keyword))))

(def field-type
  (fn (keyword more)
    (if (type-missing? more)
        (fail "this field has no type" keyword
              (string "write a type after it, as in " (symbol-name keyword) " i64"))
        (first more))))

(def field-start-error
  (fn (form)
    (if (defaults-clause? form)
        (fail "a struct takes one `defaults` clause, after its fields" form
              "move the defaults to the end")
        (fail "a field must start with `:`" form
              "write each field as `:name type`, as in (defstruct point :x f64 :y f64)"))))

(def defaults-without-key
  (fn (defaults keys)
    (if (empty? defaults)
        (list)
        (if (has-argument? (first (first defaults)) keys)
            (defaults-without-key (rest defaults) keys)
            (prepend (first defaults) (defaults-without-key (rest defaults) keys))))))

(def named-initializers
  (fn (arguments)
    (if (empty? arguments)
        (list)
        (prepend (list (first arguments) (nth arguments 1))
                 (named-initializers (drop 2 arguments))))))

(def named-construction
  (fn (arguments shape)
    (let written (named-initializers arguments))
    (let omitted (defaults-without-key (signature-defaults shape) (pair-keys arguments)))
    (prepend (quote new) (prepend (signature-name shape) (concat written omitted)))))

(def field-definition
  (fn (name)
    (definition name "field" (fn (name) name) (quote unknown-key-field))))

(def constructor-call
  (fn (form hidden shape)
    (read-call form hidden shape
               (field-definition (signature-name shape))
               (fn (form) (named-construction (rest form) shape)))))

(def constructor-expansion
  (fn (form hidden shape)
    (if (symbol? form)
        hidden
        (constructor-call form hidden shape))))

(defmacro defstruct (head body ...)
  (let name (head-name head))
  (let fields (field-groups (declared-forms body)))
  (let field-names (map-list first fields))
  (let field-types (map-list field-type-form fields))
  (let defaults (default-bindings (default-pairs body) (field-definition name) field-names))
  (let hidden (symbol (quote make) "make-" name))
  (template
    (do (struct (unquote head) (splice fields))
        (defn (unquote hidden) (unquote field-names)
          (new (unquote name) (splice (map-list field-initializer fields))))
        (def (unquote (symbol name "->" name))
          (macro (form)
            (constructor-expansion form (quote (unquote hidden))
                                   (quote (unquote (call-signature name field-names defaults field-types)))))))))
