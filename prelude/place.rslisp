(use code concat empty? first list list? rest same-binding?
          symbol?)

(use prelude/macros defmacro)
(use prelude/vec at)

(export set!)

(def set-place!
  (rust "*{0} = {1}"
    (where (a) (fn ((mut a) a) unit))))

(def at-form?
  (fn (form)
    (if (list? form)
      (if (empty? form)
        false
        (if (symbol? (first form))
          (same-binding? (first form) (quote at))
          false))
      false)))

(def at-base
  (fn (form)
    (if (at-form? form)
      (at-base (first (rest form)))
      form)))

(def at-indices
  (fn (form)
    (if (at-form? form)
      (concat (at-indices (first (rest form)))
              (list (first (rest (rest form)))))
      (list))))

(defmacro set! (target value)
  "Changes a local, a field or an element in place.

  The target is a name, a field read such as `(:x point)`, or an `at` form, as
  in `(set! (at items 0) 9)`. A vector panics when the index is out of bounds,
  and a map panics on a missing key. Any other target is an error."
  (if (at-form? target)
    (list (quote set-at)
          (at-base target)
          (at-indices target)
          value)
    (list (quote set-place!) target value)))
