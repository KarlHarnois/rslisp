(use prelude/macros document)
(use prelude/types box option result vec)
(use prelude/pair pair)

(export clone copy)

(rust-trait clone "Clone"
  bool char string i8 i16 i32 i64 i128 isize u8 u16 u32 u64
  u128 usize f32 f64
  (where (a) (ref a))
  (where ((a clone)) (vec a))
  (where ((a clone)) (option a))
  (where ((a clone) (b clone))
    (result a b))
  (where ((a clone)) (box a))
  (where ((a clone) (b clone)) (pair a b)))

(rust-trait copy "Copy"
  (requires clone)
  bool char unit i8 i16 i32 i64 i128 isize u8 u16 u32 u64
  u128 usize f32 f64
  (where (a) (ref a))
  (where ((a copy)) (option a))
  (where ((a copy) (b copy)) (result a b))
  (where ((a copy) (b copy)) (pair a b)))

(def clone
  (rust "{0}.clone()"
    (where ((a clone)) (fn ((ref a)) a))))

(document (clone value)
  "Returns a copy of a value that owns its own data.

  It takes a borrow, so `value` stays usable. A `str` has no `clone`:
  `(str text)` builds a `string` from it. `clone` is also the trait, Rust's
  `Clone`.")

(document copy
  "Marks a type whose values copy where another type would move.

  `bool`, `char`, `unit`, the number types and `(ref a)` implement it, and an
  `option`, a `result` or a `pair` of such types does. `string` and `vec` do
  not. A struct or an enum of `copy` fields that the program never changes in
  place is `copy` too.")
