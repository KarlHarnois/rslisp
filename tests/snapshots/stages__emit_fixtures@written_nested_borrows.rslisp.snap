fn is_first_after(y: &&i64) -> bool {
    **y > 2018
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let year: i64 = 2019;
    println!("{}", is_first_after(&&2019_i64));
    println!("{}", is_first_after(&&year));
    println!("{}", year > 2018);
    println!("{}", year > 2018);
    println!("{}", 2018 > year)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
