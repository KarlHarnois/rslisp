#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Car {
    make: String,
    year: i64,
}

fn make_car(make: String, year: i64) -> Car {
    Car { make, year }
}

fn is_first_after(y: &&i64) -> bool {
    **y > 2018
}

fn shallow(y: &i64) -> i64 {
    *y
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let year: i64 = 2019;
    println!("{}", is_first_after(&&2019_i64));
    println!("{}", is_first_after(&&year));
    println!("{}", year > 2018);
    println!("{}", year > 2018);
    println!("{}", 2018 > year);
    let r = &year;
    println!("{}", shallow(r));
    println!("{}", shallow(&year));
    println!("{}", shallow(&year));
    let leaf = make_car("Leaf".to_string(), 2019);
    println!("{}", leaf.make);
    println!("{}", leaf.year)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
