fn show<A: std::fmt::Display + ?Sized>(x: &A) -> i64 {
    println!("{}", x);
    0
}

fn apply_one<A, B>(f: impl FnOnce(A) -> B, a: A) -> B {
    f(a)
}

fn main() {
    let name = "Leaf".to_string();
    println!("{}", apply_one(show, name.as_str()));
    println!("{}", apply_one(|argument: i64| show(&argument), 7))
}
