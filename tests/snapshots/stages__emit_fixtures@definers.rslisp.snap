#[derive(Clone, PartialEq)]
enum Shape {
    Circle(f64),
    Labeled { text: String, size: f64 },
    Dot,
}

fn hush<A: Quiet>(value: A) -> A {
    value
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut shapes = vec![
        Shape::Circle(1.0),
        Shape::Labeled {
            text: "note".to_string(),
            size: 2.0,
        },
    ];
    shapes.push(hush(Shape::Dot));
    shapes
        .iter()
        .for_each(|item: &Shape| println!("{} {}", item.title(), item.doubled()));
    println!("{}", 40_i64 + 2_i64)
}

trait AreaOf {
    fn area(&self) -> f64;
    fn doubled(&self) -> f64 {
        self.area() * 2.0
    }
}

trait NamedArea: AreaOf {
    fn title(&self) -> String;
}

trait Quiet {}

impl AreaOf for Shape {
    fn area(&self) -> f64 {
        match self {
            Shape::Circle(r) => *r * *r * 3.0,
            Shape::Labeled { size, .. } => *size * *size,
            Shape::Dot => 0.0,
        }
    }
}

impl NamedArea for Shape {
    fn title(&self) -> String {
        match self {
            Shape::Labeled { text, .. } => text.clone(),
            _ => "plain".to_string(),
        }
    }
}

impl Quiet for Shape {}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
