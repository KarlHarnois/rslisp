#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Pair<A, B> {
    first: A,
    second: B,
}

fn main() {
    let labelled: Pair<i64, &str> = Pair {
        first: 1,
        second: "a",
    };
    println!("{}", labelled.first);
    println!("{}", labelled.second)
}
