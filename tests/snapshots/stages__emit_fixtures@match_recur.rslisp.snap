#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
enum Tick {
    Stop,
    Tick,
}

fn countdown(t: Tick, mut n: i64) -> i64 {
    loop {
        match t {
            Tick::Stop => {
                return n;
            }
            Tick::Tick => {
                if n == 0 {
                    return n;
                } else {
                    n -= 1;
                    continue;
                }
            }
        }
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", countdown(Tick::Tick, 5));
    println!("{}", countdown(Tick::Stop, 5))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
