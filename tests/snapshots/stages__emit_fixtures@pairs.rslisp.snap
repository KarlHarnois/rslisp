fn main() {
    "alpha\nbeta"
        .lines()
        .enumerate()
        .for_each(|entry: (usize, &str)| {
            let (index, line) = entry;
            println!("{}: {}", index, line)
        });
    let left = "a\nb".lines().collect::<Vec<_>>();
    let right: Vec<i64> = (1_i64..3_i64).collect::<Vec<_>>();
    left.iter()
        .copied()
        .zip(right.iter().copied())
        .for_each(|entry: (&str, i64)| {
            let (text, number) = entry;
            println!("{}{}", text, number)
        });
    let mut pairs: Vec<(i64, &str)> = vec![(2_i64, "b"), (1_i64, "a")];
    pairs.sort();
    pairs.iter().copied().for_each(|entry: (i64, &str)| {
        let (number, text) = entry;
        println!("{} {}", number, text)
    })
}
