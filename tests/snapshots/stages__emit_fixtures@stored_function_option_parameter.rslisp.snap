#[derive(Clone, Copy, Debug)]
struct Spare {
    maker: Option<fn() -> i64>,
}

fn count_doors() -> i64 {
    4
}

fn wrap(f: fn() -> i64) -> Spare {
    Spare { maker: Some(f) }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let backup = wrap(count_doors);
    match backup {
        Spare { maker: Some(maker) } => println!("{}", maker()),
        Spare { maker: None } => println!("no spare"),
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
