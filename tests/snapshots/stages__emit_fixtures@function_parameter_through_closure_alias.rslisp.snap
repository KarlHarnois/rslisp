expression: reports.report(path)
input_file: tests/fixtures/emit/function_parameter_through_closure_alias.rslisp
---
fn record_through_alias(mut record: impl FnMut(i64), year: i64) {
    let step = |n: i64| record(n);
    let mut again = step;
    again(year);
    again(year + 1)
}

fn record_through_alias_once(record: impl FnOnce(i64), year: i64) {
    let step = |n: i64| record(n);
    let again = step;
    again(year)
}

fn twice(mut action: impl FnMut(i64), year: i64) {
    action(year);
    action(year + 1)
}

fn record_alias_through_twice(mut record: impl FnMut(i64), year: i64) {
    let step = |n: i64| record(n);
    let again = step;
    twice(again, year)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut years: Vec<i64> = vec![2024_i64];
    record_through_alias(|year: i64| years.push(year), 2025);
    record_through_alias_once(|year: i64| years.push(year), 2027);
    record_alias_through_twice(|year: i64| years.push(year), 2028);
    println!("{}", years.len())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
