fn ping(mut f: impl FnMut(i64), n: i64) -> i64 {
    {
        let mut i: i64 = 0;
        loop {
            if i < 2 {
                f(i);
                i += 1;
                continue;
            } else {
                break;
            }
        }
    }
    if n > 0 { pong(f, n - 1) } else { 0 }
}

fn pong(f: impl FnMut(i64), n: i64) -> i64 {
    if n > 0 { ping(f, n - 1) } else { 0 }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut total: Vec<i64> = vec![0_i64];
    ping(|n: i64| total.push(n), 3);
    println!("{}", total.len())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
