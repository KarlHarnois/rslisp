#[derive(Clone, Copy, Debug, PartialEq)]
struct Circle {
    radius: f64,
}

#[derive(Clone, Copy, Debug, PartialEq)]
struct Square {
    side: f64,
}

fn total(shapes: Vec<Box<dyn Shape>>) -> f64 {
    shapes
        .iter()
        .fold(0.0, |total_2, shape| total_2 + shape.area())
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{}",
        total(vec![
            Box::new(Circle { radius: 1.0 }) as Box<dyn Shape>,
            Box::new(Square { side: 2.0 }) as Box<dyn Shape>
        ])
    )
}

trait Shape {
    fn area(&self) -> f64;
}

impl Shape for Circle {
    fn area(&self) -> f64 {
        3.0 * self.radius * self.radius
    }
}

impl Shape for Square {
    fn area(&self) -> f64 {
        self.side * self.side
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
