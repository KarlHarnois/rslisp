fn apply(f: impl FnOnce() -> Option<i64>) -> Option<i64> {
    f()
}

fn later(mut values: impl Iterator<Item = i64>) -> Option<i64> {
    apply(|| values.find(|value: &i64| *value > 5))
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{:?}", later(0_i64..10_i64))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
