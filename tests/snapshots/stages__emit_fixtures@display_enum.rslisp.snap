#[derive(Clone, Debug, PartialEq, Eq, Hash)]
enum Token {
    Number(i64),
    Word(String),
    End,
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", Token::Number(1));
    println!("{}", Token::Word("hello".to_string()));
    println!("{}", Token::End)
}

impl std::fmt::Display for Token {
    fn fmt(&self, out: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Token::Number(n) => write!(out, "number {}", n),
            Token::Word(w) => write!(out, "word {}", w),
            Token::End => write!(out, "end"),
        }
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
