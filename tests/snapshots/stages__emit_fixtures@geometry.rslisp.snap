input_file: tests/fixtures/emit/geometry.rslisp
---
fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "distance: {}",
        crate::shapes::geometry::distance(
            crate::shapes::geometry::make_point(0.0, 0.0),
            crate::shapes::geometry::make_point(3.0, 4.0)
        )
    )
}

mod shapes {

    pub(crate) mod geometry {
        #[derive(Clone, Copy, Debug, PartialEq)]
        pub struct Point {
            pub x: f64,
            pub y: f64,
        }

        pub(crate) fn make_point(x: f64, y: f64) -> Point {
            Point { x, y }
        }

        pub fn distance(a: Point, b: Point) -> f64 {
            let dx = a.x - b.x;
            let dy = a.y - b.y;
            (dx * dx + dy * dy).sqrt()
        }
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
