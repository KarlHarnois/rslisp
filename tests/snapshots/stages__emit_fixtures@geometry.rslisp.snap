fn main() {
    println!("distance: {}", crate::shapes::geometry::distance(&crate::shapes::geometry::make_point(0.0, 0.0), &crate::shapes::geometry::make_point(3.0, 4.0)))
}

mod shapes {


    pub(crate) mod geometry {
        #[derive(Clone, Debug, PartialEq)]
        pub struct Point {
            pub x: f64,
            pub y: f64,
        }

        pub fn make_point(x: f64, y: f64) -> Point {
            Point { x, y }
        }

        pub fn point_x(instance: &Point) -> f64 {
            instance.x
        }

        pub fn point_y(instance: &Point) -> f64 {
            instance.y
        }

        pub fn distance(a: &Point, b: &Point) -> f64 {
            let dx = point_x(a) - point_x(b);
            let dy = point_y(a) - point_y(b);
            ((dx * dx) + (dy * dy)).sqrt()
        }
    }
}
