fn label(name: &str, count: u16) -> String {
    format!("{}{}", name, count)
}

fn apply_two(f: impl FnOnce(&str, u16) -> String, a: &str, b: u16) -> String {
    f(a, b)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let name = "Leaf".to_string();
    let count: u16 = 3;
    println!("{}", apply_two(label, name.as_str(), count))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
