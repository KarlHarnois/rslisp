#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
enum PairOf<A> {
    Both(A, A),
    Neither,
}

#[derive(Clone, Debug, PartialEq)]
enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Labeled { text: String, size: f64 },
    Point,
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{:?}", Shape::Circle(1.0));
    println!("{:?}", Shape::Rect(2.0, 3.0));
    println!(
        "{:?}",
        Shape::Labeled {
            text: "box".to_string(),
            size: 2.0
        }
    );
    println!("{:?}", Shape::Point);
    println!(
        "{:?}",
        PairOf::Both("left".to_string(), "right".to_string())
    );
    println!("{:?}", {
        let result: PairOf<i64> = PairOf::Neither;
        result
    })
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
