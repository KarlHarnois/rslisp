fn walk(mut f: impl FnMut(i64), n: i64) -> i64 {
    f(n);
    if n < 5 { walk(f, n + 1) + 1 } else { 0 }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut total: Vec<i64> = Vec::new();
    println!("{}", walk(|n: i64| total.push(n), 0));
    println!("{}", total.len())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
