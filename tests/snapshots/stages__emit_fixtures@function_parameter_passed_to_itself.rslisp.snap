fn walk(mut f: impl FnMut(i64), n: i64) -> i64 {
    f(n);
    if n < 5 { walk(f, n + 1) + 1 } else { 0 }
}

fn main() {
    let mut total: Vec<i64> = Vec::new();
    println!("{}", walk(|n: i64| total.push(n), 0));
    println!("{}", total.len())
}
