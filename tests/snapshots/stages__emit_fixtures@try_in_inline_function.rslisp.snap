fn main() {
    println!(
        "{}",
        (|left: &str, right: &str| -> Result<i64, std::num::ParseIntError> {
            let a: i64 = left.parse::<i64>()?;
            let b: i64 = right.parse::<i64>()?;
            Ok(a + b)
        })("2", "3")
        .unwrap()
    );
    println!(
        "{}",
        (|text: &str| -> Result<i64, std::num::ParseIntError> {
            let value: i64 = text.parse::<i64>()?;
            Ok(value)
        })("x")
        .is_err()
    )
}
