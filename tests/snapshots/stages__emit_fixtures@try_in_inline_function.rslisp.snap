fn main() {
    println!("{}", (|left: &str, right: &str| -> Result<i64, <i64 as std::str::FromStr>::Err> {
        let a: i64 = left.parse()?;
        let b: i64 = right.parse()?;
        Ok(a + b)
    })("2", "3").unwrap());
    println!("{}", (|text: &str| -> Result<i64, <i64 as std::str::FromStr>::Err> {
        let value: i64 = text.parse()?;
        Ok(value)
    })("x").is_err())
}
