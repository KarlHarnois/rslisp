fn collatz_steps(mut n: i64, mut steps: i64) -> i64 {
    loop {
        if n == 1 {
            return steps;
        } else if n % 2 == 0 {
            (n, steps) = (n / 2, steps + 1);
            continue;
        } else {
            (n, steps) = (3 * n + 1, steps + 1);
            continue;
        }
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", collatz_steps(6, 0))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
