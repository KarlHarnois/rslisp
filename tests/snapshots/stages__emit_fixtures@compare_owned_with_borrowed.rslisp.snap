#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Person {
    name: String,
}

fn make_person(name: String) -> Person {
    Person { name }
}

fn main() {
    let ana = make_person("Ana".to_string());
    let name = "Ana".to_string();
    println!("{}", ana.name == name);
    println!("{}", name == ana.name);
    println!("{}", name < ana.name)
}
