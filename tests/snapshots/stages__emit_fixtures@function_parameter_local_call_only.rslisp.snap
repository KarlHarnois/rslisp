fn apply(mut pick: impl FnMut(&str) -> &str) -> &'static str {
    let local = "Leaf".to_string();
    if pick(local.as_str()) == "Leaf" {
        pick("Nissan")
    } else {
        "none"
    }
}

fn first_word(text: &str) -> &str {
    text
}

fn main() {
    println!("{}", apply(first_word))
}
