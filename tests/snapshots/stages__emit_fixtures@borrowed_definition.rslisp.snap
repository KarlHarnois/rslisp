#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Card<'a> {
    name: &'a str,
    set: &'a str,
}

static CARDS: std::sync::LazyLock<Vec<Card<'_>>> = std::sync::LazyLock::new(|| {
    vec![
        Card {
            name: "Black Lotus",
            set: "Alpha",
        },
        Card {
            name: "Counterspell",
            set: "Alpha",
        },
    ]
});

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{:?}", CARDS.len());
    CARDS
        .iter()
        .for_each(|card: &Card<'_>| println!("{}", card.name))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
