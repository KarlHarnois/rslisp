fn half(x: i64) -> i64 {
    x / 2
}

fn bigger(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn shrink(mut n: i64) -> i64 {
    loop {
        if n < 1 {
            return n;
        } else {
            n -= 1;
            continue;
        }
    }
}

fn flip(mut n: i64) -> i64 {
    loop {
        if n > 10 {
            return n;
        } else {
            n = 20 - n;
            continue;
        }
    }
}

fn settle(mut n: i64) -> i64 {
    loop {
        if n < 100 {
            return n;
        } else {
            n = 99;
            continue;
        }
    }
}

fn halve(mut n: i64) -> i64 {
    loop {
        if n < 2 {
            return n;
        } else {
            n = half(n);
            continue;
        }
    }
}

fn cap(mut n: i64) -> i64 {
    loop {
        if n > 5 {
            return n;
        } else {
            n = bigger(n, 6);
            continue;
        }
    }
}

fn grow(mut n: i64) -> i64 {
    loop {
        if n > 50 {
            return n;
        } else {
            n = n + 1 + 1;
            continue;
        }
    }
}

fn main() {
    println!("{}", shrink(3));
    println!("{}", flip(5));
    println!("{}", settle(500));
    println!("{}", halve(40));
    println!("{}", cap(1));
    println!("{}", grow(1))
}
