source: tests/stages.rs
expression: reports.report(path)
input_file: tests/fixtures/emit/let_scoped.rslisp
---
fn total() -> i64 {
    let x: i64 = 5;
    let y: i64 = 7;
    y + x
}

fn report(n: i64) {
    println!("{}", {
        let doubled: i64 = n * 2;
        doubled
    });
    let half: i64 = n / 2;
    let quarter: i64 = half / 2;
    println!("{}", half);
    println!("{}", quarter)
}

fn shadow() {
    let x: i64 = 1;
    {
        let x_2: i64 = 2;
        println!("{}", x_2)
    }
    println!("{}", x)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", total());
    report(8);
    shadow()
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
