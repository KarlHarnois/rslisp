#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Pair<A, B> {
    first: A,
    second: B,
}

fn make_pair<A, B>(first: A, second: B) -> Pair<A, B> {
    Pair { first, second }
}

fn swap<A: Clone, B: Clone>(p: &Pair<A, B>) -> Pair<B, A> {
    Pair {
        first: p.second.clone(),
        second: p.first.clone(),
    }
}

fn main() {
    let counted: Pair<i64, String> = make_pair(7, "seven".to_string());
    println!("{}", counted.first);
    println!("{}", swap(&counted).first);
    let named: Pair<&str, i64> = make_pair("pear", 3);
    println!("{}", named.first);
    println!("{}", named.second)
}
