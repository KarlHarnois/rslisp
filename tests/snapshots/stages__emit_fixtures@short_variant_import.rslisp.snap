fn brightness(shade: crate::short_variant_import::palette::Color) -> i64 {
    match shade {
        crate::short_variant_import::palette::Color::Red => 255,
        crate::short_variant_import::palette::Color::Custom(level) => level,
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{}",
        brightness(crate::short_variant_import::palette::Color::Red)
    );
    println!(
        "{}",
        brightness(crate::short_variant_import::palette::Color::Custom(9))
    )
}

mod short_variant_import {

    pub(crate) mod palette {
        #[derive(Clone, Copy, PartialEq, Eq, Hash)]
        pub enum Color {
            Red,
            Custom(i64),
        }
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
