fn describe_early() -> u16 {
    make_car("Toyota", "Corolla", 2018, false).year
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Car<'a> {
    make: &'a str,
    model: &'a str,
    year: u16,
    is_electric: bool,
}

fn make_car<'a>(make: &'a str, model: &'a str, year: u16, is_electric: bool) -> Car<'a> {
    Car {
        make,
        model,
        year,
        is_electric,
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let by_position = make_car("Honda", "Civic", 2019, false);
    let by_name = Car {
        make: "Nissan",
        model: "Leaf",
        year: 2024,
        is_electric: true,
    };
    let reordered = Car {
        year: 2019,
        is_electric: false,
        make: "Honda",
        model: "Civic",
    };
    let build = make_car;
    let built = build("Volkswagen", "Golf", 2021, false);
    println!("{}", by_position.make);
    println!("{}", by_name.model);
    println!("{}", reordered.year);
    println!("{}", built.model);
    println!("{}", describe_early())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
