fn build_with(constructor: impl FnOnce(i64) -> i64) -> i64 {
    constructor(2)
}

fn build_either(constructor: impl FnOnce(i64) -> i64, flag: bool) -> i64 {
    if flag {
        constructor(1)
    } else {
        build_with(constructor)
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", build_either(|n: i64| n + 1, true));
    println!("{}", build_either(|n: i64| n + 1, false))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
