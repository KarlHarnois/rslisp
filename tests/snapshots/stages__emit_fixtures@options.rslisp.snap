fn main() {
    crate::rt::restore_default_sigpipe();
    let found: Option<i64> = Some(3);
    let missing: Option<i64> = None;
    println!("{}", found.is_some());
    println!("{}", missing.is_none());
    println!("{}", found.unwrap_or(0));
    println!("{}", missing.unwrap_or(7))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
