#[derive(Clone, Debug, PartialEq, Eq, Hash)]
enum Tree<A> {
    Node(Box<Tree<A>>, A, Box<Tree<A>>),
    Leaf,
}

fn value_or_zero(tree: &Tree<i64>) -> i64 {
    match tree {
        Tree::Node(inner, _, _) if matches!(&**inner, Tree::Node(_, _, _)) => {
            let Tree::Node(_, value, _) = &**inner else {
                unreachable!()
            };
            *value
        }
        Tree::Node(_, value, _) => *value,
        Tree::Leaf => 0,
    }
}

fn main() {
    println!(
        "{}",
        value_or_zero(&Tree::Node(
            Box::new(Tree::Node(Box::new(Tree::Leaf), 7, Box::new(Tree::Leaf))),
            1,
            Box::new(Tree::Leaf)
        ))
    );
    println!(
        "{}",
        value_or_zero(&Tree::Node(Box::new(Tree::Leaf), 2, Box::new(Tree::Leaf)))
    );
    println!("{}", value_or_zero(&Tree::Leaf))
}
