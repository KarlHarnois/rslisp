#[derive(Clone, Copy, Debug, PartialEq)]
struct Point {
    x: f64,
    y: f64,
}

fn make_point(x: f64, y: f64) -> Point {
    Point { x, y }
}

#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Person {
    name: String,
    age: u32,
}

fn make_person(name: String, age: u32) -> Person {
    Person { name, age }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let origin = make_point(0.0, 0.0);
    println!("{:?}", origin);
    println!("{}", origin == make_point(0.0, 0.0));
    println!("{:?}", make_person("Ada".to_string(), 36));
    println!("{:?}", make_person("Bo".to_string(), 7))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
