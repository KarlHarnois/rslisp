input_file: tests/fixtures/emit/stored_function_let_parameter.rslisp
---
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct User<'a> {
    name: &'a str,
    age: u16,
}

fn make_user(name: &str, age: u16) -> User<'_> {
    User { name, age }
}

#[derive(Clone, Copy, Debug)]
struct Sorter<'a> {
    key: fn(&User<'_>) -> u16,
    label: &'a str,
}

fn age_of(someone: &User<'_>) -> u16 {
    someone.age
}

fn by_key(key: fn(&User<'_>) -> u16, label: &str) -> Sorter<'_> {
    let a = key;
    let b = a;
    Sorter { key: b, label }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let ana = make_user("Ana", 30);
    let by_age = by_key(age_of, "by age");
    println!("{}", by_age.label);
    println!("{}", (by_age.key)(&ana))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
