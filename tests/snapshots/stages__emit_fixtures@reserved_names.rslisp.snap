fn main() {
    crate::rt::restore_default_sigpipe();
    let r#final: i64 = 1;
    let r#macro: i64 = 2;
    let r#override: i64 = 3;
    let r#priv: i64 = 4;
    let r#typeof: i64 = 5;
    let r#unsized: i64 = 6;
    let r#virtual: i64 = 7;
    let r#yield: i64 = 8;
    let r#try: i64 = 9;
    println!("{}", r#final)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
