fn add_text_let(text: &str) -> Result<i64, std::num::ParseIntError> {
    let value: i64 = text.parse::<i64>()?;
    Ok(value + 1)
}

fn add_text_threaded(text: &str) -> Result<i64, std::num::ParseIntError> {
    let value: i64 = text.parse::<i64>()?;
    Ok(value + 1)
}

fn add_two_texts(left: &str, right: &str) -> Result<i64, std::num::ParseIntError> {
    let a: i64 = left.parse::<i64>()?;
    let b: i64 = right.parse::<i64>()?;
    Ok(a + b)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", add_text_let("41").unwrap());
    println!("{}", add_text_threaded("41").unwrap());
    println!("{}", add_two_texts("2", "3").unwrap());
    println!("{}", add_text_threaded("x").is_err())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
