fn add_text_let(text: &str) -> Result<i64, <i64 as std::str::FromStr>::Err> {
    let value: i64 = text.parse()?;
    Ok(value + 1)
}

fn add_text_threaded(text: &str) -> Result<i64, <i64 as std::str::FromStr>::Err> {
    let value: i64 = text.parse()?;
    Ok(value + 1)
}

fn add_two_texts(left: &str, right: &str) -> Result<i64, <i64 as std::str::FromStr>::Err> {
    let a: i64 = left.parse()?;
    let b: i64 = right.parse()?;
    Ok(a + b)
}

fn main() {
    println!("{}", add_text_let("41").unwrap());
    println!("{}", add_text_threaded("41").unwrap());
    println!("{}", add_two_texts("2", "3").unwrap());
    println!("{}", add_text_threaded("x").is_err())
}
