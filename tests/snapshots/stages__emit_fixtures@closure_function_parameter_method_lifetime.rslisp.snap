#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Car<'a> {
    make: &'a str,
    model: &'a str,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Depot {
    size: u16,
}

fn make_depot(size: u16) -> Depot {
    Depot { size }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let lot = make_depot(2024);
    println!("{}", Showroom::longer_make("Nissan", "Mitsubishi", &lot))
}

trait Showroom {
    fn longer_make<'a>(_: &'a str, _: &'a str, _: &'a Self) -> &'a str;
}

impl Showroom for Depot {
    fn longer_make<'a>(first: &'a str, second: &'a str, lot: &Depot) -> &'a str {
        println!("{}", lot.size);
        let pick = |build: &mut dyn FnMut() -> Car<'a>| build().make;
        pick(&mut || Car {
            make: if first.len() > second.len() {
                first
            } else {
                second
            },
            model: "Leaf",
        })
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
