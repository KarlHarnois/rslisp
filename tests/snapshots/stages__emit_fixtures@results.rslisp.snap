fn checked_half(n: i64) -> Result<i64, &'static str> {
    if n % 2 == 0 {
        Result::Ok(n / 2)
    } else {
        Result::Err("odd")
    }
}

fn main() {
    println!("{}", checked_half(10).is_ok());
    println!("{}", checked_half(7).is_err())
}
