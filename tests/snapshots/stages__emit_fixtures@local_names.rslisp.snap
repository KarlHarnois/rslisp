fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", {
        let n: i64 = 1;
        n + 1
    });
    println!("{}", {
        let n: i64 = 2;
        n * 2
    });
    let n: i64 = 5;
    println!("{}", {
        let n_2: i64 = n;
        n_2 - 1
    });
    println!("{}", {
        let left: i64 = 1;
        let middle: i64 = 2;
        left < middle && middle < 3
    });
    println!("{}", {
        let left: i64 = 3;
        let middle: i64 = 2;
        left < middle && middle < 1
    })
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
