fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{}",
        (|mut attempt: i64| -> Result<i64, std::num::ParseIntError> {
            loop {
                if attempt < 1 {
                    attempt += 1;
                    continue;
                } else {
                    let value: i64 = "7".parse::<i64>()?;
                    return Ok(value);
                }
            }
        })(0)
        .unwrap()
    )
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
