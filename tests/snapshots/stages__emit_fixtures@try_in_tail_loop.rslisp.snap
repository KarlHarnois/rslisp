fn main() {
    println!(
        "{}",
        (|mut attempt: i64| -> Result<i64, std::num::ParseIntError> {
            loop {
                if attempt < 1 {
                    attempt += 1;
                    continue;
                } else {
                    let value: i64 = "7".parse::<i64>()?;
                    return Result::Ok(value);
                }
            }
        })(0)
        .unwrap()
    )
}
