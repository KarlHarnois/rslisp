fn main() {
    println!("{}", (|mut attempt: i64| -> Result<i64, <i64 as std::str::FromStr>::Err> {
        loop {
            if attempt < 1 {
                attempt += 1;
                continue;
            } else {
                let value: i64 = "7".parse()?;
                return Ok(value);
            }
        }
    })(0).unwrap())
}
