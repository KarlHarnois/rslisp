fn main() {
    crate::rt::restore_default_sigpipe();
    let number: Result<i64, std::num::ParseIntError> = "2".parse::<i64>();
    println!("{}", number.unwrap());
    let float: Result<f32, <f32 as std::str::FromStr>::Err> = "2.5".parse::<f32>();
    println!("{}", float.unwrap())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
