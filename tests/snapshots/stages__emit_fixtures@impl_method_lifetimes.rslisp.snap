#[derive(Clone, Debug, PartialEq, Eq, Hash)]
pub struct Holder {
    pub name: String,
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let h = Holder {
        name: "hi".to_string(),
    };
    println!("{}", h.label())
}

pub trait Picker {
    fn label(&self) -> &String;
    fn pick<'a>(_: &'a Holder, _: &'a Holder) -> &'a String;
}

impl Picker for Holder {
    fn label(&self) -> &String {
        &self.name
    }
    fn pick<'a>(someone: &'a Holder, _: &Holder) -> &'a String {
        &someone.name
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
