struct Tag {
    name: std::rc::Rc<str>,
}

fn make_tag(name: std::rc::Rc<str>) -> Tag {
    Tag { name }
}

fn main() {
    let tag = make_tag(std::rc::Rc::from("Leaf"));
    let name = &tag.name;
    println!("Leaf")
}
