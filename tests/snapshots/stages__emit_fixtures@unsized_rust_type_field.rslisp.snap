struct Tag {
    name: std::rc::Rc<str>,
}

fn make_tag(name: std::rc::Rc<str>) -> Tag {
    Tag { name }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let tag = make_tag(std::rc::Rc::from("Leaf"));
    let name = &tag.name;
    println!("Leaf")
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
