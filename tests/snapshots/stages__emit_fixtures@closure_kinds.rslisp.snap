fn apply(f: impl FnOnce(i64) -> String, x: i64) -> String {
    f(x)
}

fn call_twice(mut f: impl FnMut()) {
    f();
    f()
}

fn keep(f: impl Fn(i64) -> i64) {}

fn hold(f: impl Fn() -> i64) -> impl Fn() -> i64 {
    f
}

fn hold_mut(mut f: impl FnMut() -> i64) -> i64 {
    f()
}

fn alias(f: impl FnOnce(i64) -> i64, x: i64) -> i64 {
    let g = f;
    g(x)
}

fn call_inside(f: impl FnOnce(i64) -> i64, x: i64) -> i64 {
    let g = || f(x);
    g()
}

fn nested_mover() -> String {
    let text = "nested".to_string();
    let consume = || text;
    let start = || consume();
    start()
}

fn returns_mut() -> impl FnMut() {
    let mut items: Vec<i64> = vec![1_i64];
    move || items.push(2)
}

fn returns_once() -> impl FnOnce() -> String {
    let text = "written".to_string();
    move || text
}

fn make_adder(n: i64) -> impl Fn(i64) -> i64 {
    move |x: i64| x + n
}

fn make_mutator() -> impl FnMut() {
    let mut items: Vec<i64> = vec![1_i64];
    move || items.push(2)
}

fn make_vec_changer() -> impl FnMut() {
    let mut items: Vec<i64> = vec![1_i64];
    move || {
        let borrowed = &mut items;
        borrowed.push(2)
    }
}

fn make_mover() -> impl FnOnce() -> String {
    let text = "fake".to_string();
    move || text
}

fn choose(flag: bool) -> impl Fn() -> i64 {
    if flag { || 1 } else { || 2 }
}

fn choose_by(value: i64) -> impl Fn() -> i64 {
    match value {
        0 => || 1,
        _ => || 2,
    }
}

fn choose_block() -> impl Fn() -> i64 {
    || 3
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let text = "fake".to_string();
    println!("{}", apply(|ignored: i64| text, 0));
    let mut items: Vec<i64> = vec![1_i64];
    let mut add = |x: i64| items.push(x);
    call_twice(|| add(2));
    keep(|value: i64| value + 1);
    println!("{}", items.len());
    println!("{}", alias(|value: i64| value + 1, 2));
    println!("{}", call_inside(|value: i64| value + 1, 3));
    nested_mover();
    println!("{}", make_adder(5)(1));
    let mut mutator = make_mutator();
    mutator();
    mutator();
    let mut changer = make_vec_changer();
    changer();
    println!("{}", make_mover()());
    println!("{}", hold(|| 1)());
    println!("{}", hold_mut(|| 1));
    println!("{}", choose(true)());
    println!("{}", choose_by(1)());
    println!("{}", choose_block()());
    let mut returned_mut = returns_mut();
    returned_mut();
    returned_mut();
    println!("{}", returns_once()())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
