#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct User<'a> {
    name: &'a str,
    is_admin: bool,
}

fn initial(name: &str) -> String {
    let letter = &name[0..1];
    letter.to_uppercase()
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let counts: std::collections::BTreeMap<String, i64> = {
        let mut map = std::collections::BTreeMap::new();
        map.insert("A".to_string(), 0);
        map
    };
    let counted: std::collections::BTreeMap<String, i64> = {
        let mut counts = counts;
        counts.insert(initial("ana"), 1);
        counts
    };
    println!("{}", counted.get("A").unwrap());
    let user = User {
        name: "ana",
        is_admin: false,
    };
    let renamed = User {
        name: "karl",
        ..user
    };
    println!("{} {}", renamed.name, renamed.is_admin)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
