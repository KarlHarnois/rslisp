#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Person {
    name: String,
    age: i64,
}

fn make_person(name: String, age: i64) -> Person {
    Person { name, age }
}

fn person_name(instance: &Person) -> &String {
    &instance.name
}

fn person_age(instance: &Person) -> i64 {
    instance.age
}

fn introduce(someone: &Person) -> String {
    format!("{} is {}", person_name(someone), person_age(someone))
}

fn rename(someone: &Person, new_name: String) -> Person {
    make_person(new_name, person_age(someone))
}

fn main() {
    let ada = make_person("Ada".to_string(), 36);
    println!("{}", person_name(&ada));
    println!("{}", person_name(&ada));
    println!("{}", introduce(&ada));
    let copy = person_name(&ada).clone();
    let renamed = rename(&ada, copy);
    println!("{}", introduce(&renamed))
}
