fn is_whitespace(c: char) -> bool {
    c == ' '
}

fn is_digit(c: char) -> bool {
    let left = '0';
    let middle = c;
    left <= middle && middle <= '9'
}

fn main() {
    println!("{}", is_whitespace(' '));
    println!("{}", is_digit('5'))
}
