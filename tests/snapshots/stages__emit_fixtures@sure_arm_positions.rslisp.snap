#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
enum Box {
    Value(i64),
}

fn plus_one(n: i64) -> i64 {
    n + 1
}

fn choose(flag: bool) -> i64 {
    match flag {
        true => {
            let Box::Value(n) = Box::Value(1);
            plus_one(n)
        },
        false => 0,
    }
}

fn main() {
    println!("{}", {
        let Box::Value(n) = Box::Value(2);
        plus_one(n)
    });
    println!("{}", choose(true));
    println!("{}", choose(false))
}
