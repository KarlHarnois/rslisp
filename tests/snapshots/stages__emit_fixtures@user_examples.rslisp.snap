const IS_ADMIN: bool = true;

fn some_function<A: crate::rt::Number>(x: A) -> A {
    x * x
}

fn square<A: crate::rt::Number>(x: A) -> A {
    x * x
}

fn describe(n: i64) -> &'static str {
    if n < 0 {
        "negative"
    } else if n == 0 {
        "zero"
    } else {
        "positive"
    }
}

fn main() {
    println!("{}", IS_ADMIN);
    println!("{}", some_function(7));
    println!("{}", square(2.5));
    println!("{}", (|x: i64, y: i64| x + y)(2, 3));
    println!("{}", describe(-2));
    println!("{}", describe(0));
    if IS_ADMIN {
        println!("welcome")
    }
}

mod rt {
    use std::ops::{Add, Div, Mul, Rem, Sub};

    pub trait Number:
        Copy + PartialOrd + Add<Output = Self> + Sub<Output = Self> + Mul<Output = Self> + Div<Output = Self> + Rem<Output = Self>
    {}

    macro_rules! numbers {
        ($($number:ty),*) => {
            $(
                impl Number for $number {}
            )*
        };
    }

    numbers!(i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, f32, f64);
}
