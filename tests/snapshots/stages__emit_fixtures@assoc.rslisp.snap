#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Point {
    x: i64,
    y: i64,
    label: String,
}

fn make_point(x: i64, y: i64, label: String) -> Point {
    Point { x, y, label }
}

fn point_x(instance: &Point) -> i64 {
    instance.x
}

fn point_y(instance: &Point) -> i64 {
    instance.y
}

fn point_label(instance: &Point) -> &String {
    &instance.label
}

fn bump_x(p: Point) -> Point {
    Point { x: 1, ..p }
}

fn main() {
    let p = make_point(7, 8, "seed".to_string());
    let one = Point { x: 3, ..p };
    println!("{} {} {}", point_x(&one), point_y(&one), point_label(&one));
    let p2 = make_point(4, 5, "base".to_string());
    let two = Point {
        x: 6,
        label: "two".to_string(),
        ..p2
    };
    println!("{} {} {}", point_x(&two), point_y(&two), point_label(&two));
    println!("{}", point_x(&bump_x(make_point(9, 10, "tmp".to_string()))));
    let grid: Vec<i64> = vec![1_i64, 2_i64, 3_i64];
    let next: Vec<i64> = {
        let mut grid = grid;
        grid[1] = 9;
        grid
    };
    println!("{} {} {}", next[0], next[1], next[2]);
    let direct: Vec<i64> = {
        let mut value = vec![7_i64, 8_i64];
        value[0] = 6;
        value
    };
    println!("{} {}", direct[0], direct[1]);
    let rows: Vec<Vec<i64>> = vec![vec![1_i64, 2_i64], vec![3_i64, 4_i64]];
    let changed: Vec<Vec<i64>> = {
        let mut rows = rows;
        rows[1][0] = 9;
        rows
    };
    let cell: i64 = match changed.get(1) {
        Option::Some(row) => row[0],
        Option::None => 0,
    };
    println!("{}", cell)
}
