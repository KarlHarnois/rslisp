#[derive(Clone, Debug, PartialEq, Eq, Hash)]
enum Tree<A> {
    Node(Box<Tree<A>>, A, Box<Tree<A>>),
    Leaf,
}

fn inner_left(tree: Tree<i64>) -> Tree<i64> {
    match tree {
        Tree::Node(inner, _, _) if matches!(&*inner, Tree::Node(_, _, _)) => {
            let Tree::Node(left, _, _) = *inner else {
                unreachable!()
            };
            *left
        }
        Tree::Node(inner, _, _) if matches!(&*inner, Tree::Leaf) => Tree::Leaf,
        Tree::Leaf => Tree::Leaf,
        _ => unreachable!(),
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{:?}",
        inner_left(Tree::Node(
            Box::new(Tree::Node(Box::new(Tree::Leaf), 2, Box::new(Tree::Leaf))),
            1,
            Box::new(Tree::Leaf)
        ))
    );
    println!(
        "{:?}",
        inner_left(Tree::Node(Box::new(Tree::Leaf), 1, Box::new(Tree::Leaf)))
    )
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
