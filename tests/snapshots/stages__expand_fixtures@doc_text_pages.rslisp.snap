source: tests/stages.rs
expression: reports.report(path)
input_file: tests/fixtures/expand/doc_text_pages.rslisp
---
(def print-page "(defmacro print (parts ...))\n\nPrints its parts to standard output, with no newline of its own.\n\nA string literal part is literal text, a `(pr-str x)` part prints with\n`show`, and any other part prints with `display`.")
(def display-page "(defmacro display (type param parts ...))\n\nImplements the `display` trait for a struct or an enum of the program.\n\n`param` is a one-name list that binds the value, and `parts` are what\n`print` takes. One `match` or `if` part prints each arm by its own parts.\n`display` is also the trait, Rust's `Display`, that a `print` part needs.")
(def char-page "(defmacro char (text))\n\nReturns the `char` that a string literal of one character names.\n\n`(char \"a\")` emits `'a'`. Any other form is an error. `char` is also the\nkernel type of a Unicode scalar value.")
(def parse-page "(parse text)\n\nParses a string into the type that the call's result takes.\n\nIt returns `(result target (parse-error target))`, where `target` implements\n`from-str`, so `(the (result i64 parse-int-error) (parse \"12\"))` is `ok`.")
(def parse-error-page "(parse-error target)\n\nNames the error type of parsing a `target` type.\n\nIt is the associated type of `from-str`, as `Err` is in Rust, so\n`(parse-error i64)` is `parse-int-error`.")
(def lines-page "(lines text)\n\nReturns an iterator over the lines of a string.\n\nEach line drops its `\\n` or `\\r\\n` ending, and a final ending starts no\nempty line. Use `line-seq` for standard input.")
(def fmt-page "(fmt value formatter)\n\nWrites a value's `display` text to a formatter.\n\nIt is the method of the `display` trait, and the `display` macro implements\nit.")
