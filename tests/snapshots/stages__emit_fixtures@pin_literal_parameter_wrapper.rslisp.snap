#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Car<'a> {
    make: &'a str,
    year: u16,
}

fn build(year: u16) -> Car<'static> {
    Car {
        make: "Nissan",
        year,
    }
}

fn wrap(y: u16) -> Car<'static> {
    build(y)
}

fn main() {
    println!("{}", wrap(2025).year)
}
