#[derive(Clone, Debug, PartialEq, Eq, Hash)]
enum Tree<A> {
    Node(Box<Tree<A>>, A, Box<Tree<A>>),
    Leaf,
}

fn nested_value(tree: &Tree<i64>) -> i64 {
    match tree {
        Tree::Node(inner, _, _) if matches!(&**inner, Tree::Node(_, _, _)) => {
            let Tree::Node(_, value, _) = &**inner else {
                unreachable!()
            };
            *value
        }
        Tree::Node(inner, value, _) if matches!(&**inner, Tree::Leaf) => *value,
        Tree::Leaf => 0,
        _ => unreachable!(),
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{}",
        nested_value(&Tree::Node(
            Box::new(Tree::Node(Box::new(Tree::Leaf), 7, Box::new(Tree::Leaf))),
            1,
            Box::new(Tree::Leaf)
        ))
    );
    println!(
        "{}",
        nested_value(&Tree::Node(Box::new(Tree::Leaf), 2, Box::new(Tree::Leaf)))
    );
    println!("{}", nested_value(&Tree::Leaf))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
