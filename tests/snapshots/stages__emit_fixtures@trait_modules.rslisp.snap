use crate::trait_modules::shapes::Shape;

fn total_area<A: Shape>(shapes: &[A]) -> f64 {
    shapes
        .iter()
        .fold(0.0, |total: f64, shape: &A| total + shape.area())
}

fn areas<A: Shape>(items: &[A]) -> Vec<f64> {
    let shapes = items.iter();
    shapes.map(Shape::area).collect::<Vec<_>>()
}

fn main() {
    let shapes = vec![
        crate::trait_modules::circles::Circle { radius: 1.0 },
        crate::trait_modules::circles::Circle { radius: 2.0 },
    ];
    println!("{}", total_area(&shapes));
    println!(
        "{}",
        areas(&shapes)
            .iter()
            .copied()
            .fold(0.0, |total: f64, area: f64| total + area)
    );
    let squares = vec![
        crate::trait_modules::squares::Square { side: 2.0 },
        crate::trait_modules::squares::Square { side: 3.0 },
    ];
    println!("{}", total_area(&squares));
    println!(
        "{}",
        areas(&squares)
            .iter()
            .copied()
            .fold(0.0, |total: f64, area: f64| total + area)
    );
    let mut circle = crate::trait_modules::circles::Circle { radius: 1.0 };
    circle.scale(2.0);
    println!("{}", circle.area())
}

mod trait_modules {

    pub(crate) mod circles {
        #[derive(Clone, Debug, PartialEq)]
        pub struct Circle {
            pub radius: f64,
        }

        impl crate::trait_modules::shapes::Shape for Circle {
            fn area(&self) -> f64 {
                3.0 * self.radius * self.radius
            }
            fn scale(&mut self, factor: f64) {
                let _radius = self.radius;
                let _factor = factor;
            }
        }
    }

    pub(crate) mod shapes {
        pub trait Shape {
            fn area(&self) -> f64;
            fn scale(&mut self, _: f64);
        }
    }

    pub(crate) mod squares {
        #[derive(Clone, Debug, PartialEq)]
        pub struct Square {
            pub side: f64,
        }

        impl crate::trait_modules::shapes::Shape for Square {
            fn area(&self) -> f64 {
                self.side * self.side
            }
            fn scale(&mut self, factor: f64) {
                let _side = self.side;
                let _factor = factor;
            }
        }
    }
}
