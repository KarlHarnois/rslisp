#[derive(Clone, Copy, PartialEq, Eq, Hash)]
struct Circle {
    radius: i64,
}

fn make_circle(radius: i64) -> Circle {
    Circle { radius }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let c = make_circle(2);
    let inner = &c;
    let outer = &inner;
    let radius: i64 = 2;
    let radius_view = &radius;
    let radius_outer = &radius_view;
    println!("{}", outer.area());
    println!("{}", inner.same_area(outer));
    println!("{}", inner.holds(radius_outer));
    println!("{}", Shape::fits(9, inner));
    println!("{}", Shape::exceeds(radius_outer, inner));
    println!("{}", outer.radius)
}

trait Shape {
    type Part;
    fn area(&self) -> i64;
    fn same_area(&self, _: &Self) -> bool;
    fn holds(&self, _: &Self::Part) -> bool;
    fn fits(_: i64, _: &Self) -> bool;
    fn exceeds(_: &i64, _: &Self) -> bool;
}

impl Shape for Circle {
    type Part = i64;
    fn area(&self) -> i64 {
        self.radius * self.radius
    }
    fn same_area(&self, right: &Circle) -> bool {
        self.area() == right.area()
    }
    fn holds(&self, value: &i64) -> bool {
        *value == self.radius
    }
    fn fits(limit: i64, c: &Circle) -> bool {
        limit > c.area()
    }
    fn exceeds(limit: &i64, c: &Circle) -> bool {
        *limit > c.radius
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
