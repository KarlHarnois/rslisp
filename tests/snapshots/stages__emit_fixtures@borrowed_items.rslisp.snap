fn is_later<A: PartialOrd>(left: A, right: A) -> bool {
    left > right
}

fn leaf_count(models: &[&str]) -> usize {
    models.iter().filter(|m: &&&str| ***m == *"Leaf").count()
}

fn deref_leaf_count(models: &[&str]) -> usize {
    models.iter().filter(|m: &&&str| ***m == *"Leaf").count()
}

fn count_of<A: PartialEq>(names: &[A], wanted: &A) -> usize {
    names.iter().filter(|n: &&A| *n == wanted).count()
}

fn report_years(years: &[i64]) {
    let next = |y: &i64| *y + 1;
    println!("{}", crate::prelude::iterator::sum(years.iter().map(next)));
    let is_recent = |y: &i64| *y > 2020;
    println!("{}", years.iter().any(is_recent));
    let is_typed_recent = |y: &&i64| **y > 2020;
    println!("{}", years.iter().filter(is_typed_recent).count())
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let years: Vec<i64> = vec![2019_i64, 2021_i64, 2024_i64];
    report_years(&years);
    println!("{}", count_of(&years, &2021));
    let x: i64 = 5;
    let y: i64 = 3;
    let r = &x;
    println!("{}", *r > 3);
    println!("{}", 3 > *r);
    println!("{}", is_later(&x, &y));
    let models = vec!["Leaf", "Ariya"];
    println!("{}", leaf_count(&models));
    println!("{}", deref_leaf_count(&models));
    let names = vec!["Leaf".to_string(), "Ariya".to_string()];
    let wanted = "Leaf".to_string();
    println!("{}", count_of(&names, &wanted));
    println!("{}", wanted)
}

mod prelude {

    pub(crate) mod iterator {
        pub fn sum<N: crate::rt::Number>(values: impl Iterator<Item = N>) -> N {
            values.fold(N::from_literal(0), |argument_0: N, argument_1: N| {
                argument_0 + argument_1
            })
        }
    }
}

mod rt {
    use std::ops::{Add, Div, Mul, Rem, Sub};

    pub trait Number:
        Copy
        + PartialOrd
        + Add<Output = Self>
        + Sub<Output = Self>
        + Mul<Output = Self>
        + Div<Output = Self>
        + Rem<Output = Self>
    {
        fn from_literal(value: i128) -> Self;
    }

    macro_rules! numbers {
        ($($number:ty),*) => {
            $(
                impl Number for $number {
                    fn from_literal(value: i128) -> Self {
                        value as Self
                    }
                }
            )*
        };
    }

    numbers!(
        i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, f32, f64
    );

    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
