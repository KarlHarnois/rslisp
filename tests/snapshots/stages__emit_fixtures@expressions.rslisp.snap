#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Counter {
    count: i64,
}

fn make_counter(count: i64) -> Counter {
    Counter { count }
}

fn is_in_range(a: i64) -> bool {
    a > 1 && a < 5
}

fn is_small(a: i64) -> bool {
    a == 1 || a == 2 || a == 3
}

fn twice_next(x: i64) -> i64 {
    let y: i64 = x + 1;
    y * 2
}

fn sum_to(limit: i64) -> i64 {
    let mut i: i64 = 0;
    let mut total_2: i64 = 0;
    loop {
        if i > limit {
            break total_2;
        } else {
            (i, total_2) = (i + 1, total_2 + i);
            continue;
        }
    }
}

fn total(a: i64, b: i64, c: i64) -> i64 {
    a + b + c
}

fn counter_to_text(c: &Counter) -> String {
    c.count.to_string()
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut c = make_counter(0);
    c.count += 1;
    println!("{}", is_in_range(3));
    println!("{}", is_small(2));
    println!("{}", twice_next(3));
    println!("{}", sum_to(10));
    println!("{}", total(1, 2, 3));
    println!("{}", counter_to_text(&c))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
