input_file: tests/fixtures/emit/function_parameter_in_iterator_callback.rslisp
---
fn record_each(mut record: impl FnMut(i64), years: impl Iterator<Item = i64>) {
    years.for_each(|year: i64| record(year))
}

fn each_year(mut action: impl FnMut(i64), year: i64) {
    action(year);
    action(year + 1)
}

fn record_through_each_year(mut record: impl FnMut(i64), year: i64) {
    each_year(|n: i64| record(n), year)
}

fn apply_once(action: impl FnOnce(i64), year: i64) {
    action(year)
}

fn record_in_one_call(record: impl FnOnce(i64), year: i64) {
    apply_once(|n: i64| record(n), year)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut years: Vec<i64> = vec![2024_i64];
    record_each(|year: i64| years.push(year), 2025_i64..2027_i64);
    record_through_each_year(|year: i64| years.push(year), 2028);
    record_in_one_call(|year: i64| years.push(year), 2030);
    println!("{}", years.len())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
