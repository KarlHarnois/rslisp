#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct User<'a> {
    name: &'a str,
    age: u16,
}

fn make_user(name: &str, age: u16) -> User<'_> {
    User { name, age }
}

#[derive(Clone, Copy, Debug)]
struct Sorter<'a> {
    key: fn(&User<'_>) -> u16,
    label: &'a str,
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let ana = make_user("Ana", 30);
    let key = |someone: &User<'_>| someone.age + 2;
    let by_bonus = Sorter {
        key,
        label: "by bonus",
    };
    println!("{}", by_bonus.label);
    println!("{}", (by_bonus.key)(&ana))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
