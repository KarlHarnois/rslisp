#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct User<'a> {
    nickname: Box<Option<&'a str>>,
}

fn main() {
    let user = User {
        nickname: Box::new(Some("Leafy")),
    };
    println!("{:?}", user.nickname)
}
