fn pick<A, B, C>(compare: impl FnOnce(A, B) -> C, a: A, b: B) -> C {
    compare(a, b)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let v: Vec<i64> = vec![1_i64, 2_i64, 3_i64];
    println!(
        "{}",
        v.iter()
            .fold(0, |argument: i64, argument_2: &i64| argument + argument_2)
    );
    println!(
        "{}",
        v.iter()
            .copied()
            .fold(1_i64, |argument_0: i64, argument_1: i64| argument_0
                * argument_1)
    );
    println!(
        "{}",
        crate::prelude::iterator::sum(v.iter().copied().map(|argument_0: i64| -argument_0))
    );
    println!(
        "{}",
        pick(
            |argument_0: i64, argument_1: i64| argument_0 - argument_1,
            5_i64,
            2_i64
        )
    );
    println!(
        "{}",
        pick(
            |argument_0: i64, argument_1: i64| argument_0 / argument_1,
            6_i64,
            2_i64
        )
    );
    println!(
        "{}",
        pick(
            |argument_0: i64, argument_1: i64| argument_0 < argument_1,
            1_i64,
            2_i64
        )
    );
    println!(
        "{}",
        pick(
            |argument_0: i64, argument_1: i64| argument_0 <= argument_1,
            1_i64,
            2_i64
        )
    );
    println!(
        "{}",
        pick(
            |argument_0: i64, argument_1: i64| argument_0 > argument_1,
            1_i64,
            2_i64
        )
    );
    println!(
        "{}",
        pick(
            |argument_0: i64, argument_1: i64| argument_0 >= argument_1,
            1_i64,
            2_i64
        )
    );
    println!(
        "{}",
        pick(
            |argument_0: i64, argument_1: i64| argument_0 == argument_1,
            1_i64,
            2_i64
        )
    );
    println!(
        "{}",
        pick(
            |argument_0: &str, argument_1: &str| argument_0 != argument_1,
            "a",
            "b"
        )
    );
    println!("{}", 1_i64 + 2_i64 + 3);
    println!("{}", {
        let left: i64 = 1;
        let middle: i64 = 2;
        left < middle && middle < 3
    });
    println!("{}", -5_i64)
}

mod prelude {

    pub(crate) mod iterator {
        pub fn sum<N: crate::rt::Number>(values: impl Iterator<Item = N>) -> N {
            values.fold(N::from_literal(0), |argument_0: N, argument_1: N| {
                argument_0 + argument_1
            })
        }
    }
}

mod rt {
    use std::ops::{Add, Div, Mul, Rem, Sub};

    pub trait Number:
        Copy
        + PartialOrd
        + Add<Output = Self>
        + Sub<Output = Self>
        + Mul<Output = Self>
        + Div<Output = Self>
        + Rem<Output = Self>
    {
        fn from_literal(value: i128) -> Self;
    }

    macro_rules! numbers {
        ($($number:ty),*) => {
            $(
                impl Number for $number {
                    fn from_literal(value: i128) -> Self {
                        value as Self
                    }
                }
            )*
        };
    }

    numbers!(
        i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, f32, f64
    );

    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
