input_file: tests/fixtures/emit/imported_struct_fields.rslisp
---
fn main() {
    crate::rt::restore_default_sigpipe();
    let leaf = crate::garage::cars::make_car("Nissan", "Leaf", 2024, true);
    let civic = crate::garage::cars::Car {
        make: "Honda",
        model: "Civic",
        year: 2019,
        is_electric: false,
    };
    let newer = crate::garage::cars::Car {
        year: 2021,
        ..civic
    };
    println!("{} {} {}", leaf.year, civic.make, newer.year)
}

mod garage {

    pub(crate) mod cars {
        #[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
        pub struct Car<'a> {
            pub make: &'a str,
            pub model: &'a str,
            pub year: u16,
            pub is_electric: bool,
        }

        pub(crate) fn make_car<'a>(
            make: &'a str,
            model: &'a str,
            year: u16,
            is_electric: bool,
        ) -> Car<'a> {
            Car {
                make,
                model,
                year,
                is_electric,
            }
        }
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
