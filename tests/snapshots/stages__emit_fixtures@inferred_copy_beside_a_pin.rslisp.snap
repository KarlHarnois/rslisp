fn twice<A: Copy>(x: A) -> (A, A) {
    (x, x)
}

fn port() -> u16 {
    8080
}

fn listen(p: u16) -> u16 {
    p
}

fn main() {
    crate::rt::restore_default_sigpipe();
    {
        let (left, right) = twice(7);
        println!("{}{}", left, right)
    }
    {
        let (left, right) = twice(2.5);
        println!("{}{}", left, right)
    }
    println!("{}", listen(port()))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
