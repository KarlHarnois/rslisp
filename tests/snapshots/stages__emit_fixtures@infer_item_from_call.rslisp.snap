#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Stack<A> {
    items: Vec<A>,
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut words = Stack { items: Vec::new() };
    words.put("alpha".to_string());
    println!("{}", words.items.len())
}

trait Container {
    type Item;
    fn put(&mut self, _: Self::Item);
}

impl<A> Container for Stack<A> {
    type Item = A;
    fn put(&mut self, value: A) {
        self.items.push(value)
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
