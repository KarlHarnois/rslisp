#[derive(Clone, Copy, Debug, PartialEq)]
struct Point {
    x: f64,
    y: f64,
}

fn make_point(x: f64, y: f64) -> Point {
    Point { x, y }
}

fn distance_squared(a: Point, b: Point) -> f64 {
    let dx = a.x - b.x;
    let dy = a.y - b.y;
    dx * dx + dy * dy
}

fn main() {
    println!("{}", 1_i64 + 2_i64 + 3 + 4);
    println!("{}", 2_i64 * 3_i64 * 4);
    println!("{}", -10_i64);
    println!("{}", 17_i64 % 5_i64);
    println!("{}", {
        let left: i64 = 1;
        let middle: i64 = 2;
        left < middle && middle < 3
    });
    println!("{}", {
        let left: i64 = 3;
        let middle: i64 = 2;
        left < middle && middle < 1
    });
    println!(
        "{}",
        distance_squared(make_point(0.0, 0.0), make_point(3.0, 4.0))
    )
}
