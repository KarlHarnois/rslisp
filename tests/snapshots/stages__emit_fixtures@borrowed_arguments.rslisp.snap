fn is_big(x: &i64) -> bool {
    *x > 2
}

fn is_deep_big(x: &&i64) -> bool {
    **x > 2
}

fn root(x: &f64) -> f64 {
    (*x).sqrt()
}

fn is_even(n: i64) -> bool {
    n % 2 == 0
}

fn keep<A: Copy>(value: A) -> A {
    value
}

fn keep_borrowed(x: &i64) -> &i64 {
    keep(x)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let three: i64 = 3;
    println!("{}", is_big(&three));
    println!("{}", is_deep_big(&&1_i64));
    println!("{}", root(&16.0_f64));
    println!("{}", keep_borrowed(&three));
    println!("{}", Some(5).filter(|n: &i64| *n > 2).is_some());
    println!("{}", Some(4).filter(|n: &i64| is_even(*n)).is_some())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
