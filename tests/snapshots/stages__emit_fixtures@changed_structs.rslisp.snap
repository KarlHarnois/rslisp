input_file: tests/fixtures/emit/changed_structs.rslisp
---
#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Counter {
    count: i64,
}

fn make_counter(count: i64) -> Counter {
    Counter { count }
}

#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Tally {
    total: i64,
}

fn make_tally(total: i64) -> Tally {
    Tally { total }
}

#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Mark {
    x: i64,
}

fn make_mark(x: i64) -> Mark {
    Mark { x }
}

#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Spot {
    x: i64,
}

fn make_spot(x: i64) -> Spot {
    Spot { x }
}

#[derive(Clone, Debug)]
struct Pin {
    x: i64,
}

fn make_pin(x: i64) -> Pin {
    Pin { x }
}

fn bump_tally(t: &mut Tally) {
    std::ops::AddAssign::add_assign(&mut t.total, 1)
}

fn touch(m: &mut Mark) {}

fn copy_into(target: &mut Spot, source: &Spot) {
    target.clone_from(source)
}

fn main() {
    let mut c = make_counter(1);
    std::ops::AddAssign::add_assign(&mut c.count, 1);
    println!("{}", c.count);
    let mut t = make_tally(5);
    bump_tally(&mut t);
    println!("{}", t.total);
    let mut m = make_mark(2);
    touch(&mut m);
    println!("{}", m.x);
    let mut s = make_spot(1);
    let u = make_spot(9);
    copy_into(&mut s, &u);
    println!("{}", s.x);
    println!("{}", make_pin(4).x)
}
