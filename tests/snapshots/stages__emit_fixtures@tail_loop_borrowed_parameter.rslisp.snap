fn strip(mut text: &str, mut n: i64) -> &str {
    loop {
        if n == 0 {
            return text;
        } else {
            (text, n) = (text.trim(), n - 1);
            continue;
        }
    }
}

fn main() {
    println!("{}", strip("  hi  ", 1))
}
