#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
enum AppError {
    Missing,
}

fn main_body() -> i64 {
    1
}

fn main_body_() -> Result<(), AppError> {
    println!("{}", main_body());
    Err(AppError::Missing)
}

fn main() {
    if let Err(error) = main_body_() {
        eprintln!("{}", error);
        std::process::exit(1);
    }
}

impl std::fmt::Display for AppError {
    fn fmt(&self, out: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(out, "missing")
    }
}
