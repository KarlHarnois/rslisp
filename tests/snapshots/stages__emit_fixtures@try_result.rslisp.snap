fn parse_add(left: &str, right: &str) -> Result<i64, std::num::ParseIntError> {
    let left_number: i64 = left.parse::<i64>()?;
    let right_number: i64 = right.parse::<i64>()?;
    Ok(left_number + right_number)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", parse_add("2", "3").unwrap());
    println!("{}", parse_add("2", "x").is_err())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
