#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
struct Ticket {
    id: u32,
    seat: u32,
}

fn make_ticket(id: u32, seat: u32) -> Ticket {
    Ticket { id, seat }
}

struct Tag {
    label: String,
}

fn make_tag(label: String) -> Tag {
    Tag { label }
}

fn main() {
    let early = make_ticket(1, 4);
    let same = early;
    println!("{:?}", early);
    println!("{:?}", same);
    println!("{}", early < make_ticket(2, 1));
    println!("{}", make_tag("vip".to_string()).label)
}
