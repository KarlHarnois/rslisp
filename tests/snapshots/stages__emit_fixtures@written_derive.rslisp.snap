#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
struct Ticket {
    id: u32,
    seat: u32,
}

fn make_ticket(id: u32, seat: u32) -> Ticket {
    Ticket { id, seat }
}

struct Tag {
    label: String,
}

fn make_tag(label: String) -> Tag {
    Tag { label }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let early = make_ticket(1, 4);
    let same = early;
    println!("{:?}", early);
    println!("{:?}", same);
    println!("{}", early < make_ticket(2, 1));
    println!("{}", make_tag("vip".to_string()).label)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
