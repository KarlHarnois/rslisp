#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Car<'a> {
    make: &'a str,
    year: u16,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Depot {
    size: u16,
}

fn make_depot(size: u16) -> Depot {
    Depot { size }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let lot = make_depot(1);
    let picked = lot.pick(|make: &str| Car { make, year: 2025 });
    println!("{}", picked.make);
    println!("{}", lot.size + picked.year)
}

trait Garage {
    fn pick(&self, _: impl Fn(&str) -> Car<'_>) -> Car<'_>;
}

impl Garage for Depot {
    fn pick(&self, constructor: impl FnOnce(&str) -> Car<'_>) -> Car<'_> {
        constructor("Nissan")
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
