fn first_big(values: impl Iterator<Item = i64>) -> Option<i64> {
    values.into_iter().find(|value: &i64| *value > 50)
}

fn is_has_big(values: impl Iterator<Item = i64>) -> bool {
    values.into_iter().any(|value: i64| value > 50)
}

fn is_all_small(values: impl Iterator<Item = i64>) -> bool {
    values.into_iter().all(|value: i64| value < 50)
}

fn how_many(values: impl Iterator<Item = i64>) -> usize {
    values.count()
}

fn first_even(values: impl Iterator<Item = i64>) -> Option<i64> {
    values.into_iter().find(|value: &i64| *value % 2 == 0)
}

fn even_year(years: &[i64]) -> Option<i64> {
    years.iter().copied().find(|year: &i64| *year % 2 == 0)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{:?}", first_big(1_i64..100_i64));
    println!("{:?}", is_has_big(1_i64..100_i64));
    println!("{:?}", is_all_small(1_i64..100_i64));
    println!("{:?}", how_many(1_i64..100_i64));
    println!("{:?}", first_even(2041_i64..2045_i64));
    let years: Vec<i64> = vec![2017_i64, 2018_i64, 2019_i64];
    println!("{:?}", even_year(&years));
    let recent = years.iter().filter(|year: &&i64| **year > 2017);
    println!("{:?}", recent.into_iter().all(|year: &i64| *year > 2018));
    println!("{:?}", years.iter().any(|year: &i64| *year > 2018))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
