input_file: tests/fixtures/emit/reduce_arities.rslisp
---
fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{}",
        (1_i64..5_i64).fold(10, |total: i64, n: i64| total + n)
    );
    println!(
        "{}",
        (1_i64..5_i64)
            .reduce(|product: i64, n: i64| product * n)
            .unwrap_or(0)
    );
    println!(
        "{}",
        (1_i64..1_i64)
            .reduce(|argument_0: i64, argument_1: i64| argument_0 + argument_1)
            .is_none()
    )
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
