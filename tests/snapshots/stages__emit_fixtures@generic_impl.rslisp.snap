fn main() {
    println!("{}", vec![1_i64, 2_i64].size())
}

trait Sized2 {
    fn size(&self) -> usize;
}

impl<A> Sized2 for Vec<A> {
    fn size(&self) -> usize {
        self.len()
    }
}
