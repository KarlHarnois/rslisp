fn size_of<A: crate::rt::Sequence + ?Sized>(text: &A) -> usize {
    text.len()
}

fn main() {
    let word = "hello".to_string();
    println!("{}", size_of(word.as_str()));
    println!("{}", size_of(&word))
}

mod rt {
    pub trait Sequence {
        fn len(&self) -> usize;
    }

    impl Sequence for String {
        fn len(&self) -> usize {
            self.as_str().len()
        }
    }

    impl Sequence for str {
        fn len(&self) -> usize {
            str::len(self)
        }
    }

    impl<T> Sequence for Vec<T> {
        fn len(&self) -> usize {
            Vec::len(self)
        }
    }

    impl<T> Sequence for [T] {
        fn len(&self) -> usize {
            <[T]>::len(self)
        }
    }
}
