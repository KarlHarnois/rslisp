fn size_of<A: crate::rt::Sequence + ?Sized>(text: &A) -> usize {
    text.len()
}

fn main() {
    let word = "hello".to_string();
    println!("{}", size_of(word.as_str()));
    println!("{}", size_of(&word))
}

mod rt {
    use std::ops::{Add, Div, Mul, Neg, Rem, Sub};

    pub trait Number:
        Copy + PartialOrd + Add<Output = Self> + Sub<Output = Self> + Mul<Output = Self> + Div<Output = Self> + Rem<Output = Self>
    {
        fn from_literal(value: i128) -> Self;

        fn from_float_literal(value: f64) -> Self;
    }

    pub trait Signed: Number + Neg<Output = Self> {}

    pub trait Float: Signed {}

    pub trait Integer: Number {}

    macro_rules! numbers {
        ($($number:ty),*) => {
            $(
                impl Number for $number {
                    fn from_literal(value: i128) -> Self {
                        value as Self
                    }

                    fn from_float_literal(value: f64) -> Self {
                        value as Self
                    }
                }
            )*
        };
    }

    numbers!(i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, f32, f64);

    impl<T> Signed for T where T: Number + Neg<Output = T> {}

    impl Float for f32 {}

    impl Float for f64 {}

    macro_rules! integers {
        ($($integer:ty),*) => {
            $(
                impl Integer for $integer {}
            )*
        };
    }

    integers!(i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize);

    pub trait Sequence {
        fn len(&self) -> usize;
    }

    impl Sequence for String {
        fn len(&self) -> usize {
            self.as_str().len()
        }
    }

    impl Sequence for str {
        fn len(&self) -> usize {
            str::len(self)
        }
    }

    impl<T> Sequence for Vec<T> {
        fn len(&self) -> usize {
            Vec::len(self)
        }
    }

    impl<T> Sequence for [T] {
        fn len(&self) -> usize {
            <[T]>::len(self)
        }
    }
}
