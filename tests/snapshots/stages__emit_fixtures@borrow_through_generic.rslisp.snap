fn size_of<A: crate::rt::Sequence + ?Sized>(text: &A) -> usize {
    text.len()
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let word = "hello".to_string();
    println!("{}", size_of(word.as_str()));
    println!("{}", size_of(&word))
}

mod rt {
    pub trait Sequence {
        fn len(&self) -> usize;
    }

    impl Sequence for String {
        fn len(&self) -> usize {
            self.as_str().len()
        }
    }

    impl Sequence for str {
        fn len(&self) -> usize {
            str::len(self)
        }
    }

    impl<T> Sequence for Vec<T> {
        fn len(&self) -> usize {
            Vec::len(self)
        }
    }

    impl<T> Sequence for [T] {
        fn len(&self) -> usize {
            <[T]>::len(self)
        }
    }

    impl<T: Sequence + ?Sized> Sequence for &T {
        fn len(&self) -> usize {
            T::len(self)
        }
    }

    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
