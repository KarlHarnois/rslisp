#[derive(Clone, Copy, Debug, PartialEq)]
struct Circle {
    radius: f64,
}

enum Outcome {
    Made(Box<dyn Shape>),
}

fn make() -> Outcome {
    Outcome::Made(Box::new(Circle { radius: 1.0 }) as Box<dyn Shape>)
}

fn parse(text: &str) -> Result<Box<dyn Shape>, String> {
    Ok(Box::new(Circle { radius: 1.0 }) as Box<dyn Shape>)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    {
        let Outcome::Made(shape) = make();
        println!("{}", shape.area())
    }
    match parse("c") {
        Ok(shape) => println!("{}", shape.area()),
        Err(message) => println!("{}", message),
    }
}

trait Shape {
    fn area(&self) -> f64;
}

impl Shape for Circle {
    fn area(&self) -> f64 {
        self.radius
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
