#[derive(Clone, Debug, PartialEq, Eq, Hash)]
enum Expr {
    Call(Box<Expr>, String),
    Name(String),
}

fn call_label(expr: Expr) -> String {
    match expr {
        Expr::Call(inner, label) if matches!(&*inner, Expr::Name(text) if text == "x") => label,
        Expr::Call(inner, label) => {
            let inner = *inner;
            label
        }
        Expr::Name(label) => label,
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{}",
        call_label(Expr::Call(
            Box::new(Expr::Name("x".to_string())),
            "hit".to_string()
        ))
    );
    println!(
        "{}",
        call_label(Expr::Call(
            Box::new(Expr::Name("y".to_string())),
            "miss".to_string()
        ))
    );
    println!("{}", call_label(Expr::Name("name".to_string())))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
