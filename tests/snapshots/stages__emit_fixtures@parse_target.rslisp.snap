fn add_one(text: &str) -> Result<i64, std::num::ParseIntError> {
    Ok(text.parse::<i64>()? + 1)
}

fn read_number<Target: std::str::FromStr>(
    text: &str,
) -> Result<Target, <Target as std::str::FromStr>::Err> {
    text.parse::<Target>()
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", add_one("2").unwrap());
    let parsed: Result<i64, std::num::ParseIntError> = read_number("3");
    println!("{}", parsed.unwrap())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
