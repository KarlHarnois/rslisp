#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
enum Box {
    Value(i64),
}

fn unbox(b: Box) -> i64 {
    let Box::Value(n) = b;
    n + 1
}

fn ignore(b: Box) -> i64 {
    let _ = b;
    0
}

fn countdown(mut b: Box) -> i64 {
    loop {
        let Box::Value(n) = b;
        if n == 0 {
            return n;
        } else {
            b = Box::Value(n - 1);
            continue;
        }
    }
}

fn main() {
    println!("{}", unbox(Box::Value(41)));
    println!("{}", ignore(Box::Value(5)));
    println!("{}", countdown(Box::Value(3)));
    let Box::Value(n) = Box::Value(7);
    println!("{}", n)
}
