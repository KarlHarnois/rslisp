---
source: tests/stages.rs
expression: reports.report(path)
input_file: tests/fixtures/emit/if_struct_literal.rslisp
---
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Spare<'a> {
    size: u16,
    label: &'a str,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Check {
    passed: bool,
}

fn describe(s: Spare<'_>) -> &str {
    if (Spare {
        size: 3,
        label: "bolt",
    } == s)
    {
        "same"
    } else {
        "other"
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let s = Spare {
        size: 3,
        label: "bolt",
    };
    println!("{}", s.label);
    println!("{}", describe(s));
    if (!Check { passed: false }.passed) {
        println!("failed")
    }
    let mut size: u16 = 2;
    loop {
        if (Spare {
            size,
            label: "bolt",
        } == s)
        {
            println!("{}", size);
            break;
        } else {
            size = 3;
            continue;
        }
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
