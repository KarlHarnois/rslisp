#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Point {
    x: i64,
    y: i64,
}

fn make_point(x: i64, y: i64) -> Point {
    Point { x, y }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Cube {
    x: i64,
    y: i64,
    z: i64,
}

fn make_cube(x: i64, y: i64, z: i64) -> Cube {
    Cube { x, y, z }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Pair<A> {
    left: A,
    right: A,
}

fn make_pair<A>(left: A, right: A) -> Pair<A> {
    Pair { left, right }
}

fn shift(p: Point) -> Point {
    make_point(p.x + 1, p.y)
}

fn volume(c: &Cube) -> i64 {
    c.x * (c.y * c.z)
}

fn is_same_shape<A: PartialEq>(a: A, b: A) -> bool {
    a == b
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let p = make_point(1, 2);
    println!("{}", shift(p).x);
    println!("{}", shift(p).x);
    println!("{}", volume(&make_cube(2, 3, 4)));
    let numbers: Pair<i64> = make_pair(1, 2);
    let words = make_pair("a".to_string(), "b".to_string());
    println!("{}", numbers.left);
    println!("{}", words.right);
    let mut kept = vec![p];
    kept.push(p);
    println!("{}", kept.len());
    println!("{}", p.y);
    println!("{}", is_same_shape(p, make_point(1, 2)));
    println!("{}", is_same_shape(make_cube(1, 2, 3), make_cube(3, 2, 1)))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
