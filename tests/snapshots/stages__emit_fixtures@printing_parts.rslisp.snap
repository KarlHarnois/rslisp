#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Point {
    x: i64,
    y: i64,
}

fn make_point(x: i64, y: i64) -> Point {
    Point { x, y }
}

fn main() {
    let n: i64 = 3;
    let p = make_point(1, 2);
    println!("hello");
    println!("total: {}", n);
    println!("n={}", n);
    println!("{:?}", p);
    println!("50% {{done}}");
    println!("x={}, y={}", n, n)
}
