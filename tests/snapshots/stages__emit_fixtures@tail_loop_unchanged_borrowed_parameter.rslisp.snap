#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Counter {
    label: String,
    count: i64,
}

fn count_to(limit: i64, state: &Counter, mut steps: i64) -> i64 {
    loop {
        if steps == limit {
            return steps + state.count;
        } else {
            steps += 1;
            continue;
        }
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{}",
        count_to(
            3,
            &Counter {
                label: "c".to_string(),
                count: 10
            },
            0
        )
    )
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
