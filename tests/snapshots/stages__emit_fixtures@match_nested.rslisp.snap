#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
enum Maybe<A> {
    Just(A),
    Nothing,
}

#[derive(Clone, Copy, Debug, PartialEq)]
enum Shape {
    Circle(f64),
    Rect(f64, f64),
}

fn maybe_area(m: Maybe<Shape>) -> f64 {
    match m {
        Maybe::Just(Shape::Circle(r)) => 3.0 * r * r,
        Maybe::Just(Shape::Rect(w, h)) => w * h,
        Maybe::Nothing => 0.0,
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", maybe_area(Maybe::Just(Shape::Circle(2.0))));
    println!("{}", maybe_area(Maybe::Just(Shape::Rect(2.0, 3.0))));
    println!("{}", maybe_area(Maybe::Nothing))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
