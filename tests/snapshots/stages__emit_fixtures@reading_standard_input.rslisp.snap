expression: reports.report(path)
input_file: tests/fixtures/emit/reading_standard_input.rslisp
---
fn load(path: &str) -> Result<String, std::io::Error> {
    std::fs::read_to_string(path)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let path = "cars.txt".to_string();
    match std::fs::read_to_string(&path) {
        Ok(text) => println!("{}: {}", path, text),
        Err(error) => eprintln!("{}", error),
    }
    match load("garage.txt") {
        Ok(text) => println!("{}", text),
        Err(error) => eprintln!("{}", error),
    }
    match std::io::read_to_string(&std::io::stdin()) {
        Ok(text) => println!("{}", text.as_str().lines().count()),
        Err(error) => eprintln!("{}", error),
    }
    crate::rt::lines(&std::io::stdin()).for_each(
        |line: Result<String, std::io::Error>| match line {
            Ok(text) => println!("{}", text),
            Err(error) => eprintln!("{}", error),
        },
    )
}

mod rt {
    pub fn read_line() -> std::io::Result<Option<String>> {
        let mut line = String::new();
        match std::io::stdin().read_line(&mut line) {
            Ok(0) => Ok(None),
            Ok(_) => {
                if line.ends_with('\n') {
                    line.pop();
                }
                if line.ends_with('\r') {
                    line.pop();
                }
                Ok(Some(line))
            }
            Err(error) => Err(error),
        }
    }

    pub fn lines(_: &std::io::Stdin) -> impl Iterator<Item = std::io::Result<String>> + use<> {
        let mut failed = false;
        std::iter::from_fn(move || {
            if failed {
                return None;
            }
            let line = read_line().transpose()?;
            failed = line.is_err();
            Some(line)
        })
    }

    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
