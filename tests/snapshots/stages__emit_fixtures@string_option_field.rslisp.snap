#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct User<'a> {
    nickname: Option<&'a str>,
}

fn main() {
    let user = User {
        nickname: Some("Leafy"),
    };
    println!("{}", user.nickname.unwrap())
}
