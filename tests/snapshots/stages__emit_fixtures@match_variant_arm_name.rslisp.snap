#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
enum Operation {
    Add,
    Sub,
}

fn apply<A: crate::rt::Number>(operation: Operation, left: A, right: A) -> A {
    match operation {
        Operation::Add => left + right,
        Operation::Sub => left - right,
    }
}

fn main() {
    println!("{}", apply(Operation::Add, 2, 3));
    println!("{}", apply(Operation::Sub, 7, 4))
}

mod rt {
    use std::ops::{Add, Div, Mul, Rem, Sub};

    pub trait Number:
        Copy + PartialOrd + Add<Output = Self> + Sub<Output = Self> + Mul<Output = Self> + Div<Output = Self> + Rem<Output = Self>
    {}

    macro_rules! numbers {
        ($($number:ty),*) => {
            $(
                impl Number for $number {}
            )*
        };
    }

    numbers!(i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, f32, f64);
}
