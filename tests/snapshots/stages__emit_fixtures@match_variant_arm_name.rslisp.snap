#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
enum Operation {
    Add,
    Sub,
}

fn apply(operation: Operation, left: i64, right: i64) -> i64 {
    match operation {
        Operation::Add => left + right,
        Operation::Sub => left - right,
    }
}

fn main() {
    println!("{}", apply(Operation::Add, 2, 3));
    println!("{}", apply(Operation::Sub, 7, 4))
}
