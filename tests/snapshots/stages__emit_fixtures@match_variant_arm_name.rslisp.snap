#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
enum Operation {
    Add,
    Sub,
}

fn apply(operation: Operation, left: i64, right: i64) -> i64 {
    match operation {
        Operation::Add => left + right,
        Operation::Sub => left - right,
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", apply(Operation::Add, 2, 3));
    println!("{}", apply(Operation::Sub, 7, 4))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
