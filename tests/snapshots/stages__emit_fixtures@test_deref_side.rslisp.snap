---
source: tests/stages.rs
expression: reports.report(path)
input_file: tests/fixtures/emit/test_deref_side.rslisp
---
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
struct CrateOf {
    count: i64,
}

fn count_of(crate_: &CrateOf) -> &i64 {
    &crate_.count
}

fn test_deref_of_a_local() {
    let number: i64 = 1;
    let borrowed = &number;
    crate::rt::check_equal(
        "test_deref_side.rslisp:15:3",
        "(assert (= (deref borrowed) 1))",
        &({ *borrowed }),
        &1,
        |left: &i64, right: &i64| *left == *right,
    );
}

fn holds_one(item: &i64) {
    crate::rt::check_equal(
        "test_deref_side.rslisp:20:3",
        "(assert (= (deref item) 1))",
        &({ *item }),
        &1,
        |left: &i64, right: &i64| *left == *right,
    )
}

fn test_deref_of_a_parameter() {
    holds_one(&1_i64);
}

fn test_deref_of_a_call() {
    let crate_ = CrateOf { count: 1 };
    crate::rt::check_equal(
        "test_deref_side.rslisp:26:3",
        "(assert (= (deref (count-of crate)) 1))",
        &({ *count_of(&crate_) }),
        &1,
        |left: &i64, right: &i64| *left == *right,
    );
}

fn main() {
    crate::rt::restore_default_sigpipe();
    crate::rt::start_run(
        "<record>",
        vec![
            "test_deref_side/deref-of-a-local",
            "test_deref_side/deref-of-a-parameter",
            "test_deref_side/deref-of-a-call",
        ],
    );
    crate::rt::run_test(
        "<record>",
        "test_deref_side/deref-of-a-local",
        "",
        "test_deref_side.rslisp:12:1",
        test_deref_of_a_local,
    );
    crate::rt::run_test(
        "<record>",
        "test_deref_side/deref-of-a-parameter",
        "",
        "test_deref_side.rslisp:22:1",
        test_deref_of_a_parameter,
    );
    crate::rt::run_test(
        "<record>",
        "test_deref_side/deref-of-a-call",
        "",
        "test_deref_side.rslisp:24:1",
        test_deref_of_a_call,
    );
    crate::rt::finish_run("<record>")
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    use std::fmt::{Display, Formatter, Result, Write};

    pub trait Show {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result;
    }

    pub struct Shown<'v, T: Show + ?Sized>(pub &'v T);

    impl<T: Show + ?Sized> Display for Shown<'_, T> {
        fn fmt(&self, out: &mut Formatter<'_>) -> Result {
            self.0.write_form(out)
        }
    }

    pub struct Record<'r, 'f> {
        out: &'r mut Formatter<'f>,
        written: Result,
    }

    impl<'r, 'f> Record<'r, 'f> {
        pub fn open(out: &'r mut Formatter<'f>, head: &str) -> Self {
            let written = write!(out, "({head}");
            Record { out, written }
        }

        pub fn part<T: Show + ?Sized>(self, value: &T) -> Self {
            self.write(|out| {
                out.write_char(' ')?;
                value.write_form(out)
            })
        }

        pub fn text(self, written: &str) -> Self {
            self.write(|out| write!(out, " {written}"))
        }

        pub fn close(self) -> Result {
            self.written?;
            self.out.write_char(')')
        }

        fn write(mut self, part: impl FnOnce(&mut Formatter<'f>) -> Result) -> Self {
            self.written = self.written.and_then(|()| part(self.out));
            self
        }
    }

    struct Quoted<'t>(&'t str);

    impl Display for Quoted<'_> {
        fn fmt(&self, out: &mut Formatter<'_>) -> Result {
            out.write_char('"')?;
            for character in self.0.chars() {
                match character {
                    '"' => out.write_str("\\\"")?,
                    '\\' => out.write_str("\\\\")?,
                    '\n' => out.write_str("\\n")?,
                    '\r' => out.write_str("\\r")?,
                    '\t' => out.write_str("\\t")?,
                    '\0' => out.write_str("\\0")?,
                    control if control.is_control() => write!(out, "\\u{{{:x}}}", control as u32)?,
                    printable => out.write_char(printable)?,
                }
            }
            out.write_char('"')
        }
    }

    macro_rules! shown_as_display {
        ($($shown:ty),*) => {
            $(
                impl Show for $shown {
                    fn write_form(&self, out: &mut Formatter<'_>) -> Result {
                        write!(out, "{self}")
                    }
                }
            )*
        };
    }

    shown_as_display!(
        bool, i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize
    );

    macro_rules! shown_as_float {
        ($($shown:ty),*) => {
            $(
                impl Show for $shown {
                    fn write_form(&self, out: &mut Formatter<'_>) -> Result {
                        if self.is_nan() {
                            out.write_str("(/ 0.0 0.0)")
                        } else if self.is_infinite() && self.is_sign_positive() {
                            out.write_str("(/ 1.0 0.0)")
                        } else if self.is_infinite() {
                            out.write_str("(/ -1.0 0.0)")
                        } else {
                            write!(out, "{self:?}")
                        }
                    }
                }
            )*
        };
    }

    shown_as_float!(f32, f64);

    macro_rules! shown_as_message {
        ($($shown:ty => $head:literal),*) => {
            $(
                impl Show for $shown {
                    fn write_form(&self, out: &mut Formatter<'_>) -> Result {
                        Record::open(out, $head).part(self.to_string().as_str()).close()
                    }
                }
            )*
        };
    }

    shown_as_message!(
        std::io::Error => "io-error",
        std::str::ParseBoolError => "parse-bool-error",
        std::char::ParseCharError => "parse-char-error",
        std::num::ParseIntError => "parse-int-error",
        std::num::ParseFloatError => "parse-float-error"
    );

    impl Show for std::convert::Infallible {
        fn write_form(&self, _: &mut Formatter<'_>) -> Result {
            match *self {}
        }
    }

    impl Show for char {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            let mut text = [0; 4];
            Record::open(out, "char")
                .part(&*self.encode_utf8(&mut text))
                .close()
        }
    }

    impl Show for str {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            write!(out, "{}", Quoted(self))
        }
    }

    impl Show for String {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            self.as_str().write_form(out)
        }
    }

    impl Show for () {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            out.write_str("(do)")
        }
    }

    impl<T: Show + ?Sized> Show for &T {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            T::write_form(self, out)
        }
    }

    impl<T: Show + ?Sized> Show for Box<T> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            Record::open(out, "box").part(&**self).close()
        }
    }

    impl<T: Show> Show for [T] {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            self.iter()
                .fold(Record::open(out, "vec"), Record::part)
                .close()
        }
    }

    impl<T: Show> Show for Vec<T> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            self.as_slice().write_form(out)
        }
    }

    impl<T: Show> Show for Option<T> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            match self {
                Some(value) => Record::open(out, "some").part(value).close(),
                None => out.write_str("none"),
            }
        }
    }

    impl<T: Show, E: Show> Show for std::result::Result<T, E> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            match self {
                Ok(value) => Record::open(out, "ok").part(value).close(),
                Err(error) => Record::open(out, "err").part(error).close(),
            }
        }
    }

    impl<A: Show, B: Show> Show for (A, B) {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            Record::open(out, "pair")
                .part(&self.0)
                .part(&self.1)
                .close()
        }
    }

    impl<K: Show, V: Show> Show for std::collections::BTreeMap<K, V> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            self.iter()
                .fold(Record::open(out, "sorted-map"), |record, (key, value)| {
                    record.part(key).part(value)
                })
                .close()
        }
    }

    impl<K: Show, V: Show, S> Show for std::collections::HashMap<K, V, S> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            let mut entries: Vec<(String, &V)> = self
                .iter()
                .map(|(key, value)| (Shown(key).to_string(), value))
                .collect();
            entries.sort_by(|(left, _), (right, _)| left.cmp(right));
            entries
                .iter()
                .fold(Record::open(out, "hash-map"), |record, (key, value)| {
                    record.text(key).part(*value)
                })
                .close()
        }
    }

    static FAILED_RECORD: std::sync::Mutex<Option<String>> = std::sync::Mutex::new(None);

    fn fail_check(head: &str, location: &str, text: &str, sides: &[String], message: Option<&str>) {
        let parts = [location, text]
            .into_iter()
            .chain(sides.iter().map(String::as_str))
            .chain(message);
        let record = parts.fold(head.to_string(), |record, part| {
            format!("{record} {}", Shown(part))
        });
        *FAILED_RECORD.lock().unwrap() = Some(record);
        let shown_sides: String = ["left: ", "right:"]
            .iter()
            .zip(sides)
            .map(|(label, side)| format!("\n{label} {side}"))
            .collect();
        let note = message.map(|text| format!("\n{text}")).unwrap_or_default();
        panic!("assertion failed at {location}: {text}{shown_sides}{note}");
    }

    pub fn check_equal<A: Show + ?Sized, B: Show + ?Sized>(
        location: &str,
        text: &str,
        left: &A,
        right: &B,
        equal: impl Fn(&A, &B) -> bool,
    ) {
        if !equal(left, right) {
            let sides = [Shown(left).to_string(), Shown(right).to_string()];
            fail_check("fail-equal", location, text, &sides, None);
        }
    }

    pub fn start_run(marker: &str, names: Vec<&str>) {
        std::panic::set_hook(Box::new(|_| {}));
        let selected = names.iter().filter(|name| is_selected(name)).count();
        println!("{marker}(start {selected})");
    }

    pub fn finish_run(marker: &str) {
        println!("{marker}(done)");
    }

    fn is_selected(name: &str) -> bool {
        match std::env::args().skip(1).collect::<Vec<String>>().as_slice() {
            [flag, wanted] if flag == "--exact" => name == wanted,
            [filter] => name.contains(filter.as_str()),
            _ => true,
        }
    }

    pub fn run_test(marker: &str, name: &str, summary: &str, location: &str, test: impl Fn()) {
        if !is_selected(name) {
            return;
        }
        println!("{marker}(test {} {})", Shown(name), Shown(summary));
        std::io::Write::flush(&mut std::io::stdout()).unwrap_or(());
        let caught = std::panic::catch_unwind(std::panic::AssertUnwindSafe(test));
        match caught.err() {
            None => println!("{marker}(ok)"),
            Some(payload) => println!("{marker}({})", failure_record(&*payload, location)),
        }
    }

    fn failure_record(payload: &(dyn std::any::Any + Send), location: &str) -> String {
        let failed_check = FAILED_RECORD.lock().unwrap().take();
        failed_check.unwrap_or_else(|| {
            format!(
                "panic {} {}",
                Shown(location),
                Shown(panic_message(payload))
            )
        })
    }

    fn panic_message(payload: &(dyn std::any::Any + Send)) -> &str {
        payload
            .downcast_ref::<&str>()
            .copied()
            .or_else(|| payload.downcast_ref::<String>().map(String::as_str))
            .unwrap_or("Box<dyn Any>")
    }
}
