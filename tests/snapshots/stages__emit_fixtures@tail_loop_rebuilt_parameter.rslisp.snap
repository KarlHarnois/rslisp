#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Counter {
    label: String,
    count: i64,
}

fn count_up(limit: i64, mut state: Counter) -> i64 {
    loop {
        if state.count == limit {
            return state.count;
        } else {
            state = Counter {
                label: "c".to_string(),
                count: state.count + 1,
            };
            continue;
        }
    }
}

fn main() {
    println!(
        "{}",
        count_up(
            3,
            Counter {
                label: "c".to_string(),
                count: 0
            }
        )
    )
}
