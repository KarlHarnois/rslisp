#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Counter {
    label: String,
    count: i64,
}

fn count_up(limit: i64, mut state: Counter) -> i64 {
    loop {
        if state.count == limit {
            return state.count;
        } else {
            state = Counter {
                label: "c".to_string(),
                count: state.count + 1,
            };
            continue;
        }
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{}",
        count_up(
            3,
            Counter {
                label: "c".to_string(),
                count: 0
            }
        )
    )
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
