fn count_long<'a>(names: impl Iterator<Item = &'a str>) -> usize {
    names.filter(|name: &&'a str| name.len() > 4).count()
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let models: Vec<&str> = vec!["Leaf", "Ariya", "Sakura"];
    println!("{}", count_long(models.iter().copied()))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
