fn second_of<'a>(
    reader: impl FnOnce(&'a [i64], usize) -> Option<&'a i64>,
    items: &'a [i64],
) -> Option<&'a i64> {
    reader(items, 1)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let years: Vec<i64> = vec![2019_i64, 2025_i64];
    println!(
        "{}",
        second_of(
            |argument_0: &[i64], argument_1: usize| argument_0.get(argument_1),
            &years
        )
        .unwrap()
    )
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
