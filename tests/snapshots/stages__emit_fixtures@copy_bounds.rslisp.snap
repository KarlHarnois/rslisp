fn twice<A: Copy>(value: A, combine: impl FnOnce(A, A) -> A) -> A {
    combine(value, value)
}

fn main() {
    println!("{}", twice(4, |left: i64, right: i64| left + right));
    println!("{}", twice(true, |left: bool, right: bool| left && right))
}
