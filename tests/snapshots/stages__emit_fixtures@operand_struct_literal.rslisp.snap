input_file: tests/fixtures/emit/operand_struct_literal.rslisp
---
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Spare<'a> {
    size: u16,
    label: &'a str,
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let s = Spare {
        size: 3,
        label: "bolt",
    };
    println!("{}", s.label);
    if (s
        == Spare {
            size: 3,
            label: "bolt",
        })
    {
        println!("same")
    } else {
        println!("other")
    }
    if (s.size
        > Spare {
            size: 2,
            label: "nut",
        }
        .size)
    {
        println!("larger")
    } else {
        println!("smaller")
    }
    println!(
        "{}",
        match (s
            == Spare {
                size: 4,
                label: "bolt"
            }) {
            true => "equal",
            false => "unequal",
        }
    )
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
