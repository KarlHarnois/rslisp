fn replace(items: &mut Vec<i64>) {
    *items = vec![4_i64, 5_i64]
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut numbers: Vec<i64> = vec![1_i64, 2_i64, 3_i64];
    replace(&mut numbers);
    println!("{}", numbers.len())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
