#[derive(Clone, PartialEq, Eq, Hash)]
enum AppError {
    BadInput(String),
    Missing,
}

fn fail(is_missing: bool) -> Result<(), AppError> {
    if is_missing {
        Err(AppError::Missing)
    } else {
        Err(AppError::BadInput("oops".to_string()))
    }
}

fn main_body() -> Result<(), AppError> {
    fail(true)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    if let Err(error) = main_body() {
        eprintln!("{}", error);
        std::process::exit(1);
    }
}

impl std::fmt::Display for AppError {
    fn fmt(&self, out: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            AppError::BadInput(message) => write!(out, "bad input: {}", message),
            AppError::Missing => write!(out, "missing"),
        }
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
