---
source: tests/stages.rs
expression: reports.report(path)
input_file: tests/fixtures/format/layout_atom_that_fits_nowhere_in_a_call.rslisp
---
(def show-body
  (fn (body out)
    (choose (symbol? body)
            (show-symbol body out)
            (choose (construction? body)
                    (show-construction body out)
                    (report "a `show` body is one construction form or a symbol"
                            body
                            "write the call that builds the value, as in `(->money :cents 1200)`")))))

