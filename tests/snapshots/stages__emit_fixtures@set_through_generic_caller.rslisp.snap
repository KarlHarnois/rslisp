fn reset<A>(items: &mut [A], item: A) {
    items[0] = item
}

fn reset_outer<A>(items: &mut [A], item: A) {
    reset(items, item)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut years: Vec<i64> = vec![2011_i64, 2019_i64];
    reset_outer(&mut years, 2024);
    let mut makes = vec!["Nissan", "Honda"];
    reset_outer(&mut makes, "Toyota");
    println!("{} {}", years[0], makes[0])
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
