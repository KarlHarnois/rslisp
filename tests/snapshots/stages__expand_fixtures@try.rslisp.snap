(type parse-add (fn ((ref str) (ref str)) (result i64 (parse-error i64))))
(def parse-add (fn (left right) (local a (try (parse left))) (local b (try (parse right))) (result/ok (add a b))))
(def threaded (fn (text) (result/ok (try (parse text)))))
