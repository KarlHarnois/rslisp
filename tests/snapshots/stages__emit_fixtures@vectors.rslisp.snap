static PRIMES: std::sync::LazyLock<Vec<i64>> =
    std::sync::LazyLock::new(|| vec![2_i64, 3_i64, 5_i64, 7_i64]);

fn main() {
    let mut scores: Vec<i64> = Vec::new();
    scores.push(10);
    scores.push(20);
    println!("{}", scores.len());
    println!("{}", PRIMES.len());
    scores
        .iter()
        .copied()
        .for_each(|score: i64| println!("{}", score));
    PRIMES.iter().for_each(|prime: &i64| println!("{}", prime))
}
