#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Counter {
    value: i64,
}

fn make_counter(value: i64) -> Counter {
    Counter { value }
}

fn read_counter(c: Counter) -> i64 {
    c.value
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", make_counter(1).read_value())
}

trait Readable {
    fn read_value(&self) -> i64;
}

impl Readable for Counter {
    fn read_value(&self) -> i64 {
        read_counter(*self)
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
