fn twice(mut action: impl FnMut()) {
    action();
    action()
}

fn later(mut values: impl Iterator<Item = i64>) {
    twice(|| println!("{:?}", values.find(|value: &i64| *value > 5)))
}

fn main() {
    later(0_i64..10_i64)
}
