#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Depot {
    size: usize,
}

fn make_depot(size: usize) -> Depot {
    Depot { size }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let lot = make_depot(1);
    let models: Vec<&str> = vec!["Leaf", "Ariya"];
    println!("{}", lot.tally(models.iter().copied()));
    println!("{}", Counter::total(models.iter().copied(), &lot))
}

trait Counter {
    fn tally<'a>(&self, _: impl Iterator<Item = &'a str>) -> usize;
    fn total<'a>(_: impl Iterator<Item = &'a str>, _: &Self) -> usize;
}

impl Counter for Depot {
    fn tally<'a>(&self, names: impl Iterator<Item = &'a str>) -> usize {
        self.size + names.count()
    }
    fn total<'a>(names: impl Iterator<Item = &'a str>, lot: &Depot) -> usize {
        lot.size + names.count()
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
