#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Car<'a> {
    make: &'a str,
    models: Vec<&'a str>,
}

fn main() {
    let models = vec!["Leaf", "Ariya"];
    let nissan = Car {
        make: "Nissan",
        models,
    };
    nissan
        .models
        .iter()
        .for_each(|model: &&str| println!("{} {}", nissan.make, model))
}
