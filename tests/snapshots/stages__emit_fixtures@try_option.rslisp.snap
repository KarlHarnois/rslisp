fn first_even_double(numbers: Vec<i64>) -> Option<i64> {
    let found: i64 = numbers.iter().copied().find(|n: &i64| *n % 2 == 0)?;
    Some(found * 2)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", first_even_double(vec![1_i64, 2_i64, 3_i64]).unwrap());
    println!("{}", first_even_double(vec![1_i64, 3_i64, 5_i64]).is_none())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
