fn is_later(a: i64, b: i64) -> bool {
    a > b
}

fn is_any_later(years: &[i64], floor: i64) -> bool {
    years.iter().any(|y: &i64| is_later(*y, floor))
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let years: Vec<i64> = vec![2019_i64, 2021_i64, 2024_i64];
    println!("{}", is_any_later(&years, 2020));
    let r = &3_i64;
    println!("{}", is_later(*r, 2))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
