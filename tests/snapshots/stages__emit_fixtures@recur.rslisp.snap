fn count_down(mut n: i64, mut total: i64) -> i64 {
    loop {
        if n == 0 {
            return total;
        } else {
            (n, total) = (n - 1, total + 1);
            continue;
        }
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", count_down(1000000, 0));
    (1_i64..4_i64).for_each(|mut n: i64| {
        loop {
            if n > 100 {
                println!("{}", n);
                return;
            } else {
                n *= 2;
                continue;
            }
        }
    })
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
