input_file: tests/fixtures/emit/trait_self_collapsed_borrow.rslisp
---
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
struct SizedThing {
    size: i64,
}

fn make_sized_thing(size: i64) -> SizedThing {
    SizedThing { size }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let thing = make_sized_thing(1);
    let inner = &thing;
    let outer = &inner;
    let outermost = &outer;
    let number: i64 = 1;
    let number_view = &number;
    let number_outer = &number_view;
    println!("{}", Matcher::matches(1, *outer));
    println!("{}", Matcher::matches(2, **outermost));
    println!("{}", Matcher::matches_next(0, *outer));
    println!("{}", Matcher::held_by(*number_outer, inner));
    println!("{}", Matcher::deep_size(*outermost))
}

trait Matcher {
    type Item;
    fn matches(_: i64, _: &Self) -> bool;
    fn matches_next(argument_0: i64, argument_1: &Self) -> bool {
        Matcher::matches(argument_0 + 1, argument_1)
    }
    fn held_by(_: &Self::Item, _: &Self) -> bool;
    fn deep_size(_: &&Self) -> i64;
}

impl Matcher for SizedThing {
    type Item = i64;
    fn matches(n: i64, thing: &SizedThing) -> bool {
        n == thing.size
    }
    fn held_by(value: &i64, thing: &SizedThing) -> bool {
        *value == thing.size
    }
    fn deep_size(thing: &&SizedThing) -> i64 {
        thing.size
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
