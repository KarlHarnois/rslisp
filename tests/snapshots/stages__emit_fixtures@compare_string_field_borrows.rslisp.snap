#[derive(Clone, PartialEq, Eq, Hash)]
struct Car {
    model: String,
    year: i64,
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let model = "Leaf".to_string();
    let other = "Civic".to_string();
    let leaf = Car {
        model: "Leaf".to_string(),
        year: 2024,
    };
    let civic = Car {
        model: "Civic".to_string(),
        year: 2019,
    };
    println!("{}", leaf.model == model);
    println!("{}", model == leaf.model);
    println!("{}", leaf.model == civic.model);
    println!("{}", model == other);
    println!("{}", leaf.model != model);
    println!("{}", model != leaf.model);
    println!("{}", leaf.model != civic.model);
    println!("{}", model != other);
    println!("{}", leaf.model > model);
    println!("{}", model > leaf.model);
    println!("{}", leaf.model > civic.model);
    println!("{}", model > other)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
