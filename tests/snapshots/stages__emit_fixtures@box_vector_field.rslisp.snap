#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Car<'a> {
    models: Box<Vec<&'a str>>,
}

fn main() {
    let car = Car {
        models: Box::new(vec!["Leaf", "Ariya"]),
    };
    println!("{:?}", car.models)
}
