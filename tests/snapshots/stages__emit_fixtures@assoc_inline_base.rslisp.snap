#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Point {
    x: i64,
    y: i64,
}

fn make_point(x: i64, y: i64) -> Point {
    Point { x, y }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Line {
    start: Point,
    end: Point,
}

fn make_line(start: Point, end: Point) -> Line {
    Line { start, end }
}

#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Car<'a> {
    make: &'a str,
    model: String,
    year: u16,
}

fn make_car(make: &str, model: String, year: u16) -> Car<'_> {
    Car { make, model, year }
}

fn origin() -> Point {
    make_point(0, 0)
}

fn main() {
    let positional = Point {
        x: 3,
        ..make_point(1, 2)
    };
    println!("{}{}", positional.x, positional.y);
    let named = Point {
        x: 3,
        ..Point { x: 1, y: 2 }
    };
    println!("{}{}", named.x, named.y);
    let kernel = Point {
        x: 3,
        ..Point { x: 1, y: 2 }
    };
    println!("{}{}", kernel.x, kernel.y);
    let shifted = Point { y: 4, ..origin() };
    println!("{}{}", shifted.x, shifted.y);
    let nested = Line {
        start: Point {
            y: 9,
            ..make_point(0, 0)
        },
        ..make_line(make_point(1, 2), make_point(5, 6))
    };
    println!("{}{}", nested.start.y, nested.end.x);
    let leaf = Car {
        year: 2025,
        ..make_car("Nissan", "Leaf".to_string(), 2024)
    };
    println!("{} {} {}", leaf.make, leaf.model, leaf.year);
    let grid: Vec<Vec<i64>> = {
        let mut value = vec![vec![1_i64, 2_i64], vec![3_i64, 4_i64]];
        value[1][0] = 7;
        value
    };
    println!("{}", grid[1][0])
}
