source: tests/stages.rs
expression: reports.report(path)
input_file: tests/fixtures/emit/deref_item_borrows.rslisp
---
#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Car {
    make: String,
    year: u16,
}

fn make_car(make: String, year: u16) -> Car {
    Car { make, year }
}

fn is_later(year: i64) -> bool {
    year > 2020
}

fn report_signed(years: &[i64]) {
    println!("{}", years.iter().filter(|y: &&i64| **y > 2020).count())
}

fn report_years(years: &[i64], floor: &i64) {
    println!("{}", years.iter().filter(|y: &&i64| 2020 < **y).count());
    println!("{}", years.iter().filter(|y: &&i64| **y == 2021).count());
    println!("{}", years.iter().filter(|y: &&i64| *y > floor).count());
    println!("{}", years.iter().filter(|y: &&i64| **y + 1 > 2022).count());
    println!("{}", years.iter().filter(|y: &&i64| is_later(**y)).count());
    println!("{:?}", years.iter().max_by_key(|y: &&i64| **y - 2020))
}

fn report_cars(cars: &[Car], wanted: &Car) {
    println!("{}", cars.iter().filter(|c: &&Car| wanted == *c).count())
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let years: Vec<i64> = vec![2019_i64, 2021_i64, 2024_i64];
    report_signed(&years);
    report_years(&years, &2020);
    let leaf = make_car("Nissan".to_string(), 2024);
    let cars = vec![leaf.clone(), make_car("Honda".to_string(), 2019)];
    println!("{}", cars.iter().filter(|c: &&Car| leaf == **c).count());
    report_cars(&cars, &leaf)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
