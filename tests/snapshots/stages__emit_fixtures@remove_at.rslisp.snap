fn drop_first(items: &mut Vec<i64>) -> i64 {
    items.remove(0)
}

fn main() {
    let mut items: Vec<i64> = vec![1_i64, 2_i64, 3_i64];
    println!("{}", drop_first(&mut items));
    println!("{}", items.len())
}
