#[derive(Clone, Copy, Debug, PartialEq)]
struct Circle {
    radius: f64,
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let boxed = Box::new(Circle { radius: 1.0 }) as Box<dyn Shape>;
    let other: Box<dyn Shape> = Box::new(Circle { radius: 2.0 });
    println!("{}", boxed.area());
    println!("{}", other.area())
}

trait Shape {
    fn area(&self) -> f64;
}

impl Shape for Circle {
    fn area(&self) -> f64 {
        self.radius
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
