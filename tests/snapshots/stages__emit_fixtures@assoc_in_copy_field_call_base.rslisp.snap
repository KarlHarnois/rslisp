#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Point {
    x: i64,
    y: i64,
}

fn make_point(x: i64, y: i64) -> Point {
    Point { x, y }
}

#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Sticker {
    text: String,
    at: Point,
}

fn make_sticker(text: String, at: Point) -> Sticker {
    Sticker { text, at }
}

fn make_badge() -> Sticker {
    make_sticker("open".to_string(), make_point(0, 2))
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let moved = {
        let base = make_badge();
        Point { x: 4, ..base.at }
    };
    println!("{} {} {}", make_badge().text, moved.x, moved.y)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
