fn total<A: Copy + crate::rt::Number>(numbers: &[A]) -> A {
    crate::prelude::iterator::sum(numbers.iter().copied())
}

fn first_number<A>(numbers: &[A]) -> &A {
    &numbers[0]
}

fn count_pairs<A>(numbers: &[A]) -> usize {
    numbers.windows(2).count()
}

fn total_from<A: Copy + crate::rt::Number>(numbers: &[A], mut index: usize) -> A {
    loop {
        if index < numbers.len() {
            index += 1;
            continue;
        } else {
            return total(numbers);
        }
    }
}

fn main() {
    let numbers: Vec<i64> = vec![2_i64, 3_i64, 5_i64, 7_i64, 11_i64];
    println!("{}", total(&numbers));
    println!("{}", numbers[0]);
    println!("{}", first_number(&numbers));
    println!("{}", count_pairs(&numbers));
    println!("{}", total_from(&numbers, 0));
    let floats = vec![1.5_f64, 2.5_f64, 3.5_f64];
    println!("{}", first_number(&floats));
    println!("{}", count_pairs(&floats));
    println!("{}", total_from(&floats, 0))
}

mod prelude {

    pub(crate) mod iterator {
        pub fn sum<N: crate::rt::Number>(values: impl Iterator<Item = N>) -> N {
            values.fold(N::from_literal(0), |argument_0: N, argument_1: N| {
                argument_0 + argument_1
            })
        }
    }
}

mod rt {
    use std::ops::{Add, Div, Mul, Rem, Sub};

    pub trait Number:
        Copy
        + PartialOrd
        + Add<Output = Self>
        + Sub<Output = Self>
        + Mul<Output = Self>
        + Div<Output = Self>
        + Rem<Output = Self>
    {
        fn from_literal(value: i128) -> Self;
    }

    macro_rules! numbers {
        ($($number:ty),*) => {
            $(
                impl Number for $number {
                    fn from_literal(value: i128) -> Self {
                        value as Self
                    }
                }
            )*
        };
    }

    numbers!(
        i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, f32, f64
    );
}
