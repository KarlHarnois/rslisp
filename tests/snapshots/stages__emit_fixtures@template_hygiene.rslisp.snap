fn ordered(left: i64) {
    let mut numbers: Vec<i64> = vec![3_i64, 1_i64, 2_i64];
    numbers.sort_by(|left_2, right| (left + (*right - *left_2)).cmp(&0));
    println!("{}", numbers.first().unwrap())
}

fn sorted() {
    let mut numbers: Vec<i64> = vec![3_i64, 1_i64, 2_i64];
    numbers.sort_by(|left, right| (*right - *left).cmp(&0));
    println!("{}", numbers.first().unwrap())
}

fn main() {
    crate::rt::restore_default_sigpipe();
    ordered(-5);
    sorted()
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
