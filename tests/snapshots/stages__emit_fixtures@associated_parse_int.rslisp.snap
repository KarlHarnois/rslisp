fn read_count(text: &str) -> Result<i64, std::num::ParseIntError> {
    let count: Result<i64, std::num::ParseIntError> = text.parse::<i64>();
    count
}

fn main() {
    crate::rt::restore_default_sigpipe();
    match read_count("42") {
        Ok(count) => println!("count: {}", count),
        Err(reason) => println!("not a count: {}", reason),
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
