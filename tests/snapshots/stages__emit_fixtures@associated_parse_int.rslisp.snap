fn read_count(text: &str) -> Result<i64, std::num::ParseIntError> {
    let count: Result<i64, std::num::ParseIntError> = text.parse::<i64>();
    count
}

fn main() {
    match read_count("42") {
        Ok(count) => println!("count: {}", count),
        Err(reason) => println!("not a count: {}", reason),
    }
}
