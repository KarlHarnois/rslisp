#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Counter {
    count: i64,
}

fn reset(target: &mut Counter) {}

fn takes_number(number: i64) -> i64 {
    number
}

fn pass_borrowed(number: &i64) -> i64 {
    takes_number(*number)
}

fn call_twice(mut action: impl FnMut()) {
    action();
    action()
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut target = Counter { count: 1 };
    reset(&mut target);
    let five: i64 = 5;
    println!("{}", pass_borrowed(&five));
    let pick: fn(i64) -> i64 = takes_number;
    let nothing: () = ();
    call_twice(|| println!("{}", pick(1)));
    nothing
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
