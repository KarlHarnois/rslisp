---
fn change(items: &mut Vec<i64>) -> usize {
    items.push(1);
    items.len()
}

fn apply_one(f: impl FnOnce(Vec<i64>) -> usize, a: Vec<i64>) -> usize {
    f(a)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{}",
        apply_one(|mut argument: Vec<i64>| change(&mut argument), Vec::new())
    )
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
