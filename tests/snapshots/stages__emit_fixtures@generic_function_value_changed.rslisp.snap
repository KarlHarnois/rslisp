fn change(items: &mut Vec<i64>) -> usize {
    items.push(1);
    items.len()
}

fn apply_one(f: impl FnOnce(Vec<i64>) -> usize, a: Vec<i64>) -> usize {
    f(a)
}

fn main() {
    println!(
        "{}",
        apply_one(|mut argument: Vec<i64>| change(&mut argument), Vec::new())
    )
}
