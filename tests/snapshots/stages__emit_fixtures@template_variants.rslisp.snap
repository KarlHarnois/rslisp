---
source: tests/stages.rs
expression: "Fixture::load(path).emit_report()"
input_file: tests/fixtures/emit/template_variants.rslisp
---
enum AppError {
    Io(std::io::Error),
    Parse(std::num::ParseIntError),
}

fn half(text: &str) -> Result<i64, std::num::ParseIntError> {
    text.parse::<i64>()
}

fn read_number(text: &str) -> Result<i64, AppError> {
    Ok(text.parse::<i64>()?)
}

fn read_file(path: &str) -> Result<String, AppError> {
    let text = std::fs::read_to_string(path)?;
    Ok(text)
}

fn found(n: i64) -> Option<i64> {
    if n > 0 { Some(n) } else { None }
}

fn show(value: Option<i64>) {
    match value {
        Some(n) => println!("{}", n),
        None => println!("none"),
    }
}

fn choose() {
    let value: Result<i64, String> = Ok(1);
    let bad: Result<i64, String> = Err("bad".to_string());
    match value {
        Ok(n) => println!("{}", n),
        Err(e) => println!("{}", e),
    }
}

fn main() {
    println!("{}", half("2").unwrap());
    match read_number("3") {
        Ok(n) => println!("{}", n),
        Err(AppError::Parse(_reason)) => println!("not a number"),
        Err(AppError::Io(_reason)) => println!("cannot read"),
    }
    match read_file("missing.txt") {
        Ok(text) => println!("{}", text),
        Err(AppError::Io(_reason)) => println!("cannot read"),
        Err(AppError::Parse(_reason)) => println!("not a number"),
    }
    show(found(1));
    show(found(0));
    choose()
}

impl From<std::num::ParseIntError> for AppError {
    fn from(error: std::num::ParseIntError) -> Self {
        AppError::Parse(error)
    }
}

impl From<std::io::Error> for AppError {
    fn from(error: std::io::Error) -> Self {
        AppError::Io(error)
    }
}
