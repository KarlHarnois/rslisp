#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Point {
    x: i64,
}

fn main() {
    println!("{}", Point { x: 1 });
    println!("{}", Point { x: 0 })
}

impl std::fmt::Display for Point {
    fn fmt(&self, out: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        if self.x > 0 {
            write!(out, "positive {}", self.x)
        } else {
            write!(out, "not positive")
        }
    }
}
