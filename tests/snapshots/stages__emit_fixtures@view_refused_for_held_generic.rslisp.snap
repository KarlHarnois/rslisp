fn tagged<A: std::fmt::Display>(expected: &A, actual: A) -> String {
    format!("{}{}", expected, actual)
}

fn label(name: &String) -> String {
    tagged(name, "x".to_string())
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", label(&"y".to_string()))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
