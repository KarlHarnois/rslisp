fn first_even(numbers: Vec<i64>) -> Result<i64, String> {
    let found: Option<i64> = numbers.iter().copied().find(|n: &i64| *n % 2 == 0);
    found.ok_or("no even number".to_string())
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", first_even(vec![1_i64, 2_i64, 3_i64]).unwrap());
    println!("{}", first_even(vec![1_i64, 3_i64, 5_i64]).unwrap_err())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
