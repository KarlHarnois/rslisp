fn main() {
    crate::rt::restore_default_sigpipe();
    let mut numbers: Vec<i64> = vec![3_i64, 1_i64, 2_i64];
    numbers.sort_by(|left, right| right.cmp(left));
    println!("{}{}{}", numbers[0], numbers[1], numbers[2]);
    numbers.sort();
    println!("{}{}{}", numbers[0], numbers[1], numbers[2])
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
