#[derive(Clone, Debug, PartialEq, Eq, Hash)]
struct Person {
    name: String,
    age: i64,
}

fn make_person(name: String, age: i64) -> Person {
    Person { name, age }
}

static ORIGIN: std::sync::LazyLock<Vec<i64>> = std::sync::LazyLock::new(|| vec![1_i64, 2_i64]);

fn main() {
    crate::rt::restore_default_sigpipe();
    let ada = make_person("Ada".to_string(), 36);
    println!("{}", ada.name);
    println!("{}", ada.name.clone());
    println!("{}", ada.age);
    println!("{}", ORIGIN.len())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
