#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Alpha {
    score: i64,
}

fn make_alpha(score: i64) -> Alpha {
    Alpha { score }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut alphas = vec![make_alpha(1), make_alpha(2)];
    alphas.push(make_alpha(3));
    println!("{}", make_alpha(5).rank(&alphas))
}

trait Ranked {
    fn base(&self) -> i64;
    fn rank(&self, argument_1: &[Self]) -> i64
    where
        Self: Sized,
    {
        argument_1
            .iter()
            .fold(self.base(), |total: i64, other: &Self| total + other.base())
    }
}

impl Ranked for Alpha {
    fn base(&self) -> i64 {
        self.score
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
