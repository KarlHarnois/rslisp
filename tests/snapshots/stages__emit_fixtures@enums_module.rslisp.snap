fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{:?}", crate::enums_module::shape::Shape::Circle(1.0));
    println!("{:?}", crate::enums_module::shape::Shape::Rect(2.0, 3.0));
    println!(
        "{:?}",
        crate::enums_module::shape::Shape::Labeled {
            text: "box".to_string(),
            size: 2.0
        }
    );
    println!("{:?}", crate::enums_module::shape::Shape::Point)
}

mod enums_module {

    pub(crate) mod shape {
        #[derive(Clone, Debug, PartialEq)]
        pub enum Shape {
            Circle(f64),
            Rect(f64, f64),
            Labeled { text: String, size: f64 },
            Point,
        }
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
