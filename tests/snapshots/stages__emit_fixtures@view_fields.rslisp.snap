#[derive(Clone, Copy)]
struct Tag<'a> {
    name: &'a str,
    scores: &'a [i64],
}

fn make_tag<'a>(name: &'a str, scores: &'a [i64]) -> Tag<'a> {
    Tag { name, scores }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
enum Label<'a> {
    Named(&'a str),
    Blank,
}

fn describe(item: Label<'_>) -> &str {
    match item {
        Label::Named(text) => text,
        Label::Blank => "blank",
    }
}

fn main() {
    let numbers: Vec<i64> = vec![3_i64, 4_i64];
    let fruit = make_tag("fruit", &numbers);
    println!("{} {}", fruit.name, fruit.scores.len());
    println!(
        "{} {}",
        describe(Label::Named("apple")),
        describe(Label::Blank)
    )
}
