fn copy_into<A: Clone>(target: &mut A, source: &A) {
    target.clone_from(source)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut first = "Ana".to_string();
    let second = "Bo".to_string();
    copy_into(&mut first, &second);
    println!("{}", first);
    let mut left: Vec<i64> = vec![1_i64, 2_i64];
    let right: Vec<i64> = vec![3_i64, 4_i64];
    copy_into(&mut left, &right);
    println!("{}", left.len())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
