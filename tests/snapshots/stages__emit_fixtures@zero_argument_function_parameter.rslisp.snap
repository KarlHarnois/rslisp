#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Car<'a> {
    make: &'a str,
    year: u16,
}

fn measure<'a>(constructor: impl FnOnce() -> Car<'a>) -> u16 {
    constructor().year
}

fn measure_model_year<'a>(constructor: impl FnOnce(u16) -> Car<'a>) -> u16 {
    constructor(2025).year
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let make = "Nissan".to_string();
    println!(
        "{}",
        measure(|| Car {
            make: make.as_str(),
            year: 2024
        })
    );
    println!(
        "{}",
        measure_model_year(|year: u16| Car {
            make: make.as_str(),
            year
        })
    )
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
