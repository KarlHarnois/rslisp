expression: reports.report(path)
input_file: tests/fixtures/emit/function_parameter_through_local_closure.rslisp
---
fn record_twice(mut record: impl FnMut(i64), year: i64) {
    let mut step = |n: i64| record(n);
    step(year);
    step(year + 1)
}

fn record_once(record: impl FnOnce(i64), year: i64) {
    let step = |n: i64| record(n);
    step(year)
}

fn twice(mut action: impl FnMut(i64), year: i64) {
    action(year);
    action(year + 1)
}

fn record_through_twice(mut record: impl FnMut(i64), year: i64) {
    let step = |n: i64| record(n);
    twice(step, year)
}

fn record_in_loop(mut record: impl FnMut(i64), year: i64) {
    let mut step = |n: i64| record(n);
    let mut offset: i64 = 0;
    loop {
        if offset < 2 {
            step(year + offset);
            offset += 1;
            continue;
        } else {
            break;
        }
    }
}

fn record_nested(mut record: impl FnMut(i64), year: i64) {
    let mut step = |n: i64| record(n);
    let mut step_next = |n: i64| step(n + 1);
    step_next(year);
    step_next(year + 1)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut years: Vec<i64> = vec![2024_i64];
    record_twice(|year: i64| years.push(year), 2025);
    record_once(|year: i64| years.push(year), 2027);
    record_through_twice(|year: i64| years.push(year), 2028);
    record_in_loop(|year: i64| years.push(year), 2029);
    record_nested(|year: i64| years.push(year), 2031);
    println!("{}", years.len())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
