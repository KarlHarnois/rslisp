fn width(row: &[i64]) -> usize {
    row.len()
}

fn is_long(model: &str) -> bool {
    model.len() > 4
}

fn models() -> Vec<String> {
    vec!["Leaf".to_string(), "Ariya".to_string()]
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let grid: Vec<Vec<i64>> = vec![vec![1_i64, 2_i64], vec![3_i64, 4_i64, 5_i64]];
    println!(
        "{}",
        crate::prelude::iterator::sum(grid.iter().map(|argument: &Vec<i64>| width(argument)))
    );
    println!(
        "{}",
        models()
            .iter()
            .filter(|argument: &&String| is_long(argument))
            .count()
    )
}

mod prelude {

    pub(crate) mod iterator {
        pub fn sum<N: crate::rt::Number>(values: impl Iterator<Item = N>) -> N {
            values.fold(N::from_literal(0), |argument_0: N, argument_1: N| {
                argument_0 + argument_1
            })
        }
    }
}

mod rt {
    use std::ops::{Add, Div, Mul, Rem, Sub};

    pub trait Number:
        Copy
        + PartialOrd
        + Add<Output = Self>
        + Sub<Output = Self>
        + Mul<Output = Self>
        + Div<Output = Self>
        + Rem<Output = Self>
    {
        fn from_literal(value: i128) -> Self;
    }

    macro_rules! numbers {
        ($($number:ty),*) => {
            $(
                impl Number for $number {
                    fn from_literal(value: i128) -> Self {
                        value as Self
                    }
                }
            )*
        };
    }

    numbers!(
        i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, f32, f64
    );

    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
