#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Car<'a> {
    make: &'a str,
    year: i64,
}

fn make_car(make: &str, year: i64) -> Car<'_> {
    Car { make, year }
}

fn pick<'a>(a: &'a str, b: &'a str) -> Car<'a> {
    let first = |s: &'a str| s;
    make_car(if a.len() > b.len() { first(a) } else { b }, 2025)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", pick("Nissan", "Leaf").make)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
