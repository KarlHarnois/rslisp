#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
struct Car<'a> {
    make: &'a str,
    model: &'a str,
}

#[derive(Clone, Copy, Debug)]
enum Maker<'a> {
    Factory(fn() -> Car<'a>),
    Idle,
}

fn build_leaf() -> Car<'static> {
    Car {
        make: "Nissan",
        model: "Leaf",
    }
}

fn describe(plant: Maker<'_>) {
    match plant {
        Maker::Factory(make) => println!("{}", make().model),
        Maker::Idle => println!("idle"),
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    describe(Maker::Factory(build_leaf));
    describe(Maker::Idle)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
