(use evaluator/syntax expr statement)

(export execute)

(type execute (fn ((ref (vec statement))) (result (sorted-map string i64) string)))
(defn execute (statements)
  (execute-from statements 0 (sorted-map)))

(type execute-from (fn ((ref (vec statement)) usize (sorted-map string i64))
                       (result (sorted-map string i64) string)))
(defn execute-from (statements index names)
  (match (get statements index)
    ((some (binding name value))
     (do (let result (try (evaluate value (ref names))))
         (execute-from statements (+ index 1) (assoc names (clone name) result))))
    ((some (show value))
     (do (println (str "  " value " => " (try (evaluate value (ref names)))))
         (execute-from statements (+ index 1) names)))
    (none (ok names))))

(type evaluate (fn ((ref expr) (ref (sorted-map string i64))) (result i64 string)))
(defn evaluate (e names)
  (match e
    ((literal value) (ok (deref value)))
    ((variable name) (look-up names name))
    ((binary operator left right)
     (let-try ((left-value (evaluate left names))
               (right-value (evaluate right names)))
       (apply-operator operator left-value right-value)))
    ((negate inner) (ok (- 0 (try (evaluate inner names)))))
    ((choice test then otherwise)
     (if (= (try (evaluate test names)) 0)
         (evaluate otherwise names)
         (evaluate then names)))
    ((call function arguments)
     (do (let values (try (evaluate-all arguments names 0 (vec))))
         (apply-function function values)))))

(type look-up (fn ((ref (sorted-map string i64)) (ref string)) (result i64 string)))
(defn look-up (names name)
  (match (lookup names (as-str name))
    ((some value) (ok (deref value)))
    (none (err (str "unknown name `" name "`")))))

(type evaluate-all (fn ((ref (vec expr)) (ref (sorted-map string i64)) usize (vec i64))
                       (result (vec i64) string)))
(defn evaluate-all (arguments names index values)
  (match (get arguments index)
    ((some argument)
     (do (let value (try (evaluate argument names)))
         (let growing values)
         (push! growing value)
         (evaluate-all arguments names (+ index 1) growing)))
    (none (ok values))))

(type apply-operator (fn ((ref string) i64 i64) (result i64 string)))
(defn apply-operator (operator left right)
  (match (as-str operator)
    ("+" (ok (+ left right)))
    ("-" (ok (- left right)))
    ("*" (ok (* left right)))
    ("/" (if (= right 0) (err (to-string "division by zero")) (ok (/ left right))))
    ("%" (if (= right 0) (err (to-string "remainder by zero")) (ok (rem left right))))
    ("<" (ok (truth (< left right))))
    (">" (ok (truth (> left right))))
    ("<=" (ok (truth (<= left right))))
    (">=" (ok (truth (>= left right))))
    ("==" (ok (truth (= left right))))
    ("!=" (ok (truth (!= left right))))
    (_ (err (str "unknown operator `" operator "`")))))

(type apply-function (fn ((ref string) (vec i64)) (result i64 string)))
(defn apply-function (function numbers)
  (match (as-str function)
    ("max" (ok-or (max (values numbers)) (to-string "max needs an argument")))
    ("min" (ok-or (min (values numbers)) (to-string "min needs an argument")))
    ("sum" (ok (fold (iter numbers) 0 (fn (total value) (+ total (deref value))))))
    ("abs" (match (first numbers)
             ((some value) (ok (if (< (deref value) 0) (- 0 (deref value)) (deref value))))
             (none (err (to-string "abs needs an argument")))))
    (_ (err (str "unknown function `" function "`")))))

(defn truth (condition)
  (if condition 1 0))
