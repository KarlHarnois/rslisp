  (let total (+ total 1))
  (let total (+ total 2))
  (let total (+ total 3))
  (keep-port total))

(type checksum (fn ((ref (vec u8))) u32))
(defn checksum (bytes)
  (fold (iter bytes) 0 (fn (total byte) (+ total (widen (deref byte))))))

(def widen (rust "u32::from({0})" (fn (u8) u32)))

(defn packet ()
  (vec 0 7 14 21 28 35 42 49 56 63 70 77 84 91 98 105 112 119 126 133 140 147 154 161 168 175 182 189 196 203 210 217 224 231 238 245 2 9 16 23 30 37 44 51 58 65 72 79 86 93 100 107 114 121 128 135 142 149 156 163 170 177 184 191 198 205 212 219 226 233 240 247 4 11 18 25 32 39 46 53 60 67 74 81 88 95 102 109 116 123 130 137 144 151 158 165 172 179 186 193 200 207 214 221 228 235 242 249 6 13 20 27 34 41 48 55 62 69 76 83))
