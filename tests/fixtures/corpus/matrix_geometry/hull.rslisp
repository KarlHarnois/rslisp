(use matrix_geometry/shapes point cross)

(export convex-hull)

(type convex-hull (fn ((ref (vec point))) (vec point)))
(defn convex-hull (points)
  (let ordered (clone points))
  (sort! ordered compare-points)
  (let lower (chain-of (ref ordered)))
  (reverse! ordered)
  (let upper (chain-of (ref ordered)))
  (join-chains lower upper))

(type compare-points (fn ((ref point) (ref point)) i64))
(defn compare-points (left right)
  (cond ((< (:x left) (:x right)) -1)
        ((> (:x left) (:x right)) 1)
        ((< (:y left) (:y right)) -1)
        ((> (:y left) (:y right)) 1)
        (else 0)))

(type chain-of (fn ((ref (vec point))) (vec point)))
(defn chain-of (points)
  (fold (iter points) (vec) (fn (chain p) (push-turning chain (deref p)))))

(type push-turning (fn ((vec point) point) (vec point)))
(defn push-turning (chain p)
  (if (turns-clockwise? (ref chain) p)
      (do (let trimmed chain)
          (pop! trimmed)
          (push-turning trimmed p))
      (do (let growing chain)
          (push! growing p)
          growing)))

(type turns-clockwise? (fn ((ref (vec point)) point) bool))
(defn turns-clockwise? (chain p)
  (let count (len chain))
  (and (>= count 2)
       (<= (cross (at chain (- count 2)) (at chain (- count 1)) p) 0.0)))

(type join-chains (fn ((vec point) (vec point)) (vec point)))
(defn join-chains (lower upper)
  (let joined lower)
  (pop! joined)
  (let rest upper)
  (pop! rest)
  (for-each (iter rest) (fn (p) (push! joined (deref p))))
  joined)
