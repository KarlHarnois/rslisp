(trait measured
  (weight (fn ((ref self)) f64)))

(trait labeled
  (label (fn ((ref self)) string))
  (shout (fn ((ref self)) string) (upper-case (as-str (label self)))))

(trait (cargo (measured) (labeled))
  (fragile? (fn ((ref self)) bool)))

(defstruct (crate a) :name str :items (vec a))

(type crate-weight (where ((a measured)) (fn ((ref (crate a))) f64)))
(defn crate-weight (crate)
  (fold (iter (:items crate)) 0.0 (fn (total item) (+ total (weight item)))))

(type heaviest-label (where ((a cargo)) (fn ((ref (crate a))) string)))
(defn heaviest-label (crate)
  (match (max-by-key (iter (:items crate)) (fn (item) (whole-grams (weight item))))
    ((some item) (label item))
    (none (to-string "empty"))))

(type fragile-count (where ((a cargo)) (fn ((ref (crate a))) usize)))
(defn fragile-count (crate)
  (count (filter (iter (:items crate)) (fn (item) (fragile? item)))))

(type describe (where ((a cargo)) (fn ((ref (crate a))) string)))
(defn describe (crate)
  (str (:name crate) ": " (len (:items crate)) " items, " (crate-weight crate) " kg, "
       (fragile-count crate) " fragile, heaviest " (heaviest-label crate)))

(defn whole-grams (kilograms)
  (as-grams (* kilograms 1000.0)))

(def as-grams (rust "{0} as i64" (fn (f64) i64)))

(trait (summary (labeled))
  (headline (fn ((ref self)) string)))

(defstruct bold-lantern :serial u32 :mass f64 :sealed bool)

(impl measured bold-lantern
  (weight (item) (* (:mass item) 1.0)))

(impl labeled bold-lantern
  (label (item) (str "bold-lantern #" (:serial item))))

(impl cargo bold-lantern
  (fragile? (item) (and (:sealed item) (> (:mass item) 0.0))))

