(enum bold-lantern-group
  (bold-lantern bold-lantern)
  (swift-geyser swift-geyser)
  (swift-otter swift-otter)
  (rustic-falcon rustic-falcon))

(impl labeled bold-lantern-group
  (label (entry)
    (match entry
      ((bold-lantern-group/bold-lantern item) (label item))
      ((bold-lantern-group/swift-geyser item) (label item))
      ((bold-lantern-group/swift-otter item) (label item))
      ((bold-lantern-group/rustic-falcon item) (label item)))))

(impl summary bold-lantern-group
  (headline (entry) (str "group " (shout entry))))

