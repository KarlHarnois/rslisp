(use many_modules/layer_6_module_9 layer-6-module-9-score layer-6-module-9-reading)
(use many_modules/layer_5_module_2 layer-5-module-2-score layer-5-module-2-reading)
(use many_modules/layer_4_module_7 layer-4-module-7-score layer-4-module-7-reading)

(export layer-7-module-9-score layer-7-module-9-reading layer-7-module-9-label)

(defstruct layer-7-module-9-reading :site str :level i64 :weight f64)

(display layer-7-module-9-reading (reading) "layer-7-module-9 " (:site reading) "=" (:level reading))

(defn layer-7-module-9-label (n)
  (str (->layer-7-module-9-reading "layer-7-module-9" (layer-7-module-9-score n) 69.5)))

(defn layer-7-module-9-score (n)
  (rem (+ (layer-6-module-9-score (+ n 5)) (:level (layer-5-module-2-reading n)) (:level (layer-4-module-7-reading n))) 997))

(defn layer-7-module-9-reading (n)
  (->layer-7-module-9-reading "layer-7-module-9" (layer-7-module-9-score n) (* 0.5 69.0)))
