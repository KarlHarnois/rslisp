(use many_modules/layer_1_module_7 layer-1-module-7-score layer-1-module-7-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_4_module_3 layer-4-module-3-score layer-4-module-3-reading)

(export layer-7-module-9-score layer-7-module-9-reading layer-7-module-9-label)

(defstruct layer-7-module-9-reading :site str :level i64 :weight f64)

(display layer-7-module-9-reading (reading) "layer-7-module-9 " (:site reading) "=" (:level reading))

(defn layer-7-module-9-label (n)
  (str (->layer-7-module-9-reading "layer-7-module-9" (layer-7-module-9-score n) 68.5)))

(defn layer-7-module-9-score (n)
  (rem (if (> n 1000068) (:level (layer-4-module-3-reading n)) (if (> n 1000068) (:level (layer-1-module-3-reading n)) (layer-1-module-7-score (+ n 68)))) 997))

(defn layer-7-module-9-reading (n)
  (->layer-7-module-9-reading "layer-7-module-9" (layer-7-module-9-score n) (* 0.5 68.0)))
