(use many_modules/layer_2_module_8 layer-2-module-8-score layer-2-module-8-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)

(export layer-3-module-8-score layer-3-module-8-reading layer-3-module-8-label)

(defstruct layer-3-module-8-reading :site str :level i64 :weight f64)

(display layer-3-module-8-reading (reading) "layer-3-module-8 " (:site reading) "=" (:level reading))

(defn layer-3-module-8-label (n)
  (str (->layer-3-module-8-reading "layer-3-module-8" (layer-3-module-8-score n) 28.5)))

(defn layer-3-module-8-score (n)
  (rem (+ (layer-2-module-8-score (+ n 4)) (:level (layer-1-module-1-reading n)) (:level (layer-1-module-3-reading n))) 997))

(defn layer-3-module-8-reading (n)
  (->layer-3-module-8-reading "layer-3-module-8" (layer-3-module-8-score n) (* 0.5 28.0)))
