(use many_modules/layer_7_module_6 layer-7-module-6-reading
                                   layer-7-module-6-score)

(use many_modules/layer_3_module_7 layer-3-module-7-reading
                                   layer-3-module-7-score)

(use many_modules/layer_4_module_2 layer-4-module-2-reading
                                   layer-4-module-2-score)

(export layer-8-module-6-label layer-8-module-6-reading
        layer-8-module-6-score)

(defstruct layer-8-module-6-reading
  :site str
  :level i64
  :weight f64)

(display layer-8-module-6-reading (reading)
  "layer-8-module-6 "
  (:site reading)
  "="
  (:level reading))

(defn layer-8-module-6-label (n)
  (str (->layer-8-module-6-reading "layer-8-module-6"
                                   (layer-8-module-6-score n)
                                   76.5)))

(defn layer-8-module-6-score (n)
  (rem (+ (layer-7-module-6-score (+ n 2))
          (:level (layer-3-module-7-reading n))
          (:level (layer-4-module-2-reading n)))
       997))

(defn layer-8-module-6-reading (n)
  (->layer-8-module-6-reading "layer-8-module-6"
                              (layer-8-module-6-score n)
                              (* 0.5 76.0)))
