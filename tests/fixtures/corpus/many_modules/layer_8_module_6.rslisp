(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)
(use many_modules/layer_4_module_5 layer-4-module-5-score layer-4-module-5-reading)

(export layer-8-module-6-score layer-8-module-6-reading layer-8-module-6-label)

(defstruct layer-8-module-6-reading :site str :level i64 :weight f64)

(display layer-8-module-6-reading (reading) "layer-8-module-6 " (:site reading) "=" (:level reading))

(defn layer-8-module-6-label (n)
  (str (->layer-8-module-6-reading "layer-8-module-6" (layer-8-module-6-score n) 75.5)))

(defn layer-8-module-6-score (n)
  (rem (if (> n 1000075) (:level (layer-4-module-5-reading n)) (if (> n 1000075) (:level (layer-1-module-9-reading n)) (layer-1-module-3-score (+ n 75)))) 997))

(defn layer-8-module-6-reading (n)
  (->layer-8-module-6-reading "layer-8-module-6" (layer-8-module-6-score n) (* 0.5 75.0)))
