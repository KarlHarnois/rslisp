(use many_modules/wary_cedar wary-cedar-score wary-cedar-reading)
(use many_modules/dusky_pebble dusky-pebble-score dusky-pebble-reading)
(use many_modules/rustic_yarrow rustic-yarrow-score rustic-yarrow-reading)

(export lively-orchid-score lively-orchid-reading lively-orchid-label)

(defstruct lively-orchid-reading :site str :level i64 :weight f64)

(display lively-orchid-reading (reading) "lively-orchid " (:site reading) "=" (:level reading))

(defn lively-orchid-label (n)
  (str (->lively-orchid-reading "lively-orchid" (lively-orchid-score n) 63.5)))

(defn lively-orchid-score (n)
  (rem (if (> n 1000063) (:level (rustic-yarrow-reading n)) (if (> n 1000063) (:level (dusky-pebble-reading n)) (wary-cedar-score (+ n 63)))) 997))

(defn lively-orchid-reading (n)
  (->lively-orchid-reading "lively-orchid" (lively-orchid-score n) (* 0.5 63.0)))
