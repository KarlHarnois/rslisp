(use many_modules/layer_2_module_10 layer-2-module-10-score layer-2-module-10-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)
(use many_modules/layer_2_module_5 layer-2-module-5-score layer-2-module-5-reading)

(export layer-3-module-1-score layer-3-module-1-reading layer-3-module-1-label)

(defstruct layer-3-module-1-reading :site str :level i64 :weight f64)

(display layer-3-module-1-reading (reading) "layer-3-module-1 " (:site reading) "=" (:level reading))

(defn layer-3-module-1-label (n)
  (str (->layer-3-module-1-reading "layer-3-module-1" (layer-3-module-1-score n) 20.5)))

(defn layer-3-module-1-score (n)
  (rem (if (> n 1000020) (:level (layer-2-module-5-reading n)) (if (> n 1000020) (:level (layer-1-module-1-reading n)) (layer-2-module-10-score (+ n 20)))) 997))

(defn layer-3-module-1-reading (n)
  (->layer-3-module-1-reading "layer-3-module-1" (layer-3-module-1-score n) (* 0.5 20.0)))
