(use many_modules/layer_2_module_1 layer-2-module-1-score layer-2-module-1-reading)
(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)
(use many_modules/layer_2_module_10 layer-2-module-10-score layer-2-module-10-reading)

(export layer-3-module-1-score layer-3-module-1-reading layer-3-module-1-label)

(defstruct layer-3-module-1-reading :site str :level i64 :weight f64)

(display layer-3-module-1-reading (reading) "layer-3-module-1 " (:site reading) "=" (:level reading))

(defn layer-3-module-1-label (n)
  (str (->layer-3-module-1-reading "layer-3-module-1" (layer-3-module-1-score n) 21.5)))

(defn layer-3-module-1-score (n)
  (rem (+ (layer-2-module-1-score (+ n 2)) (:level (layer-1-module-2-reading n)) (:level (layer-2-module-10-reading n))) 997))

(defn layer-3-module-1-reading (n)
  (->layer-3-module-1-reading "layer-3-module-1" (layer-3-module-1-score n) (* 0.5 21.0)))
