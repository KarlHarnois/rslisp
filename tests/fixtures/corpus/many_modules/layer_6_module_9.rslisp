(use many_modules/layer_5_module_9 layer-5-module-9-score layer-5-module-9-reading)
(use many_modules/layer_3_module_7 layer-3-module-7-score layer-3-module-7-reading)
(use many_modules/layer_5_module_2 layer-5-module-2-score layer-5-module-2-reading)

(export layer-6-module-9-score layer-6-module-9-reading layer-6-module-9-label)

(defstruct layer-6-module-9-reading :site str :level i64 :weight f64)

(display layer-6-module-9-reading (reading) "layer-6-module-9 " (:site reading) "=" (:level reading))

(defn layer-6-module-9-label (n)
  (str (->layer-6-module-9-reading "layer-6-module-9" (layer-6-module-9-score n) 59.5)))

(defn layer-6-module-9-score (n)
  (rem (+ (layer-5-module-9-score (+ n 5)) (:level (layer-3-module-7-reading n)) (:level (layer-5-module-2-reading n))) 997))

(defn layer-6-module-9-reading (n)
  (->layer-6-module-9-reading "layer-6-module-9" (layer-6-module-9-score n) (* 0.5 59.0)))
