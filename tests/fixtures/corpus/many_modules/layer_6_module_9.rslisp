(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)
(use many_modules/layer_4_module_8 layer-4-module-8-score layer-4-module-8-reading)
(use many_modules/layer_4_module_1 layer-4-module-1-score layer-4-module-1-reading)

(export layer-6-module-9-score layer-6-module-9-reading layer-6-module-9-label)

(defstruct layer-6-module-9-reading :site str :level i64 :weight f64)

(display layer-6-module-9-reading (reading) "layer-6-module-9 " (:site reading) "=" (:level reading))

(defn layer-6-module-9-label (n)
  (str (->layer-6-module-9-reading "layer-6-module-9" (layer-6-module-9-score n) 58.5)))

(defn layer-6-module-9-score (n)
  (rem (if (> n 1000058) (:level (layer-4-module-1-reading n)) (if (> n 1000058) (:level (layer-4-module-8-reading n)) (layer-1-module-9-score (+ n 58)))) 997))

(defn layer-6-module-9-reading (n)
  (->layer-6-module-9-reading "layer-6-module-9" (layer-6-module-9-score n) (* 0.5 58.0)))
