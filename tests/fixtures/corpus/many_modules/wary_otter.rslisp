(use many_modules/mellow_lagoon mellow-lagoon-score mellow-lagoon-reading)
(use many_modules/olive_meadow olive-meadow-score olive-meadow-reading)
(use many_modules/witty_meadow witty-meadow-score witty-meadow-reading)

(export wary-otter-score wary-otter-reading wary-otter-label)

(defstruct wary-otter-reading :site str :level i64 :weight f64)

(display wary-otter-reading (reading) "wary-otter " (:site reading) "=" (:level reading))

(defn wary-otter-label (n)
  (str (->wary-otter-reading "wary-otter" (wary-otter-score n) 79.5)))

(defn wary-otter-score (n)
  (rem (if (> n 1000079) (:level (witty-meadow-reading n)) (if (> n 1000079) (:level (olive-meadow-reading n)) (mellow-lagoon-score (+ n 79)))) 997))

(defn wary-otter-reading (n)
  (->wary-otter-reading "wary-otter" (wary-otter-score n) (* 0.5 79.0)))
