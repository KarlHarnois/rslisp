(export layer-1-module-5-label layer-1-module-5-reading
        layer-1-module-5-score)

(defstruct layer-1-module-5-reading
  :site str
  :level i64
  :weight f64)

(display layer-1-module-5-reading (reading)
  "layer-1-module-5 "
  (:site reading)
  "="
  (:level reading))

(defn layer-1-module-5-label (n)
  (str (->layer-1-module-5-reading "layer-1-module-5"
                                   (layer-1-module-5-score n)
                                   5.5)))

(defn layer-1-module-5-score (n)
  (rem (+ (* n 7) 8) 997))

(defn layer-1-module-5-reading (n)
  (->layer-1-module-5-reading "layer-1-module-5"
                              (layer-1-module-5-score n)
                              (* 0.5 5.0)))
