(use many_modules/layer_6_module_1 layer-6-module-1-score layer-6-module-1-reading)
(use many_modules/layer_4_module_3 layer-4-module-3-score layer-4-module-3-reading)
(use many_modules/layer_6_module_4 layer-6-module-4-score layer-6-module-4-reading)

(export layer-8-module-1-score layer-8-module-1-reading layer-8-module-1-label)

(defstruct layer-8-module-1-reading :site str :level i64 :weight f64)

(display layer-8-module-1-reading (reading) "layer-8-module-1 " (:site reading) "=" (:level reading))

(defn layer-8-module-1-label (n)
  (str (->layer-8-module-1-reading "layer-8-module-1" (layer-8-module-1-score n) 70.5)))

(defn layer-8-module-1-score (n)
  (rem (if (> n 1000070) (:level (layer-6-module-4-reading n)) (if (> n 1000070) (:level (layer-4-module-3-reading n)) (layer-6-module-1-score (+ n 70)))) 997))

(defn layer-8-module-1-reading (n)
  (->layer-8-module-1-reading "layer-8-module-1" (layer-8-module-1-score n) (* 0.5 70.0)))
