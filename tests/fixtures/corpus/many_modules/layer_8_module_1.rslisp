(use many_modules/layer_7_module_1 layer-7-module-1-reading
                                   layer-7-module-1-score)

(use many_modules/layer_2_module_9 layer-2-module-9-reading
                                   layer-2-module-9-score)

(use many_modules/layer_3_module_8 layer-3-module-8-reading
                                   layer-3-module-8-score)

(export layer-8-module-1-label layer-8-module-1-reading
        layer-8-module-1-score)

(defstruct layer-8-module-1-reading
  :site str
  :level i64
  :weight f64)

(display layer-8-module-1-reading (reading)
  "layer-8-module-1 "
  (:site reading)
  "="
  (:level reading))

(defn layer-8-module-1-label (n)
  (str (->layer-8-module-1-reading "layer-8-module-1"
                                   (layer-8-module-1-score n)
                                   71.5)))

(defn layer-8-module-1-score (n)
  (rem (+ (layer-7-module-1-score (+ n 2))
          (:level (layer-2-module-9-reading n))
          (:level (layer-3-module-8-reading n)))
       997))

(defn layer-8-module-1-reading (n)
  (->layer-8-module-1-reading "layer-8-module-1"
                              (layer-8-module-1-score n)
                              (* 0.5 71.0)))
