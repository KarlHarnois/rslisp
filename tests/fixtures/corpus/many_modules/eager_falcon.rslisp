(use many_modules/fierce_falcon fierce-falcon-score fierce-falcon-reading)
(use many_modules/olive_meadow olive-meadow-score olive-meadow-reading)
(use many_modules/stark_falcon stark-falcon-score stark-falcon-reading)

(export eager-falcon-score eager-falcon-reading eager-falcon-label)

(defstruct eager-falcon-reading :site str :level i64 :weight f64)

(display eager-falcon-reading (reading) "eager-falcon " (:site reading) "=" (:level reading))

(defn eager-falcon-label (n)
  (str (->eager-falcon-reading "eager-falcon" (eager-falcon-score n) 45.5)))

(defn eager-falcon-score (n)
  (rem (if (> n 1000045) (:level (stark-falcon-reading n)) (if (> n 1000045) (:level (olive-meadow-reading n)) (fierce-falcon-score (+ n 45)))) 997))

(defn eager-falcon-reading (n)
  (->eager-falcon-reading "eager-falcon" (eager-falcon-score n) (* 0.5 45.0)))
