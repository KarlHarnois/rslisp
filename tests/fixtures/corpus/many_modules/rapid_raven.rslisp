(use many_modules/swift_tundra swift-tundra-score swift-tundra-reading)
(use many_modules/jolly_thistle jolly-thistle-score jolly-thistle-reading)
(use many_modules/mellow_island mellow-island-score mellow-island-reading)

(export rapid-raven-score rapid-raven-reading rapid-raven-label)

(defstruct rapid-raven-reading :site str :level i64 :weight f64)

(display rapid-raven-reading (reading) "rapid-raven " (:site reading) "=" (:level reading))

(defn rapid-raven-label (n)
  (str (->rapid-raven-reading "rapid-raven" (rapid-raven-score n) 76.5)))

(defn rapid-raven-score (n)
  (rem (if (> n 1000076) (:level (mellow-island-reading n)) (if (> n 1000076) (:level (jolly-thistle-reading n)) (swift-tundra-score (+ n 76)))) 997))

(defn rapid-raven-reading (n)
  (->rapid-raven-reading "rapid-raven" (rapid-raven-score n) (* 0.5 76.0)))
