(use many_modules/tender_bison tender-bison-score tender-bison-reading)
(use many_modules/wary_otter wary-otter-score wary-otter-reading)
(use many_modules/rapid_willow rapid-willow-score rapid-willow-reading)

(export witty-quarry-score witty-quarry-reading witty-quarry-label)

(defstruct witty-quarry-reading :site str :level i64 :weight f64)

(display witty-quarry-reading (reading) "witty-quarry " (:site reading) "=" (:level reading))

(defn witty-quarry-label (n)
  (str (->witty-quarry-reading "witty-quarry" (witty-quarry-score n) 114.5)))

(defn witty-quarry-score (n)
  (rem (if (> n 1000114) (:level (rapid-willow-reading n)) (if (> n 1000114) (:level (wary-otter-reading n)) (tender-bison-score (+ n 114)))) 997))

(defn witty-quarry-reading (n)
  (->witty-quarry-reading "witty-quarry" (witty-quarry-score n) (* 0.5 114.0)))
