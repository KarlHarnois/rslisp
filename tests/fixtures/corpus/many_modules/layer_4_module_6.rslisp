(use many_modules/layer_3_module_6 layer-3-module-6-score layer-3-module-6-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_2_module_9 layer-2-module-9-score layer-2-module-9-reading)

(export layer-4-module-6-score layer-4-module-6-reading layer-4-module-6-label)

(defstruct layer-4-module-6-reading :site str :level i64 :weight f64)

(display layer-4-module-6-reading (reading) "layer-4-module-6 " (:site reading) "=" (:level reading))

(defn layer-4-module-6-label (n)
  (str (->layer-4-module-6-reading "layer-4-module-6" (layer-4-module-6-score n) 36.5)))

(defn layer-4-module-6-score (n)
  (rem (+ (layer-3-module-6-score (+ n 2)) (:level (layer-1-module-3-reading n)) (:level (layer-2-module-9-reading n))) 997))

(defn layer-4-module-6-reading (n)
  (->layer-4-module-6-reading "layer-4-module-6" (layer-4-module-6-score n) (* 0.5 36.0)))
