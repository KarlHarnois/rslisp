(use many_modules/layer_8_module_6 layer-8-module-6-reading
                                   layer-8-module-6-score)

(use many_modules/layer_5_module_10 layer-5-module-10-reading
                                    layer-5-module-10-score)

(use many_modules/layer_7_module_2 layer-7-module-2-reading
                                   layer-7-module-2-score)

(export layer-9-module-6-label layer-9-module-6-reading
        layer-9-module-6-score)

(defstruct layer-9-module-6-reading
  :site str
  :level i64
  :weight f64)

(display layer-9-module-6-reading (reading)
  "layer-9-module-6 "
  (:site reading)
  "="
  (:level reading))

(defn layer-9-module-6-label (n)
  (str (->layer-9-module-6-reading "layer-9-module-6"
                                   (layer-9-module-6-score n)
                                   86.5)))

(defn layer-9-module-6-score (n)
  (rem (+ (layer-8-module-6-score (+ n 2))
          (:level (layer-5-module-10-reading n))
          (:level (layer-7-module-2-reading n)))
       997))

(defn layer-9-module-6-reading (n)
  (->layer-9-module-6-reading "layer-9-module-6"
                              (layer-9-module-6-score n)
                              (* 0.5 86.0)))
