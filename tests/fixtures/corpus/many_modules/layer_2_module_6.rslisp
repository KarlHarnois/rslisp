(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)

(export layer-2-module-6-score layer-2-module-6-reading layer-2-module-6-label)

(defstruct layer-2-module-6-reading :site str :level i64 :weight f64)

(display layer-2-module-6-reading (reading) "layer-2-module-6 " (:site reading) "=" (:level reading))

(defn layer-2-module-6-label (n)
  (str (->layer-2-module-6-reading "layer-2-module-6" (layer-2-module-6-score n) 15.5)))

(defn layer-2-module-6-score (n)
  (rem (if (> n 1000015) (:level (layer-1-module-1-reading n)) (if (> n 1000015) (:level (layer-1-module-9-reading n)) (layer-1-module-2-score (+ n 15)))) 997))

(defn layer-2-module-6-reading (n)
  (->layer-2-module-6-reading "layer-2-module-6" (layer-2-module-6-score n) (* 0.5 15.0)))
