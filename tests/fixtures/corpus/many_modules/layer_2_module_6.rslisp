(use many_modules/layer_1_module_6 layer-1-module-6-score layer-1-module-6-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)

(export layer-2-module-6-score layer-2-module-6-reading layer-2-module-6-label)

(defstruct layer-2-module-6-reading :site str :level i64 :weight f64)

(display layer-2-module-6-reading (reading) "layer-2-module-6 " (:site reading) "=" (:level reading))

(defn layer-2-module-6-label (n)
  (str (->layer-2-module-6-reading "layer-2-module-6" (layer-2-module-6-score n) 16.5)))

(defn layer-2-module-6-score (n)
  (rem (+ (layer-1-module-6-score (+ n 2)) (:level (layer-1-module-3-reading n)) (:level (layer-1-module-2-reading n))) 997))

(defn layer-2-module-6-reading (n)
  (->layer-2-module-6-reading "layer-2-module-6" (layer-2-module-6-score n) (* 0.5 16.0)))
