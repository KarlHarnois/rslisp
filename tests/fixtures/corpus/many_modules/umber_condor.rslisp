(use many_modules/zesty_delta zesty-delta-score zesty-delta-reading)
(use many_modules/noble_tundra noble-tundra-score noble-tundra-reading)
(use many_modules/misty_heron misty-heron-score misty-heron-reading)

(export umber-condor-score umber-condor-reading umber-condor-label)

(defstruct umber-condor-reading :site str :level i64 :weight f64)

(display umber-condor-reading (reading) "umber-condor " (:site reading) "=" (:level reading))

(defn umber-condor-label (n)
  (str (->umber-condor-reading "umber-condor" (umber-condor-score n) 40.5)))

(defn umber-condor-score (n)
  (rem (if (> n 1000040) (:level (misty-heron-reading n)) (if (> n 1000040) (:level (noble-tundra-reading n)) (zesty-delta-score (+ n 40)))) 997))

(defn umber-condor-reading (n)
  (->umber-condor-reading "umber-condor" (umber-condor-score n) (* 0.5 40.0)))
