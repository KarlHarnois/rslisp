(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)
(use many_modules/rustic_falcon rustic-falcon-score rustic-falcon-reading)
(use many_modules/swift_geyser swift-geyser-score swift-geyser-reading)

(export olive-meadow-score olive-meadow-reading olive-meadow-label)

(defstruct olive-meadow-reading :site str :level i64 :weight f64)

(display olive-meadow-reading (reading) "olive-meadow " (:site reading) "=" (:level reading))

(defn olive-meadow-label (n)
  (str (->olive-meadow-reading "olive-meadow" (olive-meadow-score n) 5.5)))

(defn olive-meadow-score (n)
  (rem (if (> n 1000005) (:level (swift-geyser-reading n)) (if (> n 1000005) (:level (rustic-falcon-reading n)) (bold-lantern-score (+ n 5)))) 997))

(defn olive-meadow-reading (n)
  (->olive-meadow-reading "olive-meadow" (olive-meadow-score n) (* 0.5 5.0)))
