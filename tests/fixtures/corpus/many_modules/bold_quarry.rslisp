(use many_modules/rustic_tundra rustic-tundra-score rustic-tundra-reading)
(use many_modules/vivid_lantern vivid-lantern-score vivid-lantern-reading)
(use many_modules/tawny_island tawny-island-score tawny-island-reading)

(export bold-quarry-score bold-quarry-reading bold-quarry-label)

(defstruct bold-quarry-reading :site str :level i64 :weight f64)

(display bold-quarry-reading (reading) "bold-quarry " (:site reading) "=" (:level reading))

(defn bold-quarry-label (n)
  (str (->bold-quarry-reading "bold-quarry" (bold-quarry-score n) 115.5)))

(defn bold-quarry-score (n)
  (rem (if (> n 1000115) (:level (tawny-island-reading n)) (if (> n 1000115) (:level (vivid-lantern-reading n)) (rustic-tundra-score (+ n 115)))) 997))

(defn bold-quarry-reading (n)
  (->bold-quarry-reading "bold-quarry" (bold-quarry-score n) (* 0.5 115.0)))
