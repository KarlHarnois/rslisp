(use many_modules/layer_1_module_7 layer-1-module-7-score layer-1-module-7-reading)
(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)

(export layer-2-module-7-score layer-2-module-7-reading layer-2-module-7-label)

(defstruct layer-2-module-7-reading :site str :level i64 :weight f64)

(display layer-2-module-7-reading (reading) "layer-2-module-7 " (:site reading) "=" (:level reading))

(defn layer-2-module-7-label (n)
  (str (->layer-2-module-7-reading "layer-2-module-7" (layer-2-module-7-score n) 17.5)))

(defn layer-2-module-7-score (n)
  (rem (+ (layer-1-module-7-score (+ n 3)) (:level (layer-1-module-10-reading n)) (:level (layer-1-module-1-reading n))) 997))

(defn layer-2-module-7-reading (n)
  (->layer-2-module-7-reading "layer-2-module-7" (layer-2-module-7-score n) (* 0.5 17.0)))
