(use many_modules/layer_6_module_6 layer-6-module-6-score layer-6-module-6-reading)
(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)
(use many_modules/layer_2_module_4 layer-2-module-4-score layer-2-module-4-reading)

(export layer-7-module-6-score layer-7-module-6-reading layer-7-module-6-label)

(defstruct layer-7-module-6-reading :site str :level i64 :weight f64)

(display layer-7-module-6-reading (reading) "layer-7-module-6 " (:site reading) "=" (:level reading))

(defn layer-7-module-6-label (n)
  (str (->layer-7-module-6-reading "layer-7-module-6" (layer-7-module-6-score n) 66.5)))

(defn layer-7-module-6-score (n)
  (rem (+ (layer-6-module-6-score (+ n 2)) (:level (layer-1-module-2-reading n)) (:level (layer-2-module-4-reading n))) 997))

(defn layer-7-module-6-reading (n)
  (->layer-7-module-6-reading "layer-7-module-6" (layer-7-module-6-score n) (* 0.5 66.0)))
