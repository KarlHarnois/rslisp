(use many_modules/layer_11_module_9 layer-11-module-9-score layer-11-module-9-reading)
(use many_modules/layer_8_module_7 layer-8-module-7-score layer-8-module-7-reading)
(use many_modules/layer_9_module_2 layer-9-module-2-score layer-9-module-2-reading)

(export layer-12-module-9-score layer-12-module-9-reading layer-12-module-9-label)

(defstruct layer-12-module-9-reading :site str :level i64 :weight f64)

(display layer-12-module-9-reading (reading) "layer-12-module-9 " (:site reading) "=" (:level reading))

(defn layer-12-module-9-label (n)
  (str (->layer-12-module-9-reading "layer-12-module-9" (layer-12-module-9-score n) 119.5)))

(defn layer-12-module-9-score (n)
  (rem (+ (layer-11-module-9-score (+ n 5)) (:level (layer-8-module-7-reading n)) (:level (layer-9-module-2-reading n))) 997))

(defn layer-12-module-9-reading (n)
  (->layer-12-module-9-reading "layer-12-module-9" (layer-12-module-9-score n) (* 0.5 119.0)))
