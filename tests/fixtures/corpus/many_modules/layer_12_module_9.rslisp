(use many_modules/layer_11_module_8 layer-11-module-8-score layer-11-module-8-reading)
(use many_modules/layer_11_module_9 layer-11-module-9-score layer-11-module-9-reading)
(use many_modules/layer_1_module_6 layer-1-module-6-score layer-1-module-6-reading)

(export layer-12-module-9-score layer-12-module-9-reading layer-12-module-9-label)

(defstruct layer-12-module-9-reading :site str :level i64 :weight f64)

(display layer-12-module-9-reading (reading) "layer-12-module-9 " (:site reading) "=" (:level reading))

(defn layer-12-module-9-label (n)
  (str (->layer-12-module-9-reading "layer-12-module-9" (layer-12-module-9-score n) 118.5)))

(defn layer-12-module-9-score (n)
  (rem (if (> n 1000118) (:level (layer-1-module-6-reading n)) (if (> n 1000118) (:level (layer-11-module-9-reading n)) (layer-11-module-8-score (+ n 118)))) 997))

(defn layer-12-module-9-reading (n)
  (->layer-12-module-9-reading "layer-12-module-9" (layer-12-module-9-score n) (* 0.5 118.0)))
