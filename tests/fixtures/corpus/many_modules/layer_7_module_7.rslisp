(use many_modules/layer_6_module_7 layer-6-module-7-score layer-6-module-7-reading)
(use many_modules/layer_4_module_1 layer-4-module-1-score layer-4-module-1-reading)
(use many_modules/layer_4_module_9 layer-4-module-9-score layer-4-module-9-reading)

(export layer-7-module-7-score layer-7-module-7-reading layer-7-module-7-label)

(defstruct layer-7-module-7-reading :site str :level i64 :weight f64)

(display layer-7-module-7-reading (reading) "layer-7-module-7 " (:site reading) "=" (:level reading))

(defn layer-7-module-7-label (n)
  (str (->layer-7-module-7-reading "layer-7-module-7" (layer-7-module-7-score n) 66.5)))

(defn layer-7-module-7-score (n)
  (rem (if (> n 1000066) (:level (layer-4-module-9-reading n)) (if (> n 1000066) (:level (layer-4-module-1-reading n)) (layer-6-module-7-score (+ n 66)))) 997))

(defn layer-7-module-7-reading (n)
  (->layer-7-module-7-reading "layer-7-module-7" (layer-7-module-7-score n) (* 0.5 66.0)))
