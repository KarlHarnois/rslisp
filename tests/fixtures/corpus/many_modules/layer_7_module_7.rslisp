(use many_modules/layer_6_module_7 layer-6-module-7-score layer-6-module-7-reading)
(use many_modules/layer_2_module_2 layer-2-module-2-score layer-2-module-2-reading)
(use many_modules/layer_3_module_6 layer-3-module-6-score layer-3-module-6-reading)

(export layer-7-module-7-score layer-7-module-7-reading layer-7-module-7-label)

(defstruct layer-7-module-7-reading :site str :level i64 :weight f64)

(display layer-7-module-7-reading (reading) "layer-7-module-7 " (:site reading) "=" (:level reading))

(defn layer-7-module-7-label (n)
  (str (->layer-7-module-7-reading "layer-7-module-7" (layer-7-module-7-score n) 67.5)))

(defn layer-7-module-7-score (n)
  (rem (+ (layer-6-module-7-score (+ n 3)) (:level (layer-2-module-2-reading n)) (:level (layer-3-module-6-reading n))) 997))

(defn layer-7-module-7-reading (n)
  (->layer-7-module-7-reading "layer-7-module-7" (layer-7-module-7-score n) (* 0.5 67.0)))
