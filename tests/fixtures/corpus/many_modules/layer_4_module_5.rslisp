(use many_modules/layer_3_module_5 layer-3-module-5-reading
                                   layer-3-module-5-score)

(use many_modules/layer_1_module_10 layer-1-module-10-reading
                                    layer-1-module-10-score)

(use many_modules/layer_1_module_1 layer-1-module-1-reading
                                   layer-1-module-1-score)

(export layer-4-module-5-label layer-4-module-5-reading
        layer-4-module-5-score)

(defstruct layer-4-module-5-reading
  :site str
  :level i64
  :weight f64)

(display layer-4-module-5-reading (reading)
  "layer-4-module-5 "
  (:site reading)
  "="
  (:level reading))

(defn layer-4-module-5-label (n)
  (str (->layer-4-module-5-reading "layer-4-module-5"
                                   (layer-4-module-5-score n)
                                   35.5)))

(defn layer-4-module-5-score (n)
  (rem (+ (layer-3-module-5-score (+ n 1))
          (:level (layer-1-module-10-reading n))
          (:level (layer-1-module-1-reading n)))
       997))

(defn layer-4-module-5-reading (n)
  (->layer-4-module-5-reading "layer-4-module-5"
                              (layer-4-module-5-score n)
                              (* 0.5 35.0)))
