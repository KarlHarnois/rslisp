(use many_modules/layer_2_module_3 layer-2-module-3-score layer-2-module-3-reading)
(use many_modules/layer_2_module_4 layer-2-module-4-score layer-2-module-4-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)

(export layer-4-module-5-score layer-4-module-5-reading layer-4-module-5-label)

(defstruct layer-4-module-5-reading :site str :level i64 :weight f64)

(display layer-4-module-5-reading (reading) "layer-4-module-5 " (:site reading) "=" (:level reading))

(defn layer-4-module-5-label (n)
  (str (->layer-4-module-5-reading "layer-4-module-5" (layer-4-module-5-score n) 34.5)))

(defn layer-4-module-5-score (n)
  (rem (if (> n 1000034) (:level (layer-1-module-3-reading n)) (if (> n 1000034) (:level (layer-2-module-4-reading n)) (layer-2-module-3-score (+ n 34)))) 997))

(defn layer-4-module-5-reading (n)
  (->layer-4-module-5-reading "layer-4-module-5" (layer-4-module-5-score n) (* 0.5 34.0)))
