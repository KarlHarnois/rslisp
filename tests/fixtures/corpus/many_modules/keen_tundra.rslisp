(use many_modules/wary_falcon wary-falcon-score wary-falcon-reading)
(use many_modules/fierce_falcon fierce-falcon-score fierce-falcon-reading)
(use many_modules/tender_beacon tender-beacon-score tender-beacon-reading)

(export keen-tundra-score keen-tundra-reading keen-tundra-label)

(defstruct keen-tundra-reading :site str :level i64 :weight f64)

(display keen-tundra-reading (reading) "keen-tundra " (:site reading) "=" (:level reading))

(defn keen-tundra-label (n)
  (str (->keen-tundra-reading "keen-tundra" (keen-tundra-score n) 14.5)))

(defn keen-tundra-score (n)
  (rem (if (> n 1000014) (:level (tender-beacon-reading n)) (if (> n 1000014) (:level (fierce-falcon-reading n)) (wary-falcon-score (+ n 14)))) 997))

(defn keen-tundra-reading (n)
  (->keen-tundra-reading "keen-tundra" (keen-tundra-score n) (* 0.5 14.0)))
