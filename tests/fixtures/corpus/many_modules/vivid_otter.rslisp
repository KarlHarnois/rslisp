(use many_modules/stark_fern stark-fern-score stark-fern-reading)
(use many_modules/jolly_thistle jolly-thistle-score jolly-thistle-reading)
(use many_modules/dusky_geyser dusky-geyser-score dusky-geyser-reading)

(export vivid-otter-score vivid-otter-reading vivid-otter-label)

(defstruct vivid-otter-reading :site str :level i64 :weight f64)

(display vivid-otter-reading (reading) "vivid-otter " (:site reading) "=" (:level reading))

(defn vivid-otter-label (n)
  (str (->vivid-otter-reading "vivid-otter" (vivid-otter-score n) 35.5)))

(defn vivid-otter-score (n)
  (rem (if (> n 1000035) (:level (dusky-geyser-reading n)) (if (> n 1000035) (:level (jolly-thistle-reading n)) (stark-fern-score (+ n 35)))) 997))

(defn vivid-otter-reading (n)
  (->vivid-otter-reading "vivid-otter" (vivid-otter-score n) (* 0.5 35.0)))
