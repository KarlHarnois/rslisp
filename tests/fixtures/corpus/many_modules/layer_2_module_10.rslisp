(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)
(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)

(export layer-2-module-10-score layer-2-module-10-reading layer-2-module-10-label)

(defstruct layer-2-module-10-reading :site str :level i64 :weight f64)

(display layer-2-module-10-reading (reading) "layer-2-module-10 " (:site reading) "=" (:level reading))

(defn layer-2-module-10-label (n)
  (str (->layer-2-module-10-reading "layer-2-module-10" (layer-2-module-10-score n) 20.5)))

(defn layer-2-module-10-score (n)
  (rem (+ (layer-1-module-10-score (+ n 1)) (:level (layer-1-module-9-reading n)) (:level (layer-1-module-2-reading n))) 997))

(defn layer-2-module-10-reading (n)
  (->layer-2-module-10-reading "layer-2-module-10" (layer-2-module-10-score n) (* 0.5 20.0)))
