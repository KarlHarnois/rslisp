(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)
(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)

(export layer-2-module-10-score layer-2-module-10-reading layer-2-module-10-label)

(defstruct layer-2-module-10-reading :site str :level i64 :weight f64)

(display layer-2-module-10-reading (reading) "layer-2-module-10 " (:site reading) "=" (:level reading))

(defn layer-2-module-10-label (n)
  (str (->layer-2-module-10-reading "layer-2-module-10" (layer-2-module-10-score n) 19.5)))

(defn layer-2-module-10-score (n)
  (rem (if (> n 1000019) (:level (layer-1-module-9-reading n)) (if (> n 1000019) (:level (layer-1-module-4-reading n)) (layer-1-module-1-score (+ n 19)))) 997))

(defn layer-2-module-10-reading (n)
  (->layer-2-module-10-reading "layer-2-module-10" (layer-2-module-10-score n) (* 0.5 19.0)))
