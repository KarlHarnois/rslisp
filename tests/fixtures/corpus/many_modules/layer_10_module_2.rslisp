(use many_modules/layer_9_module_2 layer-9-module-2-score layer-9-module-2-reading)
(use many_modules/layer_4_module_3 layer-4-module-3-score layer-4-module-3-reading)
(use many_modules/layer_6_module_4 layer-6-module-4-score layer-6-module-4-reading)

(export layer-10-module-2-score layer-10-module-2-reading layer-10-module-2-label)

(defstruct layer-10-module-2-reading :site str :level i64 :weight f64)

(display layer-10-module-2-reading (reading) "layer-10-module-2 " (:site reading) "=" (:level reading))

(defn layer-10-module-2-label (n)
  (str (->layer-10-module-2-reading "layer-10-module-2" (layer-10-module-2-score n) 92.5)))

(defn layer-10-module-2-score (n)
  (rem (+ (layer-9-module-2-score (+ n 3)) (:level (layer-4-module-3-reading n)) (:level (layer-6-module-4-reading n))) 997))

(defn layer-10-module-2-reading (n)
  (->layer-10-module-2-reading "layer-10-module-2" (layer-10-module-2-score n) (* 0.5 92.0)))
