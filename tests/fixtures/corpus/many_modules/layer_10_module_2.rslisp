(use many_modules/layer_6_module_4 layer-6-module-4-score layer-6-module-4-reading)
(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)
(use many_modules/layer_7_module_4 layer-7-module-4-score layer-7-module-4-reading)

(export layer-10-module-2-score layer-10-module-2-reading layer-10-module-2-label)

(defstruct layer-10-module-2-reading :site str :level i64 :weight f64)

(display layer-10-module-2-reading (reading) "layer-10-module-2 " (:site reading) "=" (:level reading))

(defn layer-10-module-2-label (n)
  (str (->layer-10-module-2-reading "layer-10-module-2" (layer-10-module-2-score n) 91.5)))

(defn layer-10-module-2-score (n)
  (rem (if (> n 1000091) (:level (layer-7-module-4-reading n)) (if (> n 1000091) (:level (layer-1-module-4-reading n)) (layer-6-module-4-score (+ n 91)))) 997))

(defn layer-10-module-2-reading (n)
  (->layer-10-module-2-reading "layer-10-module-2" (layer-10-module-2-score n) (* 0.5 91.0)))
