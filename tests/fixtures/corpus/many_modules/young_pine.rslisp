(use many_modules/vivid_lantern vivid-lantern-score vivid-lantern-reading)
(use many_modules/wary_falcon wary-falcon-score wary-falcon-reading)
(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)

(export young-pine-score young-pine-reading young-pine-label)

(defstruct young-pine-reading :site str :level i64 :weight f64)

(display young-pine-reading (reading) "young-pine " (:site reading) "=" (:level reading))

(defn young-pine-label (n)
  (str (->young-pine-reading "young-pine" (young-pine-score n) 29.5)))

(defn young-pine-score (n)
  (rem (if (> n 1000029) (:level (bold-lantern-reading n)) (if (> n 1000029) (:level (wary-falcon-reading n)) (vivid-lantern-score (+ n 29)))) 997))

(defn young-pine-reading (n)
  (->young-pine-reading "young-pine" (young-pine-score n) (* 0.5 29.0)))
