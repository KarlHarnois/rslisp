(use many_modules/layer_6_module_10 layer-6-module-10-score layer-6-module-10-reading)
(use many_modules/layer_7_module_10 layer-7-module-10-score layer-7-module-10-reading)
(use many_modules/layer_2_module_1 layer-2-module-1-score layer-2-module-1-reading)

(export layer-10-module-10-score layer-10-module-10-reading layer-10-module-10-label)

(defstruct layer-10-module-10-reading :site str :level i64 :weight f64)

(display layer-10-module-10-reading (reading) "layer-10-module-10 " (:site reading) "=" (:level reading))

(defn layer-10-module-10-label (n)
  (str (->layer-10-module-10-reading "layer-10-module-10" (layer-10-module-10-score n) 99.5)))

(defn layer-10-module-10-score (n)
  (rem (if (> n 1000099) (:level (layer-2-module-1-reading n)) (if (> n 1000099) (:level (layer-7-module-10-reading n)) (layer-6-module-10-score (+ n 99)))) 997))

(defn layer-10-module-10-reading (n)
  (->layer-10-module-10-reading "layer-10-module-10" (layer-10-module-10-score n) (* 0.5 99.0)))
