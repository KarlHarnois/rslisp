(use many_modules/layer_9_module_10 layer-9-module-10-score layer-9-module-10-reading)
(use many_modules/layer_4_module_6 layer-4-module-6-score layer-4-module-6-reading)
(use many_modules/layer_3_module_8 layer-3-module-8-score layer-3-module-8-reading)

(export layer-10-module-10-score layer-10-module-10-reading layer-10-module-10-label)

(defstruct layer-10-module-10-reading :site str :level i64 :weight f64)

(display layer-10-module-10-reading (reading) "layer-10-module-10 " (:site reading) "=" (:level reading))

(defn layer-10-module-10-label (n)
  (str (->layer-10-module-10-reading "layer-10-module-10" (layer-10-module-10-score n) 100.5)))

(defn layer-10-module-10-score (n)
  (rem (+ (layer-9-module-10-score (+ n 1)) (:level (layer-4-module-6-reading n)) (:level (layer-3-module-8-reading n))) 997))

(defn layer-10-module-10-reading (n)
  (->layer-10-module-10-reading "layer-10-module-10" (layer-10-module-10-score n) (* 0.5 100.0)))
