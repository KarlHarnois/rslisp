(use many_modules/layer_6_module_2 layer-6-module-2-score layer-6-module-2-reading)
(use many_modules/layer_2_module_4 layer-2-module-4-score layer-2-module-4-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)

(export layer-7-module-2-score layer-7-module-2-reading layer-7-module-2-label)

(defstruct layer-7-module-2-reading :site str :level i64 :weight f64)

(display layer-7-module-2-reading (reading) "layer-7-module-2 " (:site reading) "=" (:level reading))

(defn layer-7-module-2-label (n)
  (str (->layer-7-module-2-reading "layer-7-module-2" (layer-7-module-2-score n) 62.5)))

(defn layer-7-module-2-score (n)
  (rem (+ (layer-6-module-2-score (+ n 3)) (:level (layer-2-module-4-reading n)) (:level (layer-1-module-1-reading n))) 997))

(defn layer-7-module-2-reading (n)
  (->layer-7-module-2-reading "layer-7-module-2" (layer-7-module-2-score n) (* 0.5 62.0)))
