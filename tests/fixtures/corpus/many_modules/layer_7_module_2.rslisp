(use many_modules/layer_2_module_10 layer-2-module-10-score layer-2-module-10-reading)
(use many_modules/layer_6_module_9 layer-6-module-9-score layer-6-module-9-reading)
(use many_modules/layer_2_module_5 layer-2-module-5-score layer-2-module-5-reading)

(export layer-7-module-2-score layer-7-module-2-reading layer-7-module-2-label)

(defstruct layer-7-module-2-reading :site str :level i64 :weight f64)

(display layer-7-module-2-reading (reading) "layer-7-module-2 " (:site reading) "=" (:level reading))

(defn layer-7-module-2-label (n)
  (str (->layer-7-module-2-reading "layer-7-module-2" (layer-7-module-2-score n) 61.5)))

(defn layer-7-module-2-score (n)
  (rem (if (> n 1000061) (:level (layer-2-module-5-reading n)) (if (> n 1000061) (:level (layer-6-module-9-reading n)) (layer-2-module-10-score (+ n 61)))) 997))

(defn layer-7-module-2-reading (n)
  (->layer-7-module-2-reading "layer-7-module-2" (layer-7-module-2-score n) (* 0.5 61.0)))
