(use many_modules/quiet_valley quiet-valley-score quiet-valley-reading)
(use many_modules/gilded_walrus gilded-walrus-score gilded-walrus-reading)
(use many_modules/swift_geyser swift-geyser-score swift-geyser-reading)

(export umber-valley-score umber-valley-reading umber-valley-label)

(defstruct umber-valley-reading :site str :level i64 :weight f64)

(display umber-valley-reading (reading) "umber-valley " (:site reading) "=" (:level reading))

(defn umber-valley-label (n)
  (str (->umber-valley-reading "umber-valley" (umber-valley-score n) 84.5)))

(defn umber-valley-score (n)
  (rem (if (> n 1000084) (:level (swift-geyser-reading n)) (if (> n 1000084) (:level (gilded-walrus-reading n)) (quiet-valley-score (+ n 84)))) 997))

(defn umber-valley-reading (n)
  (->umber-valley-reading "umber-valley" (umber-valley-score n) (* 0.5 84.0)))
