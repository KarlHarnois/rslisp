(use many_modules/layer_7_module_9 layer-7-module-9-score layer-7-module-9-reading)
(use many_modules/layer_2_module_7 layer-2-module-7-score layer-2-module-7-reading)
(use many_modules/layer_7_module_2 layer-7-module-2-score layer-7-module-2-reading)

(export layer-8-module-9-score layer-8-module-9-reading layer-8-module-9-label)

(defstruct layer-8-module-9-reading :site str :level i64 :weight f64)

(display layer-8-module-9-reading (reading) "layer-8-module-9 " (:site reading) "=" (:level reading))

(defn layer-8-module-9-label (n)
  (str (->layer-8-module-9-reading "layer-8-module-9" (layer-8-module-9-score n) 79.5)))

(defn layer-8-module-9-score (n)
  (rem (+ (layer-7-module-9-score (+ n 5)) (:level (layer-2-module-7-reading n)) (:level (layer-7-module-2-reading n))) 997))

(defn layer-8-module-9-reading (n)
  (->layer-8-module-9-reading "layer-8-module-9" (layer-8-module-9-score n) (* 0.5 79.0)))
