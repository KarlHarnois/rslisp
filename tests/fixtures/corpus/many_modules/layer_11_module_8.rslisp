(use many_modules/layer_2_module_9 layer-2-module-9-score layer-2-module-9-reading)
(use many_modules/layer_9_module_7 layer-9-module-7-score layer-9-module-7-reading)
(use many_modules/layer_8_module_9 layer-8-module-9-score layer-8-module-9-reading)

(export layer-11-module-8-score layer-11-module-8-reading layer-11-module-8-label)

(defstruct layer-11-module-8-reading :site str :level i64 :weight f64)

(display layer-11-module-8-reading (reading) "layer-11-module-8 " (:site reading) "=" (:level reading))

(defn layer-11-module-8-label (n)
  (str (->layer-11-module-8-reading "layer-11-module-8" (layer-11-module-8-score n) 107.5)))

(defn layer-11-module-8-score (n)
  (rem (if (> n 1000107) (:level (layer-8-module-9-reading n)) (if (> n 1000107) (:level (layer-9-module-7-reading n)) (layer-2-module-9-score (+ n 107)))) 997))

(defn layer-11-module-8-reading (n)
  (->layer-11-module-8-reading "layer-11-module-8" (layer-11-module-8-score n) (* 0.5 107.0)))
