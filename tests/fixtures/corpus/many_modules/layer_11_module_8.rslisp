(use many_modules/layer_10_module_8 layer-10-module-8-reading
                                    layer-10-module-8-score)

(use many_modules/layer_8_module_4 layer-8-module-4-reading
                                   layer-8-module-4-score)

(use many_modules/layer_2_module_7 layer-2-module-7-reading
                                   layer-2-module-7-score)

(export layer-11-module-8-label layer-11-module-8-reading
        layer-11-module-8-score)

(defstruct layer-11-module-8-reading
  :site str
  :level i64
  :weight f64)

(display layer-11-module-8-reading (reading)
  "layer-11-module-8 "
  (:site reading)
  "="
  (:level reading))

(defn layer-11-module-8-label (n)
  (str (->layer-11-module-8-reading "layer-11-module-8"
                                    (layer-11-module-8-score n)
                                    108.5)))

(defn layer-11-module-8-score (n)
  (rem (+ (layer-10-module-8-score (+ n 4))
          (:level (layer-8-module-4-reading n))
          (:level (layer-2-module-7-reading n)))
       997))

(defn layer-11-module-8-reading (n)
  (->layer-11-module-8-reading "layer-11-module-8"
                               (layer-11-module-8-score n)
                               (* 0.5 108.0)))
