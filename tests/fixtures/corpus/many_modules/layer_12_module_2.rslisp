(use many_modules/layer_11_module_2 layer-11-module-2-score layer-11-module-2-reading)
(use many_modules/layer_10_module_4 layer-10-module-4-score layer-10-module-4-reading)
(use many_modules/layer_9_module_9 layer-9-module-9-score layer-9-module-9-reading)

(export layer-12-module-2-score layer-12-module-2-reading layer-12-module-2-label)

(defstruct layer-12-module-2-reading :site str :level i64 :weight f64)

(display layer-12-module-2-reading (reading) "layer-12-module-2 " (:site reading) "=" (:level reading))

(defn layer-12-module-2-label (n)
  (str (->layer-12-module-2-reading "layer-12-module-2" (layer-12-module-2-score n) 112.5)))

(defn layer-12-module-2-score (n)
  (rem (+ (layer-11-module-2-score (+ n 3)) (:level (layer-10-module-4-reading n)) (:level (layer-9-module-9-reading n))) 997))

(defn layer-12-module-2-reading (n)
  (->layer-12-module-2-reading "layer-12-module-2" (layer-12-module-2-score n) (* 0.5 112.0)))
