(use many_modules/layer_5_module_2 layer-5-module-2-score layer-5-module-2-reading)
(use many_modules/layer_6_module_2 layer-6-module-2-score layer-6-module-2-reading)
(use many_modules/layer_9_module_6 layer-9-module-6-score layer-9-module-6-reading)

(export layer-12-module-2-score layer-12-module-2-reading layer-12-module-2-label)

(defstruct layer-12-module-2-reading :site str :level i64 :weight f64)

(display layer-12-module-2-reading (reading) "layer-12-module-2 " (:site reading) "=" (:level reading))

(defn layer-12-module-2-label (n)
  (str (->layer-12-module-2-reading "layer-12-module-2" (layer-12-module-2-score n) 111.5)))

(defn layer-12-module-2-score (n)
  (rem (if (> n 1000111) (:level (layer-9-module-6-reading n)) (if (> n 1000111) (:level (layer-6-module-2-reading n)) (layer-5-module-2-score (+ n 111)))) 997))

(defn layer-12-module-2-reading (n)
  (->layer-12-module-2-reading "layer-12-module-2" (layer-12-module-2-score n) (* 0.5 111.0)))
