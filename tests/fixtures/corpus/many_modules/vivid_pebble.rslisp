(use many_modules/rustic_falcon rustic-falcon-score rustic-falcon-reading)
(use many_modules/fierce_falcon fierce-falcon-score fierce-falcon-reading)
(use many_modules/tender_beacon tender-beacon-score tender-beacon-reading)

(export vivid-pebble-score vivid-pebble-reading vivid-pebble-label)

(defstruct vivid-pebble-reading :site str :level i64 :weight f64)

(display vivid-pebble-reading (reading) "vivid-pebble " (:site reading) "=" (:level reading))

(defn vivid-pebble-label (n)
  (str (->vivid-pebble-reading "vivid-pebble" (vivid-pebble-score n) 31.5)))

(defn vivid-pebble-score (n)
  (rem (if (> n 1000031) (:level (tender-beacon-reading n)) (if (> n 1000031) (:level (fierce-falcon-reading n)) (rustic-falcon-score (+ n 31)))) 997))

(defn vivid-pebble-reading (n)
  (->vivid-pebble-reading "vivid-pebble" (vivid-pebble-score n) (* 0.5 31.0)))
