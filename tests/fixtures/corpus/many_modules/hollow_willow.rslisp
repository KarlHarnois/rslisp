(use many_modules/rustic_falcon rustic-falcon-score rustic-falcon-reading)
(use many_modules/mellow_island mellow-island-score mellow-island-reading)
(use many_modules/rapid_raven rapid-raven-score rapid-raven-reading)

(export hollow-willow-score hollow-willow-reading hollow-willow-label)

(defstruct hollow-willow-reading :site str :level i64 :weight f64)

(display hollow-willow-reading (reading) "hollow-willow " (:site reading) "=" (:level reading))

(defn hollow-willow-label (n)
  (str (->hollow-willow-reading "hollow-willow" (hollow-willow-score n) 91.5)))

(defn hollow-willow-score (n)
  (rem (if (> n 1000091) (:level (rapid-raven-reading n)) (if (> n 1000091) (:level (mellow-island-reading n)) (rustic-falcon-score (+ n 91)))) 997))

(defn hollow-willow-reading (n)
  (->hollow-willow-reading "hollow-willow" (hollow-willow-score n) (* 0.5 91.0)))
