(use many_modules/layer_10_module_9 layer-10-module-9-reading
                                    layer-10-module-9-score)

(use many_modules/layer_2_module_2 layer-2-module-2-reading
                                   layer-2-module-2-score)

(use many_modules/layer_5_module_7 layer-5-module-7-reading
                                   layer-5-module-7-score)

(export layer-11-module-9-label layer-11-module-9-reading
        layer-11-module-9-score)

(defstruct layer-11-module-9-reading
  :site str
  :level i64
  :weight f64)

(display layer-11-module-9-reading (reading)
  "layer-11-module-9 "
  (:site reading)
  "="
  (:level reading))

(defn layer-11-module-9-label (n)
  (str (->layer-11-module-9-reading "layer-11-module-9"
                                    (layer-11-module-9-score n)
                                    109.5)))

(defn layer-11-module-9-score (n)
  (rem (+ (layer-10-module-9-score (+ n 5))
          (:level (layer-2-module-2-reading n))
          (:level (layer-5-module-7-reading n)))
       997))

(defn layer-11-module-9-reading (n)
  (->layer-11-module-9-reading "layer-11-module-9"
                               (layer-11-module-9-score n)
                               (* 0.5 109.0)))
