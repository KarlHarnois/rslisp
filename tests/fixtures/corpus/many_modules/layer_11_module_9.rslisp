(use many_modules/layer_3_module_6 layer-3-module-6-score layer-3-module-6-reading)
(use many_modules/layer_7_module_7 layer-7-module-7-score layer-7-module-7-reading)
(use many_modules/layer_3_module_2 layer-3-module-2-score layer-3-module-2-reading)

(export layer-11-module-9-score layer-11-module-9-reading layer-11-module-9-label)

(defstruct layer-11-module-9-reading :site str :level i64 :weight f64)

(display layer-11-module-9-reading (reading) "layer-11-module-9 " (:site reading) "=" (:level reading))

(defn layer-11-module-9-label (n)
  (str (->layer-11-module-9-reading "layer-11-module-9" (layer-11-module-9-score n) 108.5)))

(defn layer-11-module-9-score (n)
  (rem (if (> n 1000108) (:level (layer-3-module-2-reading n)) (if (> n 1000108) (:level (layer-7-module-7-reading n)) (layer-3-module-6-score (+ n 108)))) 997))

(defn layer-11-module-9-reading (n)
  (->layer-11-module-9-reading "layer-11-module-9" (layer-11-module-9-score n) (* 0.5 108.0)))
