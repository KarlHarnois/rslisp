(use many_modules/layer_2_module_2 layer-2-module-2-score layer-2-module-2-reading)
(use many_modules/layer_1_module_7 layer-1-module-7-score layer-1-module-7-reading)
(use many_modules/layer_1_module_8 layer-1-module-8-score layer-1-module-8-reading)

(export layer-3-module-2-score layer-3-module-2-reading layer-3-module-2-label)

(defstruct layer-3-module-2-reading :site str :level i64 :weight f64)

(display layer-3-module-2-reading (reading) "layer-3-module-2 " (:site reading) "=" (:level reading))

(defn layer-3-module-2-label (n)
  (str (->layer-3-module-2-reading "layer-3-module-2" (layer-3-module-2-score n) 22.5)))

(defn layer-3-module-2-score (n)
  (rem (+ (layer-2-module-2-score (+ n 3)) (:level (layer-1-module-7-reading n)) (:level (layer-1-module-8-reading n))) 997))

(defn layer-3-module-2-reading (n)
  (->layer-3-module-2-reading "layer-3-module-2" (layer-3-module-2-score n) (* 0.5 22.0)))
