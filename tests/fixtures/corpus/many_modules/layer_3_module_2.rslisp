(use many_modules/layer_2_module_1 layer-2-module-1-score layer-2-module-1-reading)
(use many_modules/layer_2_module_5 layer-2-module-5-score layer-2-module-5-reading)
(use many_modules/layer_1_module_7 layer-1-module-7-score layer-1-module-7-reading)

(export layer-3-module-2-score layer-3-module-2-reading layer-3-module-2-label)

(defstruct layer-3-module-2-reading :site str :level i64 :weight f64)

(display layer-3-module-2-reading (reading) "layer-3-module-2 " (:site reading) "=" (:level reading))

(defn layer-3-module-2-label (n)
  (str (->layer-3-module-2-reading "layer-3-module-2" (layer-3-module-2-score n) 21.5)))

(defn layer-3-module-2-score (n)
  (rem (if (> n 1000021) (:level (layer-1-module-7-reading n)) (if (> n 1000021) (:level (layer-2-module-5-reading n)) (layer-2-module-1-score (+ n 21)))) 997))

(defn layer-3-module-2-reading (n)
  (->layer-3-module-2-reading "layer-3-module-2" (layer-3-module-2-score n) (* 0.5 21.0)))
