(use many_modules/keen_walrus keen-walrus-score keen-walrus-reading)
(use many_modules/olive_meadow olive-meadow-score olive-meadow-reading)
(use many_modules/gentle_marten gentle-marten-score gentle-marten-reading)

(export lively-geyser-score lively-geyser-reading lively-geyser-label)

(defstruct lively-geyser-reading :site str :level i64 :weight f64)

(display lively-geyser-reading (reading) "lively-geyser " (:site reading) "=" (:level reading))

(defn lively-geyser-label (n)
  (str (->lively-geyser-reading "lively-geyser" (lively-geyser-score n) 117.5)))

(defn lively-geyser-score (n)
  (rem (if (> n 1000117) (:level (gentle-marten-reading n)) (if (> n 1000117) (:level (olive-meadow-reading n)) (keen-walrus-score (+ n 117)))) 997))

(defn lively-geyser-reading (n)
  (->lively-geyser-reading "lively-geyser" (lively-geyser-score n) (* 0.5 117.0)))
