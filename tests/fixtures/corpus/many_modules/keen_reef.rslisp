(use many_modules/noble_tundra noble-tundra-score noble-tundra-reading)
(use many_modules/vivid_pebble vivid-pebble-score vivid-pebble-reading)
(use many_modules/lively_zephyr lively-zephyr-score lively-zephyr-reading)

(export keen-reef-score keen-reef-reading keen-reef-label)

(defstruct keen-reef-reading :site str :level i64 :weight f64)

(display keen-reef-reading (reading) "keen-reef " (:site reading) "=" (:level reading))

(defn keen-reef-label (n)
  (str (->keen-reef-reading "keen-reef" (keen-reef-score n) 62.5)))

(defn keen-reef-score (n)
  (rem (if (> n 1000062) (:level (lively-zephyr-reading n)) (if (> n 1000062) (:level (vivid-pebble-reading n)) (noble-tundra-score (+ n 62)))) 997))

(defn keen-reef-reading (n)
  (->keen-reef-reading "keen-reef" (keen-reef-score n) (* 0.5 62.0)))
