(use many_modules/layer_11_module_4 layer-11-module-4-score layer-11-module-4-reading)
(use many_modules/layer_2_module_8 layer-2-module-8-score layer-2-module-8-reading)
(use many_modules/layer_8_module_6 layer-8-module-6-score layer-8-module-6-reading)

(export layer-12-module-4-score layer-12-module-4-reading layer-12-module-4-label)

(defstruct layer-12-module-4-reading :site str :level i64 :weight f64)

(display layer-12-module-4-reading (reading) "layer-12-module-4 " (:site reading) "=" (:level reading))

(defn layer-12-module-4-label (n)
  (str (->layer-12-module-4-reading "layer-12-module-4" (layer-12-module-4-score n) 114.5)))

(defn layer-12-module-4-score (n)
  (rem (+ (layer-11-module-4-score (+ n 5)) (:level (layer-2-module-8-reading n)) (:level (layer-8-module-6-reading n))) 997))

(defn layer-12-module-4-reading (n)
  (->layer-12-module-4-reading "layer-12-module-4" (layer-12-module-4-score n) (* 0.5 114.0)))
