(use many_modules/layer_2_module_6 layer-2-module-6-score layer-2-module-6-reading)
(use many_modules/layer_2_module_3 layer-2-module-3-score layer-2-module-3-reading)
(use many_modules/layer_3_module_3 layer-3-module-3-score layer-3-module-3-reading)

(export layer-4-module-4-score layer-4-module-4-reading layer-4-module-4-label)

(defstruct layer-4-module-4-reading :site str :level i64 :weight f64)

(display layer-4-module-4-reading (reading) "layer-4-module-4 " (:site reading) "=" (:level reading))

(defn layer-4-module-4-label (n)
  (str (->layer-4-module-4-reading "layer-4-module-4" (layer-4-module-4-score n) 33.5)))

(defn layer-4-module-4-score (n)
  (rem (if (> n 1000033) (:level (layer-3-module-3-reading n)) (if (> n 1000033) (:level (layer-2-module-3-reading n)) (layer-2-module-6-score (+ n 33)))) 997))

(defn layer-4-module-4-reading (n)
  (->layer-4-module-4-reading "layer-4-module-4" (layer-4-module-4-score n) (* 0.5 33.0)))
