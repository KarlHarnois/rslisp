(use many_modules/layer_3_module_4 layer-3-module-4-score layer-3-module-4-reading)
(use many_modules/layer_1_module_8 layer-1-module-8-score layer-1-module-8-reading)
(use many_modules/layer_2_module_7 layer-2-module-7-score layer-2-module-7-reading)

(export layer-4-module-4-score layer-4-module-4-reading layer-4-module-4-label)

(defstruct layer-4-module-4-reading :site str :level i64 :weight f64)

(display layer-4-module-4-reading (reading) "layer-4-module-4 " (:site reading) "=" (:level reading))

(defn layer-4-module-4-label (n)
  (str (->layer-4-module-4-reading "layer-4-module-4" (layer-4-module-4-score n) 34.5)))

(defn layer-4-module-4-score (n)
  (rem (+ (layer-3-module-4-score (+ n 5)) (:level (layer-1-module-8-reading n)) (:level (layer-2-module-7-reading n))) 997))

(defn layer-4-module-4-reading (n)
  (->layer-4-module-4-reading "layer-4-module-4" (layer-4-module-4-score n) (* 0.5 34.0)))
