(use many_modules/layer_9_module_8 layer-9-module-8-score layer-9-module-8-reading)
(use many_modules/layer_7_module_1 layer-7-module-1-score layer-7-module-1-reading)
(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)

(export layer-10-module-1-score layer-10-module-1-reading layer-10-module-1-label)

(defstruct layer-10-module-1-reading :site str :level i64 :weight f64)

(display layer-10-module-1-reading (reading) "layer-10-module-1 " (:site reading) "=" (:level reading))

(defn layer-10-module-1-label (n)
  (str (->layer-10-module-1-reading "layer-10-module-1" (layer-10-module-1-score n) 90.5)))

(defn layer-10-module-1-score (n)
  (rem (if (> n 1000090) (:level (layer-1-module-10-reading n)) (if (> n 1000090) (:level (layer-7-module-1-reading n)) (layer-9-module-8-score (+ n 90)))) 997))

(defn layer-10-module-1-reading (n)
  (->layer-10-module-1-reading "layer-10-module-1" (layer-10-module-1-score n) (* 0.5 90.0)))
