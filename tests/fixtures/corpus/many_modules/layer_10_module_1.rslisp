(use many_modules/layer_9_module_1 layer-9-module-1-reading
                                   layer-9-module-1-score)

(use many_modules/layer_4_module_1 layer-4-module-1-reading
                                   layer-4-module-1-score)

(use many_modules/layer_6_module_1 layer-6-module-1-reading
                                   layer-6-module-1-score)

(export layer-10-module-1-label layer-10-module-1-reading
        layer-10-module-1-score)

(defstruct layer-10-module-1-reading
  :site str
  :level i64
  :weight f64)

(display layer-10-module-1-reading (reading)
  "layer-10-module-1 "
  (:site reading)
  "="
  (:level reading))

(defn layer-10-module-1-label (n)
  (str (->layer-10-module-1-reading "layer-10-module-1"
                                    (layer-10-module-1-score n)
                                    91.5)))

(defn layer-10-module-1-score (n)
  (rem (+ (layer-9-module-1-score (+ n 2))
          (:level (layer-4-module-1-reading n))
          (:level (layer-6-module-1-reading n)))
       997))

(defn layer-10-module-1-reading (n)
  (->layer-10-module-1-reading "layer-10-module-1"
                               (layer-10-module-1-score n)
                               (* 0.5 91.0)))
