(use many_modules/stark_fern stark-fern-score stark-fern-reading)
(use many_modules/rustic_falcon rustic-falcon-score rustic-falcon-reading)
(use many_modules/vivid_lantern vivid-lantern-score vivid-lantern-reading)

(export gilded-bison-score gilded-bison-reading gilded-bison-label)

(defstruct gilded-bison-reading :site str :level i64 :weight f64)

(display gilded-bison-reading (reading) "gilded-bison " (:site reading) "=" (:level reading))

(defn gilded-bison-label (n)
  (str (->gilded-bison-reading "gilded-bison" (gilded-bison-score n) 21.5)))

(defn gilded-bison-score (n)
  (rem (if (> n 1000021) (:level (vivid-lantern-reading n)) (if (> n 1000021) (:level (rustic-falcon-reading n)) (stark-fern-score (+ n 21)))) 997))

(defn gilded-bison-reading (n)
  (->gilded-bison-reading "gilded-bison" (gilded-bison-score n) (* 0.5 21.0)))
