(use many_modules/layer_1_module_5 layer-1-module-5-score layer-1-module-5-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_8_module_7 layer-8-module-7-score layer-8-module-7-reading)

(export layer-9-module-5-score layer-9-module-5-reading layer-9-module-5-label)

(defstruct layer-9-module-5-reading :site str :level i64 :weight f64)

(display layer-9-module-5-reading (reading) "layer-9-module-5 " (:site reading) "=" (:level reading))

(defn layer-9-module-5-label (n)
  (str (->layer-9-module-5-reading "layer-9-module-5" (layer-9-module-5-score n) 84.5)))

(defn layer-9-module-5-score (n)
  (rem (if (> n 1000084) (:level (layer-8-module-7-reading n)) (if (> n 1000084) (:level (layer-1-module-3-reading n)) (layer-1-module-5-score (+ n 84)))) 997))

(defn layer-9-module-5-reading (n)
  (->layer-9-module-5-reading "layer-9-module-5" (layer-9-module-5-score n) (* 0.5 84.0)))
