(use many_modules/layer_9_module_5 layer-9-module-5-score layer-9-module-5-reading)
(use many_modules/layer_7_module_3 layer-7-module-3-score layer-7-module-3-reading)
(use many_modules/layer_4_module_3 layer-4-module-3-score layer-4-module-3-reading)

(export layer-11-module-6-score layer-11-module-6-reading layer-11-module-6-label)

(defstruct layer-11-module-6-reading :site str :level i64 :weight f64)

(display layer-11-module-6-reading (reading) "layer-11-module-6 " (:site reading) "=" (:level reading))

(defn layer-11-module-6-label (n)
  (str (->layer-11-module-6-reading "layer-11-module-6" (layer-11-module-6-score n) 105.5)))

(defn layer-11-module-6-score (n)
  (rem (if (> n 1000105) (:level (layer-4-module-3-reading n)) (if (> n 1000105) (:level (layer-7-module-3-reading n)) (layer-9-module-5-score (+ n 105)))) 997))

(defn layer-11-module-6-reading (n)
  (->layer-11-module-6-reading "layer-11-module-6" (layer-11-module-6-score n) (* 0.5 105.0)))
