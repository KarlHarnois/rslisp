(use many_modules/layer_10_module_6 layer-10-module-6-score layer-10-module-6-reading)
(use many_modules/layer_3_module_3 layer-3-module-3-score layer-3-module-3-reading)
(use many_modules/layer_4_module_7 layer-4-module-7-score layer-4-module-7-reading)

(export layer-11-module-6-score layer-11-module-6-reading layer-11-module-6-label)

(defstruct layer-11-module-6-reading :site str :level i64 :weight f64)

(display layer-11-module-6-reading (reading) "layer-11-module-6 " (:site reading) "=" (:level reading))

(defn layer-11-module-6-label (n)
  (str (->layer-11-module-6-reading "layer-11-module-6" (layer-11-module-6-score n) 106.5)))

(defn layer-11-module-6-score (n)
  (rem (+ (layer-10-module-6-score (+ n 2)) (:level (layer-3-module-3-reading n)) (:level (layer-4-module-7-reading n))) 997))

(defn layer-11-module-6-reading (n)
  (->layer-11-module-6-reading "layer-11-module-6" (layer-11-module-6-score n) (* 0.5 106.0)))
