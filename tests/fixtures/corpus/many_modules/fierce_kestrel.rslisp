(use many_modules/vivid_otter vivid-otter-score vivid-otter-reading)
(use many_modules/fierce_nebula fierce-nebula-score fierce-nebula-reading)
(use many_modules/tawny_island tawny-island-score tawny-island-reading)

(export fierce-kestrel-score fierce-kestrel-reading fierce-kestrel-label)

(defstruct fierce-kestrel-reading :site str :level i64 :weight f64)

(display fierce-kestrel-reading (reading) "fierce-kestrel " (:site reading) "=" (:level reading))

(defn fierce-kestrel-label (n)
  (str (->fierce-kestrel-reading "fierce-kestrel" (fierce-kestrel-score n) 110.5)))

(defn fierce-kestrel-score (n)
  (rem (if (> n 1000110) (:level (tawny-island-reading n)) (if (> n 1000110) (:level (fierce-nebula-reading n)) (vivid-otter-score (+ n 110)))) 997))

(defn fierce-kestrel-reading (n)
  (->fierce-kestrel-reading "fierce-kestrel" (fierce-kestrel-score n) (* 0.5 110.0)))
