(use many_modules/young_falcon young-falcon-score young-falcon-reading)
(use many_modules/umber_valley umber-valley-score umber-valley-reading)
(use many_modules/rustic_bison rustic-bison-score rustic-bison-reading)

(export zesty-falcon-score zesty-falcon-reading zesty-falcon-label)

(defstruct zesty-falcon-reading :site str :level i64 :weight f64)

(display zesty-falcon-reading (reading) "zesty-falcon " (:site reading) "=" (:level reading))

(defn zesty-falcon-label (n)
  (str (->zesty-falcon-reading "zesty-falcon" (zesty-falcon-score n) 99.5)))

(defn zesty-falcon-score (n)
  (rem (if (> n 1000099) (:level (rustic-bison-reading n)) (if (> n 1000099) (:level (umber-valley-reading n)) (young-falcon-score (+ n 99)))) 997))

(defn zesty-falcon-reading (n)
  (->zesty-falcon-reading "zesty-falcon" (zesty-falcon-score n) (* 0.5 99.0)))
