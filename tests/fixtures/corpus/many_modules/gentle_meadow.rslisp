(use many_modules/zesty_delta zesty-delta-score zesty-delta-reading)
(use many_modules/silver_tundra silver-tundra-score silver-tundra-reading)
(use many_modules/tender_harbor tender-harbor-score tender-harbor-reading)

(export gentle-meadow-score gentle-meadow-reading gentle-meadow-label)

(defstruct gentle-meadow-reading :site str :level i64 :weight f64)

(display gentle-meadow-reading (reading) "gentle-meadow " (:site reading) "=" (:level reading))

(defn gentle-meadow-label (n)
  (str (->gentle-meadow-reading "gentle-meadow" (gentle-meadow-score n) 102.5)))

(defn gentle-meadow-score (n)
  (rem (if (> n 1000102) (:level (tender-harbor-reading n)) (if (> n 1000102) (:level (silver-tundra-reading n)) (zesty-delta-score (+ n 102)))) 997))

(defn gentle-meadow-reading (n)
  (->gentle-meadow-reading "gentle-meadow" (gentle-meadow-score n) (* 0.5 102.0)))
