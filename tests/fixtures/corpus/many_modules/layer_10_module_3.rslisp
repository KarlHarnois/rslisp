(use many_modules/layer_9_module_3 layer-9-module-3-score layer-9-module-3-reading)
(use many_modules/layer_8_module_7 layer-8-module-7-score layer-8-module-7-reading)
(use many_modules/layer_7_module_3 layer-7-module-3-score layer-7-module-3-reading)

(export layer-10-module-3-score layer-10-module-3-reading layer-10-module-3-label)

(defstruct layer-10-module-3-reading :site str :level i64 :weight f64)

(display layer-10-module-3-reading (reading) "layer-10-module-3 " (:site reading) "=" (:level reading))

(defn layer-10-module-3-label (n)
  (str (->layer-10-module-3-reading "layer-10-module-3" (layer-10-module-3-score n) 93.5)))

(defn layer-10-module-3-score (n)
  (rem (+ (layer-9-module-3-score (+ n 4)) (:level (layer-8-module-7-reading n)) (:level (layer-7-module-3-reading n))) 997))

(defn layer-10-module-3-reading (n)
  (->layer-10-module-3-reading "layer-10-module-3" (layer-10-module-3-score n) (* 0.5 93.0)))
