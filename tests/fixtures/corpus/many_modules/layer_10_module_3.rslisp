(use many_modules/layer_8_module_4 layer-8-module-4-score layer-8-module-4-reading)
(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)
(use many_modules/layer_8_module_10 layer-8-module-10-score layer-8-module-10-reading)

(export layer-10-module-3-score layer-10-module-3-reading layer-10-module-3-label)

(defstruct layer-10-module-3-reading :site str :level i64 :weight f64)

(display layer-10-module-3-reading (reading) "layer-10-module-3 " (:site reading) "=" (:level reading))

(defn layer-10-module-3-label (n)
  (str (->layer-10-module-3-reading "layer-10-module-3" (layer-10-module-3-score n) 92.5)))

(defn layer-10-module-3-score (n)
  (rem (if (> n 1000092) (:level (layer-8-module-10-reading n)) (if (> n 1000092) (:level (layer-1-module-2-reading n)) (layer-8-module-4-score (+ n 92)))) 997))

(defn layer-10-module-3-reading (n)
  (->layer-10-module-3-reading "layer-10-module-3" (layer-10-module-3-score n) (* 0.5 92.0)))
