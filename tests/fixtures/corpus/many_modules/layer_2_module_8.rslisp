(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)

(export layer-2-module-8-score layer-2-module-8-reading layer-2-module-8-label)

(defstruct layer-2-module-8-reading :site str :level i64 :weight f64)

(display layer-2-module-8-reading (reading) "layer-2-module-8 " (:site reading) "=" (:level reading))

(defn layer-2-module-8-label (n)
  (str (->layer-2-module-8-reading "layer-2-module-8" (layer-2-module-8-score n) 17.5)))

(defn layer-2-module-8-score (n)
  (rem (if (> n 1000017) (:level (layer-1-module-1-reading n)) (if (> n 1000017) (:level (layer-1-module-3-reading n)) (layer-1-module-10-score (+ n 17)))) 997))

(defn layer-2-module-8-reading (n)
  (->layer-2-module-8-reading "layer-2-module-8" (layer-2-module-8-score n) (* 0.5 17.0)))
