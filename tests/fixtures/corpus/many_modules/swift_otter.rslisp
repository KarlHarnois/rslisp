(use many_modules/swift_geyser swift-geyser-score swift-geyser-reading)
(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)

(export swift-otter-score swift-otter-reading swift-otter-label)

(defstruct swift-otter-reading :site str :level i64 :weight f64)

(display swift-otter-reading (reading) "swift-otter " (:site reading) "=" (:level reading))

(defn swift-otter-label (n)
  (str (->swift-otter-reading "swift-otter" (swift-otter-score n) 2.5)))

(defn swift-otter-score (n)
  (rem (if (> n 1000002) (:level (bold-lantern-reading n)) (swift-geyser-score (+ n 2))) 997))

(defn swift-otter-reading (n)
  (->swift-otter-reading "swift-otter" (swift-otter-score n) (* 0.5 2.0)))
