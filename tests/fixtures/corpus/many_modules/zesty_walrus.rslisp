(use many_modules/stark_falcon stark-falcon-score stark-falcon-reading)
(use many_modules/swift_otter swift-otter-score swift-otter-reading)
(use many_modules/dusky_pebble dusky-pebble-score dusky-pebble-reading)

(export zesty-walrus-score zesty-walrus-reading zesty-walrus-label)

(defstruct zesty-walrus-reading :site str :level i64 :weight f64)

(display zesty-walrus-reading (reading) "zesty-walrus " (:site reading) "=" (:level reading))

(defn zesty-walrus-label (n)
  (str (->zesty-walrus-reading "zesty-walrus" (zesty-walrus-score n) 17.5)))

(defn zesty-walrus-score (n)
  (rem (if (> n 1000017) (:level (dusky-pebble-reading n)) (if (> n 1000017) (:level (swift-otter-reading n)) (stark-falcon-score (+ n 17)))) 997))

(defn zesty-walrus-reading (n)
  (->zesty-walrus-reading "zesty-walrus" (zesty-walrus-score n) (* 0.5 17.0)))
