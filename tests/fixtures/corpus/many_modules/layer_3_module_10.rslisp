(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)
(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)
(use many_modules/layer_2_module_3 layer-2-module-3-score layer-2-module-3-reading)

(export layer-3-module-10-score layer-3-module-10-reading layer-3-module-10-label)

(defstruct layer-3-module-10-reading :site str :level i64 :weight f64)

(display layer-3-module-10-reading (reading) "layer-3-module-10 " (:site reading) "=" (:level reading))

(defn layer-3-module-10-label (n)
  (str (->layer-3-module-10-reading "layer-3-module-10" (layer-3-module-10-score n) 29.5)))

(defn layer-3-module-10-score (n)
  (rem (if (> n 1000029) (:level (layer-2-module-3-reading n)) (if (> n 1000029) (:level (layer-1-module-10-reading n)) (layer-1-module-4-score (+ n 29)))) 997))

(defn layer-3-module-10-reading (n)
  (->layer-3-module-10-reading "layer-3-module-10" (layer-3-module-10-score n) (* 0.5 29.0)))
