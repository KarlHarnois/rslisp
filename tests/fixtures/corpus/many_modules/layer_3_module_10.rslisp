(use many_modules/layer_2_module_10 layer-2-module-10-score layer-2-module-10-reading)
(use many_modules/layer_2_module_4 layer-2-module-4-score layer-2-module-4-reading)
(use many_modules/layer_2_module_8 layer-2-module-8-score layer-2-module-8-reading)

(export layer-3-module-10-score layer-3-module-10-reading layer-3-module-10-label)

(defstruct layer-3-module-10-reading :site str :level i64 :weight f64)

(display layer-3-module-10-reading (reading) "layer-3-module-10 " (:site reading) "=" (:level reading))

(defn layer-3-module-10-label (n)
  (str (->layer-3-module-10-reading "layer-3-module-10" (layer-3-module-10-score n) 30.5)))

(defn layer-3-module-10-score (n)
  (rem (+ (layer-2-module-10-score (+ n 1)) (:level (layer-2-module-4-reading n)) (:level (layer-2-module-8-reading n))) 997))

(defn layer-3-module-10-reading (n)
  (->layer-3-module-10-reading "layer-3-module-10" (layer-3-module-10-score n) (* 0.5 30.0)))
