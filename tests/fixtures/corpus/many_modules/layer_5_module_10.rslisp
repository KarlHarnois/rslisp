(use many_modules/layer_3_module_6 layer-3-module-6-score layer-3-module-6-reading)
(use many_modules/layer_4_module_9 layer-4-module-9-score layer-4-module-9-reading)
(use many_modules/layer_4_module_7 layer-4-module-7-score layer-4-module-7-reading)

(export layer-5-module-10-score layer-5-module-10-reading layer-5-module-10-label)

(defstruct layer-5-module-10-reading :site str :level i64 :weight f64)

(display layer-5-module-10-reading (reading) "layer-5-module-10 " (:site reading) "=" (:level reading))

(defn layer-5-module-10-label (n)
  (str (->layer-5-module-10-reading "layer-5-module-10" (layer-5-module-10-score n) 49.5)))

(defn layer-5-module-10-score (n)
  (rem (if (> n 1000049) (:level (layer-4-module-7-reading n)) (if (> n 1000049) (:level (layer-4-module-9-reading n)) (layer-3-module-6-score (+ n 49)))) 997))

(defn layer-5-module-10-reading (n)
  (->layer-5-module-10-reading "layer-5-module-10" (layer-5-module-10-score n) (* 0.5 49.0)))
