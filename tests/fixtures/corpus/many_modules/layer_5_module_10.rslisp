(use many_modules/layer_4_module_10 layer-4-module-10-score layer-4-module-10-reading)
(use many_modules/layer_1_module_8 layer-1-module-8-score layer-1-module-8-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)

(export layer-5-module-10-score layer-5-module-10-reading layer-5-module-10-label)

(defstruct layer-5-module-10-reading :site str :level i64 :weight f64)

(display layer-5-module-10-reading (reading) "layer-5-module-10 " (:site reading) "=" (:level reading))

(defn layer-5-module-10-label (n)
  (str (->layer-5-module-10-reading "layer-5-module-10" (layer-5-module-10-score n) 50.5)))

(defn layer-5-module-10-score (n)
  (rem (+ (layer-4-module-10-score (+ n 1)) (:level (layer-1-module-8-reading n)) (:level (layer-1-module-9-reading n))) 997))

(defn layer-5-module-10-reading (n)
  (->layer-5-module-10-reading "layer-5-module-10" (layer-5-module-10-score n) (* 0.5 50.0)))
