(use many_modules/layer_3_module_5 layer-3-module-5-score layer-3-module-5-reading)
(use many_modules/layer_3_module_10 layer-3-module-10-score layer-3-module-10-reading)
(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)

(export layer-4-module-10-score layer-4-module-10-reading layer-4-module-10-label)

(defstruct layer-4-module-10-reading :site str :level i64 :weight f64)

(display layer-4-module-10-reading (reading) "layer-4-module-10 " (:site reading) "=" (:level reading))

(defn layer-4-module-10-label (n)
  (str (->layer-4-module-10-reading "layer-4-module-10" (layer-4-module-10-score n) 39.5)))

(defn layer-4-module-10-score (n)
  (rem (if (> n 1000039) (:level (layer-1-module-4-reading n)) (if (> n 1000039) (:level (layer-3-module-10-reading n)) (layer-3-module-5-score (+ n 39)))) 997))

(defn layer-4-module-10-reading (n)
  (->layer-4-module-10-reading "layer-4-module-10" (layer-4-module-10-score n) (* 0.5 39.0)))
