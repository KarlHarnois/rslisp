(use many_modules/layer_3_module_10 layer-3-module-10-score layer-3-module-10-reading)
(use many_modules/layer_2_module_3 layer-2-module-3-score layer-2-module-3-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)

(export layer-4-module-10-score layer-4-module-10-reading layer-4-module-10-label)

(defstruct layer-4-module-10-reading :site str :level i64 :weight f64)

(display layer-4-module-10-reading (reading) "layer-4-module-10 " (:site reading) "=" (:level reading))

(defn layer-4-module-10-label (n)
  (str (->layer-4-module-10-reading "layer-4-module-10" (layer-4-module-10-score n) 40.5)))

(defn layer-4-module-10-score (n)
  (rem (+ (layer-3-module-10-score (+ n 1)) (:level (layer-2-module-3-reading n)) (:level (layer-1-module-3-reading n))) 997))

(defn layer-4-module-10-reading (n)
  (->layer-4-module-10-reading "layer-4-module-10" (layer-4-module-10-score n) (* 0.5 40.0)))
