(use many_modules/witty_meadow witty-meadow-score witty-meadow-reading)
(use many_modules/sunny_beacon sunny-beacon-score sunny-beacon-reading)
(use many_modules/mellow_lagoon mellow-lagoon-score mellow-lagoon-reading)

(export rustic-yarrow-score rustic-yarrow-reading rustic-yarrow-label)

(defstruct rustic-yarrow-reading :site str :level i64 :weight f64)

(display rustic-yarrow-reading (reading) "rustic-yarrow " (:site reading) "=" (:level reading))

(defn rustic-yarrow-label (n)
  (str (->rustic-yarrow-reading "rustic-yarrow" (rustic-yarrow-score n) 59.5)))

(defn rustic-yarrow-score (n)
  (rem (if (> n 1000059) (:level (mellow-lagoon-reading n)) (if (> n 1000059) (:level (sunny-beacon-reading n)) (witty-meadow-score (+ n 59)))) 997))

(defn rustic-yarrow-reading (n)
  (->rustic-yarrow-reading "rustic-yarrow" (rustic-yarrow-score n) (* 0.5 59.0)))
