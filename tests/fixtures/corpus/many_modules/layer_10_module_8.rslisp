(use many_modules/layer_5_module_3 layer-5-module-3-score layer-5-module-3-reading)
(use many_modules/layer_5_module_10 layer-5-module-10-score layer-5-module-10-reading)
(use many_modules/layer_9_module_9 layer-9-module-9-score layer-9-module-9-reading)

(export layer-10-module-8-score layer-10-module-8-reading layer-10-module-8-label)

(defstruct layer-10-module-8-reading :site str :level i64 :weight f64)

(display layer-10-module-8-reading (reading) "layer-10-module-8 " (:site reading) "=" (:level reading))

(defn layer-10-module-8-label (n)
  (str (->layer-10-module-8-reading "layer-10-module-8" (layer-10-module-8-score n) 97.5)))

(defn layer-10-module-8-score (n)
  (rem (if (> n 1000097) (:level (layer-9-module-9-reading n)) (if (> n 1000097) (:level (layer-5-module-10-reading n)) (layer-5-module-3-score (+ n 97)))) 997))

(defn layer-10-module-8-reading (n)
  (->layer-10-module-8-reading "layer-10-module-8" (layer-10-module-8-score n) (* 0.5 97.0)))
