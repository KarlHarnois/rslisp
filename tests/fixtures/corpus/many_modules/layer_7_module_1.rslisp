(use many_modules/layer_6_module_1 layer-6-module-1-score layer-6-module-1-reading)
(use many_modules/layer_3_module_6 layer-3-module-6-score layer-3-module-6-reading)
(use many_modules/layer_3_module_7 layer-3-module-7-score layer-3-module-7-reading)

(export layer-7-module-1-score layer-7-module-1-reading layer-7-module-1-label)

(defstruct layer-7-module-1-reading :site str :level i64 :weight f64)

(display layer-7-module-1-reading (reading) "layer-7-module-1 " (:site reading) "=" (:level reading))

(defn layer-7-module-1-label (n)
  (str (->layer-7-module-1-reading "layer-7-module-1" (layer-7-module-1-score n) 61.5)))

(defn layer-7-module-1-score (n)
  (rem (+ (layer-6-module-1-score (+ n 2)) (:level (layer-3-module-6-reading n)) (:level (layer-3-module-7-reading n))) 997))

(defn layer-7-module-1-reading (n)
  (->layer-7-module-1-reading "layer-7-module-1" (layer-7-module-1-score n) (* 0.5 61.0)))
