(use many_modules/layer_2_module_2 layer-2-module-2-score layer-2-module-2-reading)
(use many_modules/layer_5_module_1 layer-5-module-1-score layer-5-module-1-reading)
(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)

(export layer-7-module-1-score layer-7-module-1-reading layer-7-module-1-label)

(defstruct layer-7-module-1-reading :site str :level i64 :weight f64)

(display layer-7-module-1-reading (reading) "layer-7-module-1 " (:site reading) "=" (:level reading))

(defn layer-7-module-1-label (n)
  (str (->layer-7-module-1-reading "layer-7-module-1" (layer-7-module-1-score n) 60.5)))

(defn layer-7-module-1-score (n)
  (rem (if (> n 1000060) (:level (layer-1-module-10-reading n)) (if (> n 1000060) (:level (layer-5-module-1-reading n)) (layer-2-module-2-score (+ n 60)))) 997))

(defn layer-7-module-1-reading (n)
  (->layer-7-module-1-reading "layer-7-module-1" (layer-7-module-1-score n) (* 0.5 60.0)))
