(use many_modules/fierce_nebula fierce-nebula-score fierce-nebula-reading)
(use many_modules/silver_heron silver-heron-score silver-heron-reading)
(use many_modules/gilded_comet gilded-comet-score gilded-comet-reading)

(export olive-summit-score olive-summit-reading olive-summit-label)

(defstruct olive-summit-reading :site str :level i64 :weight f64)

(display olive-summit-reading (reading) "olive-summit " (:site reading) "=" (:level reading))

(defn olive-summit-label (n)
  (str (->olive-summit-reading "olive-summit" (olive-summit-score n) 104.5)))

(defn olive-summit-score (n)
  (rem (if (> n 1000104) (:level (gilded-comet-reading n)) (if (> n 1000104) (:level (silver-heron-reading n)) (fierce-nebula-score (+ n 104)))) 997))

(defn olive-summit-reading (n)
  (->olive-summit-reading "olive-summit" (olive-summit-score n) (* 0.5 104.0)))
