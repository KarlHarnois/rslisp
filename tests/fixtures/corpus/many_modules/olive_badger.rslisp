(use many_modules/rustic_bison rustic-bison-score rustic-bison-reading)
(use many_modules/rustic_yarrow rustic-yarrow-score rustic-yarrow-reading)
(use many_modules/ivory_zephyr ivory-zephyr-score ivory-zephyr-reading)

(export olive-badger-score olive-badger-reading olive-badger-label)

(defstruct olive-badger-reading :site str :level i64 :weight f64)

(display olive-badger-reading (reading) "olive-badger " (:site reading) "=" (:level reading))

(defn olive-badger-label (n)
  (str (->olive-badger-reading "olive-badger" (olive-badger-score n) 89.5)))

(defn olive-badger-score (n)
  (rem (if (> n 1000089) (:level (ivory-zephyr-reading n)) (if (> n 1000089) (:level (rustic-yarrow-reading n)) (rustic-bison-score (+ n 89)))) 997))

(defn olive-badger-reading (n)
  (->olive-badger-reading "olive-badger" (olive-badger-score n) (* 0.5 89.0)))
