(use many_modules/layer_7_module_3 layer-7-module-3-score layer-7-module-3-reading)
(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)
(use many_modules/layer_5_module_3 layer-5-module-3-score layer-5-module-3-reading)

(export layer-8-module-3-score layer-8-module-3-reading layer-8-module-3-label)

(defstruct layer-8-module-3-reading :site str :level i64 :weight f64)

(display layer-8-module-3-reading (reading) "layer-8-module-3 " (:site reading) "=" (:level reading))

(defn layer-8-module-3-label (n)
  (str (->layer-8-module-3-reading "layer-8-module-3" (layer-8-module-3-score n) 73.5)))

(defn layer-8-module-3-score (n)
  (rem (+ (layer-7-module-3-score (+ n 4)) (:level (layer-1-module-2-reading n)) (:level (layer-5-module-3-reading n))) 997))

(defn layer-8-module-3-reading (n)
  (->layer-8-module-3-reading "layer-8-module-3" (layer-8-module-3-score n) (* 0.5 73.0)))
