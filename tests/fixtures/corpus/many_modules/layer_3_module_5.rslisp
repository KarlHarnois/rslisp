(use many_modules/layer_2_module_5 layer-2-module-5-reading
                                   layer-2-module-5-score)

(use many_modules/layer_2_module_10 layer-2-module-10-reading
                                    layer-2-module-10-score)

(use many_modules/layer_1_module_7 layer-1-module-7-reading
                                   layer-1-module-7-score)

(export layer-3-module-5-label layer-3-module-5-reading
        layer-3-module-5-score)

(defstruct layer-3-module-5-reading
  :site str
  :level i64
  :weight f64)

(display layer-3-module-5-reading (reading)
  "layer-3-module-5 "
  (:site reading)
  "="
  (:level reading))

(defn layer-3-module-5-label (n)
  (str (->layer-3-module-5-reading "layer-3-module-5"
                                   (layer-3-module-5-score n)
                                   25.5)))

(defn layer-3-module-5-score (n)
  (rem (+ (layer-2-module-5-score (+ n 1))
          (:level (layer-2-module-10-reading n))
          (:level (layer-1-module-7-reading n)))
       997))

(defn layer-3-module-5-reading (n)
  (->layer-3-module-5-reading "layer-3-module-5"
                              (layer-3-module-5-score n)
                              (* 0.5 25.0)))
