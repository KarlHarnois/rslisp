(use many_modules/layer_2_module_5 layer-2-module-5-score layer-2-module-5-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)
(use many_modules/layer_2_module_4 layer-2-module-4-score layer-2-module-4-reading)

(export layer-3-module-5-score layer-3-module-5-reading layer-3-module-5-label)

(defstruct layer-3-module-5-reading :site str :level i64 :weight f64)

(display layer-3-module-5-reading (reading) "layer-3-module-5 " (:site reading) "=" (:level reading))

(defn layer-3-module-5-label (n)
  (str (->layer-3-module-5-reading "layer-3-module-5" (layer-3-module-5-score n) 24.5)))

(defn layer-3-module-5-score (n)
  (rem (if (> n 1000024) (:level (layer-2-module-4-reading n)) (if (> n 1000024) (:level (layer-1-module-9-reading n)) (layer-2-module-5-score (+ n 24)))) 997))

(defn layer-3-module-5-reading (n)
  (->layer-3-module-5-reading "layer-3-module-5" (layer-3-module-5-score n) (* 0.5 24.0)))
