(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)
(use many_modules/mellow_island mellow-island-score mellow-island-reading)
(use many_modules/gilded_bison gilded-bison-score gilded-bison-reading)

(export young-falcon-score young-falcon-reading young-falcon-label)

(defstruct young-falcon-reading :site str :level i64 :weight f64)

(display young-falcon-reading (reading) "young-falcon " (:site reading) "=" (:level reading))

(defn young-falcon-label (n)
  (str (->young-falcon-reading "young-falcon" (young-falcon-score n) 43.5)))

(defn young-falcon-score (n)
  (rem (if (> n 1000043) (:level (gilded-bison-reading n)) (if (> n 1000043) (:level (mellow-island-reading n)) (bold-lantern-score (+ n 43)))) 997))

(defn young-falcon-reading (n)
  (->young-falcon-reading "young-falcon" (young-falcon-score n) (* 0.5 43.0)))
