(use many_modules/layer_4_module_1 layer-4-module-1-score layer-4-module-1-reading)
(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)

(export layer-5-module-1-score layer-5-module-1-reading layer-5-module-1-label)

(defstruct layer-5-module-1-reading :site str :level i64 :weight f64)

(display layer-5-module-1-reading (reading) "layer-5-module-1 " (:site reading) "=" (:level reading))

(defn layer-5-module-1-label (n)
  (str (->layer-5-module-1-reading "layer-5-module-1" (layer-5-module-1-score n) 41.5)))

(defn layer-5-module-1-score (n)
  (rem (+ (layer-4-module-1-score (+ n 2)) (:level (layer-1-module-2-reading n)) (:level (layer-1-module-1-reading n))) 997))

(defn layer-5-module-1-reading (n)
  (->layer-5-module-1-reading "layer-5-module-1" (layer-5-module-1-score n) (* 0.5 41.0)))
