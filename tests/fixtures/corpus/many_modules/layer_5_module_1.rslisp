(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)
(use many_modules/layer_2_module_6 layer-2-module-6-score layer-2-module-6-reading)
(use many_modules/layer_1_module_7 layer-1-module-7-score layer-1-module-7-reading)

(export layer-5-module-1-score layer-5-module-1-reading layer-5-module-1-label)

(defstruct layer-5-module-1-reading :site str :level i64 :weight f64)

(display layer-5-module-1-reading (reading) "layer-5-module-1 " (:site reading) "=" (:level reading))

(defn layer-5-module-1-label (n)
  (str (->layer-5-module-1-reading "layer-5-module-1" (layer-5-module-1-score n) 40.5)))

(defn layer-5-module-1-score (n)
  (rem (if (> n 1000040) (:level (layer-1-module-7-reading n)) (if (> n 1000040) (:level (layer-2-module-6-reading n)) (layer-1-module-9-score (+ n 40)))) 997))

(defn layer-5-module-1-reading (n)
  (->layer-5-module-1-reading "layer-5-module-1" (layer-5-module-1-score n) (* 0.5 40.0)))
