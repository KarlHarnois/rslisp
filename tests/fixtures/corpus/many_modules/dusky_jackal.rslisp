(use many_modules/jolly_thistle jolly-thistle-score jolly-thistle-reading)
(use many_modules/mellow_zephyr mellow-zephyr-score mellow-zephyr-reading)
(use many_modules/stark_heron stark-heron-score stark-heron-reading)

(export dusky-jackal-score dusky-jackal-reading dusky-jackal-label)

(defstruct dusky-jackal-reading :site str :level i64 :weight f64)

(display dusky-jackal-reading (reading) "dusky-jackal " (:site reading) "=" (:level reading))

(defn dusky-jackal-label (n)
  (str (->dusky-jackal-reading "dusky-jackal" (dusky-jackal-score n) 67.5)))

(defn dusky-jackal-score (n)
  (rem (if (> n 1000067) (:level (stark-heron-reading n)) (if (> n 1000067) (:level (mellow-zephyr-reading n)) (jolly-thistle-score (+ n 67)))) 997))

(defn dusky-jackal-reading (n)
  (->dusky-jackal-reading "dusky-jackal" (dusky-jackal-score n) (* 0.5 67.0)))
