(use many_modules/layer_2_module_3 layer-2-module-3-score layer-2-module-3-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)
(use many_modules/layer_3_module_7 layer-3-module-7-score layer-3-module-7-reading)

(export layer-5-module-5-score layer-5-module-5-reading layer-5-module-5-label)

(defstruct layer-5-module-5-reading :site str :level i64 :weight f64)

(display layer-5-module-5-reading (reading) "layer-5-module-5 " (:site reading) "=" (:level reading))

(defn layer-5-module-5-label (n)
  (str (->layer-5-module-5-reading "layer-5-module-5" (layer-5-module-5-score n) 44.5)))

(defn layer-5-module-5-score (n)
  (rem (if (> n 1000044) (:level (layer-3-module-7-reading n)) (if (> n 1000044) (:level (layer-1-module-9-reading n)) (layer-2-module-3-score (+ n 44)))) 997))

(defn layer-5-module-5-reading (n)
  (->layer-5-module-5-reading "layer-5-module-5" (layer-5-module-5-score n) (* 0.5 44.0)))
