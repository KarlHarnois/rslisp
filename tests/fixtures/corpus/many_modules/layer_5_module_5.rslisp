(use many_modules/layer_4_module_5 layer-4-module-5-reading
                                   layer-4-module-5-score)

(use many_modules/layer_1_module_5 layer-1-module-5-reading
                                   layer-1-module-5-score)

(use many_modules/layer_4_module_8 layer-4-module-8-reading
                                   layer-4-module-8-score)

(export layer-5-module-5-label layer-5-module-5-reading
        layer-5-module-5-score)

(defstruct layer-5-module-5-reading
  :site str
  :level i64
  :weight f64)

(display layer-5-module-5-reading (reading)
  "layer-5-module-5 "
  (:site reading)
  "="
  (:level reading))

(defn layer-5-module-5-label (n)
  (str (->layer-5-module-5-reading "layer-5-module-5"
                                   (layer-5-module-5-score n)
                                   45.5)))

(defn layer-5-module-5-score (n)
  (rem (+ (layer-4-module-5-score (+ n 1))
          (:level (layer-1-module-5-reading n))
          (:level (layer-4-module-8-reading n)))
       997))

(defn layer-5-module-5-reading (n)
  (->layer-5-module-5-reading "layer-5-module-5"
                              (layer-5-module-5-score n)
                              (* 0.5 45.0)))
