(use many_modules/layer_2_module_7 layer-2-module-7-score layer-2-module-7-reading)
(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)
(use many_modules/layer_2_module_6 layer-2-module-6-score layer-2-module-6-reading)

(export layer-3-module-7-score layer-3-module-7-reading layer-3-module-7-label)

(defstruct layer-3-module-7-reading :site str :level i64 :weight f64)

(display layer-3-module-7-reading (reading) "layer-3-module-7 " (:site reading) "=" (:level reading))

(defn layer-3-module-7-label (n)
  (str (->layer-3-module-7-reading "layer-3-module-7" (layer-3-module-7-score n) 27.5)))

(defn layer-3-module-7-score (n)
  (rem (+ (layer-2-module-7-score (+ n 3)) (:level (layer-1-module-10-reading n)) (:level (layer-2-module-6-reading n))) 997))

(defn layer-3-module-7-reading (n)
  (->layer-3-module-7-reading "layer-3-module-7" (layer-3-module-7-score n) (* 0.5 27.0)))
