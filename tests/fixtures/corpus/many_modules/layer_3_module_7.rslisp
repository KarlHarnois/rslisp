(use many_modules/layer_2_module_1 layer-2-module-1-score layer-2-module-1-reading)
(use many_modules/layer_1_module_8 layer-1-module-8-score layer-1-module-8-reading)
(use many_modules/layer_2_module_7 layer-2-module-7-score layer-2-module-7-reading)

(export layer-3-module-7-score layer-3-module-7-reading layer-3-module-7-label)

(defstruct layer-3-module-7-reading :site str :level i64 :weight f64)

(display layer-3-module-7-reading (reading) "layer-3-module-7 " (:site reading) "=" (:level reading))

(defn layer-3-module-7-label (n)
  (str (->layer-3-module-7-reading "layer-3-module-7" (layer-3-module-7-score n) 26.5)))

(defn layer-3-module-7-score (n)
  (rem (if (> n 1000026) (:level (layer-2-module-7-reading n)) (if (> n 1000026) (:level (layer-1-module-8-reading n)) (layer-2-module-1-score (+ n 26)))) 997))

(defn layer-3-module-7-reading (n)
  (->layer-3-module-7-reading "layer-3-module-7" (layer-3-module-7-score n) (* 0.5 26.0)))
