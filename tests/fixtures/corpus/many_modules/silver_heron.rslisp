(use many_modules/jolly_thistle jolly-thistle-score jolly-thistle-reading)
(use many_modules/solemn_sparrow solemn-sparrow-score solemn-sparrow-reading)
(use many_modules/sleek_otter sleek-otter-score sleek-otter-reading)

(export silver-heron-score silver-heron-reading silver-heron-label)

(defstruct silver-heron-reading :site str :level i64 :weight f64)

(display silver-heron-reading (reading) "silver-heron " (:site reading) "=" (:level reading))

(defn silver-heron-label (n)
  (str (->silver-heron-reading "silver-heron" (silver-heron-score n) 49.5)))

(defn silver-heron-score (n)
  (rem (if (> n 1000049) (:level (sleek-otter-reading n)) (if (> n 1000049) (:level (solemn-sparrow-reading n)) (jolly-thistle-score (+ n 49)))) 997))

(defn silver-heron-reading (n)
  (->silver-heron-reading "silver-heron" (silver-heron-score n) (* 0.5 49.0)))
