
(export layer-1-module-8-score layer-1-module-8-reading layer-1-module-8-label)

(defstruct layer-1-module-8-reading :site str :level i64 :weight f64)

(display layer-1-module-8-reading (reading) "layer-1-module-8 " (:site reading) "=" (:level reading))

(defn layer-1-module-8-label (n)
  (str (->layer-1-module-8-reading "layer-1-module-8" (layer-1-module-8-score n) 7.5)))

(defn layer-1-module-8-score (n)
  (rem (+ (* n 7) 10) 997))

(defn layer-1-module-8-reading (n)
  (->layer-1-module-8-reading "layer-1-module-8" (layer-1-module-8-score n) (* 0.5 7.0)))
