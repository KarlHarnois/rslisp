(use many_modules/layer_6_module_4 layer-6-module-4-score layer-6-module-4-reading)
(use many_modules/layer_6_module_2 layer-6-module-2-score layer-6-module-2-reading)
(use many_modules/layer_4_module_8 layer-4-module-8-score layer-4-module-8-reading)

(export layer-7-module-4-score layer-7-module-4-reading layer-7-module-4-label)

(defstruct layer-7-module-4-reading :site str :level i64 :weight f64)

(display layer-7-module-4-reading (reading) "layer-7-module-4 " (:site reading) "=" (:level reading))

(defn layer-7-module-4-label (n)
  (str (->layer-7-module-4-reading "layer-7-module-4" (layer-7-module-4-score n) 64.5)))

(defn layer-7-module-4-score (n)
  (rem (+ (layer-6-module-4-score (+ n 5)) (:level (layer-6-module-2-reading n)) (:level (layer-4-module-8-reading n))) 997))

(defn layer-7-module-4-reading (n)
  (->layer-7-module-4-reading "layer-7-module-4" (layer-7-module-4-score n) (* 0.5 64.0)))
