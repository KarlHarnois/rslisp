(use many_modules/layer_2_module_9 layer-2-module-9-score layer-2-module-9-reading)
(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)
(use many_modules/layer_2_module_3 layer-2-module-3-score layer-2-module-3-reading)

(export layer-3-module-9-score layer-3-module-9-reading layer-3-module-9-label)

(defstruct layer-3-module-9-reading :site str :level i64 :weight f64)

(display layer-3-module-9-reading (reading) "layer-3-module-9 " (:site reading) "=" (:level reading))

(defn layer-3-module-9-label (n)
  (str (->layer-3-module-9-reading "layer-3-module-9" (layer-3-module-9-score n) 28.5)))

(defn layer-3-module-9-score (n)
  (rem (if (> n 1000028) (:level (layer-2-module-3-reading n)) (if (> n 1000028) (:level (layer-1-module-4-reading n)) (layer-2-module-9-score (+ n 28)))) 997))

(defn layer-3-module-9-reading (n)
  (->layer-3-module-9-reading "layer-3-module-9" (layer-3-module-9-score n) (* 0.5 28.0)))
