(use many_modules/layer_2_module_9 layer-2-module-9-reading
                                   layer-2-module-9-score)

(use many_modules/layer_2_module_5 layer-2-module-5-reading
                                   layer-2-module-5-score)

(use many_modules/layer_1_module_9 layer-1-module-9-reading
                                   layer-1-module-9-score)

(export layer-3-module-9-label layer-3-module-9-reading
        layer-3-module-9-score)

(defstruct layer-3-module-9-reading
  :site str
  :level i64
  :weight f64)

(display layer-3-module-9-reading (reading)
  "layer-3-module-9 "
  (:site reading)
  "="
  (:level reading))

(defn layer-3-module-9-label (n)
  (str (->layer-3-module-9-reading "layer-3-module-9"
                                   (layer-3-module-9-score n)
                                   29.5)))

(defn layer-3-module-9-score (n)
  (rem (+ (layer-2-module-9-score (+ n 5))
          (:level (layer-2-module-5-reading n))
          (:level (layer-1-module-9-reading n)))
       997))

(defn layer-3-module-9-reading (n)
  (->layer-3-module-9-reading "layer-3-module-9"
                              (layer-3-module-9-score n)
                              (* 0.5 29.0)))
