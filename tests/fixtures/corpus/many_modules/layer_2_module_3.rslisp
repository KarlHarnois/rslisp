(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)

(export layer-2-module-3-score layer-2-module-3-reading layer-2-module-3-label)

(defstruct layer-2-module-3-reading :site str :level i64 :weight f64)

(display layer-2-module-3-reading (reading) "layer-2-module-3 " (:site reading) "=" (:level reading))

(defn layer-2-module-3-label (n)
  (str (->layer-2-module-3-reading "layer-2-module-3" (layer-2-module-3-score n) 13.5)))

(defn layer-2-module-3-score (n)
  (rem (+ (layer-1-module-3-score (+ n 4)) (:level (layer-1-module-4-reading n)) (:level (layer-1-module-9-reading n))) 997))

(defn layer-2-module-3-reading (n)
  (->layer-2-module-3-reading "layer-2-module-3" (layer-2-module-3-score n) (* 0.5 13.0)))
