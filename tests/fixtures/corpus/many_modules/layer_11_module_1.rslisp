(use many_modules/layer_10_module_1 layer-10-module-1-score layer-10-module-1-reading)
(use many_modules/layer_3_module_7 layer-3-module-7-score layer-3-module-7-reading)
(use many_modules/layer_10_module_7 layer-10-module-7-score layer-10-module-7-reading)

(export layer-11-module-1-score layer-11-module-1-reading layer-11-module-1-label)

(defstruct layer-11-module-1-reading :site str :level i64 :weight f64)

(display layer-11-module-1-reading (reading) "layer-11-module-1 " (:site reading) "=" (:level reading))

(defn layer-11-module-1-label (n)
  (str (->layer-11-module-1-reading "layer-11-module-1" (layer-11-module-1-score n) 101.5)))

(defn layer-11-module-1-score (n)
  (rem (+ (layer-10-module-1-score (+ n 2)) (:level (layer-3-module-7-reading n)) (:level (layer-10-module-7-reading n))) 997))

(defn layer-11-module-1-reading (n)
  (->layer-11-module-1-reading "layer-11-module-1" (layer-11-module-1-score n) (* 0.5 101.0)))
