(use many_modules/swift_tundra swift-tundra-score swift-tundra-reading)
(use many_modules/vivid_lantern vivid-lantern-score vivid-lantern-reading)
(use many_modules/vivid_otter vivid-otter-score vivid-otter-reading)

(export dusky-meadow-score dusky-meadow-reading dusky-meadow-label)

(defstruct dusky-meadow-reading :site str :level i64 :weight f64)

(display dusky-meadow-reading (reading) "dusky-meadow " (:site reading) "=" (:level reading))

(defn dusky-meadow-label (n)
  (str (->dusky-meadow-reading "dusky-meadow" (dusky-meadow-score n) 65.5)))

(defn dusky-meadow-score (n)
  (rem (if (> n 1000065) (:level (vivid-otter-reading n)) (if (> n 1000065) (:level (vivid-lantern-reading n)) (swift-tundra-score (+ n 65)))) 997))

(defn dusky-meadow-reading (n)
  (->dusky-meadow-reading "dusky-meadow" (dusky-meadow-score n) (* 0.5 65.0)))
