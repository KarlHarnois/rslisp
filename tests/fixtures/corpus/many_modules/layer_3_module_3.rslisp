(use many_modules/layer_2_module_3 layer-2-module-3-score layer-2-module-3-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)
(use many_modules/layer_2_module_6 layer-2-module-6-score layer-2-module-6-reading)

(export layer-3-module-3-score layer-3-module-3-reading layer-3-module-3-label)

(defstruct layer-3-module-3-reading :site str :level i64 :weight f64)

(display layer-3-module-3-reading (reading) "layer-3-module-3 " (:site reading) "=" (:level reading))

(defn layer-3-module-3-label (n)
  (str (->layer-3-module-3-reading "layer-3-module-3" (layer-3-module-3-score n) 23.5)))

(defn layer-3-module-3-score (n)
  (rem (+ (layer-2-module-3-score (+ n 4)) (:level (layer-1-module-1-reading n)) (:level (layer-2-module-6-reading n))) 997))

(defn layer-3-module-3-reading (n)
  (->layer-3-module-3-reading "layer-3-module-3" (layer-3-module-3-score n) (* 0.5 23.0)))
