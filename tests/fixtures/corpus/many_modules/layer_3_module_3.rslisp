(use many_modules/layer_2_module_7 layer-2-module-7-score layer-2-module-7-reading)
(use many_modules/layer_1_module_8 layer-1-module-8-score layer-1-module-8-reading)
(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)

(export layer-3-module-3-score layer-3-module-3-reading layer-3-module-3-label)

(defstruct layer-3-module-3-reading :site str :level i64 :weight f64)

(display layer-3-module-3-reading (reading) "layer-3-module-3 " (:site reading) "=" (:level reading))

(defn layer-3-module-3-label (n)
  (str (->layer-3-module-3-reading "layer-3-module-3" (layer-3-module-3-score n) 22.5)))

(defn layer-3-module-3-score (n)
  (rem (if (> n 1000022) (:level (layer-1-module-10-reading n)) (if (> n 1000022) (:level (layer-1-module-8-reading n)) (layer-2-module-7-score (+ n 22)))) 997))

(defn layer-3-module-3-reading (n)
  (->layer-3-module-3-reading "layer-3-module-3" (layer-3-module-3-score n) (* 0.5 22.0)))
