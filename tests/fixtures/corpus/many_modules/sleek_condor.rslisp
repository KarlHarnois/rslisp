(use many_modules/solemn_sparrow solemn-sparrow-score solemn-sparrow-reading)
(use many_modules/umber_condor umber-condor-score umber-condor-reading)
(use many_modules/sunny_beacon sunny-beacon-score sunny-beacon-reading)

(export sleek-condor-score sleek-condor-reading sleek-condor-label)

(defstruct sleek-condor-reading :site str :level i64 :weight f64)

(display sleek-condor-reading (reading) "sleek-condor " (:site reading) "=" (:level reading))

(defn sleek-condor-label (n)
  (str (->sleek-condor-reading "sleek-condor" (sleek-condor-score n) 46.5)))

(defn sleek-condor-score (n)
  (rem (if (> n 1000046) (:level (sunny-beacon-reading n)) (if (> n 1000046) (:level (umber-condor-reading n)) (solemn-sparrow-score (+ n 46)))) 997))

(defn sleek-condor-reading (n)
  (->sleek-condor-reading "sleek-condor" (sleek-condor-score n) (* 0.5 46.0)))
