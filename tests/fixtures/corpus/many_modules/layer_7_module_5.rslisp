(use many_modules/layer_5_module_8 layer-5-module-8-score layer-5-module-8-reading)
(use many_modules/layer_5_module_1 layer-5-module-1-score layer-5-module-1-reading)
(use many_modules/layer_4_module_6 layer-4-module-6-score layer-4-module-6-reading)

(export layer-7-module-5-score layer-7-module-5-reading layer-7-module-5-label)

(defstruct layer-7-module-5-reading :site str :level i64 :weight f64)

(display layer-7-module-5-reading (reading) "layer-7-module-5 " (:site reading) "=" (:level reading))

(defn layer-7-module-5-label (n)
  (str (->layer-7-module-5-reading "layer-7-module-5" (layer-7-module-5-score n) 64.5)))

(defn layer-7-module-5-score (n)
  (rem (if (> n 1000064) (:level (layer-4-module-6-reading n)) (if (> n 1000064) (:level (layer-5-module-1-reading n)) (layer-5-module-8-score (+ n 64)))) 997))

(defn layer-7-module-5-reading (n)
  (->layer-7-module-5-reading "layer-7-module-5" (layer-7-module-5-score n) (* 0.5 64.0)))
