(use many_modules/layer_6_module_5 layer-6-module-5-reading
                                   layer-6-module-5-score)

(use many_modules/layer_2_module_10 layer-2-module-10-reading
                                    layer-2-module-10-score)

(use many_modules/layer_6_module_8 layer-6-module-8-reading
                                   layer-6-module-8-score)

(export layer-7-module-5-label layer-7-module-5-reading
        layer-7-module-5-score)

(defstruct layer-7-module-5-reading
  :site str
  :level i64
  :weight f64)

(display layer-7-module-5-reading (reading)
  "layer-7-module-5 "
  (:site reading)
  "="
  (:level reading))

(defn layer-7-module-5-label (n)
  (str (->layer-7-module-5-reading "layer-7-module-5"
                                   (layer-7-module-5-score n)
                                   65.5)))

(defn layer-7-module-5-score (n)
  (rem (+ (layer-6-module-5-score (+ n 1))
          (:level (layer-2-module-10-reading n))
          (:level (layer-6-module-8-reading n)))
       997))

(defn layer-7-module-5-reading (n)
  (->layer-7-module-5-reading "layer-7-module-5"
                              (layer-7-module-5-score n)
                              (* 0.5 65.0)))
