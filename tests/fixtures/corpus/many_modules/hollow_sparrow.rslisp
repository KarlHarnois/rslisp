(use many_modules/sunny_beacon sunny-beacon-score sunny-beacon-reading)
(use many_modules/sleek_condor sleek-condor-score sleek-condor-reading)
(use many_modules/stark_fern stark-fern-score stark-fern-reading)

(export hollow-sparrow-score hollow-sparrow-reading hollow-sparrow-label)

(defstruct hollow-sparrow-reading :site str :level i64 :weight f64)

(display hollow-sparrow-reading (reading) "hollow-sparrow " (:site reading) "=" (:level reading))

(defn hollow-sparrow-label (n)
  (str (->hollow-sparrow-reading "hollow-sparrow" (hollow-sparrow-score n) 53.5)))

(defn hollow-sparrow-score (n)
  (rem (if (> n 1000053) (:level (stark-fern-reading n)) (if (> n 1000053) (:level (sleek-condor-reading n)) (sunny-beacon-score (+ n 53)))) 997))

(defn hollow-sparrow-reading (n)
  (->hollow-sparrow-reading "hollow-sparrow" (hollow-sparrow-score n) (* 0.5 53.0)))
