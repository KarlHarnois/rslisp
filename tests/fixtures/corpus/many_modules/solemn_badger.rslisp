(use many_modules/brisk_heron brisk-heron-score brisk-heron-reading)
(use many_modules/hollow_sparrow hollow-sparrow-score hollow-sparrow-reading)
(use many_modules/olive_marten olive-marten-score olive-marten-reading)

(export solemn-badger-score solemn-badger-reading solemn-badger-label)

(defstruct solemn-badger-reading :site str :level i64 :weight f64)

(display solemn-badger-reading (reading) "solemn-badger " (:site reading) "=" (:level reading))

(defn solemn-badger-label (n)
  (str (->solemn-badger-reading "solemn-badger" (solemn-badger-score n) 87.5)))

(defn solemn-badger-score (n)
  (rem (if (> n 1000087) (:level (olive-marten-reading n)) (if (> n 1000087) (:level (hollow-sparrow-reading n)) (brisk-heron-score (+ n 87)))) 997))

(defn solemn-badger-reading (n)
  (->solemn-badger-reading "solemn-badger" (solemn-badger-score n) (* 0.5 87.0)))
