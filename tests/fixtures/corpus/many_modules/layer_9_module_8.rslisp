(use many_modules/layer_8_module_8 layer-8-module-8-score layer-8-module-8-reading)
(use many_modules/layer_6_module_4 layer-6-module-4-score layer-6-module-4-reading)
(use many_modules/layer_1_module_7 layer-1-module-7-score layer-1-module-7-reading)

(export layer-9-module-8-score layer-9-module-8-reading layer-9-module-8-label)

(defstruct layer-9-module-8-reading :site str :level i64 :weight f64)

(display layer-9-module-8-reading (reading) "layer-9-module-8 " (:site reading) "=" (:level reading))

(defn layer-9-module-8-label (n)
  (str (->layer-9-module-8-reading "layer-9-module-8" (layer-9-module-8-score n) 88.5)))

(defn layer-9-module-8-score (n)
  (rem (+ (layer-8-module-8-score (+ n 4)) (:level (layer-6-module-4-reading n)) (:level (layer-1-module-7-reading n))) 997))

(defn layer-9-module-8-reading (n)
  (->layer-9-module-8-reading "layer-9-module-8" (layer-9-module-8-score n) (* 0.5 88.0)))
