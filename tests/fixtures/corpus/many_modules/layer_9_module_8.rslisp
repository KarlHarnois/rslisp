(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)
(use many_modules/layer_6_module_8 layer-6-module-8-score layer-6-module-8-reading)
(use many_modules/layer_7_module_10 layer-7-module-10-score layer-7-module-10-reading)

(export layer-9-module-8-score layer-9-module-8-reading layer-9-module-8-label)

(defstruct layer-9-module-8-reading :site str :level i64 :weight f64)

(display layer-9-module-8-reading (reading) "layer-9-module-8 " (:site reading) "=" (:level reading))

(defn layer-9-module-8-label (n)
  (str (->layer-9-module-8-reading "layer-9-module-8" (layer-9-module-8-score n) 87.5)))

(defn layer-9-module-8-score (n)
  (rem (if (> n 1000087) (:level (layer-7-module-10-reading n)) (if (> n 1000087) (:level (layer-6-module-8-reading n)) (layer-1-module-10-score (+ n 87)))) 997))

(defn layer-9-module-8-reading (n)
  (->layer-9-module-8-reading "layer-9-module-8" (layer-9-module-8-score n) (* 0.5 87.0)))
