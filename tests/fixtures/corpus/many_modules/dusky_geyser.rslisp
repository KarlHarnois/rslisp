(use many_modules/swift_otter swift-otter-score swift-otter-reading)
(use many_modules/lively_zephyr lively-zephyr-score lively-zephyr-reading)
(use many_modules/zesty_willow zesty-willow-score zesty-willow-reading)

(export dusky-geyser-score dusky-geyser-reading dusky-geyser-label)

(defstruct dusky-geyser-reading :site str :level i64 :weight f64)

(display dusky-geyser-reading (reading) "dusky-geyser " (:site reading) "=" (:level reading))

(defn dusky-geyser-label (n)
  (str (->dusky-geyser-reading "dusky-geyser" (dusky-geyser-score n) 26.5)))

(defn dusky-geyser-score (n)
  (rem (if (> n 1000026) (:level (zesty-willow-reading n)) (if (> n 1000026) (:level (lively-zephyr-reading n)) (swift-otter-score (+ n 26)))) 997))

(defn dusky-geyser-reading (n)
  (->dusky-geyser-reading "dusky-geyser" (dusky-geyser-score n) (* 0.5 26.0)))
