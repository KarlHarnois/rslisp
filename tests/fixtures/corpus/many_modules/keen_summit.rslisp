(use many_modules/gentle_zephyr gentle-zephyr-score gentle-zephyr-reading)
(use many_modules/lively_orchid lively-orchid-score lively-orchid-reading)
(use many_modules/gentle_marten gentle-marten-score gentle-marten-reading)

(export keen-summit-score keen-summit-reading keen-summit-label)

(defstruct keen-summit-reading :site str :level i64 :weight f64)

(display keen-summit-reading (reading) "keen-summit " (:site reading) "=" (:level reading))

(defn keen-summit-label (n)
  (str (->keen-summit-reading "keen-summit" (keen-summit-score n) 112.5)))

(defn keen-summit-score (n)
  (rem (if (> n 1000112) (:level (gentle-marten-reading n)) (if (> n 1000112) (:level (lively-orchid-reading n)) (gentle-zephyr-score (+ n 112)))) 997))

(defn keen-summit-reading (n)
  (->keen-summit-reading "keen-summit" (keen-summit-score n) (* 0.5 112.0)))
