
(export layer-1-module-4-score layer-1-module-4-reading layer-1-module-4-label)

(defstruct layer-1-module-4-reading :site str :level i64 :weight f64)

(display layer-1-module-4-reading (reading) "layer-1-module-4 " (:site reading) "=" (:level reading))

(defn layer-1-module-4-label (n)
  (str (->layer-1-module-4-reading "layer-1-module-4" (layer-1-module-4-score n) 3.5)))

(defn layer-1-module-4-score (n)
  (rem (+ (* n 7) 6) 997))

(defn layer-1-module-4-reading (n)
  (->layer-1-module-4-reading "layer-1-module-4" (layer-1-module-4-score n) (* 0.5 3.0)))
