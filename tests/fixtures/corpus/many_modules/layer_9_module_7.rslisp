(use many_modules/layer_8_module_7 layer-8-module-7-score layer-8-module-7-reading)
(use many_modules/layer_8_module_9 layer-8-module-9-score layer-8-module-9-reading)
(use many_modules/layer_2_module_1 layer-2-module-1-score layer-2-module-1-reading)

(export layer-9-module-7-score layer-9-module-7-reading layer-9-module-7-label)

(defstruct layer-9-module-7-reading :site str :level i64 :weight f64)

(display layer-9-module-7-reading (reading) "layer-9-module-7 " (:site reading) "=" (:level reading))

(defn layer-9-module-7-label (n)
  (str (->layer-9-module-7-reading "layer-9-module-7" (layer-9-module-7-score n) 87.5)))

(defn layer-9-module-7-score (n)
  (rem (+ (layer-8-module-7-score (+ n 3)) (:level (layer-8-module-9-reading n)) (:level (layer-2-module-1-reading n))) 997))

(defn layer-9-module-7-reading (n)
  (->layer-9-module-7-reading "layer-9-module-7" (layer-9-module-7-score n) (* 0.5 87.0)))
