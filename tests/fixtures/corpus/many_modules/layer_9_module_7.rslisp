(use many_modules/layer_4_module_10 layer-4-module-10-score layer-4-module-10-reading)
(use many_modules/layer_5_module_1 layer-5-module-1-score layer-5-module-1-reading)
(use many_modules/layer_2_module_8 layer-2-module-8-score layer-2-module-8-reading)

(export layer-9-module-7-score layer-9-module-7-reading layer-9-module-7-label)

(defstruct layer-9-module-7-reading :site str :level i64 :weight f64)

(display layer-9-module-7-reading (reading) "layer-9-module-7 " (:site reading) "=" (:level reading))

(defn layer-9-module-7-label (n)
  (str (->layer-9-module-7-reading "layer-9-module-7" (layer-9-module-7-score n) 86.5)))

(defn layer-9-module-7-score (n)
  (rem (if (> n 1000086) (:level (layer-2-module-8-reading n)) (if (> n 1000086) (:level (layer-5-module-1-reading n)) (layer-4-module-10-score (+ n 86)))) 997))

(defn layer-9-module-7-reading (n)
  (->layer-9-module-7-reading "layer-9-module-7" (layer-9-module-7-score n) (* 0.5 86.0)))
