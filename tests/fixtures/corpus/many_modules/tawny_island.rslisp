(use many_modules/zesty_walrus zesty-walrus-score zesty-walrus-reading)
(use many_modules/lively_orchid lively-orchid-score lively-orchid-reading)
(use many_modules/placid_tundra placid-tundra-score placid-tundra-reading)

(export tawny-island-score tawny-island-reading tawny-island-label)

(defstruct tawny-island-reading :site str :level i64 :weight f64)

(display tawny-island-reading (reading) "tawny-island " (:site reading) "=" (:level reading))

(defn tawny-island-label (n)
  (str (->tawny-island-reading "tawny-island" (tawny-island-score n) 106.5)))

(defn tawny-island-score (n)
  (rem (if (> n 1000106) (:level (placid-tundra-reading n)) (if (> n 1000106) (:level (lively-orchid-reading n)) (zesty-walrus-score (+ n 106)))) 997))

(defn tawny-island-reading (n)
  (->tawny-island-reading "tawny-island" (tawny-island-score n) (* 0.5 106.0)))
