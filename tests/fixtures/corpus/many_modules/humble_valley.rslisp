(use many_modules/swift_geyser swift-geyser-score swift-geyser-reading)
(use many_modules/wary_otter wary-otter-score wary-otter-reading)
(use many_modules/quiet_valley quiet-valley-score quiet-valley-reading)

(export humble-valley-score humble-valley-reading humble-valley-label)

(defstruct humble-valley-reading :site str :level i64 :weight f64)

(display humble-valley-reading (reading) "humble-valley " (:site reading) "=" (:level reading))

(defn humble-valley-label (n)
  (str (->humble-valley-reading "humble-valley" (humble-valley-score n) 83.5)))

(defn humble-valley-score (n)
  (rem (if (> n 1000083) (:level (quiet-valley-reading n)) (if (> n 1000083) (:level (wary-otter-reading n)) (swift-geyser-score (+ n 83)))) 997))

(defn humble-valley-reading (n)
  (->humble-valley-reading "humble-valley" (humble-valley-score n) (* 0.5 83.0)))
