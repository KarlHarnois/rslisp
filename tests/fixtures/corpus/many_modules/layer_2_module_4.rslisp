(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)

(export layer-2-module-4-score layer-2-module-4-reading layer-2-module-4-label)

(defstruct layer-2-module-4-reading :site str :level i64 :weight f64)

(display layer-2-module-4-reading (reading) "layer-2-module-4 " (:site reading) "=" (:level reading))

(defn layer-2-module-4-label (n)
  (str (->layer-2-module-4-reading "layer-2-module-4" (layer-2-module-4-score n) 14.5)))

(defn layer-2-module-4-score (n)
  (rem (+ (layer-1-module-4-score (+ n 5)) (:level (layer-1-module-3-reading n)) (:level (layer-1-module-2-reading n))) 997))

(defn layer-2-module-4-reading (n)
  (->layer-2-module-4-reading "layer-2-module-4" (layer-2-module-4-score n) (* 0.5 14.0)))
