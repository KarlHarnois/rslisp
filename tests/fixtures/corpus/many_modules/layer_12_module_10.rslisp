(use many_modules/layer_10_module_2 layer-10-module-2-score layer-10-module-2-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)
(use many_modules/layer_4_module_6 layer-4-module-6-score layer-4-module-6-reading)

(export layer-12-module-10-score layer-12-module-10-reading layer-12-module-10-label)

(defstruct layer-12-module-10-reading :site str :level i64 :weight f64)

(display layer-12-module-10-reading (reading) "layer-12-module-10 " (:site reading) "=" (:level reading))

(defn layer-12-module-10-label (n)
  (str (->layer-12-module-10-reading "layer-12-module-10" (layer-12-module-10-score n) 119.5)))

(defn layer-12-module-10-score (n)
  (rem (if (> n 1000119) (:level (layer-4-module-6-reading n)) (if (> n 1000119) (:level (layer-1-module-9-reading n)) (layer-10-module-2-score (+ n 119)))) 997))

(defn layer-12-module-10-reading (n)
  (->layer-12-module-10-reading "layer-12-module-10" (layer-12-module-10-score n) (* 0.5 119.0)))
