(use many_modules/lively_orchid lively-orchid-score lively-orchid-reading)
(use many_modules/sleek_otter sleek-otter-score sleek-otter-reading)
(use many_modules/rustic_tundra rustic-tundra-score rustic-tundra-reading)

(export sunny-raven-score sunny-raven-reading sunny-raven-label)

(defstruct sunny-raven-reading :site str :level i64 :weight f64)

(display sunny-raven-reading (reading) "sunny-raven " (:site reading) "=" (:level reading))

(defn sunny-raven-label (n)
  (str (->sunny-raven-reading "sunny-raven" (sunny-raven-score n) 100.5)))

(defn sunny-raven-score (n)
  (rem (if (> n 1000100) (:level (rustic-tundra-reading n)) (if (> n 1000100) (:level (sleek-otter-reading n)) (lively-orchid-score (+ n 100)))) 997))

(defn sunny-raven-reading (n)
  (->sunny-raven-reading "sunny-raven" (sunny-raven-score n) (* 0.5 100.0)))
