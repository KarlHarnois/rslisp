(use many_modules/solemn_quarry solemn-quarry-score solemn-quarry-reading)
(use many_modules/keen_tundra keen-tundra-score keen-tundra-reading)
(use many_modules/mellow_island mellow-island-score mellow-island-reading)

(export stark-heron-score stark-heron-reading stark-heron-label)

(defstruct stark-heron-reading :site str :level i64 :weight f64)

(display stark-heron-reading (reading) "stark-heron " (:site reading) "=" (:level reading))

(defn stark-heron-label (n)
  (str (->stark-heron-reading "stark-heron" (stark-heron-score n) 52.5)))

(defn stark-heron-score (n)
  (rem (if (> n 1000052) (:level (mellow-island-reading n)) (if (> n 1000052) (:level (keen-tundra-reading n)) (solemn-quarry-score (+ n 52)))) 997))

(defn stark-heron-reading (n)
  (->stark-heron-reading "stark-heron" (stark-heron-score n) (* 0.5 52.0)))
