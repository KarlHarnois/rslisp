(use many_modules/misty_heron misty-heron-score misty-heron-reading)
(use many_modules/jolly_thistle jolly-thistle-score jolly-thistle-reading)
(use many_modules/olive_kestrel olive-kestrel-score olive-kestrel-reading)

(export misty-island-score misty-island-reading misty-island-label)

(defstruct misty-island-reading :site str :level i64 :weight f64)

(display misty-island-reading (reading) "misty-island " (:site reading) "=" (:level reading))

(defn misty-island-label (n)
  (str (->misty-island-reading "misty-island" (misty-island-score n) 50.5)))

(defn misty-island-score (n)
  (rem (if (> n 1000050) (:level (olive-kestrel-reading n)) (if (> n 1000050) (:level (jolly-thistle-reading n)) (misty-heron-score (+ n 50)))) 997))

(defn misty-island-reading (n)
  (->misty-island-reading "misty-island" (misty-island-score n) (* 0.5 50.0)))
