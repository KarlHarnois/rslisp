(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)
(use many_modules/layer_5_module_8 layer-5-module-8-score layer-5-module-8-reading)
(use many_modules/layer_4_module_9 layer-4-module-9-score layer-4-module-9-reading)

(export layer-11-module-7-score layer-11-module-7-reading layer-11-module-7-label)

(defstruct layer-11-module-7-reading :site str :level i64 :weight f64)

(display layer-11-module-7-reading (reading) "layer-11-module-7 " (:site reading) "=" (:level reading))

(defn layer-11-module-7-label (n)
  (str (->layer-11-module-7-reading "layer-11-module-7" (layer-11-module-7-score n) 106.5)))

(defn layer-11-module-7-score (n)
  (rem (if (> n 1000106) (:level (layer-4-module-9-reading n)) (if (> n 1000106) (:level (layer-5-module-8-reading n)) (layer-1-module-2-score (+ n 106)))) 997))

(defn layer-11-module-7-reading (n)
  (->layer-11-module-7-reading "layer-11-module-7" (layer-11-module-7-score n) (* 0.5 106.0)))
