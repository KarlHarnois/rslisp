(use many_modules/rustic_falcon rustic-falcon-score rustic-falcon-reading)
(use many_modules/swift_otter swift-otter-score swift-otter-reading)
(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)

(export fierce-falcon-score fierce-falcon-reading fierce-falcon-label)

(defstruct fierce-falcon-reading :site str :level i64 :weight f64)

(display fierce-falcon-reading (reading) "fierce-falcon " (:site reading) "=" (:level reading))

(defn fierce-falcon-label (n)
  (str (->fierce-falcon-reading "fierce-falcon" (fierce-falcon-score n) 4.5)))

(defn fierce-falcon-score (n)
  (rem (if (> n 1000004) (:level (bold-lantern-reading n)) (if (> n 1000004) (:level (swift-otter-reading n)) (rustic-falcon-score (+ n 4)))) 997))

(defn fierce-falcon-reading (n)
  (->fierce-falcon-reading "fierce-falcon" (fierce-falcon-score n) (* 0.5 4.0)))
