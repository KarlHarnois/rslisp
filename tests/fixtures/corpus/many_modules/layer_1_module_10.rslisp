
(export layer-1-module-10-score layer-1-module-10-reading layer-1-module-10-label)

(defstruct layer-1-module-10-reading :site str :level i64 :weight f64)

(display layer-1-module-10-reading (reading) "layer-1-module-10 " (:site reading) "=" (:level reading))

(defn layer-1-module-10-label (n)
  (str (->layer-1-module-10-reading "layer-1-module-10" (layer-1-module-10-score n) 9.5)))

(defn layer-1-module-10-score (n)
  (rem (+ (* n 7) 12) 997))

(defn layer-1-module-10-reading (n)
  (->layer-1-module-10-reading "layer-1-module-10" (layer-1-module-10-score n) (* 0.5 9.0)))
