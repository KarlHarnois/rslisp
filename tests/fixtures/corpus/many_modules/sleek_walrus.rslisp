(use many_modules/fierce_falcon fierce-falcon-score fierce-falcon-reading)
(use many_modules/swift_otter swift-otter-score swift-otter-reading)
(use many_modules/vivid_lantern vivid-lantern-score vivid-lantern-reading)

(export sleek-walrus-score sleek-walrus-reading sleek-walrus-label)

(defstruct sleek-walrus-reading :site str :level i64 :weight f64)

(display sleek-walrus-reading (reading) "sleek-walrus " (:site reading) "=" (:level reading))

(defn sleek-walrus-label (n)
  (str (->sleek-walrus-reading "sleek-walrus" (sleek-walrus-score n) 75.5)))

(defn sleek-walrus-score (n)
  (rem (if (> n 1000075) (:level (vivid-lantern-reading n)) (if (> n 1000075) (:level (swift-otter-reading n)) (fierce-falcon-score (+ n 75)))) 997))

(defn sleek-walrus-reading (n)
  (->sleek-walrus-reading "sleek-walrus" (sleek-walrus-score n) (* 0.5 75.0)))
