(use many_modules/layer_2_module_1 layer-2-module-1-score layer-2-module-1-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)
(use many_modules/layer_2_module_4 layer-2-module-4-score layer-2-module-4-reading)

(export layer-4-module-9-score layer-4-module-9-reading layer-4-module-9-label)

(defstruct layer-4-module-9-reading :site str :level i64 :weight f64)

(display layer-4-module-9-reading (reading) "layer-4-module-9 " (:site reading) "=" (:level reading))

(defn layer-4-module-9-label (n)
  (str (->layer-4-module-9-reading "layer-4-module-9" (layer-4-module-9-score n) 38.5)))

(defn layer-4-module-9-score (n)
  (rem (if (> n 1000038) (:level (layer-2-module-4-reading n)) (if (> n 1000038) (:level (layer-1-module-1-reading n)) (layer-2-module-1-score (+ n 38)))) 997))

(defn layer-4-module-9-reading (n)
  (->layer-4-module-9-reading "layer-4-module-9" (layer-4-module-9-score n) (* 0.5 38.0)))
