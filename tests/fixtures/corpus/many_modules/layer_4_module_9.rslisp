(use many_modules/layer_3_module_9 layer-3-module-9-reading
                                   layer-3-module-9-score)

(use many_modules/layer_3_module_8 layer-3-module-8-reading
                                   layer-3-module-8-score)

(use many_modules/layer_1_module_10 layer-1-module-10-reading
                                    layer-1-module-10-score)

(export layer-4-module-9-label layer-4-module-9-reading
        layer-4-module-9-score)

(defstruct layer-4-module-9-reading
  :site str
  :level i64
  :weight f64)

(display layer-4-module-9-reading (reading)
  "layer-4-module-9 "
  (:site reading)
  "="
  (:level reading))

(defn layer-4-module-9-label (n)
  (str (->layer-4-module-9-reading "layer-4-module-9"
                                   (layer-4-module-9-score n)
                                   39.5)))

(defn layer-4-module-9-score (n)
  (rem (+ (layer-3-module-9-score (+ n 5))
          (:level (layer-3-module-8-reading n))
          (:level (layer-1-module-10-reading n)))
       997))

(defn layer-4-module-9-reading (n)
  (->layer-4-module-9-reading "layer-4-module-9"
                              (layer-4-module-9-score n)
                              (* 0.5 39.0)))
