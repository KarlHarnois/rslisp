(use many_modules/layer_6_module_7 layer-6-module-7-score layer-6-module-7-reading)
(use many_modules/layer_7_module_4 layer-7-module-4-score layer-7-module-4-reading)
(use many_modules/layer_4_module_1 layer-4-module-1-score layer-4-module-1-reading)

(export layer-12-module-1-score layer-12-module-1-reading layer-12-module-1-label)

(defstruct layer-12-module-1-reading :site str :level i64 :weight f64)

(display layer-12-module-1-reading (reading) "layer-12-module-1 " (:site reading) "=" (:level reading))

(defn layer-12-module-1-label (n)
  (str (->layer-12-module-1-reading "layer-12-module-1" (layer-12-module-1-score n) 110.5)))

(defn layer-12-module-1-score (n)
  (rem (if (> n 1000110) (:level (layer-4-module-1-reading n)) (if (> n 1000110) (:level (layer-7-module-4-reading n)) (layer-6-module-7-score (+ n 110)))) 997))

(defn layer-12-module-1-reading (n)
  (->layer-12-module-1-reading "layer-12-module-1" (layer-12-module-1-score n) (* 0.5 110.0)))
