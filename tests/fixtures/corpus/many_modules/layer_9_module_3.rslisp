(use many_modules/layer_8_module_6 layer-8-module-6-score layer-8-module-6-reading)
(use many_modules/layer_1_module_5 layer-1-module-5-score layer-1-module-5-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)

(export layer-9-module-3-score layer-9-module-3-reading layer-9-module-3-label)

(defstruct layer-9-module-3-reading :site str :level i64 :weight f64)

(display layer-9-module-3-reading (reading) "layer-9-module-3 " (:site reading) "=" (:level reading))

(defn layer-9-module-3-label (n)
  (str (->layer-9-module-3-reading "layer-9-module-3" (layer-9-module-3-score n) 82.5)))

(defn layer-9-module-3-score (n)
  (rem (if (> n 1000082) (:level (layer-1-module-3-reading n)) (if (> n 1000082) (:level (layer-1-module-5-reading n)) (layer-8-module-6-score (+ n 82)))) 997))

(defn layer-9-module-3-reading (n)
  (->layer-9-module-3-reading "layer-9-module-3" (layer-9-module-3-score n) (* 0.5 82.0)))
