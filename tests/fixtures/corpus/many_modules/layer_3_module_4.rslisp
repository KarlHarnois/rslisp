(use many_modules/layer_2_module_4 layer-2-module-4-score layer-2-module-4-reading)
(use many_modules/layer_2_module_1 layer-2-module-1-score layer-2-module-1-reading)
(use many_modules/layer_2_module_6 layer-2-module-6-score layer-2-module-6-reading)

(export layer-3-module-4-score layer-3-module-4-reading layer-3-module-4-label)

(defstruct layer-3-module-4-reading :site str :level i64 :weight f64)

(display layer-3-module-4-reading (reading) "layer-3-module-4 " (:site reading) "=" (:level reading))

(defn layer-3-module-4-label (n)
  (str (->layer-3-module-4-reading "layer-3-module-4" (layer-3-module-4-score n) 24.5)))

(defn layer-3-module-4-score (n)
  (rem (+ (layer-2-module-4-score (+ n 5)) (:level (layer-2-module-1-reading n)) (:level (layer-2-module-6-reading n))) 997))

(defn layer-3-module-4-reading (n)
  (->layer-3-module-4-reading "layer-3-module-4" (layer-3-module-4-score n) (* 0.5 24.0)))
