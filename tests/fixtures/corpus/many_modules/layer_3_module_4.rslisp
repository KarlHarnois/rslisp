(use many_modules/layer_2_module_6 layer-2-module-6-score layer-2-module-6-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)

(export layer-3-module-4-score layer-3-module-4-reading layer-3-module-4-label)

(defstruct layer-3-module-4-reading :site str :level i64 :weight f64)

(display layer-3-module-4-reading (reading) "layer-3-module-4 " (:site reading) "=" (:level reading))

(defn layer-3-module-4-label (n)
  (str (->layer-3-module-4-reading "layer-3-module-4" (layer-3-module-4-score n) 23.5)))

(defn layer-3-module-4-score (n)
  (rem (if (> n 1000023) (:level (layer-1-module-3-reading n)) (if (> n 1000023) (:level (layer-1-module-1-reading n)) (layer-2-module-6-score (+ n 23)))) 997))

(defn layer-3-module-4-reading (n)
  (->layer-3-module-4-reading "layer-3-module-4" (layer-3-module-4-score n) (* 0.5 23.0)))
