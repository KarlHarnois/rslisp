(use many_modules/layer_1_module_8 layer-1-module-8-score layer-1-module-8-reading)
(use many_modules/layer_1_module_5 layer-1-module-5-score layer-1-module-5-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)

(export layer-2-module-5-score layer-2-module-5-reading layer-2-module-5-label)

(defstruct layer-2-module-5-reading :site str :level i64 :weight f64)

(display layer-2-module-5-reading (reading) "layer-2-module-5 " (:site reading) "=" (:level reading))

(defn layer-2-module-5-label (n)
  (str (->layer-2-module-5-reading "layer-2-module-5" (layer-2-module-5-score n) 14.5)))

(defn layer-2-module-5-score (n)
  (rem (if (> n 1000014) (:level (layer-1-module-3-reading n)) (if (> n 1000014) (:level (layer-1-module-5-reading n)) (layer-1-module-8-score (+ n 14)))) 997))

(defn layer-2-module-5-reading (n)
  (->layer-2-module-5-reading "layer-2-module-5" (layer-2-module-5-score n) (* 0.5 14.0)))
