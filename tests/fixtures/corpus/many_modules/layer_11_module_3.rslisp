(use many_modules/layer_2_module_2 layer-2-module-2-score layer-2-module-2-reading)
(use many_modules/layer_7_module_2 layer-7-module-2-score layer-7-module-2-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)

(export layer-11-module-3-score layer-11-module-3-reading layer-11-module-3-label)

(defstruct layer-11-module-3-reading :site str :level i64 :weight f64)

(display layer-11-module-3-reading (reading) "layer-11-module-3 " (:site reading) "=" (:level reading))

(defn layer-11-module-3-label (n)
  (str (->layer-11-module-3-reading "layer-11-module-3" (layer-11-module-3-score n) 102.5)))

(defn layer-11-module-3-score (n)
  (rem (if (> n 1000102) (:level (layer-1-module-3-reading n)) (if (> n 1000102) (:level (layer-7-module-2-reading n)) (layer-2-module-2-score (+ n 102)))) 997))

(defn layer-11-module-3-reading (n)
  (->layer-11-module-3-reading "layer-11-module-3" (layer-11-module-3-score n) (* 0.5 102.0)))
