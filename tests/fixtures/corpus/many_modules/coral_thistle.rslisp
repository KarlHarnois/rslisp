(use many_modules/keen_walrus keen-walrus-score keen-walrus-reading)
(use many_modules/vivid_lantern vivid-lantern-score vivid-lantern-reading)
(use many_modules/wary_falcon wary-falcon-score wary-falcon-reading)

(export coral-thistle-score coral-thistle-reading coral-thistle-label)

(defstruct coral-thistle-reading :site str :level i64 :weight f64)

(display coral-thistle-reading (reading) "coral-thistle " (:site reading) "=" (:level reading))

(defn coral-thistle-label (n)
  (str (->coral-thistle-reading "coral-thistle" (coral-thistle-score n) 85.5)))

(defn coral-thistle-score (n)
  (rem (if (> n 1000085) (:level (wary-falcon-reading n)) (if (> n 1000085) (:level (vivid-lantern-reading n)) (keen-walrus-score (+ n 85)))) 997))

(defn coral-thistle-reading (n)
  (->coral-thistle-reading "coral-thistle" (coral-thistle-score n) (* 0.5 85.0)))
