(use many_modules/layer_10_module_7 layer-10-module-7-score layer-10-module-7-reading)
(use many_modules/layer_3_module_6 layer-3-module-6-score layer-3-module-6-reading)
(use many_modules/layer_3_module_8 layer-3-module-8-score layer-3-module-8-reading)

(export layer-12-module-5-score layer-12-module-5-reading layer-12-module-5-label)

(defstruct layer-12-module-5-reading :site str :level i64 :weight f64)

(display layer-12-module-5-reading (reading) "layer-12-module-5 " (:site reading) "=" (:level reading))

(defn layer-12-module-5-label (n)
  (str (->layer-12-module-5-reading "layer-12-module-5" (layer-12-module-5-score n) 114.5)))

(defn layer-12-module-5-score (n)
  (rem (if (> n 1000114) (:level (layer-3-module-8-reading n)) (if (> n 1000114) (:level (layer-3-module-6-reading n)) (layer-10-module-7-score (+ n 114)))) 997))

(defn layer-12-module-5-reading (n)
  (->layer-12-module-5-reading "layer-12-module-5" (layer-12-module-5-score n) (* 0.5 114.0)))
