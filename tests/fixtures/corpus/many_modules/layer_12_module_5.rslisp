(use many_modules/layer_11_module_5 layer-11-module-5-score layer-11-module-5-reading)
(use many_modules/layer_1_module_5 layer-1-module-5-score layer-1-module-5-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)

(export layer-12-module-5-score layer-12-module-5-reading layer-12-module-5-label)

(defstruct layer-12-module-5-reading :site str :level i64 :weight f64)

(display layer-12-module-5-reading (reading) "layer-12-module-5 " (:site reading) "=" (:level reading))

(defn layer-12-module-5-label (n)
  (str (->layer-12-module-5-reading "layer-12-module-5" (layer-12-module-5-score n) 115.5)))

(defn layer-12-module-5-score (n)
  (rem (+ (layer-11-module-5-score (+ n 1)) (:level (layer-1-module-5-reading n)) (:level (layer-1-module-3-reading n))) 997))

(defn layer-12-module-5-reading (n)
  (->layer-12-module-5-reading "layer-12-module-5" (layer-12-module-5-score n) (* 0.5 115.0)))
