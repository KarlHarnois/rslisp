(use many_modules/swift_thistle swift-thistle-score swift-thistle-reading)
(use many_modules/vivid_otter vivid-otter-score vivid-otter-reading)
(use many_modules/rapid_yarrow rapid-yarrow-score rapid-yarrow-reading)

(export quiet-summit-score quiet-summit-reading quiet-summit-label)

(defstruct quiet-summit-reading :site str :level i64 :weight f64)

(display quiet-summit-reading (reading) "quiet-summit " (:site reading) "=" (:level reading))

(defn quiet-summit-label (n)
  (str (->quiet-summit-reading "quiet-summit" (quiet-summit-score n) 118.5)))

(defn quiet-summit-score (n)
  (rem (if (> n 1000118) (:level (rapid-yarrow-reading n)) (if (> n 1000118) (:level (vivid-otter-reading n)) (swift-thistle-score (+ n 118)))) 997))

(defn quiet-summit-reading (n)
  (->quiet-summit-reading "quiet-summit" (quiet-summit-score n) (* 0.5 118.0)))
