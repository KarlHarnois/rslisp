(use many_modules/layer_3_module_2 layer-3-module-2-score layer-3-module-2-reading)
(use many_modules/layer_3_module_4 layer-3-module-4-score layer-3-module-4-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)

(export layer-4-module-2-score layer-4-module-2-reading layer-4-module-2-label)

(defstruct layer-4-module-2-reading :site str :level i64 :weight f64)

(display layer-4-module-2-reading (reading) "layer-4-module-2 " (:site reading) "=" (:level reading))

(defn layer-4-module-2-label (n)
  (str (->layer-4-module-2-reading "layer-4-module-2" (layer-4-module-2-score n) 32.5)))

(defn layer-4-module-2-score (n)
  (rem (+ (layer-3-module-2-score (+ n 3)) (:level (layer-3-module-4-reading n)) (:level (layer-1-module-9-reading n))) 997))

(defn layer-4-module-2-reading (n)
  (->layer-4-module-2-reading "layer-4-module-2" (layer-4-module-2-score n) (* 0.5 32.0)))
