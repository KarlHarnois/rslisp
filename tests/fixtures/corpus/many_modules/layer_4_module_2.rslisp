(use many_modules/layer_3_module_2 layer-3-module-2-score layer-3-module-2-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)
(use many_modules/layer_1_module_7 layer-1-module-7-score layer-1-module-7-reading)

(export layer-4-module-2-score layer-4-module-2-reading layer-4-module-2-label)

(defstruct layer-4-module-2-reading :site str :level i64 :weight f64)

(display layer-4-module-2-reading (reading) "layer-4-module-2 " (:site reading) "=" (:level reading))

(defn layer-4-module-2-label (n)
  (str (->layer-4-module-2-reading "layer-4-module-2" (layer-4-module-2-score n) 31.5)))

(defn layer-4-module-2-score (n)
  (rem (if (> n 1000031) (:level (layer-1-module-7-reading n)) (if (> n 1000031) (:level (layer-1-module-1-reading n)) (layer-3-module-2-score (+ n 31)))) 997))

(defn layer-4-module-2-reading (n)
  (->layer-4-module-2-reading "layer-4-module-2" (layer-4-module-2-score n) (* 0.5 31.0)))
