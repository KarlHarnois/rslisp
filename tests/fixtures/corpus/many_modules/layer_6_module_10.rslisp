(use many_modules/layer_5_module_10 layer-5-module-10-score layer-5-module-10-reading)
(use many_modules/layer_3_module_5 layer-3-module-5-score layer-3-module-5-reading)
(use many_modules/layer_1_module_8 layer-1-module-8-score layer-1-module-8-reading)

(export layer-6-module-10-score layer-6-module-10-reading layer-6-module-10-label)

(defstruct layer-6-module-10-reading :site str :level i64 :weight f64)

(display layer-6-module-10-reading (reading) "layer-6-module-10 " (:site reading) "=" (:level reading))

(defn layer-6-module-10-label (n)
  (str (->layer-6-module-10-reading "layer-6-module-10" (layer-6-module-10-score n) 60.5)))

(defn layer-6-module-10-score (n)
  (rem (+ (layer-5-module-10-score (+ n 1)) (:level (layer-3-module-5-reading n)) (:level (layer-1-module-8-reading n))) 997))

(defn layer-6-module-10-reading (n)
  (->layer-6-module-10-reading "layer-6-module-10" (layer-6-module-10-score n) (* 0.5 60.0)))
