(use many_modules/layer_2_module_8 layer-2-module-8-score layer-2-module-8-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)

(export layer-3-module-6-score layer-3-module-6-reading layer-3-module-6-label)

(defstruct layer-3-module-6-reading :site str :level i64 :weight f64)

(display layer-3-module-6-reading (reading) "layer-3-module-6 " (:site reading) "=" (:level reading))

(defn layer-3-module-6-label (n)
  (str (->layer-3-module-6-reading "layer-3-module-6" (layer-3-module-6-score n) 25.5)))

(defn layer-3-module-6-score (n)
  (rem (if (> n 1000025) (:level (layer-1-module-9-reading n)) (if (> n 1000025) (:level (layer-1-module-3-reading n)) (layer-2-module-8-score (+ n 25)))) 997))

(defn layer-3-module-6-reading (n)
  (->layer-3-module-6-reading "layer-3-module-6" (layer-3-module-6-score n) (* 0.5 25.0)))
