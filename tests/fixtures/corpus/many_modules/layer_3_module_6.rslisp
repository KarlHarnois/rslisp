(use many_modules/layer_2_module_6 layer-2-module-6-score layer-2-module-6-reading)
(use many_modules/layer_2_module_8 layer-2-module-8-score layer-2-module-8-reading)
(use many_modules/layer_1_module_8 layer-1-module-8-score layer-1-module-8-reading)

(export layer-3-module-6-score layer-3-module-6-reading layer-3-module-6-label)

(defstruct layer-3-module-6-reading :site str :level i64 :weight f64)

(display layer-3-module-6-reading (reading) "layer-3-module-6 " (:site reading) "=" (:level reading))

(defn layer-3-module-6-label (n)
  (str (->layer-3-module-6-reading "layer-3-module-6" (layer-3-module-6-score n) 26.5)))

(defn layer-3-module-6-score (n)
  (rem (+ (layer-2-module-6-score (+ n 2)) (:level (layer-2-module-8-reading n)) (:level (layer-1-module-8-reading n))) 997))

(defn layer-3-module-6-reading (n)
  (->layer-3-module-6-reading "layer-3-module-6" (layer-3-module-6-score n) (* 0.5 26.0)))
