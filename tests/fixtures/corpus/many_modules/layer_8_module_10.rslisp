(use many_modules/layer_7_module_10 layer-7-module-10-reading
                                    layer-7-module-10-score)

(use many_modules/layer_2_module_8 layer-2-module-8-reading
                                   layer-2-module-8-score)

(use many_modules/layer_5_module_10 layer-5-module-10-reading
                                    layer-5-module-10-score)

(export layer-8-module-10-label layer-8-module-10-reading
        layer-8-module-10-score)

(defstruct layer-8-module-10-reading
  :site str
  :level i64
  :weight f64)

(display layer-8-module-10-reading (reading)
  "layer-8-module-10 "
  (:site reading)
  "="
  (:level reading))

(defn layer-8-module-10-label (n)
  (str (->layer-8-module-10-reading "layer-8-module-10"
                                    (layer-8-module-10-score n)
                                    80.5)))

(defn layer-8-module-10-score (n)
  (rem (+ (layer-7-module-10-score (+ n 1))
          (:level (layer-2-module-8-reading n))
          (:level (layer-5-module-10-reading n)))
       997))

(defn layer-8-module-10-reading (n)
  (->layer-8-module-10-reading "layer-8-module-10"
                               (layer-8-module-10-score n)
                               (* 0.5 80.0)))
