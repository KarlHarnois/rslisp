(use many_modules/olive_kestrel olive-kestrel-score olive-kestrel-reading)
(use many_modules/tender_beacon tender-beacon-score tender-beacon-reading)
(use many_modules/zesty_delta zesty-delta-score zesty-delta-reading)

(export misty-heron-score misty-heron-reading misty-heron-label)

(defstruct misty-heron-reading :site str :level i64 :weight f64)

(display misty-heron-reading (reading) "misty-heron " (:site reading) "=" (:level reading))

(defn misty-heron-label (n)
  (str (->misty-heron-reading "misty-heron" (misty-heron-score n) 36.5)))

(defn misty-heron-score (n)
  (rem (if (> n 1000036) (:level (zesty-delta-reading n)) (if (> n 1000036) (:level (tender-beacon-reading n)) (olive-kestrel-score (+ n 36)))) 997))

(defn misty-heron-reading (n)
  (->misty-heron-reading "misty-heron" (misty-heron-score n) (* 0.5 36.0)))
