(use many_modules/layer_4_module_3 layer-4-module-3-score layer-4-module-3-reading)
(use many_modules/layer_4_module_1 layer-4-module-1-score layer-4-module-1-reading)
(use many_modules/layer_3_module_5 layer-3-module-5-score layer-3-module-5-reading)

(export layer-5-module-3-score layer-5-module-3-reading layer-5-module-3-label)

(defstruct layer-5-module-3-reading :site str :level i64 :weight f64)

(display layer-5-module-3-reading (reading) "layer-5-module-3 " (:site reading) "=" (:level reading))

(defn layer-5-module-3-label (n)
  (str (->layer-5-module-3-reading "layer-5-module-3" (layer-5-module-3-score n) 43.5)))

(defn layer-5-module-3-score (n)
  (rem (+ (layer-4-module-3-score (+ n 4)) (:level (layer-4-module-1-reading n)) (:level (layer-3-module-5-reading n))) 997))

(defn layer-5-module-3-reading (n)
  (->layer-5-module-3-reading "layer-5-module-3" (layer-5-module-3-score n) (* 0.5 43.0)))
