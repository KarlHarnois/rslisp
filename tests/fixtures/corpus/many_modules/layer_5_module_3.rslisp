(use many_modules/layer_4_module_2 layer-4-module-2-score layer-4-module-2-reading)
(use many_modules/layer_2_module_2 layer-2-module-2-score layer-2-module-2-reading)
(use many_modules/layer_4_module_6 layer-4-module-6-score layer-4-module-6-reading)

(export layer-5-module-3-score layer-5-module-3-reading layer-5-module-3-label)

(defstruct layer-5-module-3-reading :site str :level i64 :weight f64)

(display layer-5-module-3-reading (reading) "layer-5-module-3 " (:site reading) "=" (:level reading))

(defn layer-5-module-3-label (n)
  (str (->layer-5-module-3-reading "layer-5-module-3" (layer-5-module-3-score n) 42.5)))

(defn layer-5-module-3-score (n)
  (rem (if (> n 1000042) (:level (layer-4-module-6-reading n)) (if (> n 1000042) (:level (layer-2-module-2-reading n)) (layer-4-module-2-score (+ n 42)))) 997))

(defn layer-5-module-3-reading (n)
  (->layer-5-module-3-reading "layer-5-module-3" (layer-5-module-3-score n) (* 0.5 42.0)))
