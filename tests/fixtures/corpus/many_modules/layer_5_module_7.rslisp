(use many_modules/layer_4_module_7 layer-4-module-7-score layer-4-module-7-reading)
(use many_modules/layer_3_module_2 layer-3-module-2-score layer-3-module-2-reading)
(use many_modules/layer_1_module_6 layer-1-module-6-score layer-1-module-6-reading)

(export layer-5-module-7-score layer-5-module-7-reading layer-5-module-7-label)

(defstruct layer-5-module-7-reading :site str :level i64 :weight f64)

(display layer-5-module-7-reading (reading) "layer-5-module-7 " (:site reading) "=" (:level reading))

(defn layer-5-module-7-label (n)
  (str (->layer-5-module-7-reading "layer-5-module-7" (layer-5-module-7-score n) 47.5)))

(defn layer-5-module-7-score (n)
  (rem (+ (layer-4-module-7-score (+ n 3)) (:level (layer-3-module-2-reading n)) (:level (layer-1-module-6-reading n))) 997))

(defn layer-5-module-7-reading (n)
  (->layer-5-module-7-reading "layer-5-module-7" (layer-5-module-7-score n) (* 0.5 47.0)))
