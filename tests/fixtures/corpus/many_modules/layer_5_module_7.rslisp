(use many_modules/layer_3_module_7 layer-3-module-7-score layer-3-module-7-reading)
(use many_modules/layer_2_module_4 layer-2-module-4-score layer-2-module-4-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)

(export layer-5-module-7-score layer-5-module-7-reading layer-5-module-7-label)

(defstruct layer-5-module-7-reading :site str :level i64 :weight f64)

(display layer-5-module-7-reading (reading) "layer-5-module-7 " (:site reading) "=" (:level reading))

(defn layer-5-module-7-label (n)
  (str (->layer-5-module-7-reading "layer-5-module-7" (layer-5-module-7-score n) 46.5)))

(defn layer-5-module-7-score (n)
  (rem (if (> n 1000046) (:level (layer-1-module-1-reading n)) (if (> n 1000046) (:level (layer-2-module-4-reading n)) (layer-3-module-7-score (+ n 46)))) 997))

(defn layer-5-module-7-reading (n)
  (->layer-5-module-7-reading "layer-5-module-7" (layer-5-module-7-score n) (* 0.5 46.0)))
