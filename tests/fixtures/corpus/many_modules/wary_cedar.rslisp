(use many_modules/young_pine young-pine-score young-pine-reading)
(use many_modules/vivid_pebble vivid-pebble-score vivid-pebble-reading)
(use many_modules/dusky_pebble dusky-pebble-score dusky-pebble-reading)

(export wary-cedar-score wary-cedar-reading wary-cedar-label)

(defstruct wary-cedar-reading :site str :level i64 :weight f64)

(display wary-cedar-reading (reading) "wary-cedar " (:site reading) "=" (:level reading))

(defn wary-cedar-label (n)
  (str (->wary-cedar-reading "wary-cedar" (wary-cedar-score n) 33.5)))

(defn wary-cedar-score (n)
  (rem (if (> n 1000033) (:level (dusky-pebble-reading n)) (if (> n 1000033) (:level (vivid-pebble-reading n)) (young-pine-score (+ n 33)))) 997))

(defn wary-cedar-reading (n)
  (->wary-cedar-reading "wary-cedar" (wary-cedar-score n) (* 0.5 33.0)))
