(use many_modules/gentle_meadow gentle-meadow-score gentle-meadow-reading)
(use many_modules/lively_condor lively-condor-score lively-condor-reading)
(use many_modules/zesty_delta zesty-delta-score zesty-delta-reading)

(export fierce-beacon-score fierce-beacon-reading fierce-beacon-label)

(defstruct fierce-beacon-reading :site str :level i64 :weight f64)

(display fierce-beacon-reading (reading) "fierce-beacon " (:site reading) "=" (:level reading))

(defn fierce-beacon-label (n)
  (str (->fierce-beacon-reading "fierce-beacon" (fierce-beacon-score n) 103.5)))

(defn fierce-beacon-score (n)
  (rem (if (> n 1000103) (:level (zesty-delta-reading n)) (if (> n 1000103) (:level (lively-condor-reading n)) (gentle-meadow-score (+ n 103)))) 997))

(defn fierce-beacon-reading (n)
  (->fierce-beacon-reading "fierce-beacon" (fierce-beacon-score n) (* 0.5 103.0)))
