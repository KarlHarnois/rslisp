(use many_modules/rustic_falcon rustic-falcon-score rustic-falcon-reading)
(use many_modules/lively_orchid lively-orchid-score lively-orchid-reading)
(use many_modules/rapid_yarrow rapid-yarrow-score rapid-yarrow-reading)

(export quiet-ember-score quiet-ember-reading quiet-ember-label)

(defstruct quiet-ember-reading :site str :level i64 :weight f64)

(display quiet-ember-reading (reading) "quiet-ember " (:site reading) "=" (:level reading))

(defn quiet-ember-label (n)
  (str (->quiet-ember-reading "quiet-ember" (quiet-ember-score n) 82.5)))

(defn quiet-ember-score (n)
  (rem (if (> n 1000082) (:level (rapid-yarrow-reading n)) (if (> n 1000082) (:level (lively-orchid-reading n)) (rustic-falcon-score (+ n 82)))) 997))

(defn quiet-ember-reading (n)
  (->quiet-ember-reading "quiet-ember" (quiet-ember-score n) (* 0.5 82.0)))
