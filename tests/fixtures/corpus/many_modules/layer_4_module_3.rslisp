(use many_modules/layer_3_module_3 layer-3-module-3-reading
                                   layer-3-module-3-score)

(use many_modules/layer_2_module_1 layer-2-module-1-reading
                                   layer-2-module-1-score)

(use many_modules/layer_3_module_6 layer-3-module-6-reading
                                   layer-3-module-6-score)

(export layer-4-module-3-label layer-4-module-3-reading
        layer-4-module-3-score)

(defstruct layer-4-module-3-reading
  :site str
  :level i64
  :weight f64)

(display layer-4-module-3-reading (reading)
  "layer-4-module-3 "
  (:site reading)
  "="
  (:level reading))

(defn layer-4-module-3-label (n)
  (str (->layer-4-module-3-reading "layer-4-module-3"
                                   (layer-4-module-3-score n)
                                   33.5)))

(defn layer-4-module-3-score (n)
  (rem (+ (layer-3-module-3-score (+ n 4))
          (:level (layer-2-module-1-reading n))
          (:level (layer-3-module-6-reading n)))
       997))

(defn layer-4-module-3-reading (n)
  (->layer-4-module-3-reading "layer-4-module-3"
                              (layer-4-module-3-score n)
                              (* 0.5 33.0)))
