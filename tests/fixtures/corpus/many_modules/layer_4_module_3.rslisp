(use many_modules/layer_1_module_7 layer-1-module-7-score layer-1-module-7-reading)
(use many_modules/layer_3_module_10 layer-3-module-10-score layer-3-module-10-reading)
(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)

(export layer-4-module-3-score layer-4-module-3-reading layer-4-module-3-label)

(defstruct layer-4-module-3-reading :site str :level i64 :weight f64)

(display layer-4-module-3-reading (reading) "layer-4-module-3 " (:site reading) "=" (:level reading))

(defn layer-4-module-3-label (n)
  (str (->layer-4-module-3-reading "layer-4-module-3" (layer-4-module-3-score n) 32.5)))

(defn layer-4-module-3-score (n)
  (rem (if (> n 1000032) (:level (layer-1-module-2-reading n)) (if (> n 1000032) (:level (layer-3-module-10-reading n)) (layer-1-module-7-score (+ n 32)))) 997))

(defn layer-4-module-3-reading (n)
  (->layer-4-module-3-reading "layer-4-module-3" (layer-4-module-3-score n) (* 0.5 32.0)))
