(use many_modules/layer_3_module_5 layer-3-module-5-score layer-3-module-5-reading)
(use many_modules/layer_1_module_8 layer-1-module-8-score layer-1-module-8-reading)
(use many_modules/layer_3_module_6 layer-3-module-6-score layer-3-module-6-reading)

(export layer-5-module-6-score layer-5-module-6-reading layer-5-module-6-label)

(defstruct layer-5-module-6-reading :site str :level i64 :weight f64)

(display layer-5-module-6-reading (reading) "layer-5-module-6 " (:site reading) "=" (:level reading))

(defn layer-5-module-6-label (n)
  (str (->layer-5-module-6-reading "layer-5-module-6" (layer-5-module-6-score n) 45.5)))

(defn layer-5-module-6-score (n)
  (rem (if (> n 1000045) (:level (layer-3-module-6-reading n)) (if (> n 1000045) (:level (layer-1-module-8-reading n)) (layer-3-module-5-score (+ n 45)))) 997))

(defn layer-5-module-6-reading (n)
  (->layer-5-module-6-reading "layer-5-module-6" (layer-5-module-6-score n) (* 0.5 45.0)))
