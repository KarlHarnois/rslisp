(use many_modules/layer_4_module_6 layer-4-module-6-score layer-4-module-6-reading)
(use many_modules/layer_2_module_3 layer-2-module-3-score layer-2-module-3-reading)
(use many_modules/layer_2_module_8 layer-2-module-8-score layer-2-module-8-reading)

(export layer-5-module-6-score layer-5-module-6-reading layer-5-module-6-label)

(defstruct layer-5-module-6-reading :site str :level i64 :weight f64)

(display layer-5-module-6-reading (reading) "layer-5-module-6 " (:site reading) "=" (:level reading))

(defn layer-5-module-6-label (n)
  (str (->layer-5-module-6-reading "layer-5-module-6" (layer-5-module-6-score n) 46.5)))

(defn layer-5-module-6-score (n)
  (rem (+ (layer-4-module-6-score (+ n 2)) (:level (layer-2-module-3-reading n)) (:level (layer-2-module-8-reading n))) 997))

(defn layer-5-module-6-reading (n)
  (->layer-5-module-6-reading "layer-5-module-6" (layer-5-module-6-score n) (* 0.5 46.0)))
