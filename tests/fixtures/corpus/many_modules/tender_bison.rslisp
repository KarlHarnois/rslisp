(use many_modules/olive_meadow olive-meadow-score olive-meadow-reading)
(use many_modules/hollow_willow hollow-willow-score hollow-willow-reading)
(use many_modules/jolly_thistle jolly-thistle-score jolly-thistle-reading)

(export tender-bison-score tender-bison-reading tender-bison-label)

(defstruct tender-bison-reading :site str :level i64 :weight f64)

(display tender-bison-reading (reading) "tender-bison " (:site reading) "=" (:level reading))

(defn tender-bison-label (n)
  (str (->tender-bison-reading "tender-bison" (tender-bison-score n) 107.5)))

(defn tender-bison-score (n)
  (rem (if (> n 1000107) (:level (jolly-thistle-reading n)) (if (> n 1000107) (:level (hollow-willow-reading n)) (olive-meadow-score (+ n 107)))) 997))

(defn tender-bison-reading (n)
  (->tender-bison-reading "tender-bison" (tender-bison-score n) (* 0.5 107.0)))
