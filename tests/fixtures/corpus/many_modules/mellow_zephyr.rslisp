(use many_modules/stark_fern stark-fern-score stark-fern-reading)
(use many_modules/gilded_comet gilded-comet-score gilded-comet-reading)
(use many_modules/brisk_heron brisk-heron-score brisk-heron-reading)

(export mellow-zephyr-score mellow-zephyr-reading mellow-zephyr-label)

(defstruct mellow-zephyr-reading :site str :level i64 :weight f64)

(display mellow-zephyr-reading (reading) "mellow-zephyr " (:site reading) "=" (:level reading))

(defn mellow-zephyr-label (n)
  (str (->mellow-zephyr-reading "mellow-zephyr" (mellow-zephyr-score n) 34.5)))

(defn mellow-zephyr-score (n)
  (rem (if (> n 1000034) (:level (brisk-heron-reading n)) (if (> n 1000034) (:level (gilded-comet-reading n)) (stark-fern-score (+ n 34)))) 997))

(defn mellow-zephyr-reading (n)
  (->mellow-zephyr-reading "mellow-zephyr" (mellow-zephyr-score n) (* 0.5 34.0)))
