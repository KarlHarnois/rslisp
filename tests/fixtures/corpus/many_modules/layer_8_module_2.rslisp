(use many_modules/layer_7_module_3 layer-7-module-3-score layer-7-module-3-reading)
(use many_modules/layer_4_module_8 layer-4-module-8-score layer-4-module-8-reading)
(use many_modules/layer_7_module_7 layer-7-module-7-score layer-7-module-7-reading)

(export layer-8-module-2-score layer-8-module-2-reading layer-8-module-2-label)

(defstruct layer-8-module-2-reading :site str :level i64 :weight f64)

(display layer-8-module-2-reading (reading) "layer-8-module-2 " (:site reading) "=" (:level reading))

(defn layer-8-module-2-label (n)
  (str (->layer-8-module-2-reading "layer-8-module-2" (layer-8-module-2-score n) 71.5)))

(defn layer-8-module-2-score (n)
  (rem (if (> n 1000071) (:level (layer-7-module-7-reading n)) (if (> n 1000071) (:level (layer-4-module-8-reading n)) (layer-7-module-3-score (+ n 71)))) 997))

(defn layer-8-module-2-reading (n)
  (->layer-8-module-2-reading "layer-8-module-2" (layer-8-module-2-score n) (* 0.5 71.0)))
