(use many_modules/layer_7_module_2 layer-7-module-2-score layer-7-module-2-reading)
(use many_modules/layer_6_module_7 layer-6-module-7-score layer-6-module-7-reading)
(use many_modules/layer_4_module_4 layer-4-module-4-score layer-4-module-4-reading)

(export layer-8-module-2-score layer-8-module-2-reading layer-8-module-2-label)

(defstruct layer-8-module-2-reading :site str :level i64 :weight f64)

(display layer-8-module-2-reading (reading) "layer-8-module-2 " (:site reading) "=" (:level reading))

(defn layer-8-module-2-label (n)
  (str (->layer-8-module-2-reading "layer-8-module-2" (layer-8-module-2-score n) 72.5)))

(defn layer-8-module-2-score (n)
  (rem (+ (layer-7-module-2-score (+ n 3)) (:level (layer-6-module-7-reading n)) (:level (layer-4-module-4-reading n))) 997))

(defn layer-8-module-2-reading (n)
  (->layer-8-module-2-reading "layer-8-module-2" (layer-8-module-2-score n) (* 0.5 72.0)))
