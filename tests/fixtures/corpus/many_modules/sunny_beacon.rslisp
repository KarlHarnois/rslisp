(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)
(use many_modules/wary_falcon wary-falcon-score wary-falcon-reading)
(use many_modules/swift_geyser swift-geyser-score swift-geyser-reading)

(export sunny-beacon-score sunny-beacon-reading sunny-beacon-label)

(defstruct sunny-beacon-reading :site str :level i64 :weight f64)

(display sunny-beacon-reading (reading) "sunny-beacon " (:site reading) "=" (:level reading))

(defn sunny-beacon-label (n)
  (str (->sunny-beacon-reading "sunny-beacon" (sunny-beacon-score n) 15.5)))

(defn sunny-beacon-score (n)
  (rem (if (> n 1000015) (:level (swift-geyser-reading n)) (if (> n 1000015) (:level (wary-falcon-reading n)) (bold-lantern-score (+ n 15)))) 997))

(defn sunny-beacon-reading (n)
  (->sunny-beacon-reading "sunny-beacon" (sunny-beacon-score n) (* 0.5 15.0)))
