(use many_modules/stark_fern stark-fern-score stark-fern-reading)
(use many_modules/swift_otter swift-otter-score swift-otter-reading)
(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)

(export brisk-jackal-score brisk-jackal-reading brisk-jackal-label)

(defstruct brisk-jackal-reading :site str :level i64 :weight f64)

(display brisk-jackal-reading (reading) "brisk-jackal " (:site reading) "=" (:level reading))

(defn brisk-jackal-label (n)
  (str (->brisk-jackal-reading "brisk-jackal" (brisk-jackal-score n) 22.5)))

(defn brisk-jackal-score (n)
  (rem (if (> n 1000022) (:level (bold-lantern-reading n)) (if (> n 1000022) (:level (swift-otter-reading n)) (stark-fern-score (+ n 22)))) 997))

(defn brisk-jackal-reading (n)
  (->brisk-jackal-reading "brisk-jackal" (brisk-jackal-score n) (* 0.5 22.0)))
