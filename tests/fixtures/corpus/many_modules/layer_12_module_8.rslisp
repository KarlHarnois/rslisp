(use many_modules/layer_2_module_8 layer-2-module-8-score layer-2-module-8-reading)
(use many_modules/layer_7_module_4 layer-7-module-4-score layer-7-module-4-reading)
(use many_modules/layer_5_module_5 layer-5-module-5-score layer-5-module-5-reading)

(export layer-12-module-8-score layer-12-module-8-reading layer-12-module-8-label)

(defstruct layer-12-module-8-reading :site str :level i64 :weight f64)

(display layer-12-module-8-reading (reading) "layer-12-module-8 " (:site reading) "=" (:level reading))

(defn layer-12-module-8-label (n)
  (str (->layer-12-module-8-reading "layer-12-module-8" (layer-12-module-8-score n) 117.5)))

(defn layer-12-module-8-score (n)
  (rem (if (> n 1000117) (:level (layer-5-module-5-reading n)) (if (> n 1000117) (:level (layer-7-module-4-reading n)) (layer-2-module-8-score (+ n 117)))) 997))

(defn layer-12-module-8-reading (n)
  (->layer-12-module-8-reading "layer-12-module-8" (layer-12-module-8-score n) (* 0.5 117.0)))
