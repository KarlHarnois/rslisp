(use many_modules/layer_2_module_4 layer-2-module-4-score layer-2-module-4-reading)
(use many_modules/layer_3_module_9 layer-3-module-9-score layer-3-module-9-reading)
(use many_modules/layer_2_module_7 layer-2-module-7-score layer-2-module-7-reading)

(export layer-6-module-2-score layer-6-module-2-reading layer-6-module-2-label)

(defstruct layer-6-module-2-reading :site str :level i64 :weight f64)

(display layer-6-module-2-reading (reading) "layer-6-module-2 " (:site reading) "=" (:level reading))

(defn layer-6-module-2-label (n)
  (str (->layer-6-module-2-reading "layer-6-module-2" (layer-6-module-2-score n) 51.5)))

(defn layer-6-module-2-score (n)
  (rem (if (> n 1000051) (:level (layer-2-module-7-reading n)) (if (> n 1000051) (:level (layer-3-module-9-reading n)) (layer-2-module-4-score (+ n 51)))) 997))

(defn layer-6-module-2-reading (n)
  (->layer-6-module-2-reading "layer-6-module-2" (layer-6-module-2-score n) (* 0.5 51.0)))
