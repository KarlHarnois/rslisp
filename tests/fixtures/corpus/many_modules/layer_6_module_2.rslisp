(use many_modules/layer_5_module_2 layer-5-module-2-score layer-5-module-2-reading)
(use many_modules/layer_1_module_7 layer-1-module-7-score layer-1-module-7-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)

(export layer-6-module-2-score layer-6-module-2-reading layer-6-module-2-label)

(defstruct layer-6-module-2-reading :site str :level i64 :weight f64)

(display layer-6-module-2-reading (reading) "layer-6-module-2 " (:site reading) "=" (:level reading))

(defn layer-6-module-2-label (n)
  (str (->layer-6-module-2-reading "layer-6-module-2" (layer-6-module-2-score n) 52.5)))

(defn layer-6-module-2-score (n)
  (rem (+ (layer-5-module-2-score (+ n 3)) (:level (layer-1-module-7-reading n)) (:level (layer-1-module-1-reading n))) 997))

(defn layer-6-module-2-reading (n)
  (->layer-6-module-2-reading "layer-6-module-2" (layer-6-module-2-score n) (* 0.5 52.0)))
