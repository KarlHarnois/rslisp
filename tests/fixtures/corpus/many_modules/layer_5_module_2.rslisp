(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)
(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)
(use many_modules/layer_3_module_10 layer-3-module-10-score layer-3-module-10-reading)

(export layer-5-module-2-score layer-5-module-2-reading layer-5-module-2-label)

(defstruct layer-5-module-2-reading :site str :level i64 :weight f64)

(display layer-5-module-2-reading (reading) "layer-5-module-2 " (:site reading) "=" (:level reading))

(defn layer-5-module-2-label (n)
  (str (->layer-5-module-2-reading "layer-5-module-2" (layer-5-module-2-score n) 41.5)))

(defn layer-5-module-2-score (n)
  (rem (if (> n 1000041) (:level (layer-3-module-10-reading n)) (if (> n 1000041) (:level (layer-1-module-4-reading n)) (layer-1-module-1-score (+ n 41)))) 997))

(defn layer-5-module-2-reading (n)
  (->layer-5-module-2-reading "layer-5-module-2" (layer-5-module-2-score n) (* 0.5 41.0)))
