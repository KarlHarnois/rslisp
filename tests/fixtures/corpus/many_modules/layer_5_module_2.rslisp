(use many_modules/layer_4_module_2 layer-4-module-2-reading
                                   layer-4-module-2-score)

(use many_modules/layer_2_module_4 layer-2-module-4-reading
                                   layer-2-module-4-score)

(use many_modules/layer_1_module_4 layer-1-module-4-reading
                                   layer-1-module-4-score)

(export layer-5-module-2-label layer-5-module-2-reading
        layer-5-module-2-score)

(defstruct layer-5-module-2-reading
  :site str
  :level i64
  :weight f64)

(display layer-5-module-2-reading (reading)
  "layer-5-module-2 "
  (:site reading)
  "="
  (:level reading))

(defn layer-5-module-2-label (n)
  (str (->layer-5-module-2-reading "layer-5-module-2"
                                   (layer-5-module-2-score n)
                                   42.5)))

(defn layer-5-module-2-score (n)
  (rem (+ (layer-4-module-2-score (+ n 3))
          (:level (layer-2-module-4-reading n))
          (:level (layer-1-module-4-reading n)))
       997))

(defn layer-5-module-2-reading (n)
  (->layer-5-module-2-reading "layer-5-module-2"
                              (layer-5-module-2-score n)
                              (* 0.5 42.0)))
