(use many_modules/layer_5_module_10 layer-5-module-10-score layer-5-module-10-reading)
(use many_modules/layer_3_module_9 layer-3-module-9-score layer-3-module-9-reading)
(use many_modules/layer_8_module_5 layer-8-module-5-score layer-8-module-5-reading)

(export layer-12-module-6-score layer-12-module-6-reading layer-12-module-6-label)

(defstruct layer-12-module-6-reading :site str :level i64 :weight f64)

(display layer-12-module-6-reading (reading) "layer-12-module-6 " (:site reading) "=" (:level reading))

(defn layer-12-module-6-label (n)
  (str (->layer-12-module-6-reading "layer-12-module-6" (layer-12-module-6-score n) 115.5)))

(defn layer-12-module-6-score (n)
  (rem (if (> n 1000115) (:level (layer-8-module-5-reading n)) (if (> n 1000115) (:level (layer-3-module-9-reading n)) (layer-5-module-10-score (+ n 115)))) 997))

(defn layer-12-module-6-reading (n)
  (->layer-12-module-6-reading "layer-12-module-6" (layer-12-module-6-score n) (* 0.5 115.0)))
