(use many_modules/layer_11_module_6 layer-11-module-6-score layer-11-module-6-reading)
(use many_modules/layer_7_module_1 layer-7-module-1-score layer-7-module-1-reading)
(use many_modules/layer_5_module_6 layer-5-module-6-score layer-5-module-6-reading)

(export layer-12-module-6-score layer-12-module-6-reading layer-12-module-6-label)

(defstruct layer-12-module-6-reading :site str :level i64 :weight f64)

(display layer-12-module-6-reading (reading) "layer-12-module-6 " (:site reading) "=" (:level reading))

(defn layer-12-module-6-label (n)
  (str (->layer-12-module-6-reading "layer-12-module-6" (layer-12-module-6-score n) 116.5)))

(defn layer-12-module-6-score (n)
  (rem (+ (layer-11-module-6-score (+ n 2)) (:level (layer-7-module-1-reading n)) (:level (layer-5-module-6-reading n))) 997))

(defn layer-12-module-6-reading (n)
  (->layer-12-module-6-reading "layer-12-module-6" (layer-12-module-6-score n) (* 0.5 116.0)))
