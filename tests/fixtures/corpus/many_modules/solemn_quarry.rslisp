(use many_modules/witty_meadow witty-meadow-score witty-meadow-reading)
(use many_modules/vivid_lantern vivid-lantern-score vivid-lantern-reading)
(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)

(export solemn-quarry-score solemn-quarry-reading solemn-quarry-label)

(defstruct solemn-quarry-reading :site str :level i64 :weight f64)

(display solemn-quarry-reading (reading) "solemn-quarry " (:site reading) "=" (:level reading))

(defn solemn-quarry-label (n)
  (str (->solemn-quarry-reading "solemn-quarry" (solemn-quarry-score n) 19.5)))

(defn solemn-quarry-score (n)
  (rem (if (> n 1000019) (:level (bold-lantern-reading n)) (if (> n 1000019) (:level (vivid-lantern-reading n)) (witty-meadow-score (+ n 19)))) 997))

(defn solemn-quarry-reading (n)
  (->solemn-quarry-reading "solemn-quarry" (solemn-quarry-score n) (* 0.5 19.0)))
