(use many_modules/silver_heron silver-heron-score silver-heron-reading)
(use many_modules/gilded_walrus gilded-walrus-score gilded-walrus-reading)
(use many_modules/gentle_falcon gentle-falcon-score gentle-falcon-reading)

(export wary-walrus-score wary-walrus-reading wary-walrus-label)

(defstruct wary-walrus-reading :site str :level i64 :weight f64)

(display wary-walrus-reading (reading) "wary-walrus " (:site reading) "=" (:level reading))

(defn wary-walrus-label (n)
  (str (->wary-walrus-reading "wary-walrus" (wary-walrus-score n) 88.5)))

(defn wary-walrus-score (n)
  (rem (if (> n 1000088) (:level (gentle-falcon-reading n)) (if (> n 1000088) (:level (gilded-walrus-reading n)) (silver-heron-score (+ n 88)))) 997))

(defn wary-walrus-reading (n)
  (->wary-walrus-reading "wary-walrus" (wary-walrus-score n) (* 0.5 88.0)))
