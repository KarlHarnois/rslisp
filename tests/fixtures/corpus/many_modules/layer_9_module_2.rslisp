(use many_modules/layer_8_module_2 layer-8-module-2-score layer-8-module-2-reading)
(use many_modules/layer_4_module_10 layer-4-module-10-score layer-4-module-10-reading)
(use many_modules/layer_3_module_10 layer-3-module-10-score layer-3-module-10-reading)

(export layer-9-module-2-score layer-9-module-2-reading layer-9-module-2-label)

(defstruct layer-9-module-2-reading :site str :level i64 :weight f64)

(display layer-9-module-2-reading (reading) "layer-9-module-2 " (:site reading) "=" (:level reading))

(defn layer-9-module-2-label (n)
  (str (->layer-9-module-2-reading "layer-9-module-2" (layer-9-module-2-score n) 82.5)))

(defn layer-9-module-2-score (n)
  (rem (+ (layer-8-module-2-score (+ n 3)) (:level (layer-4-module-10-reading n)) (:level (layer-3-module-10-reading n))) 997))

(defn layer-9-module-2-reading (n)
  (->layer-9-module-2-reading "layer-9-module-2" (layer-9-module-2-score n) (* 0.5 82.0)))
