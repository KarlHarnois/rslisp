(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)
(use many_modules/layer_3_module_8 layer-3-module-8-score layer-3-module-8-reading)

(export layer-4-module-1-score layer-4-module-1-reading layer-4-module-1-label)

(defstruct layer-4-module-1-reading :site str :level i64 :weight f64)

(display layer-4-module-1-reading (reading) "layer-4-module-1 " (:site reading) "=" (:level reading))

(defn layer-4-module-1-label (n)
  (str (->layer-4-module-1-reading "layer-4-module-1" (layer-4-module-1-score n) 30.5)))

(defn layer-4-module-1-score (n)
  (rem (if (> n 1000030) (:level (layer-3-module-8-reading n)) (if (> n 1000030) (:level (layer-1-module-1-reading n)) (layer-1-module-3-score (+ n 30)))) 997))

(defn layer-4-module-1-reading (n)
  (->layer-4-module-1-reading "layer-4-module-1" (layer-4-module-1-score n) (* 0.5 30.0)))
