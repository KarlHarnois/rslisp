(use many_modules/swift_otter swift-otter-score swift-otter-reading)
(use many_modules/fierce_falcon fierce-falcon-score fierce-falcon-reading)
(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)

(export jolly-thistle-score jolly-thistle-reading jolly-thistle-label)

(defstruct jolly-thistle-reading :site str :level i64 :weight f64)

(display jolly-thistle-reading (reading) "jolly-thistle " (:site reading) "=" (:level reading))

(defn jolly-thistle-label (n)
  (str (->jolly-thistle-reading "jolly-thistle" (jolly-thistle-score n) 8.5)))

(defn jolly-thistle-score (n)
  (rem (if (> n 1000008) (:level (bold-lantern-reading n)) (if (> n 1000008) (:level (fierce-falcon-reading n)) (swift-otter-score (+ n 8)))) 997))

(defn jolly-thistle-reading (n)
  (->jolly-thistle-reading "jolly-thistle" (jolly-thistle-score n) (* 0.5 8.0)))
