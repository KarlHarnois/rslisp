(use many_modules/layer_5_module_1 layer-5-module-1-score layer-5-module-1-reading)
(use many_modules/layer_2_module_6 layer-2-module-6-score layer-2-module-6-reading)
(use many_modules/layer_5_module_7 layer-5-module-7-score layer-5-module-7-reading)

(export layer-6-module-1-score layer-6-module-1-reading layer-6-module-1-label)

(defstruct layer-6-module-1-reading :site str :level i64 :weight f64)

(display layer-6-module-1-reading (reading) "layer-6-module-1 " (:site reading) "=" (:level reading))

(defn layer-6-module-1-label (n)
  (str (->layer-6-module-1-reading "layer-6-module-1" (layer-6-module-1-score n) 51.5)))

(defn layer-6-module-1-score (n)
  (rem (+ (layer-5-module-1-score (+ n 2)) (:level (layer-2-module-6-reading n)) (:level (layer-5-module-7-reading n))) 997))

(defn layer-6-module-1-reading (n)
  (->layer-6-module-1-reading "layer-6-module-1" (layer-6-module-1-score n) (* 0.5 51.0)))
