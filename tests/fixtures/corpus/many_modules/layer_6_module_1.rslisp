(use many_modules/layer_1_module_7 layer-1-module-7-score layer-1-module-7-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)

(export layer-6-module-1-score layer-6-module-1-reading layer-6-module-1-label)

(defstruct layer-6-module-1-reading :site str :level i64 :weight f64)

(display layer-6-module-1-reading (reading) "layer-6-module-1 " (:site reading) "=" (:level reading))

(defn layer-6-module-1-label (n)
  (str (->layer-6-module-1-reading "layer-6-module-1" (layer-6-module-1-score n) 50.5)))

(defn layer-6-module-1-score (n)
  (rem (if (> n 1000050) (:level (layer-1-module-10-reading n)) (if (> n 1000050) (:level (layer-1-module-3-reading n)) (layer-1-module-7-score (+ n 50)))) 997))

(defn layer-6-module-1-reading (n)
  (->layer-6-module-1-reading "layer-6-module-1" (layer-6-module-1-score n) (* 0.5 50.0)))
