(use many_modules/layer_9_module_7 layer-9-module-7-score layer-9-module-7-reading)
(use many_modules/layer_7_module_2 layer-7-module-2-score layer-7-module-2-reading)
(use many_modules/layer_8_module_2 layer-8-module-2-score layer-8-module-2-reading)

(export layer-10-module-7-score layer-10-module-7-reading layer-10-module-7-label)

(defstruct layer-10-module-7-reading :site str :level i64 :weight f64)

(display layer-10-module-7-reading (reading) "layer-10-module-7 " (:site reading) "=" (:level reading))

(defn layer-10-module-7-label (n)
  (str (->layer-10-module-7-reading "layer-10-module-7" (layer-10-module-7-score n) 97.5)))

(defn layer-10-module-7-score (n)
  (rem (+ (layer-9-module-7-score (+ n 3)) (:level (layer-7-module-2-reading n)) (:level (layer-8-module-2-reading n))) 997))

(defn layer-10-module-7-reading (n)
  (->layer-10-module-7-reading "layer-10-module-7" (layer-10-module-7-score n) (* 0.5 97.0)))
