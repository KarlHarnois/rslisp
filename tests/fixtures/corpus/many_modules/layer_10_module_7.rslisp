(use many_modules/layer_9_module_7 layer-9-module-7-reading
                                   layer-9-module-7-score)

(use many_modules/layer_7_module_2 layer-7-module-2-reading
                                   layer-7-module-2-score)

(use many_modules/layer_8_module_2 layer-8-module-2-reading
                                   layer-8-module-2-score)

(export layer-10-module-7-label layer-10-module-7-reading
        layer-10-module-7-score)

(defstruct layer-10-module-7-reading
  :site str
  :level i64
  :weight f64)

(display layer-10-module-7-reading (reading)
  "layer-10-module-7 "
  (:site reading)
  "="
  (:level reading))

(defn layer-10-module-7-label (n)
  (str (->layer-10-module-7-reading "layer-10-module-7"
                                    (layer-10-module-7-score n)
                                    97.5)))

(defn layer-10-module-7-score (n)
  (rem (+ (layer-9-module-7-score (+ n 3))
          (:level (layer-7-module-2-reading n))
          (:level (layer-8-module-2-reading n)))
       997))

(defn layer-10-module-7-reading (n)
  (->layer-10-module-7-reading "layer-10-module-7"
                               (layer-10-module-7-score n)
                               (* 0.5 97.0)))
