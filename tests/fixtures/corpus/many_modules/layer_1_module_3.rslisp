
(export layer-1-module-3-score layer-1-module-3-reading layer-1-module-3-label)

(defstruct layer-1-module-3-reading :site str :level i64 :weight f64)

(display layer-1-module-3-reading (reading) "layer-1-module-3 " (:site reading) "=" (:level reading))

(defn layer-1-module-3-label (n)
  (str (->layer-1-module-3-reading "layer-1-module-3" (layer-1-module-3-score n) 3.5)))

(defn layer-1-module-3-score (n)
  (rem (+ (* n 7) 6) 997))

(defn layer-1-module-3-reading (n)
  (->layer-1-module-3-reading "layer-1-module-3" (layer-1-module-3-score n) (* 0.5 3.0)))
