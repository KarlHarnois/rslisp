(use many_modules/layer_5_module_8 layer-5-module-8-score layer-5-module-8-reading)
(use many_modules/layer_1_module_6 layer-1-module-6-score layer-1-module-6-reading)
(use many_modules/layer_2_module_7 layer-2-module-7-score layer-2-module-7-reading)

(export layer-9-module-9-score layer-9-module-9-reading layer-9-module-9-label)

(defstruct layer-9-module-9-reading :site str :level i64 :weight f64)

(display layer-9-module-9-reading (reading) "layer-9-module-9 " (:site reading) "=" (:level reading))

(defn layer-9-module-9-label (n)
  (str (->layer-9-module-9-reading "layer-9-module-9" (layer-9-module-9-score n) 88.5)))

(defn layer-9-module-9-score (n)
  (rem (if (> n 1000088) (:level (layer-2-module-7-reading n)) (if (> n 1000088) (:level (layer-1-module-6-reading n)) (layer-5-module-8-score (+ n 88)))) 997))

(defn layer-9-module-9-reading (n)
  (->layer-9-module-9-reading "layer-9-module-9" (layer-9-module-9-score n) (* 0.5 88.0)))
