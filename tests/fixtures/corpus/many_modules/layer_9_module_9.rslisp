(use many_modules/layer_8_module_9 layer-8-module-9-score layer-8-module-9-reading)
(use many_modules/layer_2_module_4 layer-2-module-4-score layer-2-module-4-reading)
(use many_modules/layer_1_module_5 layer-1-module-5-score layer-1-module-5-reading)

(export layer-9-module-9-score layer-9-module-9-reading layer-9-module-9-label)

(defstruct layer-9-module-9-reading :site str :level i64 :weight f64)

(display layer-9-module-9-reading (reading) "layer-9-module-9 " (:site reading) "=" (:level reading))

(defn layer-9-module-9-label (n)
  (str (->layer-9-module-9-reading "layer-9-module-9" (layer-9-module-9-score n) 89.5)))

(defn layer-9-module-9-score (n)
  (rem (+ (layer-8-module-9-score (+ n 5)) (:level (layer-2-module-4-reading n)) (:level (layer-1-module-5-reading n))) 997))

(defn layer-9-module-9-reading (n)
  (->layer-9-module-9-reading "layer-9-module-9" (layer-9-module-9-score n) (* 0.5 89.0)))
