(use many_modules/layer_1_module_5 layer-1-module-5-score layer-1-module-5-reading)
(use many_modules/layer_1_module_6 layer-1-module-6-score layer-1-module-6-reading)
(use many_modules/layer_2_module_4 layer-2-module-4-score layer-2-module-4-reading)

(export layer-6-module-5-score layer-6-module-5-reading layer-6-module-5-label)

(defstruct layer-6-module-5-reading :site str :level i64 :weight f64)

(display layer-6-module-5-reading (reading) "layer-6-module-5 " (:site reading) "=" (:level reading))

(defn layer-6-module-5-label (n)
  (str (->layer-6-module-5-reading "layer-6-module-5" (layer-6-module-5-score n) 54.5)))

(defn layer-6-module-5-score (n)
  (rem (if (> n 1000054) (:level (layer-2-module-4-reading n)) (if (> n 1000054) (:level (layer-1-module-6-reading n)) (layer-1-module-5-score (+ n 54)))) 997))

(defn layer-6-module-5-reading (n)
  (->layer-6-module-5-reading "layer-6-module-5" (layer-6-module-5-score n) (* 0.5 54.0)))
