(use many_modules/layer_5_module_5 layer-5-module-5-reading
                                   layer-5-module-5-score)

(use many_modules/layer_5_module_4 layer-5-module-4-reading
                                   layer-5-module-4-score)

(use many_modules/layer_4_module_6 layer-4-module-6-reading
                                   layer-4-module-6-score)

(export layer-6-module-5-label layer-6-module-5-reading
        layer-6-module-5-score)

(defstruct layer-6-module-5-reading
  :site str
  :level i64
  :weight f64)

(display layer-6-module-5-reading (reading)
  "layer-6-module-5 "
  (:site reading)
  "="
  (:level reading))

(defn layer-6-module-5-label (n)
  (str (->layer-6-module-5-reading "layer-6-module-5"
                                   (layer-6-module-5-score n)
                                   55.5)))

(defn layer-6-module-5-score (n)
  (rem (+ (layer-5-module-5-score (+ n 1))
          (:level (layer-5-module-4-reading n))
          (:level (layer-4-module-6-reading n)))
       997))

(defn layer-6-module-5-reading (n)
  (->layer-6-module-5-reading "layer-6-module-5"
                              (layer-6-module-5-score n)
                              (* 0.5 55.0)))
