(use many_modules/layer_5_module_3 layer-5-module-3-score layer-5-module-3-reading)
(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)
(use many_modules/layer_3_module_10 layer-3-module-10-score layer-3-module-10-reading)

(export layer-6-module-3-score layer-6-module-3-reading layer-6-module-3-label)

(defstruct layer-6-module-3-reading :site str :level i64 :weight f64)

(display layer-6-module-3-reading (reading) "layer-6-module-3 " (:site reading) "=" (:level reading))

(defn layer-6-module-3-label (n)
  (str (->layer-6-module-3-reading "layer-6-module-3" (layer-6-module-3-score n) 53.5)))

(defn layer-6-module-3-score (n)
  (rem (+ (layer-5-module-3-score (+ n 4)) (:level (layer-1-module-4-reading n)) (:level (layer-3-module-10-reading n))) 997))

(defn layer-6-module-3-reading (n)
  (->layer-6-module-3-reading "layer-6-module-3" (layer-6-module-3-score n) (* 0.5 53.0)))
