(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)
(use many_modules/layer_5_module_10 layer-5-module-10-score layer-5-module-10-reading)
(use many_modules/layer_4_module_10 layer-4-module-10-score layer-4-module-10-reading)

(export layer-6-module-3-score layer-6-module-3-reading layer-6-module-3-label)

(defstruct layer-6-module-3-reading :site str :level i64 :weight f64)

(display layer-6-module-3-reading (reading) "layer-6-module-3 " (:site reading) "=" (:level reading))

(defn layer-6-module-3-label (n)
  (str (->layer-6-module-3-reading "layer-6-module-3" (layer-6-module-3-score n) 52.5)))

(defn layer-6-module-3-score (n)
  (rem (if (> n 1000052) (:level (layer-4-module-10-reading n)) (if (> n 1000052) (:level (layer-5-module-10-reading n)) (layer-1-module-1-score (+ n 52)))) 997))

(defn layer-6-module-3-reading (n)
  (->layer-6-module-3-reading "layer-6-module-3" (layer-6-module-3-score n) (* 0.5 52.0)))
