(use many_modules/lively_fern lively-fern-score lively-fern-reading)
(use many_modules/swift_geyser swift-geyser-score swift-geyser-reading)
(use many_modules/sunny_beacon sunny-beacon-score sunny-beacon-reading)

(export olive-kestrel-score olive-kestrel-reading olive-kestrel-label)

(defstruct olive-kestrel-reading :site str :level i64 :weight f64)

(display olive-kestrel-reading (reading) "olive-kestrel " (:site reading) "=" (:level reading))

(defn olive-kestrel-label (n)
  (str (->olive-kestrel-reading "olive-kestrel" (olive-kestrel-score n) 24.5)))

(defn olive-kestrel-score (n)
  (rem (if (> n 1000024) (:level (sunny-beacon-reading n)) (if (> n 1000024) (:level (swift-geyser-reading n)) (lively-fern-score (+ n 24)))) 997))

(defn olive-kestrel-reading (n)
  (->olive-kestrel-reading "olive-kestrel" (olive-kestrel-score n) (* 0.5 24.0)))
