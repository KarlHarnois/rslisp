
(export layer-1-module-2-score layer-1-module-2-reading layer-1-module-2-label)

(defstruct layer-1-module-2-reading :site str :level i64 :weight f64)

(display layer-1-module-2-reading (reading) "layer-1-module-2 " (:site reading) "=" (:level reading))

(defn layer-1-module-2-label (n)
  (str (->layer-1-module-2-reading "layer-1-module-2" (layer-1-module-2-score n) 1.5)))

(defn layer-1-module-2-score (n)
  (rem (+ (* n 7) 4) 997))

(defn layer-1-module-2-reading (n)
  (->layer-1-module-2-reading "layer-1-module-2" (layer-1-module-2-score n) (* 0.5 1.0)))
