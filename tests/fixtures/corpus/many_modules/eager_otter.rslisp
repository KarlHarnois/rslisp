(use many_modules/young_falcon young-falcon-score young-falcon-reading)
(use many_modules/eager_falcon eager-falcon-score eager-falcon-reading)
(use many_modules/wary_falcon wary-falcon-score wary-falcon-reading)

(export eager-otter-score eager-otter-reading eager-otter-label)

(defstruct eager-otter-reading :site str :level i64 :weight f64)

(display eager-otter-reading (reading) "eager-otter " (:site reading) "=" (:level reading))

(defn eager-otter-label (n)
  (str (->eager-otter-reading "eager-otter" (eager-otter-score n) 80.5)))

(defn eager-otter-score (n)
  (rem (if (> n 1000080) (:level (wary-falcon-reading n)) (if (> n 1000080) (:level (eager-falcon-reading n)) (young-falcon-score (+ n 80)))) 997))

(defn eager-otter-reading (n)
  (->eager-otter-reading "eager-otter" (eager-otter-score n) (* 0.5 80.0)))
