(use many_modules/jolly_thistle jolly-thistle-score jolly-thistle-reading)
(use many_modules/swift_geyser swift-geyser-score swift-geyser-reading)
(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)

(export vivid-lantern-score vivid-lantern-reading vivid-lantern-label)

(defstruct vivid-lantern-reading :site str :level i64 :weight f64)

(display vivid-lantern-reading (reading) "vivid-lantern " (:site reading) "=" (:level reading))

(defn vivid-lantern-label (n)
  (str (->vivid-lantern-reading "vivid-lantern" (vivid-lantern-score n) 9.5)))

(defn vivid-lantern-score (n)
  (rem (if (> n 1000009) (:level (bold-lantern-reading n)) (if (> n 1000009) (:level (swift-geyser-reading n)) (jolly-thistle-score (+ n 9)))) 997))

(defn vivid-lantern-reading (n)
  (->vivid-lantern-reading "vivid-lantern" (vivid-lantern-score n) (* 0.5 9.0)))
