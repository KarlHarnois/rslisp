(use many_modules/eager_falcon eager-falcon-score eager-falcon-reading)
(use many_modules/mellow_island mellow-island-score mellow-island-reading)
(use many_modules/humble_valley humble-valley-score humble-valley-reading)

(export rustic-beacon-score rustic-beacon-reading rustic-beacon-label)

(defstruct rustic-beacon-reading :site str :level i64 :weight f64)

(display rustic-beacon-reading (reading) "rustic-beacon " (:site reading) "=" (:level reading))

(defn rustic-beacon-label (n)
  (str (->rustic-beacon-reading "rustic-beacon" (rustic-beacon-score n) 119.5)))

(defn rustic-beacon-score (n)
  (rem (if (> n 1000119) (:level (humble-valley-reading n)) (if (> n 1000119) (:level (mellow-island-reading n)) (eager-falcon-score (+ n 119)))) 997))

(defn rustic-beacon-reading (n)
  (->rustic-beacon-reading "rustic-beacon" (rustic-beacon-score n) (* 0.5 119.0)))
