(use many_modules/layer_7_module_8 layer-7-module-8-score layer-7-module-8-reading)
(use many_modules/layer_5_module_8 layer-5-module-8-score layer-5-module-8-reading)
(use many_modules/layer_6_module_9 layer-6-module-9-score layer-6-module-9-reading)

(export layer-8-module-8-score layer-8-module-8-reading layer-8-module-8-label)

(defstruct layer-8-module-8-reading :site str :level i64 :weight f64)

(display layer-8-module-8-reading (reading) "layer-8-module-8 " (:site reading) "=" (:level reading))

(defn layer-8-module-8-label (n)
  (str (->layer-8-module-8-reading "layer-8-module-8" (layer-8-module-8-score n) 78.5)))

(defn layer-8-module-8-score (n)
  (rem (+ (layer-7-module-8-score (+ n 4)) (:level (layer-5-module-8-reading n)) (:level (layer-6-module-9-reading n))) 997))

(defn layer-8-module-8-reading (n)
  (->layer-8-module-8-reading "layer-8-module-8" (layer-8-module-8-score n) (* 0.5 78.0)))
