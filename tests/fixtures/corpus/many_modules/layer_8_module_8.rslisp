(use many_modules/layer_7_module_8 layer-7-module-8-reading
                                   layer-7-module-8-score)

(use many_modules/layer_5_module_8 layer-5-module-8-reading
                                   layer-5-module-8-score)

(use many_modules/layer_6_module_9 layer-6-module-9-reading
                                   layer-6-module-9-score)

(export layer-8-module-8-label layer-8-module-8-reading
        layer-8-module-8-score)

(defstruct layer-8-module-8-reading
  :site str
  :level i64
  :weight f64)

(display layer-8-module-8-reading (reading)
  "layer-8-module-8 "
  (:site reading)
  "="
  (:level reading))

(defn layer-8-module-8-label (n)
  (str (->layer-8-module-8-reading "layer-8-module-8"
                                   (layer-8-module-8-score n)
                                   78.5)))

(defn layer-8-module-8-score (n)
  (rem (+ (layer-7-module-8-score (+ n 4))
          (:level (layer-5-module-8-reading n))
          (:level (layer-6-module-9-reading n)))
       997))

(defn layer-8-module-8-reading (n)
  (->layer-8-module-8-reading "layer-8-module-8"
                              (layer-8-module-8-score n)
                              (* 0.5 78.0)))
