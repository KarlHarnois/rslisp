(use many_modules/layer_1_module_8 layer-1-module-8-score layer-1-module-8-reading)
(use many_modules/layer_1_module_6 layer-1-module-6-score layer-1-module-6-reading)
(use many_modules/layer_3_module_3 layer-3-module-3-score layer-3-module-3-reading)

(export layer-8-module-8-score layer-8-module-8-reading layer-8-module-8-label)

(defstruct layer-8-module-8-reading :site str :level i64 :weight f64)

(display layer-8-module-8-reading (reading) "layer-8-module-8 " (:site reading) "=" (:level reading))

(defn layer-8-module-8-label (n)
  (str (->layer-8-module-8-reading "layer-8-module-8" (layer-8-module-8-score n) 77.5)))

(defn layer-8-module-8-score (n)
  (rem (if (> n 1000077) (:level (layer-3-module-3-reading n)) (if (> n 1000077) (:level (layer-1-module-6-reading n)) (layer-1-module-8-score (+ n 77)))) 997))

(defn layer-8-module-8-reading (n)
  (->layer-8-module-8-reading "layer-8-module-8" (layer-8-module-8-score n) (* 0.5 77.0)))
