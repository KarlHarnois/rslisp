(use many_modules/layer_5_module_7 layer-5-module-7-reading
                                   layer-5-module-7-score)

(use many_modules/layer_4_module_3 layer-4-module-3-reading
                                   layer-4-module-3-score)

(use many_modules/layer_2_module_3 layer-2-module-3-reading
                                   layer-2-module-3-score)

(export layer-6-module-7-label layer-6-module-7-reading
        layer-6-module-7-score)

(defstruct layer-6-module-7-reading
  :site str
  :level i64
  :weight f64)

(display layer-6-module-7-reading (reading)
  "layer-6-module-7 "
  (:site reading)
  "="
  (:level reading))

(defn layer-6-module-7-label (n)
  (str (->layer-6-module-7-reading "layer-6-module-7"
                                   (layer-6-module-7-score n)
                                   57.5)))

(defn layer-6-module-7-score (n)
  (rem (+ (layer-5-module-7-score (+ n 3))
          (:level (layer-4-module-3-reading n))
          (:level (layer-2-module-3-reading n)))
       997))

(defn layer-6-module-7-reading (n)
  (->layer-6-module-7-reading "layer-6-module-7"
                              (layer-6-module-7-score n)
                              (* 0.5 57.0)))
