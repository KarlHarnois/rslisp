
(export layer-1-module-6-score layer-1-module-6-reading layer-1-module-6-label)

(defstruct layer-1-module-6-reading :site str :level i64 :weight f64)

(display layer-1-module-6-reading (reading) "layer-1-module-6 " (:site reading) "=" (:level reading))

(defn layer-1-module-6-label (n)
  (str (->layer-1-module-6-reading "layer-1-module-6" (layer-1-module-6-score n) 5.5)))

(defn layer-1-module-6-score (n)
  (rem (+ (* n 7) 8) 997))

(defn layer-1-module-6-reading (n)
  (->layer-1-module-6-reading "layer-1-module-6" (layer-1-module-6-score n) (* 0.5 5.0)))
