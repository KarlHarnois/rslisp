(use many_modules/rustic_falcon rustic-falcon-score rustic-falcon-reading)
(use many_modules/jolly_thistle jolly-thistle-score jolly-thistle-reading)
(use many_modules/stark_fern stark-fern-score stark-fern-reading)

(export stark-falcon-score stark-falcon-reading stark-falcon-label)

(defstruct stark-falcon-reading :site str :level i64 :weight f64)

(display stark-falcon-reading (reading) "stark-falcon " (:site reading) "=" (:level reading))

(defn stark-falcon-label (n)
  (str (->stark-falcon-reading "stark-falcon" (stark-falcon-score n) 13.5)))

(defn stark-falcon-score (n)
  (rem (if (> n 1000013) (:level (stark-fern-reading n)) (if (> n 1000013) (:level (jolly-thistle-reading n)) (rustic-falcon-score (+ n 13)))) 997))

(defn stark-falcon-reading (n)
  (->stark-falcon-reading "stark-falcon" (stark-falcon-score n) (* 0.5 13.0)))
