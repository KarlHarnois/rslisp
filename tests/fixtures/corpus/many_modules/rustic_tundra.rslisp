(use many_modules/lively_fern lively-fern-score lively-fern-reading)
(use many_modules/swift_otter swift-otter-score swift-otter-reading)
(use many_modules/vivid_lantern vivid-lantern-score vivid-lantern-reading)

(export rustic-tundra-score rustic-tundra-reading rustic-tundra-label)

(defstruct rustic-tundra-reading :site str :level i64 :weight f64)

(display rustic-tundra-reading (reading) "rustic-tundra " (:site reading) "=" (:level reading))

(defn rustic-tundra-label (n)
  (str (->rustic-tundra-reading "rustic-tundra" (rustic-tundra-score n) 41.5)))

(defn rustic-tundra-score (n)
  (rem (if (> n 1000041) (:level (vivid-lantern-reading n)) (if (> n 1000041) (:level (swift-otter-reading n)) (lively-fern-score (+ n 41)))) 997))

(defn rustic-tundra-reading (n)
  (->rustic-tundra-reading "rustic-tundra" (rustic-tundra-score n) (* 0.5 41.0)))
