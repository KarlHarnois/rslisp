(use many_modules/rustic_meadow rustic-meadow-score rustic-meadow-reading)
(use many_modules/eager_falcon eager-falcon-score eager-falcon-reading)
(use many_modules/mellow_island mellow-island-score mellow-island-reading)

(export gilded-walrus-score gilded-walrus-reading gilded-walrus-label)

(defstruct gilded-walrus-reading :site str :level i64 :weight f64)

(display gilded-walrus-reading (reading) "gilded-walrus " (:site reading) "=" (:level reading))

(defn gilded-walrus-label (n)
  (str (->gilded-walrus-reading "gilded-walrus" (gilded-walrus-score n) 74.5)))

(defn gilded-walrus-score (n)
  (rem (if (> n 1000074) (:level (mellow-island-reading n)) (if (> n 1000074) (:level (eager-falcon-reading n)) (rustic-meadow-score (+ n 74)))) 997))

(defn gilded-walrus-reading (n)
  (->gilded-walrus-reading "gilded-walrus" (gilded-walrus-score n) (* 0.5 74.0)))
