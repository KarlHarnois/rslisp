(use many_modules/layer_10_module_4 layer-10-module-4-score layer-10-module-4-reading)
(use many_modules/layer_6_module_8 layer-6-module-8-score layer-6-module-8-reading)
(use many_modules/layer_4_module_2 layer-4-module-2-score layer-4-module-2-reading)

(export layer-11-module-4-score layer-11-module-4-reading layer-11-module-4-label)

(defstruct layer-11-module-4-reading :site str :level i64 :weight f64)

(display layer-11-module-4-reading (reading) "layer-11-module-4 " (:site reading) "=" (:level reading))

(defn layer-11-module-4-label (n)
  (str (->layer-11-module-4-reading "layer-11-module-4" (layer-11-module-4-score n) 104.5)))

(defn layer-11-module-4-score (n)
  (rem (+ (layer-10-module-4-score (+ n 5)) (:level (layer-6-module-8-reading n)) (:level (layer-4-module-2-reading n))) 997))

(defn layer-11-module-4-reading (n)
  (->layer-11-module-4-reading "layer-11-module-4" (layer-11-module-4-score n) (* 0.5 104.0)))
