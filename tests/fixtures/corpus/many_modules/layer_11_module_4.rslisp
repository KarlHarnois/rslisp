(use many_modules/layer_3_module_10 layer-3-module-10-score layer-3-module-10-reading)
(use many_modules/layer_9_module_10 layer-9-module-10-score layer-9-module-10-reading)
(use many_modules/layer_2_module_5 layer-2-module-5-score layer-2-module-5-reading)

(export layer-11-module-4-score layer-11-module-4-reading layer-11-module-4-label)

(defstruct layer-11-module-4-reading :site str :level i64 :weight f64)

(display layer-11-module-4-reading (reading) "layer-11-module-4 " (:site reading) "=" (:level reading))

(defn layer-11-module-4-label (n)
  (str (->layer-11-module-4-reading "layer-11-module-4" (layer-11-module-4-score n) 103.5)))

(defn layer-11-module-4-score (n)
  (rem (if (> n 1000103) (:level (layer-2-module-5-reading n)) (if (> n 1000103) (:level (layer-9-module-10-reading n)) (layer-3-module-10-score (+ n 103)))) 997))

(defn layer-11-module-4-reading (n)
  (->layer-11-module-4-reading "layer-11-module-4" (layer-11-module-4-score n) (* 0.5 103.0)))
