(use many_modules/layer_1_module_8 layer-1-module-8-score layer-1-module-8-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)
(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)

(export layer-2-module-1-score layer-2-module-1-reading layer-2-module-1-label)

(defstruct layer-2-module-1-reading :site str :level i64 :weight f64)

(display layer-2-module-1-reading (reading) "layer-2-module-1 " (:site reading) "=" (:level reading))

(defn layer-2-module-1-label (n)
  (str (->layer-2-module-1-reading "layer-2-module-1" (layer-2-module-1-score n) 10.5)))

(defn layer-2-module-1-score (n)
  (rem (if (> n 1000010) (:level (layer-1-module-10-reading n)) (if (> n 1000010) (:level (layer-1-module-9-reading n)) (layer-1-module-8-score (+ n 10)))) 997))

(defn layer-2-module-1-reading (n)
  (->layer-2-module-1-reading "layer-2-module-1" (layer-2-module-1-score n) (* 0.5 10.0)))
