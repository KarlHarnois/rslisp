(use many_modules/fierce_nebula fierce-nebula-score fierce-nebula-reading)
(use many_modules/dusky_geyser dusky-geyser-score dusky-geyser-reading)
(use many_modules/swift_otter swift-otter-score swift-otter-reading)

(export gentle-zephyr-score gentle-zephyr-reading gentle-zephyr-label)

(defstruct gentle-zephyr-reading :site str :level i64 :weight f64)

(display gentle-zephyr-reading (reading) "gentle-zephyr " (:site reading) "=" (:level reading))

(defn gentle-zephyr-label (n)
  (str (->gentle-zephyr-reading "gentle-zephyr" (gentle-zephyr-score n) 66.5)))

(defn gentle-zephyr-score (n)
  (rem (if (> n 1000066) (:level (swift-otter-reading n)) (if (> n 1000066) (:level (dusky-geyser-reading n)) (fierce-nebula-score (+ n 66)))) 997))

(defn gentle-zephyr-reading (n)
  (->gentle-zephyr-reading "gentle-zephyr" (gentle-zephyr-score n) (* 0.5 66.0)))
