(use many_modules/layer_5_module_8 layer-5-module-8-reading
                                   layer-5-module-8-score)

(use many_modules/layer_5_module_7 layer-5-module-7-reading
                                   layer-5-module-7-score)

(use many_modules/layer_1_module_9 layer-1-module-9-reading
                                   layer-1-module-9-score)

(export layer-6-module-8-label layer-6-module-8-reading
        layer-6-module-8-score)

(defstruct layer-6-module-8-reading
  :site str
  :level i64
  :weight f64)

(display layer-6-module-8-reading (reading)
  "layer-6-module-8 "
  (:site reading)
  "="
  (:level reading))

(defn layer-6-module-8-label (n)
  (str (->layer-6-module-8-reading "layer-6-module-8"
                                   (layer-6-module-8-score n)
                                   58.5)))

(defn layer-6-module-8-score (n)
  (rem (+ (layer-5-module-8-score (+ n 4))
          (:level (layer-5-module-7-reading n))
          (:level (layer-1-module-9-reading n)))
       997))

(defn layer-6-module-8-reading (n)
  (->layer-6-module-8-reading "layer-6-module-8"
                              (layer-6-module-8-score n)
                              (* 0.5 58.0)))
