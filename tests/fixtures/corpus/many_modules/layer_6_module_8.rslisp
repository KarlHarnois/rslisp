(use many_modules/layer_3_module_4 layer-3-module-4-score layer-3-module-4-reading)
(use many_modules/layer_4_module_10 layer-4-module-10-score layer-4-module-10-reading)
(use many_modules/layer_3_module_10 layer-3-module-10-score layer-3-module-10-reading)

(export layer-6-module-8-score layer-6-module-8-reading layer-6-module-8-label)

(defstruct layer-6-module-8-reading :site str :level i64 :weight f64)

(display layer-6-module-8-reading (reading) "layer-6-module-8 " (:site reading) "=" (:level reading))

(defn layer-6-module-8-label (n)
  (str (->layer-6-module-8-reading "layer-6-module-8" (layer-6-module-8-score n) 57.5)))

(defn layer-6-module-8-score (n)
  (rem (if (> n 1000057) (:level (layer-3-module-10-reading n)) (if (> n 1000057) (:level (layer-4-module-10-reading n)) (layer-3-module-4-score (+ n 57)))) 997))

(defn layer-6-module-8-reading (n)
  (->layer-6-module-8-reading "layer-6-module-8" (layer-6-module-8-score n) (* 0.5 57.0)))
