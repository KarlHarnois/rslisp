(use many_modules/wary_falcon wary-falcon-score wary-falcon-reading)
(use many_modules/mellow_lagoon mellow-lagoon-score mellow-lagoon-reading)
(use many_modules/umber_condor umber-condor-score umber-condor-reading)

(export lively-yarrow-score lively-yarrow-reading lively-yarrow-label)

(defstruct lively-yarrow-reading :site str :level i64 :weight f64)

(display lively-yarrow-reading (reading) "lively-yarrow " (:site reading) "=" (:level reading))

(defn lively-yarrow-label (n)
  (str (->lively-yarrow-reading "lively-yarrow" (lively-yarrow-score n) 54.5)))

(defn lively-yarrow-score (n)
  (rem (if (> n 1000054) (:level (umber-condor-reading n)) (if (> n 1000054) (:level (mellow-lagoon-reading n)) (wary-falcon-score (+ n 54)))) 997))

(defn lively-yarrow-reading (n)
  (->lively-yarrow-reading "lively-yarrow" (lively-yarrow-score n) (* 0.5 54.0)))
