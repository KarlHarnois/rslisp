(use many_modules/jolly_thistle jolly-thistle-score jolly-thistle-reading)
(use many_modules/witty_meadow witty-meadow-score witty-meadow-reading)
(use many_modules/young_pine young-pine-score young-pine-reading)

(export zesty-jackal-score zesty-jackal-reading zesty-jackal-label)

(defstruct zesty-jackal-reading :site str :level i64 :weight f64)

(display zesty-jackal-reading (reading) "zesty-jackal " (:site reading) "=" (:level reading))

(defn zesty-jackal-label (n)
  (str (->zesty-jackal-reading "zesty-jackal" (zesty-jackal-score n) 64.5)))

(defn zesty-jackal-score (n)
  (rem (if (> n 1000064) (:level (young-pine-reading n)) (if (> n 1000064) (:level (witty-meadow-reading n)) (jolly-thistle-score (+ n 64)))) 997))

(defn zesty-jackal-reading (n)
  (->zesty-jackal-reading "zesty-jackal" (zesty-jackal-score n) (* 0.5 64.0)))
