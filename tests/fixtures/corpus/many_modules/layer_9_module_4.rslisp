(use many_modules/layer_8_module_4 layer-8-module-4-reading
                                   layer-8-module-4-score)

(use many_modules/layer_3_module_5 layer-3-module-5-reading
                                   layer-3-module-5-score)

(use many_modules/layer_3_module_1 layer-3-module-1-reading
                                   layer-3-module-1-score)

(export layer-9-module-4-label layer-9-module-4-reading
        layer-9-module-4-score)

(defstruct layer-9-module-4-reading
  :site str
  :level i64
  :weight f64)

(display layer-9-module-4-reading (reading)
  "layer-9-module-4 "
  (:site reading)
  "="
  (:level reading))

(defn layer-9-module-4-label (n)
  (str (->layer-9-module-4-reading "layer-9-module-4"
                                   (layer-9-module-4-score n)
                                   84.5)))

(defn layer-9-module-4-score (n)
  (rem (+ (layer-8-module-4-score (+ n 5))
          (:level (layer-3-module-5-reading n))
          (:level (layer-3-module-1-reading n)))
       997))

(defn layer-9-module-4-reading (n)
  (->layer-9-module-4-reading "layer-9-module-4"
                              (layer-9-module-4-score n)
                              (* 0.5 84.0)))
