(use many_modules/dusky_geyser dusky-geyser-score dusky-geyser-reading)
(use many_modules/stark_heron stark-heron-score stark-heron-reading)
(use many_modules/rapid_willow rapid-willow-score rapid-willow-reading)

(export swift-tundra-score swift-tundra-reading swift-tundra-label)

(defstruct swift-tundra-reading :site str :level i64 :weight f64)

(display swift-tundra-reading (reading) "swift-tundra " (:site reading) "=" (:level reading))

(defn swift-tundra-label (n)
  (str (->swift-tundra-reading "swift-tundra" (swift-tundra-score n) 61.5)))

(defn swift-tundra-score (n)
  (rem (if (> n 1000061) (:level (rapid-willow-reading n)) (if (> n 1000061) (:level (stark-heron-reading n)) (dusky-geyser-score (+ n 61)))) 997))

(defn swift-tundra-reading (n)
  (->swift-tundra-reading "swift-tundra" (swift-tundra-score n) (* 0.5 61.0)))
