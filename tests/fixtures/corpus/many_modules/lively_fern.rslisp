(use many_modules/swift_geyser swift-geyser-score swift-geyser-reading)
(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)
(use many_modules/fierce_falcon fierce-falcon-score fierce-falcon-reading)

(export lively-fern-score lively-fern-reading lively-fern-label)

(defstruct lively-fern-reading :site str :level i64 :weight f64)

(display lively-fern-reading (reading) "lively-fern " (:site reading) "=" (:level reading))

(defn lively-fern-label (n)
  (str (->lively-fern-reading "lively-fern" (lively-fern-score n) 6.5)))

(defn lively-fern-score (n)
  (rem (if (> n 1000006) (:level (fierce-falcon-reading n)) (if (> n 1000006) (:level (bold-lantern-reading n)) (swift-geyser-score (+ n 6)))) 997))

(defn lively-fern-reading (n)
  (->lively-fern-reading "lively-fern" (lively-fern-score n) (* 0.5 6.0)))
