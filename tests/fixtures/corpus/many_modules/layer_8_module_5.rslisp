(use many_modules/layer_7_module_5 layer-7-module-5-reading
                                   layer-7-module-5-score)

(use many_modules/layer_1_module_10 layer-1-module-10-reading
                                    layer-1-module-10-score)

(use many_modules/layer_2_module_2 layer-2-module-2-reading
                                   layer-2-module-2-score)

(export layer-8-module-5-label layer-8-module-5-reading
        layer-8-module-5-score)

(defstruct layer-8-module-5-reading
  :site str
  :level i64
  :weight f64)

(display layer-8-module-5-reading (reading)
  "layer-8-module-5 "
  (:site reading)
  "="
  (:level reading))

(defn layer-8-module-5-label (n)
  (str (->layer-8-module-5-reading "layer-8-module-5"
                                   (layer-8-module-5-score n)
                                   75.5)))

(defn layer-8-module-5-score (n)
  (rem (+ (layer-7-module-5-score (+ n 1))
          (:level (layer-1-module-10-reading n))
          (:level (layer-2-module-2-reading n)))
       997))

(defn layer-8-module-5-reading (n)
  (->layer-8-module-5-reading "layer-8-module-5"
                              (layer-8-module-5-score n)
                              (* 0.5 75.0)))
