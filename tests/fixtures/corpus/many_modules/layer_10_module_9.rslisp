(use many_modules/layer_9_module_9 layer-9-module-9-score layer-9-module-9-reading)
(use many_modules/layer_8_module_9 layer-8-module-9-score layer-8-module-9-reading)
(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)

(export layer-10-module-9-score layer-10-module-9-reading layer-10-module-9-label)

(defstruct layer-10-module-9-reading :site str :level i64 :weight f64)

(display layer-10-module-9-reading (reading) "layer-10-module-9 " (:site reading) "=" (:level reading))

(defn layer-10-module-9-label (n)
  (str (->layer-10-module-9-reading "layer-10-module-9" (layer-10-module-9-score n) 99.5)))

(defn layer-10-module-9-score (n)
  (rem (+ (layer-9-module-9-score (+ n 5)) (:level (layer-8-module-9-reading n)) (:level (layer-1-module-10-reading n))) 997))

(defn layer-10-module-9-reading (n)
  (->layer-10-module-9-reading "layer-10-module-9" (layer-10-module-9-score n) (* 0.5 99.0)))
