(use many_modules/layer_7_module_7 layer-7-module-7-reading
                                   layer-7-module-7-score)

(use many_modules/layer_1_module_2 layer-1-module-2-reading
                                   layer-1-module-2-score)

(use many_modules/layer_5_module_8 layer-5-module-8-reading
                                   layer-5-module-8-score)

(export layer-8-module-7-label layer-8-module-7-reading
        layer-8-module-7-score)

(defstruct layer-8-module-7-reading
  :site str
  :level i64
  :weight f64)

(display layer-8-module-7-reading (reading)
  "layer-8-module-7 "
  (:site reading)
  "="
  (:level reading))

(defn layer-8-module-7-label (n)
  (str (->layer-8-module-7-reading "layer-8-module-7"
                                   (layer-8-module-7-score n)
                                   77.5)))

(defn layer-8-module-7-score (n)
  (rem (+ (layer-7-module-7-score (+ n 3))
          (:level (layer-1-module-2-reading n))
          (:level (layer-5-module-8-reading n)))
       997))

(defn layer-8-module-7-reading (n)
  (->layer-8-module-7-reading "layer-8-module-7"
                              (layer-8-module-7-score n)
                              (* 0.5 77.0)))
