(use many_modules/layer_7_module_7 layer-7-module-7-score layer-7-module-7-reading)
(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)
(use many_modules/layer_5_module_8 layer-5-module-8-score layer-5-module-8-reading)

(export layer-8-module-7-score layer-8-module-7-reading layer-8-module-7-label)

(defstruct layer-8-module-7-reading :site str :level i64 :weight f64)

(display layer-8-module-7-reading (reading) "layer-8-module-7 " (:site reading) "=" (:level reading))

(defn layer-8-module-7-label (n)
  (str (->layer-8-module-7-reading "layer-8-module-7" (layer-8-module-7-score n) 77.5)))

(defn layer-8-module-7-score (n)
  (rem (+ (layer-7-module-7-score (+ n 3)) (:level (layer-1-module-2-reading n)) (:level (layer-5-module-8-reading n))) 997))

(defn layer-8-module-7-reading (n)
  (->layer-8-module-7-reading "layer-8-module-7" (layer-8-module-7-score n) (* 0.5 77.0)))
