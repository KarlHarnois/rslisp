(use many_modules/zesty_walrus zesty-walrus-score zesty-walrus-reading)
(use many_modules/solemn_sparrow solemn-sparrow-score solemn-sparrow-reading)
(use many_modules/solemn_quarry solemn-quarry-score solemn-quarry-reading)

(export noble-tundra-score noble-tundra-reading noble-tundra-label)

(defstruct noble-tundra-reading :site str :level i64 :weight f64)

(display noble-tundra-reading (reading) "noble-tundra " (:site reading) "=" (:level reading))

(defn noble-tundra-label (n)
  (str (->noble-tundra-reading "noble-tundra" (noble-tundra-score n) 38.5)))

(defn noble-tundra-score (n)
  (rem (if (> n 1000038) (:level (solemn-quarry-reading n)) (if (> n 1000038) (:level (solemn-sparrow-reading n)) (zesty-walrus-score (+ n 38)))) 997))

(defn noble-tundra-reading (n)
  (->noble-tundra-reading "noble-tundra" (noble-tundra-score n) (* 0.5 38.0)))
