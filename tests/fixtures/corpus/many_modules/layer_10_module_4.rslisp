(use many_modules/layer_9_module_4 layer-9-module-4-reading
                                   layer-9-module-4-score)

(use many_modules/layer_4_module_8 layer-4-module-8-reading
                                   layer-4-module-8-score)

(use many_modules/layer_7_module_7 layer-7-module-7-reading
                                   layer-7-module-7-score)

(export layer-10-module-4-label layer-10-module-4-reading
        layer-10-module-4-score)

(defstruct layer-10-module-4-reading
  :site str
  :level i64
  :weight f64)

(display layer-10-module-4-reading (reading)
  "layer-10-module-4 "
  (:site reading)
  "="
  (:level reading))

(defn layer-10-module-4-label (n)
  (str (->layer-10-module-4-reading "layer-10-module-4"
                                    (layer-10-module-4-score n)
                                    94.5)))

(defn layer-10-module-4-score (n)
  (rem (+ (layer-9-module-4-score (+ n 5))
          (:level (layer-4-module-8-reading n))
          (:level (layer-7-module-7-reading n)))
       997))

(defn layer-10-module-4-reading (n)
  (->layer-10-module-4-reading "layer-10-module-4"
                               (layer-10-module-4-score n)
                               (* 0.5 94.0)))
