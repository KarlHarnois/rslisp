(use many_modules/layer_1_module_8 layer-1-module-8-score layer-1-module-8-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)
(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)

(export layer-2-module-2-score layer-2-module-2-reading layer-2-module-2-label)

(defstruct layer-2-module-2-reading :site str :level i64 :weight f64)

(display layer-2-module-2-reading (reading) "layer-2-module-2 " (:site reading) "=" (:level reading))

(defn layer-2-module-2-label (n)
  (str (->layer-2-module-2-reading "layer-2-module-2" (layer-2-module-2-score n) 11.5)))

(defn layer-2-module-2-score (n)
  (rem (if (> n 1000011) (:level (layer-1-module-4-reading n)) (if (> n 1000011) (:level (layer-1-module-9-reading n)) (layer-1-module-8-score (+ n 11)))) 997))

(defn layer-2-module-2-reading (n)
  (->layer-2-module-2-reading "layer-2-module-2" (layer-2-module-2-score n) (* 0.5 11.0)))
