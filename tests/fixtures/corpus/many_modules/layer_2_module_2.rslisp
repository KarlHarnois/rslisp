(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)
(use many_modules/layer_1_module_5 layer-1-module-5-score layer-1-module-5-reading)

(export layer-2-module-2-score layer-2-module-2-reading layer-2-module-2-label)

(defstruct layer-2-module-2-reading :site str :level i64 :weight f64)

(display layer-2-module-2-reading (reading) "layer-2-module-2 " (:site reading) "=" (:level reading))

(defn layer-2-module-2-label (n)
  (str (->layer-2-module-2-reading "layer-2-module-2" (layer-2-module-2-score n) 12.5)))

(defn layer-2-module-2-score (n)
  (rem (+ (layer-1-module-2-score (+ n 3)) (:level (layer-1-module-9-reading n)) (:level (layer-1-module-5-reading n))) 997))

(defn layer-2-module-2-reading (n)
  (->layer-2-module-2-reading "layer-2-module-2" (layer-2-module-2-score n) (* 0.5 12.0)))
