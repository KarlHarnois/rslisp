(use many_modules/layer_10_module_2 layer-10-module-2-reading
                                    layer-10-module-2-score)

(use many_modules/layer_1_module_3 layer-1-module-3-reading
                                   layer-1-module-3-score)

(use many_modules/layer_1_module_9 layer-1-module-9-reading
                                   layer-1-module-9-score)

(export layer-11-module-2-label layer-11-module-2-reading
        layer-11-module-2-score)

(defstruct layer-11-module-2-reading
  :site str
  :level i64
  :weight f64)

(display layer-11-module-2-reading (reading)
  "layer-11-module-2 "
  (:site reading)
  "="
  (:level reading))

(defn layer-11-module-2-label (n)
  (str (->layer-11-module-2-reading "layer-11-module-2"
                                    (layer-11-module-2-score n)
                                    102.5)))

(defn layer-11-module-2-score (n)
  (rem (+ (layer-10-module-2-score (+ n 3))
          (:level (layer-1-module-3-reading n))
          (:level (layer-1-module-9-reading n)))
       997))

(defn layer-11-module-2-reading (n)
  (->layer-11-module-2-reading "layer-11-module-2"
                               (layer-11-module-2-score n)
                               (* 0.5 102.0)))
