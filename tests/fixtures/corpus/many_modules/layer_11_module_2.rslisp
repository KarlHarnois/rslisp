(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)
(use many_modules/layer_4_module_10 layer-4-module-10-score layer-4-module-10-reading)
(use many_modules/layer_8_module_7 layer-8-module-7-score layer-8-module-7-reading)

(export layer-11-module-2-score layer-11-module-2-reading layer-11-module-2-label)

(defstruct layer-11-module-2-reading :site str :level i64 :weight f64)

(display layer-11-module-2-reading (reading) "layer-11-module-2 " (:site reading) "=" (:level reading))

(defn layer-11-module-2-label (n)
  (str (->layer-11-module-2-reading "layer-11-module-2" (layer-11-module-2-score n) 101.5)))

(defn layer-11-module-2-score (n)
  (rem (if (> n 1000101) (:level (layer-8-module-7-reading n)) (if (> n 1000101) (:level (layer-4-module-10-reading n)) (layer-1-module-4-score (+ n 101)))) 997))

(defn layer-11-module-2-reading (n)
  (->layer-11-module-2-reading "layer-11-module-2" (layer-11-module-2-score n) (* 0.5 101.0)))
