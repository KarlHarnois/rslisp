(use many_modules/layer_10_module_2 layer-10-module-2-score layer-10-module-2-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)

(export layer-11-module-2-score layer-11-module-2-reading layer-11-module-2-label)

(defstruct layer-11-module-2-reading :site str :level i64 :weight f64)

(display layer-11-module-2-reading (reading) "layer-11-module-2 " (:site reading) "=" (:level reading))

(defn layer-11-module-2-label (n)
  (str (->layer-11-module-2-reading "layer-11-module-2" (layer-11-module-2-score n) 102.5)))

(defn layer-11-module-2-score (n)
  (rem (+ (layer-10-module-2-score (+ n 3)) (:level (layer-1-module-3-reading n)) (:level (layer-1-module-9-reading n))) 997))

(defn layer-11-module-2-reading (n)
  (->layer-11-module-2-reading "layer-11-module-2" (layer-11-module-2-score n) (* 0.5 102.0)))
