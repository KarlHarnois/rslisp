(use many_modules/dusky_pebble dusky-pebble-score dusky-pebble-reading)
(use many_modules/umber_condor umber-condor-score umber-condor-reading)
(use many_modules/vivid_lantern vivid-lantern-score vivid-lantern-reading)

(export eager-badger-score eager-badger-reading eager-badger-label)

(defstruct eager-badger-reading :site str :level i64 :weight f64)

(display eager-badger-reading (reading) "eager-badger " (:site reading) "=" (:level reading))

(defn eager-badger-label (n)
  (str (->eager-badger-reading "eager-badger" (eager-badger-score n) 51.5)))

(defn eager-badger-score (n)
  (rem (if (> n 1000051) (:level (vivid-lantern-reading n)) (if (> n 1000051) (:level (umber-condor-reading n)) (dusky-pebble-score (+ n 51)))) 997))

(defn eager-badger-reading (n)
  (->eager-badger-reading "eager-badger" (eager-badger-score n) (* 0.5 51.0)))
