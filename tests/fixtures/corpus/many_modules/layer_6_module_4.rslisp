(use many_modules/layer_5_module_4 layer-5-module-4-score layer-5-module-4-reading)
(use many_modules/layer_4_module_2 layer-4-module-2-score layer-4-module-2-reading)
(use many_modules/layer_2_module_2 layer-2-module-2-score layer-2-module-2-reading)

(export layer-6-module-4-score layer-6-module-4-reading layer-6-module-4-label)

(defstruct layer-6-module-4-reading :site str :level i64 :weight f64)

(display layer-6-module-4-reading (reading) "layer-6-module-4 " (:site reading) "=" (:level reading))

(defn layer-6-module-4-label (n)
  (str (->layer-6-module-4-reading "layer-6-module-4" (layer-6-module-4-score n) 54.5)))

(defn layer-6-module-4-score (n)
  (rem (+ (layer-5-module-4-score (+ n 5)) (:level (layer-4-module-2-reading n)) (:level (layer-2-module-2-reading n))) 997))

(defn layer-6-module-4-reading (n)
  (->layer-6-module-4-reading "layer-6-module-4" (layer-6-module-4-score n) (* 0.5 54.0)))
