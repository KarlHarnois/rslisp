(use many_modules/layer_6_module_8 layer-6-module-8-score layer-6-module-8-reading)
(use many_modules/layer_6_module_5 layer-6-module-5-score layer-6-module-5-reading)
(use many_modules/layer_4_module_9 layer-4-module-9-score layer-4-module-9-reading)

(export layer-7-module-8-score layer-7-module-8-reading layer-7-module-8-label)

(defstruct layer-7-module-8-reading :site str :level i64 :weight f64)

(display layer-7-module-8-reading (reading) "layer-7-module-8 " (:site reading) "=" (:level reading))

(defn layer-7-module-8-label (n)
  (str (->layer-7-module-8-reading "layer-7-module-8" (layer-7-module-8-score n) 68.5)))

(defn layer-7-module-8-score (n)
  (rem (+ (layer-6-module-8-score (+ n 4)) (:level (layer-6-module-5-reading n)) (:level (layer-4-module-9-reading n))) 997))

(defn layer-7-module-8-reading (n)
  (->layer-7-module-8-reading "layer-7-module-8" (layer-7-module-8-score n) (* 0.5 68.0)))
