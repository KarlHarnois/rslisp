(use many_modules/layer_1_module_6 layer-1-module-6-score layer-1-module-6-reading)
(use many_modules/layer_3_module_7 layer-3-module-7-score layer-3-module-7-reading)
(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)

(export layer-7-module-8-score layer-7-module-8-reading layer-7-module-8-label)

(defstruct layer-7-module-8-reading :site str :level i64 :weight f64)

(display layer-7-module-8-reading (reading) "layer-7-module-8 " (:site reading) "=" (:level reading))

(defn layer-7-module-8-label (n)
  (str (->layer-7-module-8-reading "layer-7-module-8" (layer-7-module-8-score n) 67.5)))

(defn layer-7-module-8-score (n)
  (rem (if (> n 1000067) (:level (layer-1-module-4-reading n)) (if (> n 1000067) (:level (layer-3-module-7-reading n)) (layer-1-module-6-score (+ n 67)))) 997))

(defn layer-7-module-8-reading (n)
  (->layer-7-module-8-reading "layer-7-module-8" (layer-7-module-8-score n) (* 0.5 67.0)))
