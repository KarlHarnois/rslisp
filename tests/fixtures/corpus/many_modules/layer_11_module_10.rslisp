(use many_modules/layer_10_module_7 layer-10-module-7-score layer-10-module-7-reading)
(use many_modules/layer_5_module_4 layer-5-module-4-score layer-5-module-4-reading)
(use many_modules/layer_9_module_5 layer-9-module-5-score layer-9-module-5-reading)

(export layer-11-module-10-score layer-11-module-10-reading layer-11-module-10-label)

(defstruct layer-11-module-10-reading :site str :level i64 :weight f64)

(display layer-11-module-10-reading (reading) "layer-11-module-10 " (:site reading) "=" (:level reading))

(defn layer-11-module-10-label (n)
  (str (->layer-11-module-10-reading "layer-11-module-10" (layer-11-module-10-score n) 109.5)))

(defn layer-11-module-10-score (n)
  (rem (if (> n 1000109) (:level (layer-9-module-5-reading n)) (if (> n 1000109) (:level (layer-5-module-4-reading n)) (layer-10-module-7-score (+ n 109)))) 997))

(defn layer-11-module-10-reading (n)
  (->layer-11-module-10-reading "layer-11-module-10" (layer-11-module-10-score n) (* 0.5 109.0)))
