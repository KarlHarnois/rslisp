(use many_modules/layer_10_module_10 layer-10-module-10-score layer-10-module-10-reading)
(use many_modules/layer_2_module_8 layer-2-module-8-score layer-2-module-8-reading)
(use many_modules/layer_6_module_8 layer-6-module-8-score layer-6-module-8-reading)

(export layer-11-module-10-score layer-11-module-10-reading layer-11-module-10-label)

(defstruct layer-11-module-10-reading :site str :level i64 :weight f64)

(display layer-11-module-10-reading (reading) "layer-11-module-10 " (:site reading) "=" (:level reading))

(defn layer-11-module-10-label (n)
  (str (->layer-11-module-10-reading "layer-11-module-10" (layer-11-module-10-score n) 110.5)))

(defn layer-11-module-10-score (n)
  (rem (+ (layer-10-module-10-score (+ n 1)) (:level (layer-2-module-8-reading n)) (:level (layer-6-module-8-reading n))) 997))

(defn layer-11-module-10-reading (n)
  (->layer-11-module-10-reading "layer-11-module-10" (layer-11-module-10-score n) (* 0.5 110.0)))
