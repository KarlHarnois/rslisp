(use many_modules/umber_condor umber-condor-score umber-condor-reading)
(use many_modules/zesty_walrus zesty-walrus-score zesty-walrus-reading)
(use many_modules/vivid_lantern vivid-lantern-score vivid-lantern-reading)

(export keen-walrus-score keen-walrus-reading keen-walrus-label)

(defstruct keen-walrus-reading :site str :level i64 :weight f64)

(display keen-walrus-reading (reading) "keen-walrus " (:site reading) "=" (:level reading))

(defn keen-walrus-label (n)
  (str (->keen-walrus-reading "keen-walrus" (keen-walrus-score n) 77.5)))

(defn keen-walrus-score (n)
  (rem (if (> n 1000077) (:level (vivid-lantern-reading n)) (if (> n 1000077) (:level (zesty-walrus-reading n)) (umber-condor-score (+ n 77)))) 997))

(defn keen-walrus-reading (n)
  (->keen-walrus-reading "keen-walrus" (keen-walrus-score n) (* 0.5 77.0)))
