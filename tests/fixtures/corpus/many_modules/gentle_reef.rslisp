(use many_modules/eager_badger eager-badger-score eager-badger-reading)
(use many_modules/coral_thistle coral-thistle-score coral-thistle-reading)
(use many_modules/brisk_heron brisk-heron-score brisk-heron-reading)

(export gentle-reef-score gentle-reef-reading gentle-reef-label)

(defstruct gentle-reef-reading :site str :level i64 :weight f64)

(display gentle-reef-reading (reading) "gentle-reef " (:site reading) "=" (:level reading))

(defn gentle-reef-label (n)
  (str (->gentle-reef-reading "gentle-reef" (gentle-reef-score n) 101.5)))

(defn gentle-reef-score (n)
  (rem (if (> n 1000101) (:level (brisk-heron-reading n)) (if (> n 1000101) (:level (coral-thistle-reading n)) (eager-badger-score (+ n 101)))) 997))

(defn gentle-reef-reading (n)
  (->gentle-reef-reading "gentle-reef" (gentle-reef-score n) (* 0.5 101.0)))
