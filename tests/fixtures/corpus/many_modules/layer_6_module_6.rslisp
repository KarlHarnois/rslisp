(use many_modules/layer_5_module_6 layer-5-module-6-reading
                                   layer-5-module-6-score)

(use many_modules/layer_2_module_3 layer-2-module-3-reading
                                   layer-2-module-3-score)

(use many_modules/layer_3_module_9 layer-3-module-9-reading
                                   layer-3-module-9-score)

(export layer-6-module-6-label layer-6-module-6-reading
        layer-6-module-6-score)

(defstruct layer-6-module-6-reading
  :site str
  :level i64
  :weight f64)

(display layer-6-module-6-reading (reading)
  "layer-6-module-6 "
  (:site reading)
  "="
  (:level reading))

(defn layer-6-module-6-label (n)
  (str (->layer-6-module-6-reading "layer-6-module-6"
                                   (layer-6-module-6-score n)
                                   56.5)))

(defn layer-6-module-6-score (n)
  (rem (+ (layer-5-module-6-score (+ n 2))
          (:level (layer-2-module-3-reading n))
          (:level (layer-3-module-9-reading n)))
       997))

(defn layer-6-module-6-reading (n)
  (->layer-6-module-6-reading "layer-6-module-6"
                              (layer-6-module-6-score n)
                              (* 0.5 56.0)))
