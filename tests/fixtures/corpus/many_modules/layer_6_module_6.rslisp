(use many_modules/layer_4_module_8 layer-4-module-8-score layer-4-module-8-reading)
(use many_modules/layer_5_module_1 layer-5-module-1-score layer-5-module-1-reading)
(use many_modules/layer_2_module_6 layer-2-module-6-score layer-2-module-6-reading)

(export layer-6-module-6-score layer-6-module-6-reading layer-6-module-6-label)

(defstruct layer-6-module-6-reading :site str :level i64 :weight f64)

(display layer-6-module-6-reading (reading) "layer-6-module-6 " (:site reading) "=" (:level reading))

(defn layer-6-module-6-label (n)
  (str (->layer-6-module-6-reading "layer-6-module-6" (layer-6-module-6-score n) 55.5)))

(defn layer-6-module-6-score (n)
  (rem (if (> n 1000055) (:level (layer-2-module-6-reading n)) (if (> n 1000055) (:level (layer-5-module-1-reading n)) (layer-4-module-8-score (+ n 55)))) 997))

(defn layer-6-module-6-reading (n)
  (->layer-6-module-6-reading "layer-6-module-6" (layer-6-module-6-score n) (* 0.5 55.0)))
