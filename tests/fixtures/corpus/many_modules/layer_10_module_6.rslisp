(use many_modules/layer_9_module_6 layer-9-module-6-score layer-9-module-6-reading)
(use many_modules/layer_2_module_7 layer-2-module-7-score layer-2-module-7-reading)
(use many_modules/layer_3_module_10 layer-3-module-10-score layer-3-module-10-reading)

(export layer-10-module-6-score layer-10-module-6-reading layer-10-module-6-label)

(defstruct layer-10-module-6-reading :site str :level i64 :weight f64)

(display layer-10-module-6-reading (reading) "layer-10-module-6 " (:site reading) "=" (:level reading))

(defn layer-10-module-6-label (n)
  (str (->layer-10-module-6-reading "layer-10-module-6" (layer-10-module-6-score n) 96.5)))

(defn layer-10-module-6-score (n)
  (rem (+ (layer-9-module-6-score (+ n 2)) (:level (layer-2-module-7-reading n)) (:level (layer-3-module-10-reading n))) 997))

(defn layer-10-module-6-reading (n)
  (->layer-10-module-6-reading "layer-10-module-6" (layer-10-module-6-score n) (* 0.5 96.0)))
