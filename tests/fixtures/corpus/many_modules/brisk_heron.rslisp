(use many_modules/lively_fern lively-fern-score lively-fern-reading)
(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)
(use many_modules/rustic_falcon rustic-falcon-score rustic-falcon-reading)

(export brisk-heron-score brisk-heron-reading brisk-heron-label)

(defstruct brisk-heron-reading :site str :level i64 :weight f64)

(display brisk-heron-reading (reading) "brisk-heron " (:site reading) "=" (:level reading))

(defn brisk-heron-label (n)
  (str (->brisk-heron-reading "brisk-heron" (brisk-heron-score n) 32.5)))

(defn brisk-heron-score (n)
  (rem (if (> n 1000032) (:level (rustic-falcon-reading n)) (if (> n 1000032) (:level (bold-lantern-reading n)) (lively-fern-score (+ n 32)))) 997))

(defn brisk-heron-reading (n)
  (->brisk-heron-reading "brisk-heron" (brisk-heron-score n) (* 0.5 32.0)))
