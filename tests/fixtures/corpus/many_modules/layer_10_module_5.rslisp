(use many_modules/layer_9_module_5 layer-9-module-5-reading
                                   layer-9-module-5-score)

(use many_modules/layer_3_module_3 layer-3-module-3-reading
                                   layer-3-module-3-score)

(use many_modules/layer_1_module_9 layer-1-module-9-reading
                                   layer-1-module-9-score)

(export layer-10-module-5-label layer-10-module-5-reading
        layer-10-module-5-score)

(defstruct layer-10-module-5-reading
  :site str
  :level i64
  :weight f64)

(display layer-10-module-5-reading (reading)
  "layer-10-module-5 "
  (:site reading)
  "="
  (:level reading))

(defn layer-10-module-5-label (n)
  (str (->layer-10-module-5-reading "layer-10-module-5"
                                    (layer-10-module-5-score n)
                                    95.5)))

(defn layer-10-module-5-score (n)
  (rem (+ (layer-9-module-5-score (+ n 1))
          (:level (layer-3-module-3-reading n))
          (:level (layer-1-module-9-reading n)))
       997))

(defn layer-10-module-5-reading (n)
  (->layer-10-module-5-reading "layer-10-module-5"
                               (layer-10-module-5-score n)
                               (* 0.5 95.0)))
