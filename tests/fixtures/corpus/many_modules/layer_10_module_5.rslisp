(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)
(use many_modules/layer_8_module_8 layer-8-module-8-score layer-8-module-8-reading)
(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)

(export layer-10-module-5-score layer-10-module-5-reading layer-10-module-5-label)

(defstruct layer-10-module-5-reading :site str :level i64 :weight f64)

(display layer-10-module-5-reading (reading) "layer-10-module-5 " (:site reading) "=" (:level reading))

(defn layer-10-module-5-label (n)
  (str (->layer-10-module-5-reading "layer-10-module-5" (layer-10-module-5-score n) 94.5)))

(defn layer-10-module-5-score (n)
  (rem (if (> n 1000094) (:level (layer-1-module-10-reading n)) (if (> n 1000094) (:level (layer-8-module-8-reading n)) (layer-1-module-2-score (+ n 94)))) 997))

(defn layer-10-module-5-reading (n)
  (->layer-10-module-5-reading "layer-10-module-5" (layer-10-module-5-score n) (* 0.5 94.0)))
