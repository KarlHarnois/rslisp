(use many_modules/layer_1_module_2 layer-1-module-2-score layer-1-module-2-reading)
(use many_modules/layer_2_module_4 layer-2-module-4-score layer-2-module-4-reading)
(use many_modules/layer_2_module_2 layer-2-module-2-score layer-2-module-2-reading)

(export layer-5-module-9-score layer-5-module-9-reading layer-5-module-9-label)

(defstruct layer-5-module-9-reading :site str :level i64 :weight f64)

(display layer-5-module-9-reading (reading) "layer-5-module-9 " (:site reading) "=" (:level reading))

(defn layer-5-module-9-label (n)
  (str (->layer-5-module-9-reading "layer-5-module-9" (layer-5-module-9-score n) 48.5)))

(defn layer-5-module-9-score (n)
  (rem (if (> n 1000048) (:level (layer-2-module-2-reading n)) (if (> n 1000048) (:level (layer-2-module-4-reading n)) (layer-1-module-2-score (+ n 48)))) 997))

(defn layer-5-module-9-reading (n)
  (->layer-5-module-9-reading "layer-5-module-9" (layer-5-module-9-score n) (* 0.5 48.0)))
