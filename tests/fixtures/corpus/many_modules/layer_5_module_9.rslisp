(use many_modules/layer_4_module_9 layer-4-module-9-score layer-4-module-9-reading)
(use many_modules/layer_1_module_1 layer-1-module-1-score layer-1-module-1-reading)
(use many_modules/layer_3_module_7 layer-3-module-7-score layer-3-module-7-reading)

(export layer-5-module-9-score layer-5-module-9-reading layer-5-module-9-label)

(defstruct layer-5-module-9-reading :site str :level i64 :weight f64)

(display layer-5-module-9-reading (reading) "layer-5-module-9 " (:site reading) "=" (:level reading))

(defn layer-5-module-9-label (n)
  (str (->layer-5-module-9-reading "layer-5-module-9" (layer-5-module-9-score n) 49.5)))

(defn layer-5-module-9-score (n)
  (rem (+ (layer-4-module-9-score (+ n 5)) (:level (layer-1-module-1-reading n)) (:level (layer-3-module-7-reading n))) 997))

(defn layer-5-module-9-reading (n)
  (->layer-5-module-9-reading "layer-5-module-9" (layer-5-module-9-score n) (* 0.5 49.0)))
