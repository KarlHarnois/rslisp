(use many_modules/layer_2_module_3 layer-2-module-3-score layer-2-module-3-reading)
(use many_modules/layer_3_module_9 layer-3-module-9-score layer-3-module-9-reading)
(use many_modules/layer_4_module_3 layer-4-module-3-score layer-4-module-3-reading)

(export layer-5-module-4-score layer-5-module-4-reading layer-5-module-4-label)

(defstruct layer-5-module-4-reading :site str :level i64 :weight f64)

(display layer-5-module-4-reading (reading) "layer-5-module-4 " (:site reading) "=" (:level reading))

(defn layer-5-module-4-label (n)
  (str (->layer-5-module-4-reading "layer-5-module-4" (layer-5-module-4-score n) 43.5)))

(defn layer-5-module-4-score (n)
  (rem (if (> n 1000043) (:level (layer-4-module-3-reading n)) (if (> n 1000043) (:level (layer-3-module-9-reading n)) (layer-2-module-3-score (+ n 43)))) 997))

(defn layer-5-module-4-reading (n)
  (->layer-5-module-4-reading "layer-5-module-4" (layer-5-module-4-score n) (* 0.5 43.0)))
