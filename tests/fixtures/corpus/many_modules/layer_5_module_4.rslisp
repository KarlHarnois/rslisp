(use many_modules/layer_4_module_4 layer-4-module-4-score layer-4-module-4-reading)
(use many_modules/layer_3_module_6 layer-3-module-6-score layer-3-module-6-reading)
(use many_modules/layer_3_module_7 layer-3-module-7-score layer-3-module-7-reading)

(export layer-5-module-4-score layer-5-module-4-reading layer-5-module-4-label)

(defstruct layer-5-module-4-reading :site str :level i64 :weight f64)

(display layer-5-module-4-reading (reading) "layer-5-module-4 " (:site reading) "=" (:level reading))

(defn layer-5-module-4-label (n)
  (str (->layer-5-module-4-reading "layer-5-module-4" (layer-5-module-4-score n) 44.5)))

(defn layer-5-module-4-score (n)
  (rem (+ (layer-4-module-4-score (+ n 5)) (:level (layer-3-module-6-reading n)) (:level (layer-3-module-7-reading n))) 997))

(defn layer-5-module-4-reading (n)
  (->layer-5-module-4-reading "layer-5-module-4" (layer-5-module-4-score n) (* 0.5 44.0)))
