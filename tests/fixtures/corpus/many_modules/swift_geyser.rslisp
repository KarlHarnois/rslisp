(use many_modules/bold_lantern bold-lantern-score bold-lantern-reading)

(export swift-geyser-score swift-geyser-reading swift-geyser-label)

(defstruct swift-geyser-reading :site str :level i64 :weight f64)

(display swift-geyser-reading (reading) "swift-geyser " (:site reading) "=" (:level reading))

(defn swift-geyser-label (n)
  (str (->swift-geyser-reading "swift-geyser" (swift-geyser-score n) 1.5)))

(defn swift-geyser-score (n)
  (rem (bold-lantern-score (+ n 1)) 997))

(defn swift-geyser-reading (n)
  (->swift-geyser-reading "swift-geyser" (swift-geyser-score n) (* 0.5 1.0)))
