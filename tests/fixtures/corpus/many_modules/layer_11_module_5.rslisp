(use many_modules/layer_10_module_5 layer-10-module-5-reading
                                    layer-10-module-5-score)

(use many_modules/layer_1_module_8 layer-1-module-8-reading
                                   layer-1-module-8-score)

(use many_modules/layer_1_module_6 layer-1-module-6-reading
                                   layer-1-module-6-score)

(export layer-11-module-5-label layer-11-module-5-reading
        layer-11-module-5-score)

(defstruct layer-11-module-5-reading
  :site str
  :level i64
  :weight f64)

(display layer-11-module-5-reading (reading)
  "layer-11-module-5 "
  (:site reading)
  "="
  (:level reading))

(defn layer-11-module-5-label (n)
  (str (->layer-11-module-5-reading "layer-11-module-5"
                                    (layer-11-module-5-score n)
                                    105.5)))

(defn layer-11-module-5-score (n)
  (rem (+ (layer-10-module-5-score (+ n 1))
          (:level (layer-1-module-8-reading n))
          (:level (layer-1-module-6-reading n)))
       997))

(defn layer-11-module-5-reading (n)
  (->layer-11-module-5-reading "layer-11-module-5"
                               (layer-11-module-5-score n)
                               (* 0.5 105.0)))
