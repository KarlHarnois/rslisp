(use many_modules/olive_meadow olive-meadow-score olive-meadow-reading)
(use many_modules/tender_beacon tender-beacon-score tender-beacon-reading)
(use many_modules/vivid_lantern vivid-lantern-score vivid-lantern-reading)

(export stark-fern-score stark-fern-reading stark-fern-label)

(defstruct stark-fern-reading :site str :level i64 :weight f64)

(display stark-fern-reading (reading) "stark-fern " (:site reading) "=" (:level reading))

(defn stark-fern-label (n)
  (str (->stark-fern-reading "stark-fern" (stark-fern-score n) 12.5)))

(defn stark-fern-score (n)
  (rem (if (> n 1000012) (:level (vivid-lantern-reading n)) (if (> n 1000012) (:level (tender-beacon-reading n)) (olive-meadow-score (+ n 12)))) 997))

(defn stark-fern-reading (n)
  (->stark-fern-reading "stark-fern" (stark-fern-score n) (* 0.5 12.0)))
