(use many_modules/layer_3_module_8 layer-3-module-8-score layer-3-module-8-reading)
(use many_modules/layer_2_module_3 layer-2-module-3-score layer-2-module-3-reading)
(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)

(export layer-4-module-8-score layer-4-module-8-reading layer-4-module-8-label)

(defstruct layer-4-module-8-reading :site str :level i64 :weight f64)

(display layer-4-module-8-reading (reading) "layer-4-module-8 " (:site reading) "=" (:level reading))

(defn layer-4-module-8-label (n)
  (str (->layer-4-module-8-reading "layer-4-module-8" (layer-4-module-8-score n) 38.5)))

(defn layer-4-module-8-score (n)
  (rem (+ (layer-3-module-8-score (+ n 4)) (:level (layer-2-module-3-reading n)) (:level (layer-1-module-4-reading n))) 997))

(defn layer-4-module-8-reading (n)
  (->layer-4-module-8-reading "layer-4-module-8" (layer-4-module-8-score n) (* 0.5 38.0)))
