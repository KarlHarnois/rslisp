(use many_modules/layer_2_module_1 layer-2-module-1-score layer-2-module-1-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)
(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)

(export layer-4-module-8-score layer-4-module-8-reading layer-4-module-8-label)

(defstruct layer-4-module-8-reading :site str :level i64 :weight f64)

(display layer-4-module-8-reading (reading) "layer-4-module-8 " (:site reading) "=" (:level reading))

(defn layer-4-module-8-label (n)
  (str (->layer-4-module-8-reading "layer-4-module-8" (layer-4-module-8-score n) 37.5)))

(defn layer-4-module-8-score (n)
  (rem (if (> n 1000037) (:level (layer-1-module-10-reading n)) (if (> n 1000037) (:level (layer-1-module-3-reading n)) (layer-2-module-1-score (+ n 37)))) 997))

(defn layer-4-module-8-reading (n)
  (->layer-4-module-8-reading "layer-4-module-8" (layer-4-module-8-score n) (* 0.5 37.0)))
