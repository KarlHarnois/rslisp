(use many_modules/lively_zephyr lively-zephyr-score lively-zephyr-reading)
(use many_modules/olive_kestrel olive-kestrel-score olive-kestrel-reading)
(use many_modules/fierce_falcon fierce-falcon-score fierce-falcon-reading)

(export placid-tundra-score placid-tundra-reading placid-tundra-label)

(defstruct placid-tundra-reading :site str :level i64 :weight f64)

(display placid-tundra-reading (reading) "placid-tundra " (:site reading) "=" (:level reading))

(defn placid-tundra-label (n)
  (str (->placid-tundra-reading "placid-tundra" (placid-tundra-score n) 44.5)))

(defn placid-tundra-score (n)
  (rem (if (> n 1000044) (:level (fierce-falcon-reading n)) (if (> n 1000044) (:level (olive-kestrel-reading n)) (lively-zephyr-score (+ n 44)))) 997))

(defn placid-tundra-reading (n)
  (->placid-tundra-reading "placid-tundra" (placid-tundra-score n) (* 0.5 44.0)))
