(use many_modules/layer_6_module_10 layer-6-module-10-score layer-6-module-10-reading)
(use many_modules/layer_1_module_7 layer-1-module-7-score layer-1-module-7-reading)
(use many_modules/layer_1_module_3 layer-1-module-3-score layer-1-module-3-reading)

(export layer-7-module-10-score layer-7-module-10-reading layer-7-module-10-label)

(defstruct layer-7-module-10-reading :site str :level i64 :weight f64)

(display layer-7-module-10-reading (reading) "layer-7-module-10 " (:site reading) "=" (:level reading))

(defn layer-7-module-10-label (n)
  (str (->layer-7-module-10-reading "layer-7-module-10" (layer-7-module-10-score n) 70.5)))

(defn layer-7-module-10-score (n)
  (rem (+ (layer-6-module-10-score (+ n 1)) (:level (layer-1-module-7-reading n)) (:level (layer-1-module-3-reading n))) 997))

(defn layer-7-module-10-reading (n)
  (->layer-7-module-10-reading "layer-7-module-10" (layer-7-module-10-score n) (* 0.5 70.0)))
