(use many_modules/layer_2_module_7 layer-2-module-7-score layer-2-module-7-reading)
(use many_modules/layer_2_module_6 layer-2-module-6-score layer-2-module-6-reading)
(use many_modules/layer_5_module_8 layer-5-module-8-score layer-5-module-8-reading)

(export layer-7-module-10-score layer-7-module-10-reading layer-7-module-10-label)

(defstruct layer-7-module-10-reading :site str :level i64 :weight f64)

(display layer-7-module-10-reading (reading) "layer-7-module-10 " (:site reading) "=" (:level reading))

(defn layer-7-module-10-label (n)
  (str (->layer-7-module-10-reading "layer-7-module-10" (layer-7-module-10-score n) 69.5)))

(defn layer-7-module-10-score (n)
  (rem (if (> n 1000069) (:level (layer-5-module-8-reading n)) (if (> n 1000069) (:level (layer-2-module-6-reading n)) (layer-2-module-7-score (+ n 69)))) 997))

(defn layer-7-module-10-reading (n)
  (->layer-7-module-10-reading "layer-7-module-10" (layer-7-module-10-score n) (* 0.5 69.0)))
