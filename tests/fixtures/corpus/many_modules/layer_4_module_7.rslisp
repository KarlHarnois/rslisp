(use many_modules/layer_3_module_5 layer-3-module-5-score layer-3-module-5-reading)
(use many_modules/layer_3_module_2 layer-3-module-2-score layer-3-module-2-reading)
(use many_modules/layer_1_module_9 layer-1-module-9-score layer-1-module-9-reading)

(export layer-4-module-7-score layer-4-module-7-reading layer-4-module-7-label)

(defstruct layer-4-module-7-reading :site str :level i64 :weight f64)

(display layer-4-module-7-reading (reading) "layer-4-module-7 " (:site reading) "=" (:level reading))

(defn layer-4-module-7-label (n)
  (str (->layer-4-module-7-reading "layer-4-module-7" (layer-4-module-7-score n) 36.5)))

(defn layer-4-module-7-score (n)
  (rem (if (> n 1000036) (:level (layer-1-module-9-reading n)) (if (> n 1000036) (:level (layer-3-module-2-reading n)) (layer-3-module-5-score (+ n 36)))) 997))

(defn layer-4-module-7-reading (n)
  (->layer-4-module-7-reading "layer-4-module-7" (layer-4-module-7-score n) (* 0.5 36.0)))
