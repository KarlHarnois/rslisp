(use many_modules/layer_3_module_7 layer-3-module-7-score layer-3-module-7-reading)
(use many_modules/layer_3_module_5 layer-3-module-5-score layer-3-module-5-reading)
(use many_modules/layer_1_module_4 layer-1-module-4-score layer-1-module-4-reading)

(export layer-4-module-7-score layer-4-module-7-reading layer-4-module-7-label)

(defstruct layer-4-module-7-reading :site str :level i64 :weight f64)

(display layer-4-module-7-reading (reading) "layer-4-module-7 " (:site reading) "=" (:level reading))

(defn layer-4-module-7-label (n)
  (str (->layer-4-module-7-reading "layer-4-module-7" (layer-4-module-7-score n) 37.5)))

(defn layer-4-module-7-score (n)
  (rem (+ (layer-3-module-7-score (+ n 3)) (:level (layer-3-module-5-reading n)) (:level (layer-1-module-4-reading n))) 997))

(defn layer-4-module-7-reading (n)
  (->layer-4-module-7-reading "layer-4-module-7" (layer-4-module-7-score n) (* 0.5 37.0)))
