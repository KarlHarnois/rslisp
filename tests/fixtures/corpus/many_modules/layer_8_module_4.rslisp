(use many_modules/layer_7_module_4 layer-7-module-4-score layer-7-module-4-reading)
(use many_modules/layer_4_module_8 layer-4-module-8-score layer-4-module-8-reading)
(use many_modules/layer_5_module_10 layer-5-module-10-score layer-5-module-10-reading)

(export layer-8-module-4-score layer-8-module-4-reading layer-8-module-4-label)

(defstruct layer-8-module-4-reading :site str :level i64 :weight f64)

(display layer-8-module-4-reading (reading) "layer-8-module-4 " (:site reading) "=" (:level reading))

(defn layer-8-module-4-label (n)
  (str (->layer-8-module-4-reading "layer-8-module-4" (layer-8-module-4-score n) 74.5)))

(defn layer-8-module-4-score (n)
  (rem (+ (layer-7-module-4-score (+ n 5)) (:level (layer-4-module-8-reading n)) (:level (layer-5-module-10-reading n))) 997))

(defn layer-8-module-4-reading (n)
  (->layer-8-module-4-reading "layer-8-module-4" (layer-8-module-4-score n) (* 0.5 74.0)))
