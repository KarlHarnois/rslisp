(use many_modules/layer_3_module_10 layer-3-module-10-score layer-3-module-10-reading)
(use many_modules/layer_7_module_2 layer-7-module-2-score layer-7-module-2-reading)
(use many_modules/layer_1_module_10 layer-1-module-10-score layer-1-module-10-reading)

(export layer-8-module-4-score layer-8-module-4-reading layer-8-module-4-label)

(defstruct layer-8-module-4-reading :site str :level i64 :weight f64)

(display layer-8-module-4-reading (reading) "layer-8-module-4 " (:site reading) "=" (:level reading))

(defn layer-8-module-4-label (n)
  (str (->layer-8-module-4-reading "layer-8-module-4" (layer-8-module-4-score n) 73.5)))

(defn layer-8-module-4-score (n)
  (rem (if (> n 1000073) (:level (layer-1-module-10-reading n)) (if (> n 1000073) (:level (layer-7-module-2-reading n)) (layer-3-module-10-score (+ n 73)))) 997))

(defn layer-8-module-4-reading (n)
  (->layer-8-module-4-reading "layer-8-module-4" (layer-8-module-4-score n) (* 0.5 73.0)))
