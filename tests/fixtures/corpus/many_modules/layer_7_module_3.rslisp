(use many_modules/layer_6_module_3 layer-6-module-3-score layer-6-module-3-reading)
(use many_modules/layer_4_module_10 layer-4-module-10-score layer-4-module-10-reading)
(use many_modules/layer_2_module_6 layer-2-module-6-score layer-2-module-6-reading)

(export layer-7-module-3-score layer-7-module-3-reading layer-7-module-3-label)

(defstruct layer-7-module-3-reading :site str :level i64 :weight f64)

(display layer-7-module-3-reading (reading) "layer-7-module-3 " (:site reading) "=" (:level reading))

(defn layer-7-module-3-label (n)
  (str (->layer-7-module-3-reading "layer-7-module-3" (layer-7-module-3-score n) 62.5)))

(defn layer-7-module-3-score (n)
  (rem (if (> n 1000062) (:level (layer-2-module-6-reading n)) (if (> n 1000062) (:level (layer-4-module-10-reading n)) (layer-6-module-3-score (+ n 62)))) 997))

(defn layer-7-module-3-reading (n)
  (->layer-7-module-3-reading "layer-7-module-3" (layer-7-module-3-score n) (* 0.5 62.0)))
