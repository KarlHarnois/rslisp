(use many_modules/layer_6_module_3 layer-6-module-3-score layer-6-module-3-reading)
(use many_modules/layer_2_module_8 layer-2-module-8-score layer-2-module-8-reading)
(use many_modules/layer_6_module_7 layer-6-module-7-score layer-6-module-7-reading)

(export layer-7-module-3-score layer-7-module-3-reading layer-7-module-3-label)

(defstruct layer-7-module-3-reading :site str :level i64 :weight f64)

(display layer-7-module-3-reading (reading) "layer-7-module-3 " (:site reading) "=" (:level reading))

(defn layer-7-module-3-label (n)
  (str (->layer-7-module-3-reading "layer-7-module-3" (layer-7-module-3-score n) 63.5)))

(defn layer-7-module-3-score (n)
  (rem (+ (layer-6-module-3-score (+ n 4)) (:level (layer-2-module-8-reading n)) (:level (layer-6-module-7-reading n))) 997))

(defn layer-7-module-3-reading (n)
  (->layer-7-module-3-reading "layer-7-module-3" (layer-7-module-3-score n) (* 0.5 63.0)))
