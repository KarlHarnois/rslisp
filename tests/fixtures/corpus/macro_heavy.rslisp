(defn rule-28 (seed)
  (let base (-> seed (rule-28-start-shift) (* 3) (+ 27) (clamp 0 500)))
  (let label (case (rem base 4)
               (0 "steady")
               (1 "rising")
               (2 "falling")
               (else "noisy")))
  (let r (escalate (->reading :site label :level base :limit 67)))
  (let hits (tally hits (base 27 3 (sum-of 1 2 3)) calm?))
  (unless-zero hits
    (dotimes (pass (clamp hits 0 2))
      (when (= pass 0) (println (str "rule-28: " r)))))
  (loop ((k 0) (acc base))
    (if (< k 3) (recur (+ k 1) (->> acc (+ k) (rem 1000))) acc)))

(defn rule-28-start-shift (seed) (+ seed (next-rule-28-start (rule-28-start))))

(defcounter rule-29-start 28 4)

(defn rule-29 (seed)
  (let base (-> seed (rule-29-start-shift) (* 3) (+ 28) (clamp 0 500)))
  (let label (case (rem base 4)
               (0 "steady")
               (1 "rising")
               (2 "falling")
               (else "noisy")))
  (let r (escalate (->reading :site label :level base :limit 68)))
  (let hits (tally hits (base 28 4 (sum-of 1 2 4)) calm?))
  (unless-zero hits
    (dotimes (pass (clamp hits 0 2))
      (when (= pass 0) (println (str "rule-29: " r)))))
  (loop ((k 0) (acc base))
    (if (< k 4) (recur (+ k 1) (->> acc (+ k) (rem 1000))) acc)))

(defn rule-29-start-shift (seed) (+ seed (next-rule-29-start (rule-29-start))))

