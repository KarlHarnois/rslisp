(defcounter dusky-geyser-start 26 2)

(defn dusky-geyser (seed)
  (let base (-> seed (dusky-geyser-start-shift) (* 3) (+ 26) (clamp 0 500)))
  (let label (case (rem base 4)
               (0 "steady")
               (1 "rising")
               (2 "falling")
               (else "noisy")))
  (let r (escalate (->reading :site label :level base :limit 66)))
  (let hits (tally hits (base 26 2 (sum-of 1 2 2)) calm?))
  (unless-zero hits
    (dotimes (pass (clamp hits 0 2))
      (when (= pass 0) (println (str "dusky-geyser: " r)))))
  (loop ((k 0) (acc base))
    (if (< k 2) (recur (+ k 1) (->> acc (+ k) (rem 1000))) acc)))

(defn dusky-geyser-start-shift (seed) (+ seed (next-dusky-geyser-start (dusky-geyser-start))))

