(use code symbol symbol-name length number-add empty? first rest list concat)

(defrule dotimes
  (((index count) body ...) (for-each (range 0 count) (fn (index) body ...))))

(defrule case
  ((value clause ...) (do (let subject value) (case-clauses subject clause ...))))

(defrule case-clauses
  ((subject ((quote else) body ...)) (do body ...))
  ((subject (match body ...) clause more ...)
   (if (= subject match) (do body ...) (case-clauses subject clause more ...))))

(defrule clamp
  ((value low high) (cond ((< value low) low) ((> value high) high) (else value))))

(defrule unless-zero
  ((value body ...) (unless (= value 0) body ...)))

(defrule sum-of
  ((value) value)
  ((value more ...) (+ value (sum-of more ...))))

(defrule tally
  ((counter (item ...) test)
   (fold (iter (vec item ...)) 0 (fn (counter element) (if (test (deref element)) (+ counter 1) counter)))))

(defmacro defcounter (name start step)
  (let next-name (symbol name "next-" (symbol-name name)))
  (template
    (do (defn (unquote name) () (unquote start))
        (defn (unquote next-name) (value) (+ value (unquote step))))))

(defmacro defchecks (name checks ...)
  (template
    (defn (unquote name) (value)
      (and (splice (map-check checks))))))

(def map-check
  (fn (checks)
    (if (empty? checks)
        (list)
        (concat (list (template ((unquote (first checks)) value)))
                (map-check (rest checks))))))

(defstruct reading :site str :level i64 :limit i64 :alarms u32 (defaults :alarms 0 :limit 100))

(display reading (r) (:site r) " level " (:level r) "/" (:limit r) " alarms " (:alarms r))

(defn positive? (n) (> n 0))
(defn even? (n) (= (rem n 2) 0))
(defn small? (n) (< n 50))

(defchecks calm? positive? even? small?)

(defn escalate (r)
  (let limit (:limit r))
  (let alarms (+ (:alarms r) 1))
  (if (> (:level r) limit)
      (assoc r :alarms alarms :level limit)
      r))

(type parse-level (fn ((ref str)) (result i64 string)))
(defn parse-level (text)
  (map-err (parse text) (fn (problem) (str "bad level " text ": " problem))))

(type sum-levels (fn ((ref str) (ref str)) (result i64 string)))
(defn sum-levels (left right)
  (let-try ((first-level (parse-level left))
            (second-level (parse-level right)))
    (ok (+ first-level second-level))))

(defn checked-sum (left right)
  (match (sum-levels left right)
    ((ok total) (str total))
    ((err problem) problem)))

(defcounter bold-lantern-start 0 1)

(defn bold-lantern (seed)
  (let base (-> seed (bold-lantern-start-shift) (* 3) (+ 0) (clamp 0 500)))
  (let label (case (rem base 4)
               (0 "steady")
               (1 "rising")
               (2 "falling")
               (else "noisy")))
  (let r (escalate (->reading :site label :level base :limit 40)))
  (let hits (tally hits (base 0 1 (sum-of 1 2 1)) calm?))
  (unless-zero hits
    (dotimes (pass (clamp hits 0 2))
      (when (= pass 0) (println (str "bold-lantern: " r)))))
  (loop ((k 0) (acc base))
    (if (< k 1) (recur (+ k 1) (->> acc (+ k) (rem 1000))) acc)))

(defn bold-lantern-start-shift (seed) (+ seed (next-bold-lantern-start (bold-lantern-start))))

