(use prelude/macros header-shape)
(defrule unless-zero ((value body ...) (unless (= value 0) body ...)))
(header-shape (unless-zero value))
(defrule repeat-twice ((body ...) (do body ... body ...)))
(defn report (hits)
  (unless-zero hits (println (str "hits: " hits)) (println "done reporting the hits")))
(defn twice-report (hits) (repeat-twice (println (str "hits: " hits)) (println "twice")))
