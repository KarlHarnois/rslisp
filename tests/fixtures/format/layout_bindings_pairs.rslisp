(use prelude/macros header-shape)

(defrule bind ((bindings body ...) (do body ...)))

(header-shape (bind bindings) :bindings)

(defn one () (bind (x 5) (+ x 1)))

(defn two () (bind (x 5 y 7) (+ y x)))

(defn three-on-one-line () (bind (x 5 y 7 z 9) z))

(defn empty () (bind () 1))

(defn header-list-without-the-marker (a b c d) (+ a b c d))
