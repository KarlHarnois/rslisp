(rust-type (parse-error-for target) "<{0} as std::str::FromStr>::Err")

(def parse-int
  (rust "{0}.parse::<{target}>()" (where ((target from-str))
                                          (fn ((ref str)) (result target (parse-error-for target))))))

(defn main ()
  (let (value (result i64 (parse-error-for i64))) (parse-int "2"))
  (println (unwrap-ok value)))
