(rust-type mark "std::cell::Cell<i64>")
(struct person (name string) (age u32))
(struct handler (callback (fn (person) bool)) (tag mark))
(defn adult? (p) (>= (field p age) 18))
(defn keep (value) value)
(defn main ()
  (let handler (new handler (callback adult?) (tag (rust "std::cell::Cell::new(0)" mark))))
  (keep (field handler callback))
  (keep (field handler tag))
  (do))
