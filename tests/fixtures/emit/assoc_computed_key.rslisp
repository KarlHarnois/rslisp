(defstruct user
  :name str
  :admin? bool)

(defn initial (name)
  (local letter (subs name 0 1))
  (upper-case letter))

(defn main ()
  (local counts (sorted-map (str "A") 0))
  (local counted (assoc counts (initial "ana") 1))
  (println (unwrap (get counted "A")))
  (local user (->user :name "ana" :admin? false))
  (local renamed (assoc user :name "karl"))
  (println (:name renamed) " " (:admin? renamed)))
