(def bump! (rust "*{0} += 1" (fn ((mut i64)) unit)))
(defstruct counter :count i64)

(defn in-range? (a) (and (> a 1) (< a 5)))
(defn small? (a) (or (= a 1) (= a 2) (= a 3)))
(defn twice-next (x) (do (let y (+ x 1)) (* y 2)))
(defn sum-to (limit) (loop ((i 0) (total 0)) (if (> i limit) total (recur (+ i 1) (+ total i)))))
(defn total (a b c) (+ a b c))
(defn counter->text (c) (to-string (counter-count c)))

(defn main ()
  (let c (->counter 0))
  (bump! (field c count))
  (println (in-range? 3))
  (println (small? 2))
  (println (twice-next 3))
  (println (sum-to 10))
  (println (total 1 2 3))
  (println (counter->text c)))
