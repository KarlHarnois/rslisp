(def assign!
  (rust "{0}.clone_from({1})"
    (where ((a clone))
      (fn ((mut a) (ref a)) unit))))

(defn copy-into! (target source) (assign! target source))

(defn main ()
  (local first (str "Ana"))
  (local second (str "Bo"))
  (copy-into! first second)
  (println first)
  (local left (vec 1 2))
  (local right (vec 3 4))
  (copy-into! left right)
  (println (len left)))
