(type read-source
  (where ((s source))
    (fn ((ref s)) (result string io-error))))

(defn read-source (source) (slurp source))

(defn report (read)
  (match read
    ((ok text) (println (len text)))
    ((err error) (eprintln error))))

(defn main ()
  (local path (str "garage.txt"))
  (report (slurp "cars.txt"))
  (report (slurp path))
  (report (slurp stdin))
  (report (read-source "cars.txt"))
  (report (read-source stdin)))
