(defstruct car :make str :model str :year u16 :electric? bool)
(defstruct user :name str :tags (vec string))

(defn main ()
  (let leaf (->car "Nissan" "Leaf" 2024 true))
  (let civic (->car "Honda" "Civic" 2019 false))
  (let cars (vec leaf civic))
  (println (:year leaf))
  (prn (collect (map (iter cars) :year)))
  (let users (vec (->user "ana" (vec (to-string "admin"))) (->user "bo" (vec))))
  (prn (collect (map users :name)))
  (let someone (->user "cy" (vec (to-string "ops") (to-string "dev"))))
  (println (len (:tags someone)))
  (println (:name someone)))
