(defn count-years (years)
  (count (iter years)))

(defn main ()
  (local years (vec 2011 2019 2024))
  (println (count (iter years)))
  (println (count-years years))
  (local prices (hash-map "leaf" 28000 "ariya" 39000))
  (println (count (iter prices)))
  (println (count (filter (iter years)
                          (fn (year) (> year 2015))))))
