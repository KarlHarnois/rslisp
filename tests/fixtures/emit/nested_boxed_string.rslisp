(enum (expr)
  (call (expr) string)
  (name string))

(defn call-label (expr)
  (match expr
    ((expr/call (expr/name "x") label) label)
    ((expr/call inner label) label)
    ((expr/name label) label)))

(defn main ()
  (println (call-label (expr/call (expr/name (str "x"))
                                  (str "hit"))))
  (println (call-label (expr/call (expr/name (str "y"))
                                  (str "miss"))))
  (println (call-label (expr/name (str "name")))))
