(defstruct badge
  :text string
  :size u16)

(defstruct garage
  :name string
  :badge badge)

(defn main ()
  (local g
    (->garage (str "Leaf Garage")
              (->badge (str "open") 12)))
  (local bigger
    (assoc-in g
              (:badge :size)
              (+ 1 (:size (:badge g)))))
  (println (:name bigger)
           " "
           (:text (:badge bigger))
           " "
           (:size (:badge bigger))))
