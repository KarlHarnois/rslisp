(defstruct badge :text string :size u16)

(defstruct garage :name string :badge badge)

(defn main ()
  (let g (->garage (to-string "Leaf Garage") (->badge (to-string "open") 12)))
  (let bigger (assoc-in g (:badge :size) (+ 1 (:size (:badge g)))))
  (println (:name bigger) " " (:text (:badge bigger)) " " (:size (:badge bigger))))
