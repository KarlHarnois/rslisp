(type later?
  (where ((a partial-ord))
    (fn (a a) bool)))

(defn later? (left right) (> left right))

(type leaf-count
  (fn ((ref (slice (ref str)))) usize))

(defn leaf-count (models)
  (count (filter (iter models)
                 (fn (m) (= m "Leaf")))))

(type deref-leaf-count
  (fn ((ref (slice (ref str)))) usize))

(defn deref-leaf-count (models)
  (count (filter (iter models)
                 (fn (m) (= (deref m) "Leaf")))))

(defn count-of (names wanted)
  (count (filter (iter names)
                 (fn (n) (= n wanted)))))

(defn report-years (years)
  (local next (fn (y) (+ (deref y) 1)))
  (println (sum (map (iter years) next)))
  (local recent?
    (fn (y) (> (deref y) 2020)))
  (println (any? (iter years) recent?))
  (local typed-recent?
    (fn ((y (ref (ref i64))))
      (> (deref y) 2020)))
  (println (count (filter (iter years) typed-recent?))))

(defn main ()
  (local years (vec 2019 2021 2024))
  (report-years years)
  (println (count-of years 2021))
  (local x 5)
  (local y 3)
  (local r (ref x))
  (println (> r 3))
  (println (> 3 r))
  (println (later? (ref x) (ref y)))
  (local models (vec "Leaf" "Ariya"))
  (println (leaf-count models))
  (println (deref-leaf-count models))
  (local names
    (vec (str "Leaf") (str "Ariya")))
  (local wanted (str "Leaf"))
  (println (count-of names wanted))
  (println wanted))
