(defstruct point :x i64 :y i64)
(defstruct cube :x i64 :y i64 :z i64)
(defstruct (pair a) :left a :right a)

(defn shift (p) (->point (+ (point-x p) 1) (point-y p)))
(defn volume (c) (* (cube-x c) (* (cube-y c) (cube-z c))))
(defn same-shape? (a b) (= a b))

(defn main ()
  (let p (->point 1 2))
  (println (point-x (shift p)))
  (println (point-x (shift p)))
  (println (volume (->cube 2 3 4)))
  (let numbers (->pair 1 2))
  (let words (->pair (to-string "a") (to-string "b")))
  (println (pair-left numbers))
  (println (pair-right words))
  (let kept (vec p))
  (push! kept p)
  (println (len kept))
  (println (point-y p))
  (println (same-shape? p (->point 1 2)))
  (println (same-shape? (->cube 1 2 3) (->cube 3 2 1))))
