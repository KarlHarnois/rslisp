(defstruct point (x f64) (y f64))

(defn distance-squared (a b)
  (let dx (- (point-x a) (point-x b)))
  (let dy (- (point-y a) (point-y b)))
  (+ (* dx dx) (* dy dy)))

(defn main ()
  (println (+ 1 2 3 4))
  (println (* 2 3 4))
  (println (- 10))
  (println (rem 17 5))
  (println (< 1 2 3))
  (println (< 3 2 1))
  (println (distance-squared (make-point 0 0) (make-point 3 4))))
