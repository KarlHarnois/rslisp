(defstruct person
  :name string
  :age i64)

(defn introduce (someone)
  (str (:name someone) " is " (:age someone)))

(defn rename (someone new-name)
  (->person new-name (:age someone)))

(defn main ()
  (local ada (->person (str "Ada") 36))
  (println (:name ada))
  (println (:name ada))
  (println (introduce ada))
  (local copy (clone (:name ada)))
  (local renamed (rename ada copy))
  (println (introduce renamed)))
