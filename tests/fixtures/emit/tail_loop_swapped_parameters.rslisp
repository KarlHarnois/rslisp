(defn fill! (spare years label count)
  (if (= count 0)
    (println label)
    (do
      (push! spare count)
      (recur years spare label (- count 1)))))

(defn alternate (make model turns)
  (if (= turns 0)
    make
    (alternate model make (- turns 1))))

(defn settle (make model turns)
  (if (= turns 0)
    (len make)
    (settle model model (- turns 1))))

(defn swap-years (low high turns)
  (if (= turns 0)
    low
    (recur high low (- turns 1))))

(defn main ()
  (local spare (vec 2019))
  (local years (vec 2021))
  (fill! (mut spare) (mut years) "filled" 3)
  (println (len spare) " " (len years))
  (local model (str "Leaf"))
  (println (alternate "Nissan" (as-str model) 3))
  (println (settle "Nissan" (as-str model) 2))
  (println (swap-years 2019 2024 3)))
