(defn main ()
  (for-each (enumerate (lines "alpha\nbeta"))
            (fn (entry)
              (let-pair (index line) entry
                (println (str index ": " line)))))
  (local left (collect (lines "a\nb")))
  (local right (collect (range 1 3)))
  (for-each (zip (copied left) (copied right))
            (fn (entry)
              (let-pair (text number) entry
                (println (str text number)))))
  (local pairs
    (vec (pair 2 "b") (pair 1 "a")))
  (sort! pairs)
  (for-each (copied pairs)
            (fn (entry)
              (let-pair (number text) entry
                (println (str number " " text))))))
