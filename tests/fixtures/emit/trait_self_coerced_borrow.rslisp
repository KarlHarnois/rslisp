(defstruct circle
  :radius i64)

(trait shape
  (type part)
  (area (fn ((ref self)) i64))
  (same-area (fn ((ref self) (ref self)) bool))
  (holds (fn ((ref self) (ref part)) bool))
  (fits (fn (i64 (ref self)) bool))
  (exceeds (fn ((ref i64) (ref self)) bool)))

(impl shape circle
  (type part i64)
  (area (c) (* (:radius c) (:radius c)))
  (same-area (left right)
             (= (area left) (area right)))
  (holds (c value) (= value (:radius c)))
  (fits (limit c) (> limit (area c)))
  (exceeds (limit c)
           (> (deref limit) (:radius c))))

(def radius-of
  (rust "{0}.radius"
    (fn ((ref circle)) i64)))

(defn main ()
  (local c (->circle 2))
  (local inner (ref c))
  (local outer (ref inner))
  (local radius 2)
  (local radius-view (ref radius))
  (local radius-outer (ref radius-view))
  (println (area outer))
  (println (same-area inner outer))
  (println (holds inner radius-outer))
  (println (fits 9 inner))
  (println (exceeds radius-outer inner))
  (println (radius-of outer)))
