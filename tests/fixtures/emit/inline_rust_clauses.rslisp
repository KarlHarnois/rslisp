(defn main ()
  (println ((rust "{0}.len()"
              (where ((s sequence))
                (fn ((ref s)) usize))
              (str "{0}.len()"))
            "Leaf"))
  (local measure
    (rust "{0}.len()"
      (where ((s sequence))
        (fn ((ref s)) usize))
      (str "{0}.len()")))
  (println (measure "Ariya")))
