(defn main ()
  (local (value (option i64)) (some 1))
  (local (nothing (option i64)) none)
  (local (answer (result i64 string))
    (ok 1))
  (local (bad (result i64 string))
    (err (str "bad")))
  (println (none? nothing))
  (match value
    ((some n) (println n))
    (none (println "none")))
  (match answer
    ((ok n) (println n))
    ((err e) (println e)))
  (println (err? bad)))
