(defstruct user :name str :age u16)
(defstruct sorter :key (fn ((ref user)) (ref str)) :label str)

(defn name-of ((someone (ref user))) (:name someone))

(type apply-key (fn ((fn ((ref user)) (ref str)) (ref user)) (ref str)))
(defn apply-key (key someone) (key someone))

(defn main ()
  (let by-name (->sorter :name "by name"))
  (let by-name-again (->sorter name-of "by name again"))
  (let ana (->user :name "ana" :age 34))
  (println (:label by-name) (:label by-name-again) (apply-key (:key by-name) ana)))
