(defn main ()
  (let empty (the (hash-map string i64) (hash-map)))
  (let built (hash-map "b" 2 "a" 1))
  (let added (assoc built "c" 3))
  (let changed (assoc added "a" 10))
  (set! (at changed "b") 20)
  (let pairs (vec (pair "x" 1) (pair "y" 2)))
  (let collected (into-hash-map pairs))
  (let next (update changed "a" (fn (n) (+ n 1)) 0))
  (println (len next) " " (empty? empty))
  (println (unwrap (lookup next "a")))
  (for-each (keys next) (fn (key) (println key)))
  (for-each (vals next) (fn (value) (println value)))
  (for-each (entries next)
            (fn (entry)
              (let-pair (key value) entry
                (println key " " value))))
  (println (len collected)))
