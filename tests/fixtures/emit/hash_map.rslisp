(defn main ()
  (local empty
    (the (hash-map string i64) (hash-map)))
  (local built (hash-map "b" 2 "a" 1))
  (local added (assoc built "c" 3))
  (local changed (assoc added "a" 10))
  (set! (at changed "b") 20)
  (local pairs
    (vec (pair "x" 1) (pair "y" 2)))
  (local collected (into-hash-map pairs))
  (local next
    (update changed "a" (fn (n) (+ n 1)) 0))
  (println (len next) " " (empty? empty))
  (println (unwrap (get next "a")))
  (for-each (keys next)
            (fn (key) (println key)))
  (for-each (vals next)
            (fn (value) (println value)))
  (for-each (iter next)
            (fn (entry)
              (let-pair (key value) entry (println key " " value))))
  (println (len collected)))
