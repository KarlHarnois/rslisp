(defn bigger (a b) (if (> a b) a b))

(defn same (a b) (if (= a b) a b))

(defn main ()
  (println (bigger 3 7))
  (println (bigger (str "pear") (str "apple")))
  (println (same 4 4))
  (local name (str "Ana"))
  (local other (str "Bo"))
  (println (= name other))
  (println name)
  (println other))
