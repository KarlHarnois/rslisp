(use code nth)

(def with-total
  (macro (form)
    (template (do (let total 100) (+ total (unquote (nth form 1)))))))

(defn main ()
  (let total 1)
  (let doubled (* total 2))
  (let total (+ total doubled))
  (let add-total (fn (amount) (+ amount total)))
  (let inner
    (do
      (let doubled 10)
      (let total (+ total doubled))
      total))
  (println (with-total total))
  (println (add-total inner))
  (println doubled))
