(use code nth)

(def with-total
  (macro (form)
    (template (do
                (local total 100)
                (+ total (unquote (nth form 1)))))))

(defn main ()
  (local total 1)
  (local doubled (* total 2))
  (local total (+ total doubled))
  (local add-total
    (fn (amount) (+ amount total)))
  (local inner
    (do
      (local doubled 10)
      (local total (+ total doubled))
      total))
  (println (with-total total))
  (println (add-total inner))
  (println doubled))
