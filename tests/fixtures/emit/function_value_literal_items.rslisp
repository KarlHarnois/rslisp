(defn small-byte? (b) (< b 10))

(defn small-reading? (r) (< r 10))

(defn small-offset? (o) (< o 10))

(defn small-ratio? (x) (< x 10.0))

(defn bytes ()
  (the (vec u8) (vec 3 7 12 4)))

(defn readings ()
  (the (vec u16) (vec 1 2 3 40 5)))

(defn offsets ()
  (the (vec i32) (vec -2 9 10)))

(defn ratios ()
  (the (vec f32) (vec 0.5 9.5 10.5)))

(defn main ()
  (println (count (take-while (iter (bytes)) small-byte?)))
  (println (count (take-while (iter (readings)) small-reading?)))
  (println (count (take-while (iter (offsets)) small-offset?)))
  (println (count (take-while (iter (ratios)) small-ratio?))))
