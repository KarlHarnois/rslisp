(defstruct (pair a b) :first a :second b)

(type swap (where ((a clone) (b clone)) (fn ((ref (pair a b))) (pair b a))))
(defn swap (p) (new pair (first (clone (field p second))) (second (clone (field p first)))))

(defn main ()
  (let counted (->pair 7 (to-string "seven")))
  (println (:first counted))
  (println (:first (swap counted)))
  (let named (->pair "pear" 3))
  (println (field named first))
  (println (:second named)))
