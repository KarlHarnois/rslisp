(trait shape
  (area (fn ((ref self)) f64)))

(struct circle (radius f64))

(impl shape circle
  (area (c) (field c radius)))

(defn main ()
  (local boxed
    (the (box shape)
         (box (new circle (radius 1.0)))))
  (local (other (box shape))
    (box (new circle (radius 2.0))))
  (println (area boxed))
  (println (area other)))
