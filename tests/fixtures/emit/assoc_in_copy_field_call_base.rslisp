(defstruct point
  :x i64
  :y i64)

(defstruct sticker
  :text string
  :at point)

(defn make-badge ()
  (->sticker (str "open") (->point 0 2)))

(defn main ()
  (local moved
    (assoc-in (:at (make-badge)) (:x) 4))
  (println (:text (make-badge))
           " "
           (:x moved)
           " "
           (:y moved)))
