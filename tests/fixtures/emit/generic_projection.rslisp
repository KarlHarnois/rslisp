(type read-value
  (where ((target from-str))
    (fn ((ref str))
      (result target (parse-error target)))))

(defn read-value (text) (parse text))

(defn read-inferred (text) (parse text))

(defn main ()
  (local (count (result i64 _))
    (read-value "4"))
  (println (unwrap-ok count))
  (local (flag (result bool _))
    (read-inferred "true"))
  (println (unwrap-ok flag))
  (local (ratio (result f64 _))
    (read-inferred "0.5"))
  (println (unwrap-ok ratio)))
