(type oldest-first (fn ((ref i64) (ref i64)) i64))
(defn oldest-first (left right) (- right left))

(defn main ()
  (let numbers (vec 3 1 2))
  (println (empty? numbers))
  (sort-descending! numbers)
  (println (unwrap (first numbers)))
  (println (unwrap (last numbers)))
  (reverse! numbers)
  (for-each (reverse numbers) (fn (n) (println n)))
  (sort! numbers oldest-first)
  (sort! numbers (fn (left right) (- right left)))
  (let words (vec (to-string "Alpha") (to-string "beta")))
  (sort! words)
  (println (lower-case "MiXeD") " " (upper-case "MiXeD"))
  (println (alphanumeric? (char "a")) (whitespace? (char " ")) (digit? (char "7")))
  (for-each (split-when "a1 b2" whitespace?) (fn (part) (println part)))
  (let message (to-string "ab"))
  (append! message "cd")
  (append-char! message (char "!"))
  (println message)
  (push! words (to-string "gamma")))
