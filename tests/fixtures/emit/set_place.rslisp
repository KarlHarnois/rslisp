(defstruct cell
  :alive bool
  :label string)

(defn revive! (cell)
  (set! (field cell alive) true))

(defn rename! (cell label)
  (set! (field cell label) label))

(defn main ()
  (local grid (vec))
  (push! grid (vec false false))
  (push! grid (vec false false))
  (set! (at (at grid 1) 0) true)
  (local alive
    (match (get grid 1)
      ((some row) (at row 0))
      (none false)))
  (println alive)
  (local cell (->cell false (str "seed")))
  (revive! cell)
  (rename! cell (str "grown"))
  (println (:alive cell) " " (:label cell))
  (local total 0)
  (local add!
    (fn (n)
      (do
        (set! total (if (> n total) n total)))))
  (add! 1)
  (add! 2)
  (println total))
