(defstruct cell (alive bool) (label string))

(defn revive! (cell)
  (set! (field cell alive) true))

(defn rename! (cell label)
  (set! (field cell label) label))

(defn main ()
  (let grid (vec))
  (push! grid (vec false false))
  (push! grid (vec false false))
  (set! (at (at grid 1) 0) true)
  (let alive (match (get grid 1)
               ((some row) (at row 0))
               (none false)))
  (println alive)
  (let cell (make-cell false (to-string "seed")))
  (revive! cell)
  (rename! cell (to-string "grown"))
  (println (cell-alive cell) " " (cell-label cell))
  (let total 0)
  (let add! (fn (n) (do (set! total (if (> n total) n total)))))
  (add! 1)
  (add! 2)
  (println total))
