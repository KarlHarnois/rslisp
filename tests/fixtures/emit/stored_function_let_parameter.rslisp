(defstruct user
  :name str
  :age u16)

(defstruct sorter
  :key (fn ((ref user)) u16)
  :label str)

(defn age-of ((someone (ref user)))
  (:age someone))

(defn by-key (key label)
  (local a key)
  (local b a)
  (new sorter (:key b) (:label label)))

(defn main ()
  (local ana (->user "Ana" 30))
  (local by-age (by-key age-of "by age"))
  (println (:label by-age))
  (println ((:key by-age) ana)))
