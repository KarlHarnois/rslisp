(defn set-next! (years i year)
  (set! (at years (+ i 1)) year))

(defn fill! (years i n)
  (if (< i n)
      (do (set! (at years i) 2020)
          (fill! years (+ i 1) n))
      (do)))

(defn main ()
  (let years (vec 2011 2015 2019))
  (set-next! (mut years) 0 2016)
  (println (at years 1))
  (fill! (mut years) 1 3)
  (println (at years 0) " " (at years 1) " " (at years 2)))
