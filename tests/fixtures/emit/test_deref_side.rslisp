(use prelude/test assert deftest run-tests)

(defstruct crate-of
  :count i64)

(type count-of
  (fn ((ref crate-of)) (ref i64)))

(defn count-of (crate)
  (ref (:count crate)))

(deftest deref-of-a-local
  (local number 1)
  (local borrowed (ref number))
  (assert (= (deref borrowed) 1)))

(type holds-one (fn ((ref i64)) unit))

(defn holds-one (item)
  (assert (= (deref item) 1)))

(deftest deref-of-a-parameter (holds-one (ref 1)))

(deftest deref-of-a-call
  (local crate (->crate-of :count 1))
  (assert (= (deref (count-of crate)) 1)))

(defn main () (run-tests :marker "<record>"))
