(defstruct car
  :model string
  :year i64)

(defn main ()
  (local year 2024)
  (local floor 2020)
  (local leaf (->car :model (str "Leaf") :year 2024))
  (local civic (->car :model (str "Civic") :year 2019))
  (println (= (ref (:year leaf)) (ref year)))
  (println (= (ref year) (ref (:year leaf))))
  (println (= (ref (:year leaf))
              (ref (:year civic))))
  (println (= (ref year) (ref floor)))
  (println (not= (ref (:year leaf)) (ref year)))
  (println (not= (ref year) (ref (:year leaf))))
  (println (not= (ref (:year leaf))
                 (ref (:year civic))))
  (println (not= (ref year) (ref floor)))
  (println (> (ref (:year leaf)) (ref year)))
  (println (> (ref year) (ref (:year leaf))))
  (println (> (ref (:year leaf))
              (ref (:year civic))))
  (println (> (ref year) (ref floor))))
