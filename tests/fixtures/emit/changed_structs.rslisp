(def add-one! (rust "std::ops::AddAssign::add_assign({0}, 1)" (fn ((mut i64)) unit)))
(def assign! (rust "{0}.clone_from({1})" (where ((a clone)) (fn ((mut a) (ref a)) unit))))

(defstruct counter :count i64)
(defstruct tally :total i64)
(defstruct mark :x i64)
(defstruct spot :x i64)
(defstruct pin :x i64)
(derive pin clone debug)

(defn bump-tally! (t) (add-one! (field t total)))
(type touch! (fn ((mut mark)) unit))
(defn touch! (m) (do))
(defn copy-into! (target source) (assign! target source))

(defn main ()
  (let c (make-counter 1))
  (add-one! (field c count))
  (println (counter-count c))
  (let t (make-tally 5))
  (bump-tally! t)
  (println (tally-total t))
  (let m (make-mark 2))
  (touch! m)
  (println (mark-x m))
  (let s (make-spot 1))
  (let u (make-spot 9))
  (copy-into! s u)
  (println (spot-x s))
  (println (pin-x (make-pin 4))))
