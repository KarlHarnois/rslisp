(defstruct shelf
  :label string
  :items (vec i64))

(defn stock ()
  (->shelf (str "top") (vec 1 2 3)))

(defn main ()
  (local items
    (assoc-in (:items (stock)) (1) 9))
  (println (:label (stock))
           " "
           (at items 0)
           " "
           (at items 1)
           " "
           (at items 2)))
