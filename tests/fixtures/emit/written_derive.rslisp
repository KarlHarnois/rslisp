(defstruct ticket :id u32 :seat u32)
(derive ticket copy ord hash debug)

(defstruct tag :label string)
(derive tag)

(defn main ()
  (let early (make-ticket 1 4))
  (let same early)
  (prn early)
  (prn same)
  (println (< early (make-ticket 2 1)))
  (println (tag-label (make-tag (to-string "vip")))))
