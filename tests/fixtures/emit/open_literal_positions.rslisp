(defn twice (x) (pair x x))
(defn same (x) x)
(defn call-it (f) (f))
(defn shown (x) (prn x) x)
(defn wrap (x) (some x))
(defn peek (x) (prn x))

(struct (holder a) (value a) (spare a))

(defn main ()
  (let several? (> (len (command-line-args)) 5))
  (let odometer (the i64 2024))
  (let (total i64) (same 3000000000))
  (println total)
  (let reading (fn () 3000000000))
  (prn (reading))
  (shown 3000000000)
  (prn (twice (do (shown "block") 3000000000)))
  (prn (twice (if several? 1 3000000000)))
  (prn (twice (match several? (true 1) (false 3000000000))))
  (match (wrap 3000000000) ((some miles) (prn miles)) (none (println "none")))
  (prn (some 3000000000))
  (let (maybe (option i64)) (some 3000000000))
  (prn maybe)
  (prn (field (new holder (value 3000000000) (spare 1)) value))
  (prn (field (assoc (new holder (value 1) (spare 2)) :value 3000000000) value))
  (peek (ref (if several? 1 3000000000)))
  (prn (call-it (fn () 3000000000)))
  (prn (twice ((fn () (shown "call") 3000000000))))
  (prn (pair odometer 3000000000))
  (println (if several? 1 3000000000))
  (prn (twice "Leaf"))
  (println (same "Leaf"))
  (prn (call-it (fn () "Leaf")))
  (prn (wrap "Leaf"))
  (shown "Leaf")
  (peek (ref "Leaf"))
  (do))
