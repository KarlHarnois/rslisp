(type add-one (fn ((ref str)) (result i64 (parse-error i64))))
(type read-number (where ((target from-str)) (fn ((ref str)) (result target (parse-error target)))))

(defn add-one (text)
  (ok (+ (try (parse text)) 1)))

(defn read-number (text)
  (parse text))

(defn main ()
  (println (unwrap-ok (add-one "2")))
  (let (parsed (result i64 _)) (read-number "3"))
  (println (unwrap-ok parsed)))
