(defstruct user
  :name string
  :age u16)

(defstruct sorter
  :key (fn ((ref user)) u16)
  :label str)

(enum order
  (ascending (fn ((ref user)) u16))
  unordered)

(defn age-of ((someone (ref user)))
  (:age someone))

(defn by-key (key label)
  (new sorter (:key key) (:label label)))

(defn rekeyed (chosen key) (assoc chosen :key key))

(defn ascending (key) (order/ascending key))

(defn main ()
  (local by-age (->sorter age-of "by age"))
  (local by-next-age
    (->sorter (fn (someone) (+ (:age someone) 1))
              "by next age"))
  (local by-age-again
    (rekeyed (by-key age-of "by age again") age-of))
  (local oldest-last (ascending age-of))
  (local oldest-first order/unordered)
  (local ana (->user :name (str "ana") :age 34))
  (println (:label by-age)
           (:label by-next-age)
           (:label by-age-again)
           ((:key by-age) ana)
           (match oldest-last
             ((order/ascending key) (key ana))
             (order/unordered 0))
           (match oldest-first
             ((order/ascending key) (key ana))
             (order/unordered 0))))
