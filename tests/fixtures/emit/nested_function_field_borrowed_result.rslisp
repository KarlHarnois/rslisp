(defstruct car
  :make str
  :model str)

(defstruct plant
  :maker (fn () (fn () car)))

(defn build-leaf () (->car :make "Nissan" :model "Leaf"))

(defn main ()
  (local oppama
    (->plant :maker (fn () build-leaf)))
  (local make ((:maker oppama)))
  (local leaf (make))
  (println (:make leaf) " " (:model leaf)))
