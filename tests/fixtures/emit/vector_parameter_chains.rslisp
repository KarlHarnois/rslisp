(defn record-year! (years year)
  (push! years year))

(defn record-twice! (years year)
  (record-year! years year)
  (record-year! years (+ year 1)))

(defn record-decade! (years year)
  (record-twice! years year)
  (set! (at years 0) year))

(defn oldest-year (years)
  (at years 0))

(defn newest-year (years)
  (at years (- (len years) 1)))

(defn year-span (years)
  (- (newest-year years) (oldest-year years)))

(defn added-years (years index)
  (if (< index (len years))
      (+ (at years index) (subtracted-years years (+ index 1)))
      0))

(defn subtracted-years (years index)
  (if (< index (len years))
      (- (added-years years (+ index 1)) (at years index))
      0))

(defn pad-years! (years year remaining)
  (push! years year)
  (fill-years! years (+ year 1) (- remaining 1)))

(defn fill-years! (years year remaining)
  (when (> remaining 0)
    (pad-years! years year remaining)))

(defn year-capacity (years)
  ((rust "{0}.capacity()" (where (a) (fn ((ref (vec a))) usize))) years))

(defn year-count (years)
  (len years))

(defn counted-years (years)
  (year-count years))

(defn main ()
  (let leaf-years (vec 2011 2017))
  (record-decade! (mut leaf-years) 2019)
  (println (len leaf-years) " " (year-span leaf-years))
  (println (added-years leaf-years 0))
  (fill-years! (mut leaf-years) 2024 2)
  (println (len leaf-years) " " (oldest-year leaf-years))
  (println (<= (len leaf-years) (year-capacity leaf-years)) " " (counted-years leaf-years))
  (let count-years year-count)
  (println (count-years (ref leaf-years))))
