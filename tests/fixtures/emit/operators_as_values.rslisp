(defn pick (compare a b) (compare a b))

(defn main ()
  (local v (vec 1 2 3))
  (println (reduce (iter v) 0 +))
  (println (reduce (copied v) 1 *))
  (println (sum (map (copied v) neg)))
  (println (pick - 5 2))
  (println (pick / 6 2))
  (println (pick < 1 2))
  (println (pick <= 1 2))
  (println (pick > 1 2))
  (println (pick >= 1 2))
  (println (pick = 1 2))
  (println (pick not= "a" "b"))
  (println (+ 1 2 3))
  (println (< 1 2 3))
  (println (- 5)))
