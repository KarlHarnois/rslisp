(defn recent (years floor)
  (count (filter (iter years)
                 (fn (y) (> (deref y) floor)))))

(defn after? (years floor)
  (any? (iter years) (fn (y) (> y floor))))

(defn typed-recent ((years (ref (slice i64))) floor)
  (count (filter (iter years)
                 (fn (y) (> (deref y) floor)))))

(defn written-recent (years (floor (ref i64)))
  (count (filter (iter years)
                 (fn (y) (> y floor)))))

(defn named (names wanted)
  (count (filter (iter names)
                 (fn (n) (= n wanted)))))

(defn main ()
  (local years (vec 2019 2021 2024))
  (println (recent years 2020))
  (println (after? years 2020))
  (println (typed-recent years 2020))
  (println (written-recent years (ref 2020)))
  (local names
    (vec (str "Leaf") (str "Ariya")))
  (local wanted (str "Leaf"))
  (println (named names wanted))
  (println wanted))
