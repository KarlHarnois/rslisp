(defstruct car
  :make str
  :model str)

(defstruct spare
  :maker (option (fn () car)))

(enum line (stations (vec (fn () i64))))

(defn build-leaf () (->car :make "Nissan" :model "Leaf"))

(defn count-doors () 4)

(defn main ()
  (println (none? (:maker (->spare :maker none))))
  (match (line/stations (vec))
    ((stations steps) (println (len steps))))
  (local backup (->spare :maker (some build-leaf)))
  (match backup
    ((spare (some maker))
     (println (:make (maker))
              " "
              (:model (maker))))
    ((spare none) (println "no spare")))
  (match (line/stations (vec count-doors))
    ((stations steps) (println (len steps)))))
