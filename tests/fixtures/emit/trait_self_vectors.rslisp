(defstruct car
  :year i64)

(trait fleet
  (newest (fn ((ref self) (vec self)) i64))
  (pair (fn (self) (vec self))))

(impl fleet car
  (newest (c others)
          (+ (:year c) (:year (at others 0))))
  (pair (c) (vec c c)))

(defn main ()
  (local leaf (->car 2024))
  (local others (pair (->car 2019)))
  (println (newest leaf others)))
