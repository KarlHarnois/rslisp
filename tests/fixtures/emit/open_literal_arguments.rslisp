(defn twice (x) (pair x x))
(defn both (a b) (pair a b))
(defn larger (a b) (if (> a b) a b))
(defn square (x) (* x x))
(defn apply-to (start f) (f start))
(defn wrap (x) (some x))
(defn first-of (a b) (wrap b) a)

(type first-code (fn ((pair i32 i32)) i32))
(defn first-code (codes) (let-pair (code _) codes code))

(defn count-down (n)
  (if (= n 0)
      n
      (recur (first-of (- n 1) 3000000000))))

(defn main ()
  (let several? (> (len (command-line-args)) 5))
  (let odometer (the i64 2024))
  (prn (twice 3000000000))
  (prn (twice 2.5))
  (println (larger 1 2.5))
  (let codes (twice 7))
  (println (first-code codes))
  (prn (both 3000000000 4000000000))
  (println (larger 3000000000 1))
  (println (larger 1 odometer))
  (println (larger (if several? 1 2) odometer))
  (println (apply-to (if several? 1 2) (fn (n) (* n 2))))
  (println (larger 3 (if several? 1 2)))
  (println (= 0 odometer))
  (println (= odometer 0))
  (println ((rust "{&0} == {&1}" (where ((a (partial-eq b)) b) (fn (a b) bool))) 0 odometer))
  (println (square 100000))
  (println (count-down 3))
  (let add-one (fn (n) (+ n 1)))
  (println (add-one 3000000000))
  (prn (twice "Leaf"))
  (prn (both "Leaf" 2.5))
  (println (larger 2.5 1.5))
  (prn (wrap "Leaf"))
  (println (square 2.5))
  (println (apply-to "Leaf" (fn (model) (len model))))
  (println (first-of "Leaf" 2.5)))
