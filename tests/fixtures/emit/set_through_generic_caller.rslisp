(defn reset! (items item)
  (set! (at items 0) item))

(defn reset-outer! (items item)
  (reset! items item))

(defn main ()
  (let years (vec 2011 2019))
  (reset-outer! (mut years) 2024)
  (let makes (vec "Nissan" "Honda"))
  (reset-outer! (mut makes) "Toyota")
  (println (at years 0) " " (at makes 0)))
