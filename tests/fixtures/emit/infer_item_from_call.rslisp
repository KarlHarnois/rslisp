(trait container
  (type item)
  (put (fn ((mut self) item) unit)))

(struct (stack a) (items (vec a)))

(impl container (stack a)
  (type item a)
  (put (s value)
       (push! (mut (field s items)) value)))

(defn main ()
  (local words (new stack (items (vec))))
  (put (mut words) (str "alpha"))
  (println (len (field words items))))
