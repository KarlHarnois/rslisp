(type apply (fn ((fn ((ref str)) (ref str)) (ref str)) (ref str)))
(defn apply (pick text)
  (let local (to-string "Leaf"))
  (if (= (pick (as-str local)) "Leaf") (pick text) text))

(type first-word (fn ((ref str)) (ref str)))
(defn first-word (text) text)

(defn main ()
  (println (apply first-word "Nissan")))
