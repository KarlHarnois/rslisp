(defstruct car
  :make (ref str)
  :year u16)

(defstruct depot
  :size u16)

(trait garage
  (park (fn ((ref self) (fn ((ref str) u16) car))
          u16)
        (local make (str "Nissan"))
        (local parked (argument-1 (as-str make) 2024))
        (println (:make parked))
        (:year parked)))

(impl garage depot)

(defn main ()
  (local lot (->depot 1))
  (println (+ (:size lot) (park lot ->car))))
