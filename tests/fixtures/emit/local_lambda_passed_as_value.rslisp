(type apply-to-year
  (fn ((fn ((fn (i64) i64)) i64)) i64))

(defn apply-to-year (apply)
  (apply (fn (n) (+ n 1))))

(defn main ()
  (local year 2024)
  (local apply
    (fn (action) (action year)))
  (println (apply-to-year apply))
  (local shift (fn (n) (+ n year)))
  (prn (collect (map (range 1 4) shift))))
