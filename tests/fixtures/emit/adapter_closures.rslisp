(defstruct car
  :make str
  :year u16)

(defn report-years (years)
  (println (count (filter (iter years)
                          (fn (y) (> (deref y) 2020)))))
  (println (sum (map (iter years)
                     (fn (y) (+ (deref y) 1)))))
  (println (count (take-while (iter years)
                              (fn (y) (< (deref y) 2022)))))
  (prn (find (iter years)
             (fn (y) (> (deref y) 2020))))
  (println (any? (iter years)
                 (fn (y) (> (deref y) 2020))))
  (println (every? (iter years)
                   (fn (y) (> (deref y) 2020))))
  (println (reduce (iter years)
                   0
                   (fn (total y) (+ total (deref y)))))
  (for-each (iter years)
            (fn (y) (println (+ (deref y) 1)))))

(defn report-cars (cars)
  (println (count (filter (iter cars)
                          (fn (c) (> (:year c) 2020)))))
  (println (sum (map (iter cars) (fn (c) (:year c)))))
  (println (count (take-while (iter cars)
                              (fn (c) (> (:year c) 2020)))))
  (prn (find (iter cars)
             (fn (c) (> (:year c) 2020))))
  (println (any? (iter cars)
                 (fn (c) (> (:year c) 2020))))
  (println (every? (iter cars)
                   (fn (c) (> (:year c) 2020))))
  (println (reduce (iter cars)
                   0
                   (fn (total c) (+ total (:year c)))))
  (for-each (iter cars)
            (fn (c) (println (:make c)))))

(defn main ()
  (local years (vec 2019 2021 2024))
  (println (count (filter (iter years)
                          (fn (y) (> (deref y) 2020)))))
  (println (sum (map (iter years)
                     (fn (y) (+ (deref y) 1)))))
  (report-years years)
  (local cars
    (vec (->car "Nissan" 2024) (->car "Honda" 2019)))
  (report-cars cars))
