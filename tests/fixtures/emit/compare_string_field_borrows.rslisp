(defstruct car :model string :year i64)

(defn main ()
  (let model (to-string "Leaf"))
  (let other (to-string "Civic"))
  (let leaf (->car :model (to-string "Leaf") :year 2024))
  (let civic (->car :model (to-string "Civic") :year 2019))
  (println (= (ref (:model leaf)) (ref model)))
  (println (= (ref model) (ref (:model leaf))))
  (println (= (ref (:model leaf)) (ref (:model civic))))
  (println (= (ref model) (ref other)))
  (println (!= (ref (:model leaf)) (ref model)))
  (println (!= (ref model) (ref (:model leaf))))
  (println (!= (ref (:model leaf)) (ref (:model civic))))
  (println (!= (ref model) (ref other)))
  (println (> (ref (:model leaf)) (ref model)))
  (println (> (ref model) (ref (:model leaf))))
  (println (> (ref (:model leaf)) (ref (:model civic))))
  (println (> (ref model) (ref other))))
