(defn main ()
  (local years (vec 2019 2021 2024))
  (local recent?
    (fn (y) (> (deref y) 2020)))
  (println (count (filter (iter years) recent?)))
  (local late?
    (fn (y) (< 2020 (deref y))))
  (println (count (filter (iter years) late?)))
  (local launch?
    (fn (y) (= (deref y) 2021)))
  (prn (find (iter years) launch?))
  (local first-year
    (fn (y) (> (deref y) 2018)))
  (local year 2019)
  (local borrowed (ref year))
  (println (first-year (ref borrowed))))
