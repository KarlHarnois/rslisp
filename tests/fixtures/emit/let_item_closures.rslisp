(defn main ()
  (let years (vec 2019 2021 2024))
  (let recent? (fn (y) (> (deref y) 2020)))
  (println (count (filter (iter years) recent?)))
  (let late? (fn (y) (< 2020 (deref y))))
  (println (count (filter (iter years) late?)))
  (let launch? (fn (y) (= (deref y) 2021)))
  (prn (find (iter years) launch?))
  (let first-year (fn (y) (> (deref y) 2018)))
  (let year 2019)
  (let borrowed (ref year))
  (println (first-year (ref borrowed))))
