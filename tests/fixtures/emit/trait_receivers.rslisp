(struct circle (radius f64))
(struct square (side f64))
(enum tag (dot) (box))

(trait shape
  (area (fn ((ref self)) f64))
  (scale! (fn ((mut self) f64) unit)))

(impl shape circle
  (area (c) (* 3.0 (field c radius) (field c radius)))
  (scale! (c factor) (do (let _radius (field c radius)) (let _factor factor))))

(impl shape square
  (area (s) (* (field s side) (field s side)))
  (scale! (s factor) (do (let _side (field s side)) (let _factor factor))))

(impl shape tag
  (area (t) (match t (dot 0.0) (box 1.0)))
  (scale! (t factor) (let _factor factor)))

(trait labelled
  (label (fn (i64 (ref self)) i64)))

(impl labelled tag
  (label (value t) (do (let _t t) value)))

(trait consumed
  (take (fn (self) i64)))

(impl consumed tag
  (take (t) (match t (dot 0) (box 1))))

(trait identity
  (itself (fn ((ref self)) self)))

(impl identity tag
  (itself (t) (clone t)))

(trait swapped
  (swap! (fn ((mut self) (mut self)) unit)))

(impl swapped tag
  (swap! (a b) (do (let _b b))))

(defn total-area (shapes)
  (fold (iter shapes) 0.0 (fn (total shape) (+ total (area shape)))))

(defn areas (items)
  (let shapes (iter items))
  (collect (map shapes area)))

(defn total-of (areas)
  (fold areas 0.0 (fn (total area) (+ total area))))

(defn main ()
  (let shapes (vec (new circle (radius 1.0)) (new circle (radius 2.0))))
  (println (total-area shapes))
  (println (total-of (values (areas shapes))))
  (println (area tag/box))
  (println (area tag/dot))
  (println (area (new square (side 2.0))))
  (println (area (new circle (radius 1.0))))
  (println (area (if true (new circle (radius 1.0)) (new circle (radius 2.0)))))
  (println (label 1 tag/dot))
  (println (take tag/dot))
  (println (area (itself tag/dot)))
  (let first tag/dot)
  (let second tag/box)
  (swap! first second)
  (let circle (new circle (radius 1.0)))
  (scale! circle 2.0)
  (println (area circle)))
