(defstruct car
  :model string)

(defn main ()
  (local model (str "Leaf"))
  (local other (str "Civic"))
  (local make "Nissan")
  (local leaf (->car :model (str "Leaf")))
  (println (> "Civic" (ref model)))
  (println (> (ref model) "Civic"))
  (println (= (ref model) "Leaf"))
  (println (> (ref model) make))
  (println (> (ref (:model leaf)) "Civic"))
  (println (> (ref model) (ref other)))
  (println (> (ref model) other)))
