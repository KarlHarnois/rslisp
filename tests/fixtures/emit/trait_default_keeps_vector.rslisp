(defstruct odometer :offset i64)
(defstruct meter :scale i64)
(defstruct gauge :level i64)

(trait mileage
  (record! (fn ((ref self) (mut (vec i64))) unit)
    (push! argument-1 9)))

(impl mileage odometer
  (record! (o readings) (set! (at readings 0) (:offset o))))

(impl mileage meter
  (record! (m readings) (set! (at readings 1) (:scale m))))

(impl mileage gauge)

(defn main ()
  (let readings (vec 1200 3400))
  (let reading-gauge (->gauge 7))
  (record! (->odometer 5) (mut readings))
  (record! (->meter 2) (mut readings))
  (record! reading-gauge (mut readings))
  (println (at readings 0) " " (at readings 1) " " (len readings) " " (:level reading-gauge)))
