(def check-both
  (rust "{2}({0}, {1})"
    (where (a b)
      (fn ((ref a)
           (ref b)
           (fn ((ref a) (ref b)) bool))
        bool))))

(type total (fn ((ref i64)) i64))

(defn total (value) (+ value 1))

(type count-items
  (where (a) (fn ((ref (vec a))) usize)))

(defn count-items (items) (len items))

(defn main ()
  (local number 1)
  (local inner (ref number))
  (local outer (ref inner))
  (local equal
    (fn (left right) (= left right)))
  (println (equal outer outer))
  (println (check-both outer outer
                       (fn (left right) (= left right))))
  (println (total outer))
  (local items (vec 1 2))
  (local view (ref items))
  (local deep-view (ref view))
  (println (count-items deep-view))
  (local names (vec "a" "b"))
  (push! names "c")
  (local matches
    (collect (map (iter names)
                  (fn (name) (= name "a")))))
  (println (len matches)))
