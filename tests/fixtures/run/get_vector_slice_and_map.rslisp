(defn second (items) (get items 1))

(defn main ()
  (let years (vec 2019 2025))
  (let prices (hash-map "leaf" 30))
  (println (unwrap (get years 0)))
  (println (unwrap (second years)))
  (println (none? (get years 5)))
  (println (unwrap (get prices "leaf")))
  (println (none? (get prices "ariya"))))
