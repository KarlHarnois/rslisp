(type read-source
  (where ((s source))
    (fn ((ref s)) (result string io-error))))

(defn read-source (source) (slurp source))

(defn report (read)
  (match read
    ((ok text) (println (len text)))
    ((err error) (eprintln error))))

(defn main ()
  (local path (str "slurp_sources.txt"))
  (report (slurp "slurp_sources.txt"))
  (report (slurp path))
  (report (read-source "slurp_sources.txt"))
  (report (read-source path))
  (report (slurp stdin))
  (report (read-source stdin)))
