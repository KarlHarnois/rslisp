(defn flip ((flag bool)) (not flag))

(defn main ()
  (local grid
    (vec (vec true false) (vec false true)))
  (local row (at grid 1))
  (println (at row 0))
  (println (at (at grid 1) 0))
  (println (flip (at (at grid 1) 0)))
  (local rows
    (vec (vec (str "alpha"))
         (vec (str "beta"))))
  (local last-row (at rows 1))
  (local word (at last-row 0))
  (println word)
  (println (at (vec 5 6) 0))
  (println (match (get grid 1)
             (none false)
             ((some row) (at row 0))))
  (local (three i64) (deref (ref 3)))
  (println three)
  (local numbers (vec 4 5))
  (println (match (get numbers 1)
             ((some _) (at numbers 1))
             (none 0)))
  (push! grid (vec true true))
  (push! rows (vec (str "gamma"))))
