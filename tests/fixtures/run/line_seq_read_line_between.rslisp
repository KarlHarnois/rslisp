(defn main ()
  (for-each (line-seq stdin)
            (fn (line)
              (match line
                ((ok name)
                 (match (read-line)
                   ((ok (some value)) (println name " = " value))
                   ((ok none) (println name))
                   ((err error) (eprintln error))))
                ((err error) (eprintln error))))))
