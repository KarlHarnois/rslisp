(defn main ()
  (let items (vec 3 1 2))
  (sort! items)
  (for-each (values items) (fn (n) (println n)))
  (sort-by-key! items (fn (n) (- n)))
  (for-each (values items) (fn (n) (println n)))
  (println (some? (get items 1)))
  (pop! items)
  (println (len items))
  (for-each (windows items 2) (fn (pair) (println (at pair 0))))
  (println (len (collect (windows items 2)))))
