(defn main ()
  (local items (vec 3 1 2))
  (sort! items)
  (for-each (copied items)
            (fn (n) (println n)))
  (sort-by! items (fn (n) (- n)))
  (for-each (copied items)
            (fn (n) (println n)))
  (println (some? (get items 1)))
  (pop! items)
  (println (len items))
  (for-each (windows items 2)
            (fn (pair) (println (at pair 0))))
  (println (len (collect (windows items 2)))))
