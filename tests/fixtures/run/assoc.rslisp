(defstruct point :x i64 :y i64 :label string)

(defn bump-x (p)
  (assoc p (x 1)))

(defn main ()
  (let p (->point 7 8 (to-string "seed")))
  (let one (assoc p (x 3)))
  (println (point-x one) " " (point-y one) " " (point-label one))
  (let p2 (->point 4 5 (to-string "base")))
  (let two (assoc p2 (x 6) (label (to-string "two"))))
  (println (point-x two) " " (point-y two) " " (point-label two))
  (println (point-x (bump-x (->point 9 10 (to-string "tmp")))))
  (let grid (vec 1 2 3))
  (let next (assoc grid 1 9))
  (println (at next 0) " " (at next 1) " " (at next 2))
  (let direct (assoc (vec 7 8) 0 6))
  (println (at direct 0) " " (at direct 1))
  (let rows (vec (vec 1 2) (vec 3 4)))
  (let changed (assoc-in rows (1 0) 9))
  (let cell (match (get changed 1) ((some row) (at row 0)) (none 0)))
  (println cell))
