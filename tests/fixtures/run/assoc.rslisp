(defstruct point
  :x i64
  :y i64
  :label string)

(defn bump-x (p) (assoc p :x 1))

(defn main ()
  (local p (->point 7 8 (str "seed")))
  (local one (assoc p :x 3))
  (println (:x one)
           " "
           (:y one)
           " "
           (:label one))
  (local p2 (->point 4 5 (str "base")))
  (local two (assoc p2 :x 6 :label (str "two")))
  (println (:x two)
           " "
           (:y two)
           " "
           (:label two))
  (println (:x (bump-x (->point 9 10 (str "tmp")))))
  (local grid (vec 1 2 3))
  (local next (assoc grid 1 9))
  (println (at next 0)
           " "
           (at next 1)
           " "
           (at next 2))
  (local direct (assoc (vec 7 8) 0 6))
  (println (at direct 0) " " (at direct 1))
  (local rows (vec (vec 1 2) (vec 3 4)))
  (local changed (assoc-in rows (1 0) 9))
  (local cell
    (match (get changed 1)
      ((some row) (at row 0))
      (none 0)))
  (println cell))
