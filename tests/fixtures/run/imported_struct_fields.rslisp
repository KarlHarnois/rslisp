(use cars/cars ->car car)

(defn main ()
  (local leaf (->car "Nissan" "Leaf" 2024 true))
  (local civic
    (new car
      (make "Honda")
      (model "Civic")
      (year 2019)
      (electric? false)))
  (local newer (assoc civic :year 2021))
  (println (:year leaf)
           " "
           (:make civic)
           " "
           (:year newer)))
