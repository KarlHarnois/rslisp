(use calculator/lexer tokenize)
(use calculator/checked_parser evaluate)
(use calculator/support either and-then)

(defn main ()
  (calculate "12 + 3 * (4 - 1)")
  (calculate "12 +")
  (calculate "(1 + 2")
  (calculate "4 / (2 - 2)")
  (calculate "7 % 2"))

(defn calculate (source)
  (either (and-then (tokenize source) (fn (tokens) (evaluate (ref tokens))))
          (fn (value) (println (str source " = " value)))
          (fn (message) (println (str source " -> error: " message)))))
