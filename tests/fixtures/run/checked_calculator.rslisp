(use calculator/lexer tokenize)
(use calculator/checked_parser evaluate)

(defn main ()
  (calculate "12 + 3 * (4 - 1)")
  (calculate "12 +")
  (calculate "(1 + 2")
  (calculate "4 / (2 - 2)")
  (calculate "7 % 2"))

(defn calculate (source)
  (let outcome (then-ok (tokenize source) (fn (tokens) (evaluate (ref tokens)))))
  (if (ok? outcome)
      (println (str source " = " (unwrap-ok outcome)))
      (println (str source " -> error: " (unwrap-err outcome)))))
