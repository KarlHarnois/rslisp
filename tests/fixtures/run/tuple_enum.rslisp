(enum (pair-user a b) (rust "({0}, {1})") (of a b))

(defn make (a b) (pair-user/of a b))

(defn first-of (p) (match p ((pair-user/of a _) a)))

(defn main ()
  (let p (make (to-string "left") 2))
  (println (first-of p))
  (match (make 3 (to-string "right"))
    ((pair-user/of n text) (println (str n text)))))
