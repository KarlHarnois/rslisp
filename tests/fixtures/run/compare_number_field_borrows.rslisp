(defstruct car :model string :year i64)

(defn main ()
  (let year 2024)
  (let floor 2020)
  (let leaf (->car :model (to-string "Leaf") :year 2024))
  (let civic (->car :model (to-string "Civic") :year 2019))
  (println (= (ref (:year leaf)) (ref year)))
  (println (= (ref year) (ref (:year leaf))))
  (println (= (ref (:year leaf)) (ref (:year civic))))
  (println (= (ref year) (ref floor)))
  (println (!= (ref (:year leaf)) (ref year)))
  (println (!= (ref year) (ref (:year leaf))))
  (println (!= (ref (:year leaf)) (ref (:year civic))))
  (println (!= (ref year) (ref floor)))
  (println (> (ref (:year leaf)) (ref year)))
  (println (> (ref year) (ref (:year leaf))))
  (println (> (ref (:year leaf)) (ref (:year civic))))
  (println (> (ref year) (ref floor))))
