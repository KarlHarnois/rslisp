(defn sum-of (it)
  (reduce it 0
          (fn (total year) (+ total year))))

(defn main ()
  (local through-function
    (fn (it) (sum-of it)))
  (println (through-function (range 2019 2025)))
  (local pass (fn (it) it))
  (println (count (pass (range 2019 2025))))
  (local extra (range 0 3))
  (local combined
    (fn (it)
      (println (sum-of it))
      (count extra)))
  (println (combined (range 2019 2025)))
  (local label-length
    (fn (label) (len label)))
  (println (label-length "Nissan Leaf")))
