(defstruct car
  :make str
  :model string
  :year u16)

(defstruct garage
  :name string
  :bays (vec car)
  :levels (vec (vec u16)))

(defn main ()
  (local garage
    (->garage (str "North")
              (vec (->car "Honda" (str "Civic") 2019))
              (vec (vec 1 2) (vec 3 4))))
  (local parked
    (assoc-in garage
              (:bays 0)
              (->car "Nissan" (str "Leaf") 2024)))
  (local renumbered (assoc-in parked (:levels 1 0) 7))
  (println (:name renumbered)
           " "
           (:make (at (:bays renumbered) 0))
           " "
           (at (at (:levels renumbered) 1) 0)))
