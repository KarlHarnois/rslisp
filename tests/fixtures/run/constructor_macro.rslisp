(defn describe-early ()
  (:year (->car "Toyota" "Corolla" 2018 false)))

(defstruct car
  :make str
  :model str
  :year u16
  :electric? bool)

(defn main ()
  (local by-position (->car "Honda" "Civic" 2019 false))
  (local by-name
    (->car :make "Nissan"
           :model "Leaf"
           :year 2024
           :electric? true))
  (local reordered
    (->car :year 2019
           :electric? false
           :make "Honda"
           :model "Civic"))
  (local build ->car)
  (local built (build "Volkswagen" "Golf" 2021 false))
  (println (:make by-position))
  (println (:model by-name))
  (println (:year reordered))
  (println (:model built))
  (println (describe-early)))
