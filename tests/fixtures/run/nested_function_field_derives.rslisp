(defstruct car :make str :model str)
(defstruct spare :maker (option (fn () car)))
(enum line (stations (vec (fn () i64))))

(defn build-leaf ()
  (->car :make "Nissan" :model "Leaf"))

(defn count-doors () 4)

(defn main ()
  (prn (->spare :maker none))
  (prn (line/stations (vec)))
  (let backup (->spare :maker (some build-leaf)))
  (match backup
    ((spare (some maker)) (println (:make (maker)) " " (:model (maker))))
    ((spare none) (println "no spare")))
  (match (line/stations (vec count-doors))
    ((stations steps) (println (len steps)))))
