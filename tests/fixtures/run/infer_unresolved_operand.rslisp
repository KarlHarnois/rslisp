(defrule open-text
  (() (do (str (some (vec))) 1)))

(defn main ()
  (println (infer (len (vec))))
  (println (infer (do none 1)))
  (println (infer (some? none)))
  (println (infer (do (local v (vec)) 1)))
  (println (infer (do (prn (vec)) 1)))
  (println (infer (do (prn none) 1)))
  (println (infer (= (vec) (vec))))
  (println (infer (do (str (some (vec))) 1)))
  (println (infer (do (local v (vec)) (infer v))))
  (println (infer (open-text))))
