(defstruct (holder a)
  :value a
  :label str)

(defn wrap (f)
  (new holder (:value f) (:label "wrapped")))

(defn main ()
  (local offset 3)
  (local direct
    (new holder
      (:value (fn (x) (+ x offset)))
      (:label "direct")))
  (local held
    (wrap (fn (x) (+ x offset))))
  (local peek (:value direct))
  (println (:label held) (:label direct)))
