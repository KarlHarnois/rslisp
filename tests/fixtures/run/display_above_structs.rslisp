(defn main ()
  (local card-1 (->card :name "Black Lotus" :set "Alpha"))
  (local card-2 (->card :name "Counterspell" :set "Alpha"))
  (local deck
    (->deck :name "The Deck" :cards (vec card-1 card-2)))
  (println deck))

(display deck (d)
  (:name d)
  ": "
  (len (:cards d))
  " cards")

(display card (c)
  (:name c)
  " ("
  (:set c)
  ")")

(defstruct deck
  :name str
  :cards (vec card))

(defstruct card
  :name str
  :set str)
