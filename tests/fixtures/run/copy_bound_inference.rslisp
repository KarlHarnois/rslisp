(type twice-pinned (where ((a copy)) (fn (a) (vec a))))
(defn twice-pinned (x) (vec x x))

(defn twice (x) (vec x x))

(defn wrap (x) (vec x))

(defn show-twice (x) (println x) (println x))

(defn bigger (a b) (if (> a b) a b))

(defn main ()
  (println (len (twice 3)))
  (println (len (twice 1.5)))
  (println (len (twice-pinned 3)))
  (println (len (wrap 3)))
  (println (len (wrap (to-string "one"))))
  (show-twice 3)
  (show-twice (to-string "two"))
  (println (bigger 1 2))
  (println (bigger (to-string "pear") (to-string "apple"))))
