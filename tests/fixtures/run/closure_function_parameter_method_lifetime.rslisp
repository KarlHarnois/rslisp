(defstruct car :make str :model str)

(defstruct depot :size u16)

(trait showroom
  (longer-make (fn ((ref str) (ref str) (ref self)) (ref str))))

(impl showroom depot
  (longer-make (first second lot)
    (println (:size lot))
    (let pick (fn (build) (:make (build))))
    (pick (fn () (->car :make (if (> (len first) (len second)) first second) :model "Leaf")))))

(defn main ()
  (let lot (->depot 2024))
  (println (longer-make "Nissan" "Mitsubishi" lot)))
