(def fallback-years (vec 2019 2021))

(defn first-fallback () (at fallback-years 0))

(defn main ()
  (local years (vec 2019 2021 2024))
  (local year-at
    (fn (index) (at years index)))
  (local first
    (fn ((items (ref (vec i64))))
      (at items 0)))
  (local longer
    (fn ((a (ref str)) (b (ref str)))
      (if (> (len a) (len b)) a b)))
  (local (second (fn ((ref (vec i64))) (ref i64)))
    (fn (items) (at items 1)))
  (local name (str "Ariya"))
  (local tagged
    (fn ((items (ref (vec i64)))
         (label (ref str)))
      (at items (rem (len label) 2))))
  (println (first-fallback))
  (println (first fallback-years))
  (println (longer "Nissan" "Leaf"))
  (println (second years))
  (println (year-at 2))
  (println (tagged fallback-years (as-str name))))
