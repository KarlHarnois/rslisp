(defstruct car
  :model string
  :year u16)

(defn main ()
  (println (loop (i 0
                  total 0)
             (if (< i 3)
               (do
                 (local leaf
                   (->car (str "Leaf") (+ 2020 i)))
                 (local kept leaf)
                 (println (:model kept) " " (:year kept))
                 (recur (+ i 1) (+ total (:year kept))))
               total))))
