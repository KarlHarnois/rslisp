(defn ordered (left)
  (local numbers (vec 3 1 2))
  (sort! numbers
         (fn (a b) (+ left (- b a))))
  (println (unwrap (first numbers))))

(defn sorted ()
  (local numbers (vec 3 1 2))
  (sort! numbers (fn (a b) (- b a)))
  (println (unwrap (first numbers))))

(defn main ()
  (ordered -5)
  (sorted))
