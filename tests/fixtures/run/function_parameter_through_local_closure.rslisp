(defn record-twice (record year)
  (let step (fn (n) (record n)))
  (step year)
  (step (+ year 1)))

(defn record-once (record year)
  (let step (fn (n) (record n)))
  (step year))

(defn twice (action year)
  (action year)
  (action (+ year 1)))

(defn record-through-twice (record year)
  (let step (fn (n) (record n)))
  (twice step year))

(defn record-in-loop (record year)
  (let step (fn (n) (record n)))
  (loop ((offset 0))
    (if (< offset 2)
      (do (step (+ year offset)) (recur (+ offset 1)))
      (do))))

(defn record-nested (record year)
  (let step (fn (n) (record n)))
  (let step-next (fn (n) (step (+ n 1))))
  (step-next year)
  (step-next (+ year 1)))

(defn main ()
  (let years (vec 2024))
  (record-twice (fn (year) (push! years year)) 2025)
  (record-once (fn (year) (push! years year)) 2027)
  (record-through-twice (fn (year) (push! years year)) 2028)
  (record-in-loop (fn (year) (push! years year)) 2029)
  (record-nested (fn (year) (push! years year)) 2031)
  (println (len years)))
