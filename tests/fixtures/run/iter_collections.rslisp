(defn main ()
  (local numbers (vec 1 2 3))
  (local sorted (sorted-map "a" 1 "b" 2))
  (local hashed (hash-map "a" 10 "b" 20))
  (for-each (iter numbers)
            (fn (n) (println n)))
  (for-each (iter sorted)
            (fn (entry)
              (let-pair (key value) entry (println key " " value))))
  (println (sum (map (iter hashed)
                     (fn (entry)
                       (let-pair (_ value) entry (deref value)))))))
