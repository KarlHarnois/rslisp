(trait shape
  (area (fn ((ref self)) f64)))

(struct circle (radius f64))
(struct square (side f64))
(impl shape circle
  (area (c) (* 3.0 (field c radius) (field c radius))))
(impl shape square
  (area (s) (* (field s side) (field s side))))

(type total (fn ((vec (box shape))) f64))
(defn total (shapes)
  (fold shapes 0.0 (fn (total shape) (+ total (area shape)))))

(defn main ()
  (println (total (vec (box-new (new circle (radius 1.0)))
                       (box-new (new square (side 2.0)))))))
