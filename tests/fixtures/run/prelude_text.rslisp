(defn main ()
  (println (trim "  trim me  "))
  (for-each (chars "abc")
            (fn (c) (print c)))
  (println "")
  (for-each (lines "one\ntwo")
            (fn (line) (println line)))
  (for-each (split "a,b,c" ",")
            (fn (part) (println part)))
  (println (as-str (str "as-str")))
  (local (good (result i64 _))
    (parse "42"))
  (local (bad (result i64 _))
    (parse "nope"))
  (println (ok? good))
  (println (err? bad)))
