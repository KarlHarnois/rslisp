(defstruct spare
  :maker (fn () i64))

(defstruct backup
  :maker (option (fn () i64)))

(defn count-doors () 4)

(defn main ()
  (local base 4)
  (local chosen
    (->spare :maker (if (> base 2)
                      (fn () (+ 4 1))
                      count-doors)))
  (local matched
    (->backup :maker (some (match base
                             (4 count-doors)
                             (_ (fn () (+ 2 1)))))))
  (local made
    (->spare :maker (do (println "making") (fn () (+ 6 1)))))
  (local pick (:maker chosen))
  (local build (:maker made))
  (println (pick))
  (println (build))
  (match matched
    ((backup (some maker)) (println (maker)))
    ((backup none) (println "no backup"))))
