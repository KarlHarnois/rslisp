(defstruct user :name str :age u16)
(defstruct sorter :key (fn ((ref user)) u16) :label str)

(defn main ()
  (let ana (->user "Ana" 30))
  (let key (fn ((someone (ref user))) (+ (:age someone) 2)))
  (let by-bonus (new sorter (:key key) (:label "by bonus")))
  (println (:label by-bonus))
  (println ((:key by-bonus) ana)))
