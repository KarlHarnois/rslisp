(defstruct user
  :name str
  :age u16)

(defstruct sorter
  :key (fn ((ref user)) u16)
  :label str)

(defn main ()
  (local ana (->user "Ana" 30))
  (local key
    (fn ((someone (ref user)))
      (+ (:age someone) 2)))
  (local by-bonus
    (new sorter (:key key) (:label "by bonus")))
  (println (:label by-bonus))
  (println ((:key by-bonus) ana)))
