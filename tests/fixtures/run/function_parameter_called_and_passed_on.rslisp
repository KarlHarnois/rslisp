(defstruct car
  :make str
  :year u16)

(type build-with
  (fn ((fn ((ref str) u16) car)) car))

(defn build-with (constructor) (constructor "Nissan" 2024))

(defn build-twice (constructor)
  (local make (str "Nissan"))
  (local owned (constructor (as-str make) 2011))
  (local built (build-with constructor))
  (println (:make built))
  (+ (:year owned) (:year built)))

(defn main ()
  (println (build-twice ->car)))
