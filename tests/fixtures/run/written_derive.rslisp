(defstruct ticket
  :id u32
  :seat u32)

(derive ticket copy ord hash debug show)

(defstruct tag
  :label string)

(derive tag)

(defn main ()
  (local early (->ticket 1 4))
  (local same early)
  (prn early)
  (prn same)
  (println (< early (->ticket 2 1)))
  (println (:label (->tag (str "vip")))))
