(def add-one!
  (rust "*{0} += 1" (fn ((mut i64)) unit)))

(type peek (fn ((ref i64)) i64))

(defn peek (x) (deref x))

(defn plus-one (r) (+ (deref r) 1))

(def vec-capacity
  (rust "{0}.capacity()"
    (fn ((ref (vec string))) usize)))

(defn vec-size (names) (vec-capacity names))

(type show (fn ((ref string)) unit))

(defn show (s) (println s))

(defn relay (s) (show (ref s)))

(defn relay-mut! (x) (add-one! (mut x)))

(defmacro three () (deref (ref 3)))

(def value (three))

(type pair-up (where (a) (fn (a a) a)))

(defn pair-up (a b) a)

(defn main ()
  (local n 4)
  (println (peek (ref n)))
  (local n 4)
  (add-one! (mut n))
  (println n)
  (local n 4)
  (println (plus-one (ref n)))
  (local p 4)
  (local r (pair-up (ref p) (ref p)))
  (println r)
  (local names (vec (str "ana")))
  (println (vec-size (ref names)))
  (relay (str "bo"))
  (local v 5)
  (relay-mut! (mut v))
  (println v)
  (local q 4)
  (local (m (mut i64)) (mut q))
  (local deref-value (deref m))
  (println deref-value)
  (println value))
