(defstruct user
  :name string
  :age u16)

(defstruct sorter
  :key (fn ((ref user)) (ref string))
  :label str)

(defn main ()
  (local by-name
    (new sorter (:key :name) (:label "by name")))
  (local by-name-again
    (->sorter :key :name :label "by name again"))
  (println (:label by-name) ", " (:label by-name-again)))
