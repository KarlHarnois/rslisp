(defn identity (x) x)

(defn wrap (x)
  (println (infer x))
  (some x))

(defn wrap-pair (x)
  (println (infer (pair x none)))
  (some x))

(defn main ()
  (println (infer none))
  (println (infer identity))
  (println (infer (fn (x) (str x))))
  (local v (vec))
  (push! v (char "x"))
  (println (infer v))
  (wrap 1)
  (wrap "a")
  (prn (wrap-pair 1)))
