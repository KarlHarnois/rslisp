(defn count-words (text)
  (reduce (split (as-str text) " ")
          (hash-map)
          (fn (counts word)
            (update counts
                    (str word)
                    (fn (n) (+ n 1))
                    0))))

(defn main ()
  (local counts (count-words (str "the cat and the hat")))
  (println (len counts))
  (println (unwrap (get counts "the")))
  (println (unwrap (get counts "cat"))))
