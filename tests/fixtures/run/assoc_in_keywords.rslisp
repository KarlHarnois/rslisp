(defstruct point
  :x i64
  :y i64)

(defstruct line
  :start point
  :end point)

(defstruct badge
  :text string
  :at point)

(defstruct garage
  :name string
  :badge badge)

(defn load-line ()
  (println "load")
  (->line (->point 1 2) (->point 5 6)))

(defn main ()
  (local line
    (->line (->point 1 2) (->point 5 6)))
  (local moved (assoc-in line (:start :x) 3))
  (println (:x (:start moved))
           " "
           (:y (:start moved))
           " "
           (:x (:end moved)))
  (local loaded
    (assoc-in (load-line) (:end :y) 9))
  (println (:y (:end loaded)))
  (local garage
    (->garage (str "Leaf Garage")
              (->badge (str "open") (->point 0 0))))
  (local repainted (assoc-in garage (:badge :at :x) 4))
  (println (:name repainted)
           " "
           (:text (:badge repainted))
           " "
           (:x (:at (:badge repainted)))))
