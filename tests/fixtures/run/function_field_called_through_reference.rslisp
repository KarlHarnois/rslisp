(defstruct user
  :name string
  :age u16)

(defstruct sorter
  :key (fn ((ref user)) u16)
  :label str)

(defn key-of ((chosen (ref sorter))
              (someone (ref user)))
  ((:key chosen) someone))

(defn main ()
  (local by-age (->sorter :key :age :label "by age"))
  (local ana (->user :name (str "ana") :age 34))
  (println (:label by-age) ": " (key-of by-age ana)))
