(defn direct! (items)
  (loop ()
    (match (pop! items)
      (none (do))
      ((some item) (recur)))))

(defn three-arms! (items)
  (loop ()
    (match (pop! items)
      ((some 0) (do))
      ((some item) (do (println item) (recur)))
      (none (do)))))

(defn nested-if! (items)
  (loop ()
    (match (pop! items)
      ((some item) (if (> item 0) (recur) (do)))
      (none (do)))))

(defn not-empty! (items)
  (loop ()
    (match (pop! items)
      ((some item) (do (println item) (recur)))
      (none (do (println "done"))))))

(defn let-arm! (items)
  (loop ()
    (match (pop! items)
      ((some item) (do (println item) (recur)))
      (none (local done (println "stop"))))))

(defn let-tail! (items)
  (loop ()
    (match (pop! items)
      ((some item) (do (println item) (recur)))
      (none (do (local done (println "end")))))))

(type guarded!
  (fn ((mut (vec string))) unit))

(defn guarded! (items)
  (loop ()
    (match (pop! items)
      ((some "again") (do (println "again") (recur)))
      (_ (do)))))

(defn plain! (items)
  (loop ()
    (if (some? (pop! items)) (recur) (do))))

(defn bound ()
  (loop (n 0)
    (match n (0 (recur 1)) (_ (do)))))

(defn main ()
  (do)
  (local direct-items (vec 1 2))
  (direct! (mut direct-items))
  (local three-arm-items (vec 1 2))
  (three-arms! (mut three-arm-items))
  (local nested-items (vec 1 2))
  (nested-if! (mut nested-items))
  (local not-empty-items (vec 1 2))
  (not-empty! (mut not-empty-items))
  (local let-arm-items (vec 1 2))
  (let-arm! (mut let-arm-items))
  (local let-tail-items (vec 1 2))
  (let-tail! (mut let-tail-items))
  (local guarded-items
    (vec (str "stop") (str "again")))
  (guarded! (mut guarded-items))
  (local plain-items (vec 1))
  (plain! (mut plain-items))
  (bound)
  (local shaped (do (local inner 3) 4))
  (println shaped))
