(defn direct! (items)
  (loop ()
    (match (pop! items)
      (none (do))
      ((some item) (recur)))))

(defn three-arms! (items)
  (loop ()
    (match (pop! items)
      ((some 0) (do))
      ((some item) (do (println item) (recur)))
      (none (do)))))

(defn nested-if! (items)
  (loop ()
    (match (pop! items)
      ((some item) (if (> item 0) (recur) (do)))
      (none (do)))))

(defn not-empty! (items)
  (loop ()
    (match (pop! items)
      ((some item) (do (println item) (recur)))
      (none (do (println "done"))))))

(defn let-arm! (items)
  (loop ()
    (match (pop! items)
      ((some item) (do (println item) (recur)))
      (none (let done (println "stop"))))))

(defn let-tail! (items)
  (loop ()
    (match (pop! items)
      ((some item) (do (println item) (recur)))
      (none (do (let done (println "end")))))))

(type guarded! (fn ((mut (vec string))) unit))
(defn guarded! (items)
  (loop ()
    (match (pop! items)
      ((some "again") (do (println "again") (recur)))
      (_ (do)))))

(defn plain! (items)
  (loop ()
    (if (some? (pop! items))
        (recur)
        (do))))

(defn bound ()
  (loop ((n 0))
    (match n
      (0 (recur 1))
      (_ (do)))))

(defn main ()
  (do)
  (let direct-items (vec 1 2))
  (direct! (mut direct-items))
  (let three-arm-items (vec 1 2))
  (three-arms! (mut three-arm-items))
  (let nested-items (vec 1 2))
  (nested-if! (mut nested-items))
  (let not-empty-items (vec 1 2))
  (not-empty! (mut not-empty-items))
  (let let-arm-items (vec 1 2))
  (let-arm! (mut let-arm-items))
  (let let-tail-items (vec 1 2))
  (let-tail! (mut let-tail-items))
  (let guarded-items (vec (to-string "stop") (to-string "again")))
  (guarded! (mut guarded-items))
  (let plain-items (vec 1))
  (plain! (mut plain-items))
  (bound)
  (let shaped (do (let inner 3) 4))
  (println shaped))
