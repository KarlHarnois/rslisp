(defn count-words (text)
  (reduce (split (as-str text) " ")
        (sorted-map)
        (fn (counts word)
          (update counts (str word) (fn (n) (+ n 1)) 0))))

(defn main ()
  (for-each (iter (count-words (str "the cat and the hat")))
            (fn (entry)
              (let-pair (word count) entry
                (println (str word " " count))))))
