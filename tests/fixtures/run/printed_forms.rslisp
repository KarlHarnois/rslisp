(defstruct point
  :x i64
  :y i64)

(enum shape
  (circle f64)
  empty
  (labeled (struct (text string) (size f64))))

(enum (tree a)
  leaf
  (node (tree a) a (tree a)))

(defstruct holder
  :item (option point)
  :label string)

(defn main ()
  (prn 42)
  (prn (the u8 7))
  (prn -3)
  (prn 1.0)
  (prn (the f32 0.1))
  (prn 1e100)
  (prn (/ 1.0 0.0))
  (prn (/ -1.0 0.0))
  (prn (/ 0.0 0.0))
  (prn true)
  (prn (char "a"))
  (prn (char "\""))
  (prn "hello \"ana\"\n")
  (prn "\\ \r \t \0 \u{1} é")
  (prn (str "owned"))
  (prn (do))
  (prn (some 3))
  (prn (the (option i64) none))
  (prn (the (result i64 string) (ok 1)))
  (prn (the (result i64 string)
            (err (str "bad"))))
  (prn (pair 1 "a"))
  (prn (vec 1 2 3))
  (prn (the (vec i64) (vec)))
  (prn (box 5))
  (prn (sorted-map "b" 2 "a" 1))
  (prn (hash-map "zed" 1 "amy" 2))
  (prn (->point 4 3))
  (prn (shape/circle 1.0))
  (prn shape/empty)
  (prn (shape/labeled (str "box") 2.0))
  (prn (tree/node tree/leaf 1 tree/leaf))
  (prn (->holder (some (->point 1 2))
                 (str "box")))
  (prn (slurp "missing.txt"))
  (prn (the (result i64 parse-int-error) (parse "x")))
  (prn (the (result bool parse-bool-error) (parse "maybe")))
  (prn (the (result char parse-char-error) (parse "ab")))
  (prn (the (result f64 parse-float-error) (parse "x")))
  (println "part " (pr-str (vec "a")) " end")
  (println (pr-str (->point 1 2)))
  (println (= (pr-str (->point :x 4 :y 3)) "(->point :x 4 :y 3)")))
