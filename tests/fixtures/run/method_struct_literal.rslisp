(defstruct spare :size u16 :label str)

(trait sized
  (size-of (fn ((ref self)) u16)))

(impl sized spare
  (size-of (s) (:size s)))

(defn main ()
  (println (:label (->spare :size 1 :label "washer")))
  (if (= (size-of (->spare :size 3 :label "nut")) 3)
    (println "three")
    (println "other")))
