(defstruct car
  :model string)

(defn same-model? ((leaf (ref car)) (model (ref string)))
  (= (ref (:model leaf)) model))

(defn main ()
  (local model (str "Leaf"))
  (local other (str "Civic"))
  (local r (ref other))
  (local leaf (->car :model (str "Leaf")))
  (local civic (->car :model (str "Civic")))
  (println (= (ref (:model leaf)) (:model civic)))
  (println (= (:model leaf) (ref model)))
  (println (= (ref model) (:model civic)))
  (println (= (ref model) r))
  (println (= r (ref model)))
  (println (> (ref model) r))
  (println (same-model? leaf model)))
