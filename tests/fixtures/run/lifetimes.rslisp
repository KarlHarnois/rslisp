(type written-longer (fn ((ref str) (ref str)) (ref str)))
(defn written-longer (a b) (if (> (len a) (len b)) a b))

(defn longer (a b) (if (> (len a) (len b)) a b))

(type first (where ('a 'b) (fn ((ref 'a str) (ref 'b str)) (ref 'a str))))
(defn first (a b) a)

(struct snippet (text (ref str)))
(defn snippet-of (source) (new snippet (text source)))
(defn literal-snippet () (new snippet (text "hi")))

(struct (label 'a) (text (ref 'a str)))
(defn label-of (source) (new label (text source)))

(enum token (symbol (ref str)) (number (ref str)))

(enum (tagged 'a) (value (ref 'a str)))

(type choose (where (a) (fn (a a (ref str) (ref str)) (ref str))))
(defn choose (x y s t) t)

(defn token-text (token)
  (match token
    ((symbol text) text)
    ((number text) text)))

(defn main ()
  (println (written-longer "hi" "hello there"))
  (println (longer "hi" "hello there"))
  (println (first "hello" "hi"))
  (let source "hello there")
  (let shorter (snippet-of source))
  (println (str "snippet " (field shorter text)))
  (println (str "literal " (field (literal-snippet) text)))
  (let named (label-of source))
  (println (str "label " (field named text)))
  (println (str "token " (token-text (token/symbol "hi"))))
  (println (str "number " (token-text (token/number "42"))))
  (println (match (tagged/value "tagged") ((value text) text)))
  (println (choose 1 2 "hi" "there")))
