(defstruct dealer
  :prices (hash-map str u32)
  :ranking (sorted-map u8 str))

(defn main ()
  (local dealer
    (->dealer :prices (hash-map "Leaf" 30000)
              :ranking (sorted-map 1 "Leaf")))
  (println (unwrap (get (:prices dealer) "Leaf")))
  (println (unwrap (get (:ranking dealer) 1))))
