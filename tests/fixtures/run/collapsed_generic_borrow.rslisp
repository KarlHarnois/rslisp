(type check-both
  (where (a b)
    (fn ((ref a)
         (ref b)
         (fn ((ref a) (ref b)) bool))
      bool)))

(defn check-both (left right equal) (equal left right))

(type apply-to
  (where (a)
    (fn ((ref a) (fn ((ref a)) bool)) bool)))

(defn apply-to (value test) (test value))

(type same?
  (where ((a partial-eq)) (fn (a a) bool)))

(defn same? (left right) (= left right))

(type check-reference
  (where (a)
    (fn ((ref (ref a))
         (fn ((ref (ref a))) bool))
      bool)))

(defn check-reference (value test) (test value))

(defn main ()
  (let number 1)
  (let inner (ref number))
  (let outer (ref inner))
  (let outermost (ref outer))
  (println (check-both outer outer
                       (fn (left right) (= left right))))
  (println (check-both outermost outermost
                       (fn (left right) (= left right))))
  (println (check-both outer outermost
                       (fn (left right) (= left right))))
  (let word "a")
  (let view (ref word))
  (let deep-view (ref view))
  (println (apply-to view (fn (text) (= text "a"))))
  (println (apply-to deep-view
                     (fn (text) (= text "b"))))
  (let views (vec view))
  (let deep-views (vec deep-view))
  (push! views view)
  (push! deep-views deep-view)
  (println (apply-to (at views 0)
                     (fn (text) (= text "a"))))
  (println (apply-to (at deep-views 0)
                     (fn (text) (= text "a"))))
  (println (check-reference outermost
                            (fn (item) (> item 0))))
  (let name (str "ada"))
  (let borrowed (ref name))
  (let reborrowed (ref borrowed))
  (println (same? borrowed reborrowed))
  (println (same? reborrowed borrowed)))
