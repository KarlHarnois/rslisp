(defstruct tag :name str :scores (slice i64))
(enum label (named str) blank)

(defn describe (item)
  (match item
    ((named text) text)
    (blank "blank")))

(defn main ()
  (let numbers (vec 3 4))
  (let fruit (->tag "fruit" numbers))
  (println (:name fruit) " " (len (:scores fruit)))
  (println (describe (label/named "apple")) " " (describe label/blank)))
