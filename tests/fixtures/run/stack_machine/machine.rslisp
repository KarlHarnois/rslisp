(use stack_machine/instruction instruction-opcode instruction-argument
     push-code add-code sub-code mul-code dup-code swap-code over-code
     jump-code jump-if-zero-code print-code halt-code)
(use stack_machine/collections to-index)

(export run)

(defn run (program)
  (let stack (vec))
  (run-from! program 0 stack))

(defn run-from! (program counter stack)
  (if (>= counter (len program))
      (err (str "jump out of range: " counter))
      (do
          (let instruction (unwrap (get program counter)))
          (let opcode (instruction-opcode instruction))
          (let argument (instruction-argument instruction))
          (let next (+ counter 1))
          (cond ((= opcode push-code)
                 (do (push! stack argument) (run-from! program next stack)))
                ((= opcode add-code)
                 (do (let right (pop! stack))
                     (let left (pop! stack))
                     (if (and (some? left) (some? right))
                         (do (push! stack (add (unwrap left) (unwrap right)))
                             (run-from! program next stack))
                         (underflow))))
                ((= opcode sub-code)
                 (do (let right (pop! stack))
                     (let left (pop! stack))
                     (if (and (some? left) (some? right))
                         (do (push! stack (sub (unwrap left) (unwrap right)))
                             (run-from! program next stack))
                         (underflow))))
                ((= opcode mul-code)
                 (do (let right (pop! stack))
                     (let left (pop! stack))
                     (if (and (some? left) (some? right))
                         (do (push! stack (mul (unwrap left) (unwrap right)))
                             (run-from! program next stack))
                         (underflow))))
                ((= opcode dup-code)
                 (do (let top (pop! stack))
                     (if (some? top)
                         (do (let (value i64) (unwrap top))
                             (push! stack value)
                             (push! stack value)
                             (run-from! program next stack))
                         (underflow))))
                ((= opcode swap-code)
                 (do (let right (pop! stack))
                     (let left (pop! stack))
                     (if (and (some? left) (some? right))
                         (do (push! stack (unwrap right))
                             (push! stack (unwrap left))
                             (run-from! program next stack))
                         (underflow))))
                ((= opcode over-code)
                 (do (let right (pop! stack))
                     (let left (pop! stack))
                     (if (and (some? left) (some? right))
                         (do (let (below i64) (unwrap left))
                             (push! stack below)
                             (push! stack (unwrap right))
                             (push! stack below)
                             (run-from! program next stack))
                         (underflow))))
                ((= opcode jump-code) (run-from! program (to-index argument) stack))
                ((= opcode jump-if-zero-code)
                 (do (let top (pop! stack))
                     (if (some? top)
                         (run-from! program (if (= (unwrap top) 0) (to-index argument) next) stack)
                         (underflow))))
                ((= opcode print-code)
                 (do (let top (pop! stack))
                     (if (some? top)
                         (do (println (unwrap top)) (run-from! program next stack))
                         (underflow))))
                ((= opcode halt-code)
                 (do (let top (pop! stack))
                     (if (some? top)
                         (ok (unwrap top))
                         (underflow))))
                (else (err (str "unknown opcode: " opcode)))))))

(defn underflow () (err (to-string "stack underflow")))
