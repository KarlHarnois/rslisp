(use stack_machine/instruction instruction)

(export run)

(defn run (program)
  (let stack (vec))
  (run-from! program 0 stack))

(defn run-from! (program counter stack)
  (match (try (instruction-at program counter))
    ((push value)
     (do (push! stack value) (run-from! program (+ counter 1) stack)))
    (add
     (let-try ((right (pop-value! stack))
               (left (pop-value! stack)))
       (push! stack (+ left right))
       (run-from! program (+ counter 1) stack)))
    (sub
     (let-try ((right (pop-value! stack))
               (left (pop-value! stack)))
       (push! stack (- left right))
       (run-from! program (+ counter 1) stack)))
    (mul
     (let-try ((right (pop-value! stack))
               (left (pop-value! stack)))
       (push! stack (* left right))
       (run-from! program (+ counter 1) stack)))
    (dup
     (let-try ((value (pop-value! stack)))
       (push! stack value)
       (push! stack value)
       (run-from! program (+ counter 1) stack)))
    (swap
     (let-try ((right (pop-value! stack))
               (left (pop-value! stack)))
       (push! stack right)
       (push! stack left)
       (run-from! program (+ counter 1) stack)))
    (over
     (let-try ((right (pop-value! stack))
               (left (pop-value! stack)))
       (push! stack left)
       (push! stack right)
       (push! stack left)
       (run-from! program (+ counter 1) stack)))
    ((jump target) (run-from! program target stack))
    ((jump-if-zero target)
     (let-try ((top (pop-value! stack)))
       (run-from! program (if (= top 0) target (+ counter 1)) stack)))
    (print
     (let-try ((top (pop-value! stack)))
       (println top)
       (run-from! program (+ counter 1) stack)))
    (halt
     (let-try ((top (pop-value! stack)))
       (ok top)))))

(defn instruction-at (program counter)
  (match (get program counter)
    ((some instruction) (ok (deref instruction)))
    (none (err (str "jump out of range: " counter)))))

(defn pop-value! (stack)
  (match (pop! stack)
    ((some value) (ok value))
    (none (err (to-string "stack underflow")))))
