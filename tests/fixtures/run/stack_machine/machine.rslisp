(use stack_machine/instruction instruction-opcode instruction-argument
     push-code add-code sub-code mul-code dup-code swap-code over-code
     jump-code jump-if-zero-code print-code halt-code)
(use stack_machine/collections to-index)

(export run)

(defn run (program)
  (let stack (vec))
  (step program 0 stack))

(defn step (program counter stack)
  (if (< counter (len program))
      (execute program counter stack)
      (err (str "jump out of range: " counter))))

(defn execute (program counter given-stack)
  (let stack given-stack)
  (let instruction (unwrap (get program counter)))
  (let opcode (instruction-opcode instruction))
  (let argument (instruction-argument instruction))
  (let next (+ counter 1))
  (cond ((= opcode push-code) (do (push! stack argument) (step program next stack)))
        ((= opcode add-code) (combine program next stack add))
        ((= opcode sub-code) (combine program next stack sub))
        ((= opcode mul-code) (combine program next stack mul))
        ((= opcode dup-code) (duplicate program next stack))
        ((= opcode swap-code) (swap program next stack))
        ((= opcode over-code) (over program next stack))
        ((= opcode jump-code) (step program (to-index argument) stack))
        ((= opcode jump-if-zero-code) (jump-if-zero program (to-index argument) next stack))
        ((= opcode print-code) (print-top program next stack))
        ((= opcode halt-code) (pop-result stack))
        (else (err (str "unknown opcode: " opcode)))))

(defn underflow () (err (to-string "stack underflow")))

(defn combine (program next given-stack operation)
  (let stack given-stack)
  (let right (pop! stack))
  (let left (pop! stack))
  (if (and (some? left) (some? right))
      (do (push! stack (operation (unwrap left) (unwrap right)))
          (step program next stack))
      (underflow)))

(defn swap (program next given-stack)
  (let stack given-stack)
  (let right (pop! stack))
  (let left (pop! stack))
  (if (and (some? left) (some? right))
      (do (push! stack (unwrap right))
          (push! stack (unwrap left))
          (step program next stack))
      (underflow)))

(defn over (program next given-stack)
  (let stack given-stack)
  (let right (pop! stack))
  (let left (pop! stack))
  (if (and (some? left) (some? right))
      (do (let (below i64) (unwrap left))
          (push! stack below)
          (push! stack (unwrap right))
          (push! stack below)
          (step program next stack))
      (underflow)))

(defn duplicate (program next given-stack)
  (let stack given-stack)
  (let top (pop! stack))
  (if (some? top)
      (do (let (value i64) (unwrap top))
          (push! stack value)
          (push! stack value)
          (step program next stack))
      (underflow)))

(defn jump-if-zero (program target next given-stack)
  (let stack given-stack)
  (let top (pop! stack))
  (if (some? top)
      (step program (if (= (unwrap top) 0) target next) stack)
      (underflow)))

(defn print-top (program next given-stack)
  (let stack given-stack)
  (let top (pop! stack))
  (if (some? top)
      (do (println (unwrap top)) (step program next stack))
      (underflow)))

(defn pop-result (stack)
  (let top (pop! stack))
  (if (some? top) (ok (unwrap top)) (underflow)))
