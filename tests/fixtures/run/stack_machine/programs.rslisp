(use stack_machine/instruction push-op add-op sub-op mul-op dup-op swap-op over-op jump-op jump-if-zero-op print-op halt-op)

(export countdown factorial underflowing million-steps)

(defn countdown ()
  (vec (push-op 5)
       (dup-op)
       (jump-if-zero-op 8)
       (dup-op)
       (print-op)
       (push-op 1)
       (sub-op)
       (jump-op 1)
       (halt-op)))

(defn factorial ()
  (vec (push-op 10)
       (push-op 1)
       (over-op)
       (jump-if-zero-op 11)
       (over-op)
       (mul-op)
       (swap-op)
       (push-op 1)
       (sub-op)
       (swap-op)
       (jump-op 2)
       (halt-op)))

(defn underflowing ()
  (vec (push-op 1)
       (add-op)
       (halt-op)))

(defn million-steps ()
  (vec (push-op 7)
       (push-op 8)
       (sub-op)
       (push-op 199999)
       (dup-op)
       (jump-if-zero-op 9)
       (push-op 1)
       (sub-op)
       (jump-op 4)
       (halt-op)))
