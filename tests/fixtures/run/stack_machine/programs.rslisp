(use stack_machine/instruction instruction)

(export countdown factorial underflowing million-steps)

(defn countdown ()
  (vec (instruction/push 5)
       instruction/dup
       (instruction/jump-if-zero 8)
       instruction/dup
       instruction/print
       (instruction/push 1)
       instruction/sub
       (instruction/jump 1)
       instruction/halt))

(defn factorial ()
  (vec (instruction/push 10)
       (instruction/push 1)
       instruction/over
       (instruction/jump-if-zero 11)
       instruction/over
       instruction/mul
       instruction/swap
       (instruction/push 1)
       instruction/sub
       instruction/swap
       (instruction/jump 2)
       instruction/halt))

(defn underflowing ()
  (vec (instruction/push 1)
       instruction/add
       instruction/halt))

(defn million-steps ()
  (vec (instruction/push 7)
       (instruction/push 8)
       instruction/sub
       (instruction/push 199999)
       instruction/dup
       (instruction/jump-if-zero 9)
       (instruction/push 1)
       instruction/sub
       (instruction/jump 4)
       instruction/halt))
