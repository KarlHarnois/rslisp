(defn even? (n) (= (rem n 2) 0))

(defn main ()
  (println (reduce (range 1 1000001)
                   0
                   (fn (total n) (+ total n))))
  (local numbers (collect (range 1 11)))
  (local evens
    (collect (filter (copied numbers)
                     (fn (n) (even? n)))))
  (for-each (copied evens)
            (fn (n) (println n))))
