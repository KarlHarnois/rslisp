(defn main ()
  (let numbers (vec 1 2 3 4))
  (println (sum (values numbers)))
  (println (count (iter numbers)))
  (println (unwrap-or (max (values numbers)) 0))
  (println (unwrap-or (min (values numbers)) 0))
  (println (unwrap-or (max-by-key (values numbers) (fn (n) (- n))) 0))
  (println (any (values numbers) (fn (n) (= n 3))))
  (println (all (values numbers) (fn (n) (< n 5))))
  (println (unwrap-or (find (values numbers) (fn (n) (= n 2))) 0))
  (println (len (collect (take (values numbers) 2))))
  (println (len (collect (take-while (values numbers) (fn (n) (< n 3)))))))
