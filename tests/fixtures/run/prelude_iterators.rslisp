(defn main ()
  (local numbers (vec 1 2 3 4))
  (println (sum (copied numbers)))
  (println (count (iter numbers)))
  (println (unwrap-or (max (copied numbers)) 0))
  (println (unwrap-or (min (copied numbers)) 0))
  (println (unwrap-or (max-by-key (copied numbers)
                                  (fn (n) (- n)))
                      0))
  (println (any? (copied numbers) (fn (n) (= n 3))))
  (println (every? (copied numbers)
                   (fn (n) (< n 5))))
  (println (unwrap-or (find (copied numbers) (fn (n) (= n 2)))
                      0))
  (println (len (collect (take (copied numbers) 2))))
  (println (len (collect (take-while (copied numbers)
                                     (fn (n) (< n 3)))))))
