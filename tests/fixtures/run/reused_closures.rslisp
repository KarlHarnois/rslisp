(defstruct person
  :name string
  :age i64)

(defn apply-to-ten (f) (f 10))

(defn greet-with (f) (f "hello"))

(defn duplicate (value) (clone value))

(defn main ()
  (local offset 5)
  (local shift (fn (x) (+ x offset)))
  (println (apply-to-ten shift))
  (println (apply-to-ten shift))
  (local name (str "Ada"))
  (local greet
    (fn (greeting) (str greeting ", " name)))
  (println (greet-with greet))
  (println (greet-with greet))
  (println name)
  (local ada (->person (duplicate name) 36))
  (local twin (duplicate ada))
  (println (:name twin))
  (println (duplicate 7)))
