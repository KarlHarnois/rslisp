(defstruct person (name string) (age i64))

(defn apply-to-ten (f) (f 10))
(defn greet-with (f) (f "hello"))
(defn duplicate (value) (clone value))

(defn main ()
  (let offset 5)
  (let shift (fn (x) (+ x offset)))
  (println (apply-to-ten shift))
  (println (apply-to-ten shift))
  (let name (to-string "Ada"))
  (let greet (fn (greeting) (str greeting ", " name)))
  (println (greet-with greet))
  (println (greet-with greet))
  (println name)
  (let ada (make-person (duplicate name) 36))
  (let twin (duplicate ada))
  (println (person-name twin))
  (println (duplicate 7)))
