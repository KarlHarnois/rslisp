(defstruct car
  :make str
  :model str
  :year u16
  :electric? bool)

(defstruct user
  :name str
  :tags (vec string))

(defn main ()
  (local leaf (->car "Nissan" "Leaf" 2024 true))
  (local civic (->car "Honda" "Civic" 2019 false))
  (local cars (vec leaf civic))
  (println (:year leaf))
  (prn (collect (map (iter cars) :year)))
  (local users
    (vec (->user "ana" (vec (str "admin")))
         (->user "bo" (vec))))
  (prn (collect (map users :name)))
  (local someone
    (->user "cy"
            (vec (str "ops") (str "dev"))))
  (println (len (:tags someone)))
  (println (:name someone)))
