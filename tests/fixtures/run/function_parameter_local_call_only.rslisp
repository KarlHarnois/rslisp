(type apply
  (fn ((fn ((ref str)) (ref str)))
    (ref str)))

(defn apply (pick)
  (local owned (str "Leaf"))
  (if (= (pick (as-str owned)) "Leaf")
    (pick "Nissan")
    "none"))

(type first-word
  (fn ((ref str)) (ref str)))

(defn first-word (text) text)

(defn main ()
  (println (apply first-word)))
