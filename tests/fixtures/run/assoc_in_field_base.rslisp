(defstruct point
  :x i64
  :y i64)

(defstruct badge
  :text string
  :at point)

(defstruct garage
  :name string
  :badge badge)

(defn main ()
  (local g
    (->garage (str "Leaf Garage")
              (->badge (str "open") (->point 0 0))))
  (println (:name g))
  (local moved
    (assoc-in (:badge g) (:at :x) 4))
  (println (:text moved)
           " "
           (:x (:at moved))
           " "
           (:y (:at moved))))
