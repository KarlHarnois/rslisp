(defn main ()
  (println (unwrap-ok ((fn ((left (ref str)) (right (ref str)))
                         (local (a i64) (try (parse left)))
                         (local (b i64) (try (parse right)))
                         (ok (+ a b)))
                       "2" "3")))
  (println (err? ((fn ((text (ref str)))
                    (local (value i64) (try (parse text)))
                    (ok value))
                  "x"))))
