(defn twice (action)
  (action)
  (action))

(defn keep (model) model)

(defn main ()
  (local model (str "Leaf"))
  (local count 0)
  (local make-counter
    (fn ()
      (keep model)
      (fn () (set! count (+ count 1)))))
  (local counter (make-counter))
  (twice counter)
  (println (str count)))
