(trait label
  (label (fn ((ref self)) string)))

(impl label i64
  (label (number) (str number)))

(impl label string
  (label (text) (str text)))

(impl label (vec i64)
  (label (numbers) (pr-str numbers)))

(defn make-numbers () (vec 1 2 3))

(defn main ()
  (println (label 3))
  (local name (str "Ada"))
  (println (label name))
  (println (label (make-numbers))))
