(defstruct car :make str :year u16)

(defn first ((s (ref str))) (len s))

(defn fleet () (vec (->car "Nissan" 2025) (->car "Leaf" 2019)))

(defn fill! ((out (mut (vec (ref str)))) (name (ref str)))
  (let pick (fn ((s (ref str))) s))
  (push! out (pick name)))

(defn count-names ((name string))
  (let pick (fn ((s (ref str))) s))
  (let out (vec "Leaf"))
  (push! out (pick (as-str name)))
  (len out))

(defn main ()
  (println (first "Nissan"))
  (let first (fn ((s (ref str))) s))
  (println (first "Leaf"))
  (let first (fn ((s (ref str))) s))
  (println (first "Ariya"))
  (do (let model (to-string "Ariya")) (first (as-str model)))
  (do (let model (to-string "Nissan")) (let shown (first (as-str model))) (println shown))
  (let earlier (to-string "Ariya"))
  (let names (vec "Leaf"))
  (let later (to-string "Nissan"))
  (push! names (first (as-str earlier)))
  (push! names (first (as-str later)))
  (fill! names "Leaf")
  (println (len names) (count-names (to-string "Ariya")))
  (let length (do (let model (to-string "Ariya")) (let picked (first (as-str model))) (len picked)))
  (let long (if (do (let model (to-string "Ariya")) (let picked (first (as-str model))) (> (len picked) 2)) "yes" "no"))
  (println (do (let model (to-string "Ariya")) (len (first (first (as-str model))))))
  (println length long)
  (let cars (fleet))
  (let year-of (fn ((leaf (ref car))) (ref (:year leaf))))
  (println (sum (map (iter cars) (fn (c) (deref (year-of c))))))
  (let make-of (fn ((c (ref car))) (let inner (fn ((d (ref car))) (:make d))) (inner c)))
  (println (make-of (at cars 1)))
  (let skip (fn ((model (ref str)) (n usize)) (if (= n 0) model (recur model (- n 1)))))
  (println (skip "Ariya" 3)))
