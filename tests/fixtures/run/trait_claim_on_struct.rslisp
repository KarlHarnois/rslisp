(rust-trait record-eq "PartialEq" employee)

(def same-record?
  (rust "{0} == {1}"
    (where ((a record-eq))
      (fn ((ref a) (ref a)) bool))))

(defstruct employee
  :name string
  :score u32)

(defn main ()
  (local first-hire (->employee (str "Ada") 91))
  (local second-hire (->employee (str "Bram") 78))
  (println (same-record? first-hire second-hire)))
