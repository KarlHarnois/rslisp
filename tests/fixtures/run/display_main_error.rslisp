(enum app-error
  (bad-input string)
  (missing))

(display app-error (error)
  (match error
    ((bad-input message) (str "bad input: " message))
    (missing "missing")))

(type fail (fn (bool) (result unit app-error)))
(defn fail (missing?)
  (if missing?
      (err app-error/missing)
      (err (app-error/bad-input (to-string "oops")))))

(type main (fn () (result unit app-error)))
(defn main () (fail true))
