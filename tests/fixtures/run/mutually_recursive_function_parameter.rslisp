(defstruct car :make str :year u16)

(type build-at-dealer (fn ((fn ((ref str) u16) car) u16) car))
(defn build-at-dealer (constructor count)
  (if (= count 0)
    (constructor "Nissan" 2024)
    (if (= (rem count 4) 1)
      (build-at-depot constructor (- count 1))
      (if (= (rem count 4) 2)
        (build-at-factory constructor (- count 1))
        (if (= (rem count 4) 3)
          (build-at-port constructor (- count 1))
          (build-at-yard constructor (- count 1)))))))

(type build-at-depot (fn ((fn ((ref str) u16) car) u16) car))
(defn build-at-depot (constructor count)
  (if (= count 0)
    (constructor "Nissan" 2024)
    (if (= (rem count 4) 1)
      (build-at-dealer constructor (- count 1))
      (if (= (rem count 4) 2)
        (build-at-factory constructor (- count 1))
        (if (= (rem count 4) 3)
          (build-at-port constructor (- count 1))
          (build-at-yard constructor (- count 1)))))))

(type build-at-factory (fn ((fn ((ref str) u16) car) u16) car))
(defn build-at-factory (constructor count)
  (if (= count 0)
    (constructor "Nissan" 2024)
    (if (= (rem count 4) 1)
      (build-at-dealer constructor (- count 1))
      (if (= (rem count 4) 2)
        (build-at-depot constructor (- count 1))
        (if (= (rem count 4) 3)
          (build-at-port constructor (- count 1))
          (build-at-yard constructor (- count 1)))))))

(type build-at-port (fn ((fn ((ref str) u16) car) u16) car))
(defn build-at-port (constructor count)
  (if (= count 0)
    (constructor "Nissan" 2024)
    (if (= (rem count 4) 1)
      (build-at-dealer constructor (- count 1))
      (if (= (rem count 4) 2)
        (build-at-depot constructor (- count 1))
        (if (= (rem count 4) 3)
          (build-at-factory constructor (- count 1))
          (build-at-yard constructor (- count 1)))))))

(type build-at-yard (fn ((fn ((ref str) u16) car) u16) car))
(defn build-at-yard (constructor count)
  (if (= count 0)
    (constructor "Nissan" 2024)
    (if (= (rem count 4) 1)
      (build-at-dealer constructor (- count 1))
      (if (= (rem count 4) 2)
        (build-at-depot constructor (- count 1))
        (if (= (rem count 4) 3)
          (build-at-factory constructor (- count 1))
          (build-at-port constructor (- count 1)))))))

(defn main ()
  (let model (to-string "Leaf"))
  (let borrowing (fn (make year) (->car :make (as-str model) :year year)))
  (let built (build-at-dealer borrowing 7))
  (println (:make built) " " (:year built)))
