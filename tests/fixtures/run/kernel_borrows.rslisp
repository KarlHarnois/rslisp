(def bump!
  (rust "*{0} += 1" (fn ((mut i64)) unit)))

(defstruct counter
  :count i64)

(type peek (fn ((ref i64)) i64))

(defn peek (x) (deref x))

(defn main ()
  (local n 3)
  (local r (ref n))
  (println (peek r))
  (local m (mut n))
  (bump! m)
  (println n)
  (local c (->counter 3))
  (println (peek (ref (field c count))))
  (local r (ref c))
  (println (peek (ref (field r count)))))
