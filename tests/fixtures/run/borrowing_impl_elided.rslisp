(defstruct car :make str :year u16)

(trait badged
  (badge (fn (i64 (ref self)) (ref str)))
  (pick (fn ((ref str) (ref self)) (ref str)))
  (make (fn ((ref self)) (ref str))))

(impl badged car
  (badge (year c) (if (> year 2020) (:make c) "classic"))
  (pick (fallback c) (if (> (:year c) 2020) (:make c) fallback))
  (make (self) (:make self)))

(defn main ()
  (let leaf (->car :make "Nissan" :year 2024))
  (println (badge 2024 (ref leaf)))
  (println (pick "classic" (ref leaf)))
  (println (make (ref leaf))))
