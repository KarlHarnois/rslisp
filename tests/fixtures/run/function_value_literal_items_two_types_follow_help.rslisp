(type small?
  (where ((a partial-ord number))
         (fn (a) bool)))

(defn small? (b) (< b 10))

(defn main ()
  (let bytes
    (the (vec u8) (vec 3 7 12 4)))
  (let readings
    (the (vec u16) (vec 3 30)))
  (println (count (take-while (iter bytes) small?)))
  (println (count (take-while (iter readings) small?))))
