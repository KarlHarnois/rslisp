(defn record-through-alias (record year)
  (local step (fn (n) (record n)))
  (local again step)
  (again year)
  (again (+ year 1)))

(defn record-through-alias-once (record year)
  (local step (fn (n) (record n)))
  (local again step)
  (again year))

(defn twice (action year)
  (action year)
  (action (+ year 1)))

(defn record-alias-through-twice (record year)
  (local step (fn (n) (record n)))
  (local again step)
  (twice again year))

(defn main ()
  (local years (vec 2024))
  (record-through-alias (fn (year) (push! years year))
                        2025)
  (record-through-alias-once (fn (year) (push! years year))
                             2027)
  (record-alias-through-twice (fn (year) (push! years year))
                              2028)
  (println (len years)))
