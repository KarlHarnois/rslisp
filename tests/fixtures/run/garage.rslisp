(defstruct car
  :make str
  :model str
  :year u16
  :electric? bool)

(defstruct garage
  :owner str
  :cars (vec car))

(defn describe (vehicle)
  (str (:year vehicle) " " (:make vehicle) " " (:model vehicle)
       (if (:electric? vehicle) " (electric)" "")))

(defn main ()
  (let leaf (->car :make "Nissan" :model "Leaf" :year 2024 :electric? true))
  (let civic (->car "Honda" "Civic" 2019 false))
  (let build ->car)
  (let golf (build "Volkswagen" "Golf" 2021 false))
  (let mine (->garage "karl" (vec leaf civic golf)))
  (println (:owner mine) "'s garage:")
  (for-each (iter (:cars mine)) (fn (vehicle) (println (describe vehicle))))
  (println (describe (assoc civic (year 2020))))
  (let newest (max (map (iter (:cars mine)) :year)))
  (println "newest: " (unwrap newest)))
