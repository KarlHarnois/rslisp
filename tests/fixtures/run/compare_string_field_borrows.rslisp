(defstruct car
  :model string
  :year i64)

(defn main ()
  (local model (str "Leaf"))
  (local other (str "Civic"))
  (local leaf (->car :model (str "Leaf") :year 2024))
  (local civic (->car :model (str "Civic") :year 2019))
  (println (= (ref (:model leaf)) (ref model)))
  (println (= (ref model) (ref (:model leaf))))
  (println (= (ref (:model leaf))
              (ref (:model civic))))
  (println (= (ref model) (ref other)))
  (println (not= (ref (:model leaf)) (ref model)))
  (println (not= (ref model) (ref (:model leaf))))
  (println (not= (ref (:model leaf))
                 (ref (:model civic))))
  (println (not= (ref model) (ref other)))
  (println (> (ref (:model leaf)) (ref model)))
  (println (> (ref model) (ref (:model leaf))))
  (println (> (ref (:model leaf))
              (ref (:model civic))))
  (println (> (ref model) (ref other))))
