(defstruct user :name str :email str :admin? bool (defaults :admin? false))
(defstruct client :host str :retries u8 (defaults :retries 3))
(defstruct basket :owner str :items (vec i64) (defaults :items (vec)))

(defn main ()
  (let ana (->user :name "ana" :email "ana@example.org"))
  (let root (->user :name "root" :email "root@example.org" :admin? true))
  (let sam (->user "sam" "sam@example.org" false))
  (let local (->client :host "localhost"))
  (let first-basket (->basket :owner "ana"))
  (let second-basket (->basket :owner "sam"))
  (push! (:items first-basket) 7)
  (println (:admin? ana))
  (println (:admin? root))
  (println (:name sam))
  (println (:retries local))
  (println (len (:items first-basket)))
  (println (len (:items second-basket))))
