(defstruct user
  :name str
  :email str
  :admin? bool
  (defaults :admin? false))

(defstruct client
  :host str
  :retries u8
  (defaults :retries 3))

(defstruct basket
  :owner str
  :items (vec i64)
  (defaults :items (vec)))

(defn main ()
  (local ana (->user :name "ana" :email "ana@example.org"))
  (local root
    (->user :name "root" :email "root@example.org" :admin? true))
  (local sam (->user "sam" "sam@example.org" false))
  (local owned (->client :host "localhost"))
  (local first-basket (->basket :owner "ana"))
  (local second-basket (->basket :owner "sam"))
  (push! (:items first-basket) 7)
  (println (:admin? ana))
  (println (:admin? root))
  (println (:name sam))
  (println (:retries owned))
  (println (len (:items first-basket)))
  (println (len (:items second-basket))))
