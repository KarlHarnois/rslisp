(defstruct point :x i64 :y i64)

(defstruct badge :text string :at point)

(defstruct garage :name string :badge badge)

(defn shift (g)
  (println (:name g))
  (assoc-in (:badge g) (:at :x) 4))

(defn main ()
  (let moved (shift (->garage (to-string "Leaf Garage") (->badge (to-string "open") (->point 0 0)))))
  (println (:text moved) " " (:x (:at moved)) " " (:y (:at moved))))
