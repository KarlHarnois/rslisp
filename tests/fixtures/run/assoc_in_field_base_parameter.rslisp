(defstruct point
  :x i64
  :y i64)

(defstruct badge
  :text string
  :at point)

(defstruct garage
  :name string
  :badge badge)

(defn shift (g)
  (println (:name g))
  (assoc-in (:badge g) (:at :x) 4))

(defn main ()
  (local moved
    (shift (->garage (str "Leaf Garage")
                     (->badge (str "open") (->point 0 0)))))
  (println (:text moved)
           " "
           (:x (:at moved))
           " "
           (:y (:at moved))))
