(use puzzles/support/text parse-integer)

(export solve-rations)

(def packing-list
  "1200\n800\n\n3100\n\n450\n900\n1500\n\n2000\n2200\n\n700")

(def podium-size 3)

(defn solve-rations ()
  (local totals (group-totals packing-list))
  (println (str "largest group: " (largest-total totals)))
  (println (str "top three groups: " (podium-total totals))))

(defn group-totals (packing)
  (collect (map (split packing "\n\n")
                (fn (group) (group-total group)))))

(defn group-total (group)
  (sum (map (lines group) parse-integer)))

(defn largest-total (totals)
  (unwrap-or (max (copied totals)) 0))

(defn podium-total (totals)
  (sort-descending totals)
  (sum (take (copied totals) podium-size)))

(defn sort-descending ((items (mut (vec i64))))
  (sort-by! items (fn (value) (- value))))
