(export ord slice deref expect windows at element item-at count sum maximum take any
        sort sort-descending sort-by-key dedup max-by-key)

(rust-trait ord "Ord" char string (ref str) i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize)
(rust-type slice (where (item) "[{0}]"))

(def deref (rust "*{0}" (where ((a copy)) (fn ((ref a)) a))))
(def expect (rust "{0}.expect({1})" (where (a) (fn ((option a) (ref str)) a))))

(def windows (rust "{0}.windows({1})" (where (a) (fn ((ref (vec a)) usize) (iterator (ref (slice a)))))))
(def at (rust "{0}[{1}]" (where ((a copy)) (fn ((ref (slice a)) usize) a))))
(def element (rust "&{0}[{1}]" (where (a) (fn ((ref (vec a)) usize) (ref a)))))
(def item-at (rust "{0}[{1}]" (where ((a copy)) (fn ((ref (vec a)) usize) a))))

(def count (rust "{0}.count()" (where (a) (fn ((iterator a)) usize))))
(def maximum (rust "{0}.max()" (where ((a ord)) (fn ((iterator a)) (option a)))))
(def take (rust "{0}.take({1})" (where (a) (fn ((iterator a) usize) (iterator a)))))
(def any (rust "{0}.any({1})" (where (a) (fn ((iterator a) (fn (a) bool)) bool))))
(def max-by-key (rust "{0}.max_by_key({1})" (where (a (k ord)) (fn ((iterator a) (fn ((ref a)) k)) (option a)))))

(type sum (where ((n number)) (fn ((iterator n)) n)))
(defn sum (numbers) (fold numbers 0 add))

(def sort (rust "{0}.sort()" (where ((a ord)) (fn ((mut (vec a))) unit))))
(def sort-descending (rust "{0}.sort_unstable_by(|a, b| b.cmp(a))" (where ((a ord)) (fn ((mut (vec a))) unit))))
(def sort-by-key (rust "{0}.sort_by_key({1})" (where (a (k ord)) (fn ((mut (vec a)) (fn ((ref a)) k)) unit))))
(def dedup (rust "{0}.dedup()" (where ((a partial-eq)) (fn ((mut (vec a))) unit))))
