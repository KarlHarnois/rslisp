(use code concat list rest take)

(def print-branches
  (macro (form)
    (local base (list 1 2))
    (local longer (concat base (list 3)))
    (local other (concat base (list 4)))
    (local grown
      (concat (rest longer) (list 5)))
    (local shorter (take 1 longer))
    (concat (list (quote println))
            base
            (list " ")
            longer
            (list " ")
            other
            (list " ")
            grown
            (list " ")
            shorter
            (list " ")
            (concat shorter (list 6)))))

(defn main () (print-branches))
