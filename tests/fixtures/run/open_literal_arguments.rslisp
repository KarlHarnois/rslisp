(defn twice (x) (pair x x))
(defn both (a b) (pair a b))
(defn larger (a b) (if (> a b) a b))
(defn same (x) x)
(defn call-it (f) (f))
(defn shown (x) (prn x) x)
(defn wrap (x) (some x))
(defn first-of (a b) (wrap b) a)

(trait weighed
  (weight-of (fn ((ref self)) i64)))

(struct crate (weight i64))
(impl weighed crate
  (weight-of (c) (field c weight)))

(defn any-big? (values)
  (some? (find values (fn (value) (> (deref (first-of value 3000000000)) 1)))))

(type total-weight (fn ((vec (box weighed))) i64))
(defn total-weight (crates)
  (fold crates 0 (fn (total item) (+ total (weight-of item)))))

(defn main ()
  (let several? (> (len (command-line-args)) 5))
  (let odometer (the i64 2024))
  (let-pair (left right) (twice 3000000000) (println left " " right))
  (prn (twice 2.5))
  (prn (twice -3000000000))
  (prn (both 3000000000 4000000000))
  (prn (both odometer 3000000000))
  (println (larger 3000000000 1))
  (prn (twice (twice 3000000000)))
  (println (+ (same 3000000000) 1))
  (println (+ 1 (same 3000000000)))
  (prn (twice (if several? 1 3000000000)))
  (prn (twice (do 3000000000)))
  (prn (twice (match several? (true 1) (false 3000000000))))
  (prn (twice (some 3000000000)))
  (prn (call-it (fn () 3000000000)))
  (match (wrap 3000000000) ((some miles) (prn miles)) (none (do)))
  (shown 3000000000)
  (let add-one (fn (n) (+ n 1)))
  (println (add-one (first-of 1 3000000000)))
  (println (unwrap-ok ((fn ((text (ref str)))
                         (let (code i64) (try (first-of (parse text) 3000000000)))
                         (ok code))
                       "7")))
  (println (any-big? (range 1 3)))
  (println (total-weight (vec (box-new (first-of (new crate (weight 4)) 3000000000)))))
  (prn (assoc-at (first-of (vec 7 8) 3000000000) (0) 6))
  (prn (assoc-at (vec 7 8) ((first-of 0 3000000000)) 6))
  (prn (assoc-at (vec 7 8) (0) (first-of 6 3000000000)))
  (prn (twice "Leaf"))
  (prn (both "Leaf" 2.5))
  (println (larger 2.5 1.5))
  (println (same "Leaf"))
  (prn (call-it (fn () "Leaf")))
  (prn (wrap "Leaf"))
  (shown "Leaf")
  (do))
