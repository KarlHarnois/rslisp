(defn size (items) (len items))
(defn sizes (grid) (collect (map (iter grid) (fn (row) (size row)))))
(type owned-size (where ((collection sequence)) (fn (collection) usize)))
(defn owned-size (collection) (len collection))
(defn main ()
  (let grid (vec (vec 1 2 3) (vec 4 5)))
  (let models (vec (to-string "Leaf") (to-string "Ariya")))
  (prn (sizes grid))
  (prn (sizes models))
  (prn (collect (map (iter grid) (fn (row) (owned-size row))))))
