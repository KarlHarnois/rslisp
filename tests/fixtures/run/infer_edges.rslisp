(defstruct point
  :x i64
  :y i64)

(defrule types-of
  ((value) (str (infer value) " " (infer (pair value none)))))

(def text (infer (->point 1 2)))

(defn main ()
  (println (infer (->point 1 2)))
  (println (types-of 1.5))
  (println (types-of "Leaf"))
  (println text)
  (println (infer (infer (vec 1)))))
