(use stack_machine/machine run)
(use stack_machine/programs countdown factorial underflowing million-steps)

(type report (fn ((ref str) (result i64 string)) unit))
(defn report (name outcome)
  (match outcome
    ((ok value) (println (str name ": " value)))
    ((err message) (println (str name " failed: " message)))))

(defn main ()
  (report "countdown" (run (countdown)))
  (report "factorial" (run (factorial)))
  (report "underflowing" (run (underflowing)))
  (report "million-steps" (run (million-steps))))
