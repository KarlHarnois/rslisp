(use calculator/lexer tokenize token-kind token-text)
(use calculator/parser evaluate)

(defn main ()
  (calculate "12 + 3 * (4 - 1)")
  (calculate "2 * (3 + 4) - 10 / 5")
  (calculate "7 % 2"))

(defn calculate (source)
  (let outcome (tokenize source))
  (if (ok? outcome)
      (report (unwrap-ok outcome))
      (println (str "error: " (unwrap-err (map-ok outcome (fn (tokens) (do))))))))

(defn report (tokens)
  (for-each (iter tokens) (fn (t) (println (str (token-kind t) " " (token-text t)))))
  (println (str "= " (evaluate tokens))))
