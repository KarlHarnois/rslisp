(defstruct badge
  :text string
  :size u16)

(defstruct garage
  :name string
  :badge badge)

(defn main ()
  (local g
    (->garage (str "Leaf Garage")
              (->badge (str "open") 12)))
  (local b (assoc (:badge g) :size 14))
  (println (:text b)
           " "
           (:size b)
           " "
           (:size (:badge g))
           " "
           (:name g))
  (local k
    (->garage (str "Leaf Depot")
              (->badge (str "shut") 9)))
  (local h (assoc k :name (str "x")))
  (println (:name h)
           " "
           (:size (:badge h))
           " "
           (:name k)))
