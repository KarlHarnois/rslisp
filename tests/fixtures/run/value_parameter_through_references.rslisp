(defstruct employee :name string :score u32)

(defn high? (person) (> (employee-score person) 80))
(defn big? (n) (> n 2))

(defn main ()
  (let people (vec (make-employee (to-string "Ada") 91) (make-employee (to-string "Bo") 70)))
  (let numbers (vec 1 2 3))
  (println (count (filter (iter people) (fn (person) (high? person)))))
  (println (count (filter (iter numbers) (fn (n) (big? n))))))
