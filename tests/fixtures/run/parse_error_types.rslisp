(defn show-number (text)
  (local (parsed (result i64 _))
    (parse text))
  (if (ok? parsed)
    (str (unwrap-ok parsed))
    (str "error")))

(defn show-float (text)
  (local (parsed (result f64 _))
    (parse text))
  (if (ok? parsed)
    (str (unwrap-ok parsed))
    (str "error")))

(defn show-bool (text)
  (local (parsed (result bool _))
    (parse text))
  (if (ok? parsed)
    (str (unwrap-ok parsed))
    (str "error")))

(defn show-char (text)
  (local (parsed (result char _))
    (parse text))
  (if (ok? parsed)
    (str (unwrap-ok parsed))
    (str "error")))

(defn main ()
  (println (show-number "42"))
  (println (show-number "nope"))
  (println (show-float "2.5"))
  (println (show-bool "true"))
  (println (show-char "x"))
  (println (show-char "xy")))
