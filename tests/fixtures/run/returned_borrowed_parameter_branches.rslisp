(defn counted-first (years)
  (at (do (let count (len years)) (println count) years) 0))

(defn first-by-length (years)
  (first (match (len years) (0 years) (_ years))))

(defn noted-first (years)
  (at (do (println "noting") years) 0))

(defn checked-first (years)
  (at (if (> (len years) 1) years years) 0))

(defn main ()
  (let years (vec 2019 2021))
  (prn (counted-first years))
  (prn (first-by-length years))
  (prn (noted-first years))
  (prn (checked-first years)))
