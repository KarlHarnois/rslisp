(use calculator/lexer token)

(export evaluate)

(defstruct parsed (value i64) (next usize))

(defn evaluate (tokens)
  (then-ok (parse-expression tokens 0) (fn (result) (expect-end tokens result))))

(defn expect-end (tokens result)
  (if (= (parsed-next result) (len tokens))
      (ok (parsed-value result))
      (err (str "unexpected token at " (parsed-next result)))))

(type parse-expression (fn ((ref (vec token)) usize) (result parsed string)))
(defn parse-expression (tokens position)
  (then-ok (parse-term tokens position) (fn (left) (parse-sums tokens left))))

(defn parse-sums (tokens left)
  (let next (parsed-next left))
  (match (get tokens next)
    ((some (symbol text))
     (match (as-str text)
       ("+" (then-ok (parse-term tokens (+ next 1)) (fn (right) (parse-sums tokens (combine left right add)))))
       ("-" (then-ok (parse-term tokens (+ next 1)) (fn (right) (parse-sums tokens (combine left right sub)))))
       (_ (ok left))))
    (_ (ok left))))

(defn parse-term (tokens position)
  (then-ok (parse-factor tokens position) (fn (left) (parse-products tokens left))))

(defn parse-products (tokens left)
  (let next (parsed-next left))
  (match (get tokens next)
    ((some (symbol text))
     (match (as-str text)
       ("*" (then-ok (parse-factor tokens (+ next 1)) (fn (right) (parse-products tokens (combine left right mul)))))
       ("/" (then-ok (parse-factor tokens (+ next 1)) (fn (right) (divide tokens left right))))
       (_ (ok left))))
    (_ (ok left))))

(defn divide (tokens left right)
  (if (= (parsed-value right) 0)
      (err (to-string "division by zero"))
      (parse-products tokens (combine left right div))))

(defn parse-factor (tokens position)
  (match (get tokens position)
    ((some (symbol text))
     (match (as-str text)
       ("(" (then-ok (parse-expression tokens (+ position 1)) (fn (inner) (expect-close tokens inner))))
       (_ (err (str "expected a number at token " position)))))
    ((some (number text)) (ok (make-parsed (number-value text) (+ position 1))))
    (none (err (str "expected a number at token " position)))))

(defn expect-close (tokens inner)
  (let next (parsed-next inner))
  (match (get tokens next)
    ((some (symbol text))
     (match (as-str text)
       (")" (ok (make-parsed (parsed-value inner) (+ next 1))))
       (_ (err (str "expected `)` at token " next)))))
    (_ (err (str "expected `)` at token " next)))))

(defn combine (left right operator)
  (make-parsed (operator (parsed-value left) (parsed-value right)) (parsed-next right)))

(defn number-value (text)
  (let (parsed (result i64 _)) (parse (as-str text)))
  (if (ok? parsed) (unwrap-ok parsed) 0))
