(use calculator/lexer token)

(export evaluate)

(defstruct parsed (value i64) (next usize))

(defn evaluate (tokens)
  (parsed-value (parse-expression tokens 0)))

(type parse-expression (fn ((ref (vec token)) usize) parsed))
(defn parse-expression (tokens position)
  (parse-sums tokens (parse-term tokens position)))

(defn parse-sums (tokens left)
  (let next (parsed-next left))
  (match (get tokens next)
    ((some (symbol text))
     (match (as-str text)
       ("+" (parse-sums tokens (combine left (parse-term tokens (+ next 1)) add)))
       ("-" (parse-sums tokens (combine left (parse-term tokens (+ next 1)) sub)))
       (_ left)))
    (_ left)))

(defn parse-term (tokens position)
  (parse-products tokens (parse-factor tokens position)))

(defn parse-products (tokens left)
  (let next (parsed-next left))
  (match (get tokens next)
    ((some (symbol text))
     (match (as-str text)
       ("*" (parse-products tokens (combine left (parse-factor tokens (+ next 1)) mul)))
       ("/" (parse-products tokens (combine left (parse-factor tokens (+ next 1)) div)))
       (_ left)))
    (_ left)))

(defn parse-factor (tokens position)
  (match (get tokens position)
    ((some (symbol text))
     (match (as-str text)
       ("(" (skip-close-paren (parse-expression tokens (+ position 1))))
       (_ (make-parsed 0 (+ position 1)))))
    ((some (number text)) (make-parsed (number-value text) (+ position 1)))
    (none (make-parsed 0 (+ position 1)))))

(defn skip-close-paren (inner)
  (make-parsed (parsed-value inner) (+ (parsed-next inner) 1)))

(defn combine (left right operator)
  (make-parsed (operator (parsed-value left) (parsed-value right)) (parsed-next right)))

(defn number-value (text)
  (let (parsed (result i64 _)) (parse (as-str text)))
  (if (ok? parsed) (unwrap-ok parsed) 0))
