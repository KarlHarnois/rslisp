(type later? (where ((a partial-ord)) (fn (a a) bool)))
(defn later? (left right) (> left right))

(type leaf-count (fn ((ref (slice (ref str)))) usize))
(defn leaf-count (models)
  (count (filter (iter models) (fn (m) (= m "Leaf")))))

(type deref-leaf-count (fn ((ref (slice (ref str)))) usize))
(defn deref-leaf-count (models)
  (count (filter (iter models) (fn (m) (= (deref m) "Leaf")))))

(defn count-of (names wanted)
  (count (filter (iter names) (fn (n) (= n wanted)))))

(defn report-years (years)
  (let next (fn (y) (+ (deref y) 1)))
  (println (sum (map (iter years) next)))
  (let recent? (fn (y) (> (deref y) 2020)))
  (println (any (iter years) recent?))
  (let typed-recent? (fn ((y (ref (ref i64)))) (> (deref y) 2020)))
  (println (count (filter (iter years) typed-recent?))))

(defn main ()
  (let years (vec 2019 2021 2024))
  (report-years years)
  (println (count-of years 2021))
  (let x 5)
  (let y 3)
  (let r (ref x))
  (println (> r 3))
  (println (> 3 r))
  (println (later? (ref x) (ref y)))
  (let models (vec "Leaf" "Ariya"))
  (println (leaf-count models))
  (println (deref-leaf-count models))
  (let names (vec (to-string "Leaf") (to-string "Ariya")))
  (let wanted (to-string "Leaf"))
  (println (count-of names wanted))
  (println wanted))
