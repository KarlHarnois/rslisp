(use code escape-string escape-format string-strip-suffix string-strip-prefix)

(defmacro show-escape-string (form)
  (escape-string "brace { quote \" slash \\ newline\n"))

(defmacro show-escape-format (form)
  (escape-format "brace { quote \" slash \\ newline\n"))

(defmacro show-strip-suffix (form)
  (string-strip-suffix "brace { quote \" slash \\ newline\nEND" "END"))

(defmacro show-strip-prefix (form)
  (string-strip-prefix ":year" ":"))

(defmacro show-keep-prefix (form)
  (string-strip-prefix "year" ":"))

(def escaped-string (show-escape-string "unused"))
(def escaped-format (show-escape-format "unused"))
(def stripped-suffix (show-strip-suffix "unused"))
(def stripped-prefix (show-strip-prefix "unused"))
(def kept-prefix (show-keep-prefix "unused"))
