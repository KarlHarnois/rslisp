(use code nth)

(def pick-separate-quotes
  (macro (form)
    (local reference (quote picked))
    (template (do
                (local picked (unquote (nth form 1)))
                (unquote reference)))))

(def pick-passed
  (macro (form)
    (local name (quote picked))
    (template (do
                (local (unquote name)
                  (unquote (nth form 1)))
                (unquote (echo name))))))

(def echo (fn (name) name))

(defn main ()
  (println (pick-separate-quotes 2)))
