(def passes-another-argument
  (rust "measure({0}, {1})"
    (where ((a partial-ord)) (fn (a a) a))
    (ord "{0}.max({1})")))

(def without-binder
  (rust "measure({0})"
    (fn (i64) i64)
    (ord "count({0})")))

(def two-binders
  (rust "measure({0}, {1})"
    (where (a b) (fn (a b) a))
    (ord "count({0}, {1})")))

(def unknown-target
  (rust "measure({0})"
    (where (a) (fn (a) a))
    (nosuch "count({0})")))

(def trait-with-second-type
  (rust "measure({0})"
    (where (a) (fn (a) a))
    ((partial-eq i64) "count({0})")))
