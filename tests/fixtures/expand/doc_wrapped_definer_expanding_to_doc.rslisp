(use code module-notes add-module-note definition-symbol empty?)

(defmacro defn-once (name parameters body)
  (if (empty? (module-notes (definition-symbol (quote defn-once) "notes")
                            (quote defined)))
      (do (add-module-note (quote defined) name)
          (template (defn (unquote name) (unquote parameters)
                      (unquote body))))
      (template (doc-page (unquote name)))))

(defn-once twice (x) (* 2 x))

(def twice-page (doc-page twice))

(defmacro defn-once-into-header (name parameters body)
  (if (empty? (module-notes (definition-symbol (quote defn-once-into-header)
                                               "notes")
                            (quote headed)))
      (do (add-module-note (quote headed) name)
          (template (defn (unquote name) (unquote parameters)
                      (unquote body))))
      (template (header (unquote name)))))

(defn-once-into-header thrice (x) (* 3 x))

(def thrice-page (doc-page thrice))
