(defn add (:x i64 :y i64) (+ x y))
(defn twice (:x i64 :x i64) (+ x x))
(defn untyped-start (:x i64 i64) x)
(defn early (:x (defaults :x 1) :y) x)
(defn misspelled (:x (defaults :z 1)) x)

(defn main ()
  (add :x 6)
  (add :z 6 :y 7)
  (add :x 6 :x 7)
  (add :xx 6 :y 7)
  (add 1 2 3))

(defn apply-key (:key :label) (key label))

(defn apply-name ()
  (apply-key :name "x"))
