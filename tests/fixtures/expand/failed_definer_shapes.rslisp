(use code fail)
(use prelude/macros header-shape)

(defmacro defpair (left right)
  (fail "defpair is not ready" left))

(header-shape (defpair left right))

(defmacro defone (name extra)
  (fail "defone is not ready" name))

(header-shape (defone name))

(defmacro defbare (name) (fail "defbare is not ready" name))

(defone first-thing second-thing)

(defbare third-thing)

(defn main ()
  (first-thing)
  (second-thing)
  (third-thing))
