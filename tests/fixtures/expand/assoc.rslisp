(defstruct point
  :x i64
  :y i64)

(defn bump (p) (assoc p :x 1))

(defn main ()
  (local grid (vec 1 2 3))
  (local next (assoc grid 1 9))
  (local rows (vec (vec 1 2) (vec 3 4)))
  (local changed (assoc-in rows (1 0) 9))
  (println (:x (bump (->point 1 2)))
           (at next 0)
           (len changed)))
