(defstruct car
  :make str
  :model str
  :year u16
  :electric? bool)

(def :model "Leaf")

(def rename (fn (:make) :make))

(defn describe (vehicle)
  (match vehicle (:year 0)))

(defn main ()
  (local leaf (->car "Nissan" "Leaf" 2024 true))
  (local civic (->car "Honda" "Civic" 2019 false))
  (println (:year leaf civic))
  (println (:year))
  (local :year 3)
  (println :year))
