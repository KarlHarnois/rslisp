(use notes/heron bird)

(use code add-module-note definition-symbol len module-notes
          nth)

(def remember-crane
  (macro (form)
    (add-module-note (quote sightings) "a crane")
    (quote (def remembered true))))

(def count-sightings
  (macro (form)
    (len (module-notes (definition-symbol (nth form 1) "notes")
                       (quote sightings)))))

(remember-crane)

(def pond "pond")

(def heron-sightings (count-sightings bird))

(def pond-sightings (count-sightings pond))
