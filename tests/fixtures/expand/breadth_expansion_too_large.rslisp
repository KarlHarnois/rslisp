(use code list concat number-sub number-le)

(def doubled
  (fn (items times)
    (if (number-le times 0) items (doubled (concat items items) (number-sub times 1)))))

(defmacro spread (form)
  (template (do (spread (unquote form)) (spread (unquote form)) (splice (doubled (list 0) 5)))))

(defn spreads ()
  (println (spread 1)))
