(use code add-module-note definition-symbol fail len
          module-notes nth string)

(def note-then-fail
  (macro (form)
    (add-module-note (quote sightings) "a heron")
    (fail "this sighting is unconfirmed" form)))

(def report-sightings
  (macro (form)
    (local notes
      (module-notes (definition-symbol (nth form 1) "notes")
                    (quote sightings)))
    (fail (string "sightings noted: " (len notes)) form)))

(def unconfirmed (note-then-fail))

(def bird "heron")

(def report (report-sightings bird))
