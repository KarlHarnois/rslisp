(use code list concat number-sub number-le)

(def doubled
  (fn (items times)
    (if (number-le times 0) items (doubled (concat items items) (number-sub times 1)))))

(defmacro pad ()
  (template (do (splice (doubled (list 0) 16)))))

(defmacro defs ()
  (template (do (def x (fn () (pad))) (defs) (defs))))

(defs)
