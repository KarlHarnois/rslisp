(use code add-module-note definition-symbol empty?
          module-notes)

(defmacro defn-once (name parameters body)
  (if (empty? (module-notes (definition-symbol (quote defn-once) "notes")
                            (quote defined)))
    (do
      (add-module-note (quote defined) name)
      (template (defn (unquote name) (unquote parameters)
                  (unquote body))))
    (template 0)))

(defn-once twice (x) (* 2 x))

(def twice-page (doc-page twice))

(defmacro documented-defn-once (name parameters docstring body)
  (if (empty? (module-notes (definition-symbol (quote documented-defn-once)
                                               "notes")
                            (quote documented)))
    (do
      (add-module-note (quote documented) name)
      (template (defn (unquote name) (unquote parameters)
                  (unquote docstring)
                  (unquote body))))
    (template 0)))

(documented-defn-once halve (x) "Halves." (/ x 2))

(def halve-page (doc-page halve))
