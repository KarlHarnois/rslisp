(use prelude/macros header-shape)

(defrule my-defn
  ((n p b ...)
   (defn n p
     b
     ...)))

(header-shape (my-defn name parameters) :documented)

(header-shape (my-defn name parameters)
              :docstring :docstring)

(header-shape (my-defn name parameters) "text")

(header-shape (my-defn name parameters) :docstring :doc)

(header-shape (my-defn name parameters)
              :documented :docstring)
