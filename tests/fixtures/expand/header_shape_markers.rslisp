(use prelude/macros header-shape)

(defrule my-defn
  ((n p b ...)
   (defn n p
     b ...)))

(header-shape (my-defn name parameters) :documented)

(header-shape (my-defn name parameters)
              :docstring :docstring)

(header-shape (my-defn name parameters) "text")

(header-shape (my-defn name parameters) :docstring :doc)

(header-shape (my-defn name parameters)
              :documented :docstring)

(header-shape (my-defn name parameters)
              :one-per-line :docstring)

(header-shape (my-defn name parameters)
              :one-per-line :one-per-line)

(header-shape (my-defn name parameters) :one-per-lin)

(header-shape (my-defn name parameters) :arm)

(header-shape (my-defn name parameters) :arms :arms)

(header-shape (my-defn name parameters)
              :arms :docstring
              :one-per-line)

(header-shape (my-defn name parameters) :binding)

(header-shape (my-defn name parameters) :bindings :bindings)

(header-shape (my-defn name parameters) :bindings :arms :docstring)
