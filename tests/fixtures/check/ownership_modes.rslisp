(defstruct person :name string :age i64)

(defn label (someone) (str (:name someone)))
(defn forward (someone) (label someone))
(defn keep (value) value)
(defn store (name) (->person name 3))
(defn first-name (someone) (:name someone))
(defn print-then-keep (someone) (println (:name someone)) (keep someone))
(defn add-one (n) (+ n 1))
(type explicit (fn ((ref person)) i64))
(defn explicit (someone) (:age someone))
