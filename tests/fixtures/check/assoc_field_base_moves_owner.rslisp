(defstruct badge :text string :size u16)

(defstruct garage :name string :badge badge)

(defn main ()
  (let garage (->garage (to-string "Leaf Garage") (->badge (to-string "open") 12)))
  (let bigger (assoc (:badge garage) :size 14))
  (let again garage)
  (println (:size bigger) " " (:name again)))
