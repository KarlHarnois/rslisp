(defstruct badge
  :text string
  :size u16)

(defstruct garage
  :name string
  :badge badge)

(defn main ()
  (local garage
    (->garage (str "Leaf Garage")
              (->badge (str "open") 12)))
  (local bigger (assoc (:badge garage) :size 14))
  (local again garage)
  (println (:size bigger) " " (:name again)))
