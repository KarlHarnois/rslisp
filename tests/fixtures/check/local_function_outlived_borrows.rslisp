(defn fill! ((out (mut (vec (ref str)))) (name string))
  (let pick (fn ((s (ref str))) s))
  (push! out (pick (as-str name))))

(defn main ()
  (let pick (fn ((s (ref str))) s))
  (let first (fn ((items (ref (vec i64)))) (at items 0)))
  (let flag (> (len "Leaf") 2))
  (let got (do (let name (to-string "Ariya")) (pick (as-str name))))
  (let temporary (pick (as-str (to-string "Ariya"))))
  (let year (first (vec 2019 2021)))
  (let inner (do (let ys (vec 2019 2021)) (first (ref ys))))
  (let held (some (pick (as-str (to-string "Leaf")))))
  (let branch (if flag (pick (as-str (to-string "Nissan"))) "Leaf"))
  (let years (vec 2019 2021))
  (let kept (first (ref years)))
  (let arm (match (some 1) ((some n) (pick (as-str (to-string "Leaf")))) (none "Ariya")))
  (let nested (do (let model (to-string "Leaf")) (match (some 1) ((some n) (pick (as-str model))) (none "Ariya"))))
  (let names (vec "Leaf"))
  (push! names (pick (as-str (to-string "Ariya"))))
  (set! (at names 0) (pick (as-str (to-string "Nissan"))))
  (let scrutinee (match (some (pick (as-str (to-string "Ariya")))) ((some n) n) (none "x")))
  (let through (do (let model (to-string "Ariya")) (let inner (pick (as-str model))) inner))
  (let kept-some (do (let model (to-string "Ariya")) (let held (some (pick (as-str model)))) (unwrap-or held "x")))
  (let add (fn ((item string)) (push! names (pick (as-str item)))))
  (add (to-string "Ariya"))
  (let store (fn (s) (push! names s)))
  (store (pick (as-str (to-string "Ariya"))))
  (fill! names (to-string "Nissan"))
  (pick (as-str (to-string "Leaf")))
  (some (do (let model (to-string "Leaf")) (pick (as-str model))))
  (do (let model (to-string "Leaf")) (push! names (pick (as-str model))))
  (do (let model (to-string "Leaf")) (let shown (pick (as-str model))) (println shown))
  (println (pick (as-str (to-string "Leaf"))))
  (println got temporary year inner kept branch arm nested scrutinee through kept-some (at names 0))
  (println (unwrap-or held "none")))
