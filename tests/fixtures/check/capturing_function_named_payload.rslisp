(defstruct car
  :make str
  :model str
  :year u16)

(enum rule
  (keep (struct (test (fn ((ref car)) bool))
                (label str)))
  skip)

(defn main ()
  (local cutoff 2020)
  (local recent
    (rule/keep (fn ((vehicle (ref car)))
                 (> (:year vehicle) cutoff))
               "recent"))
  (match recent
    ((keep test _)
     (println (test (->car "Nissan" "Leaf" 2024))))
    (skip (println "skipped"))))
