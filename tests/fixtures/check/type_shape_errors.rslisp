(defstruct point (x f64) (y f64))
(defstruct pixel (x i64) (y i64))

(defn read-x (thing) (field thing x))

(defn field-of-boolean () (field true x))

(defn self-apply (f) (f f))

(type nested-where (fn ((where (a) a)) i64))
(defn nested-where (value) 1)

(type with-arguments (fn ((point i64)) i64))
(defn with-arguments (value) 1)
