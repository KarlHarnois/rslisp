(defn forward ((text (ref str))) text)

(defn make ()
  (local text (str "hi"))
  (ref text))

(defn pick (flag)
  (local text (str "hi"))
  (if flag (ref text) (ref text)))

(defn nested ()
  (local text (str "hi"))
  (do (ref text)))

(enum choice yes no)

(defn choose (value)
  (local text (str "hi"))
  (match value
    (yes (ref text))
    (no (ref text))))

(defn main () (println (make)))
