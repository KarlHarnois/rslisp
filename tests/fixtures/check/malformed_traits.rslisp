(trait)
(trait shape-one area)
(trait shape-two (area))
(trait broken (area))
(trait not-a-function (probe i64))
(struct circle (radius f64))
(trait painted (area (fn ((ref self)) f64)))
(impl circle painted (area (c) (field c radius)))
(impl painted i64 (area (c) c))
(impl painted circle)
(impl painted circle area)
(impl painted circle (area))
(impl painted circle (nope (c) c))
(impl broken circle (anything (c) c))
