(enum marker (empty) full)

(enum shape
  (circle f64)
  (rect f64 f64)
  (labeled (struct (text string) (size f64)))
  point)

(defn main ()
  (local _ (shape/circle 1.0))
  (local _ (shape/rect 2.0 3.0))
  (local _ (shape/labeled (str "box") 2.0))
  (local _ shape/point)
  (local _ marker/empty)
  (do))
