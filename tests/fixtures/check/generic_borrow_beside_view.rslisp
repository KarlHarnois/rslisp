(type later?
  (where ((a partial-ord))
    (fn (a a) bool)))

(defn later? (a b) (> a b))

(defn view-first ()
  (let make "Nissan")
  (later? (ref make) "Honda"))

(defn view-last ()
  (let make "Nissan")
  (later? "Honda" (ref make)))

(defn string-first ()
  (let model (str "Leaf"))
  (later? (ref model) "Civic"))

(defn char-last ()
  (let grade (char "b"))
  (later? (char "a") (ref grade)))
