(defstruct user :name str :age u16)
(defstruct sorter :key (fn ((ref user)) u16) :label str)

(defn main ()
  (let bonus 2)
  (let key (fn ((someone (ref user))) (+ (:age someone) bonus)))
  (let a (new sorter (:key key) (:label "a")))
  (let b (new sorter (:key key) (:label "b")))
  (println (:label a))
  (println (:label b)))
