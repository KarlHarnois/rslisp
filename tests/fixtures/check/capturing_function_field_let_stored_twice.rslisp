(defstruct user
  :name str
  :age u16)

(defstruct sorter
  :key (fn ((ref user)) u16)
  :label str)

(defn main ()
  (local bonus 2)
  (local key
    (fn ((someone (ref user)))
      (+ (:age someone) bonus)))
  (local a
    (new sorter (:key key) (:label "a")))
  (local b
    (new sorter (:key key) (:label "b")))
  (println (:label a))
  (println (:label b)))
