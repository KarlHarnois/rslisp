(defstruct badge
  :label string
  :size u16)

(defstruct garage
  :owner string
  :badge badge)

(defn main ()
  (local g
    (->garage (str "karl")
              (->badge (str "Leaf") 12)))
  (println (loop (i 0)
             (if (< i 2)
               (do (local b g) (recur (+ i 1)))
               i))))
