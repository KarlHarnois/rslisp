(type later? (where ((a partial-ord)) (fn (a a) bool)))
(defn later? (a b) (> a b))

(defn literal-first ()
  (let model "Leaf")
  (later? 2020 (ref model)))

(defn literal-last ()
  (let model "Leaf")
  (later? (ref model) 2020))

(defn string-literal-first ()
  (let model (to-string "Leaf"))
  (later? 2020 (ref model)))

(defn vector-literal-first ()
  (let years (vec 2019 2024))
  (later? 2020 (ref years)))
