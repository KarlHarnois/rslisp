(type later?
  (where ((a partial-ord))
    (fn (a a) bool)))

(defn later? (a b) (> a b))

(defn literal-first ()
  (local model "Leaf")
  (later? 2020 (ref model)))

(defn literal-last ()
  (local model "Leaf")
  (later? (ref model) 2020))

(defn string-literal-first ()
  (local model (str "Leaf"))
  (later? 2020 (ref model)))

(defn vector-literal-first ()
  (local years (vec 2019 2024))
  (later? 2020 (ref years)))
