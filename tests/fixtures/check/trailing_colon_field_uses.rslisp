(defstruct user
  :name str
  :email str)

(defn read-email (:someone user) (:email: someone))

(defn build-user ()
  (->user :name "ana" :email: "ana@example.com"))

(defn change-email (:someone user)
  (assoc someone :email: "bo@example.com"))

(defn emails (:users (vec user))
  (map (iter users) :email:))

(defn main ()
  (local ana (build-user))
  (println (read-email ana))
  (println (:name (change-email ana)))
  (println (count (emails (vec ana)))))
