(defstruct badge
  :text string
  :size u16)

(defstruct garage
  :name string
  :badge badge)

(defn main ()
  (local g
    (->garage (str "Leaf Garage")
              (->badge (str "open") 12)))
  (local b (assoc (:badge g) :size 14))
  (println (:size b)
           " "
           (:name g)
           " "
           (:text (:badge g))))
