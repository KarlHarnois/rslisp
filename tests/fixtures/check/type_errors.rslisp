(defn branches (flag) (if flag 1 "one"))
(defn test-not-bool () (if 1 2 3))
(defn too-many () (not true false))
(defn calls-number () (5 1))
(defn adds-text () (+ "a" "b"))
(defstruct point :x f64 :y f64)
(defn unknown-field (p) (field (the point p) z))
(defn missing-fields () (new point (x 1)))
(type keeps (where (a) (fn (a) a)))
(defn keeps (value) 1)
(defn unused () (let ignored (fn (y) y)) 1)
(def too-big (the u8 300))
(defn negative-unsigned () (neg (the u8 1)))
