(defstruct user
  :name str
  :age u16)

(defstruct sorter
  :key (fn ((ref user)) u16)
  :label str)

(defn main ()
  (local bonus 2)
  (local key
    (fn ((someone (ref user)))
      (+ (:age someone) bonus)))
  (local by-bonus
    (new sorter (:key key) (:label "by bonus")))
  (println (:label by-bonus)))

(defn by-key (key label)
  (new sorter (:key key) (:label label)))

(defn rebound ()
  (local bonus 3)
  (local key
    (fn ((someone (ref user)))
      (+ (:age someone) bonus)))
  (local chosen key)
  (println (:label (by-key chosen "rebound"))))
