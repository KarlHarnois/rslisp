(defstruct badge
  :text string
  :size u16)

(defstruct garage
  :name string
  :badge badge)

(defn main ()
  (let garage
    (->garage (str "Leaf Garage")
              (->badge (str "open") 12)))
  (let bigger (assoc-in garage (:badge :size) 14))
  (println (:size (:badge bigger))
           " "
           (:name garage)))
