(defstruct car :make str :year u16)

(defn main ()
  (let years (vec 2019 2021 2024))
  (let leaf (->car "Nissan" 2025))
  (let offset 1)
  (let first (fn ((items (ref (vec i64)))) (println offset) (at items 0)))
  (let longer (fn ((a (ref str)) (b (ref str))) (println offset) (if (> (len a) (len b)) a b)))
  (let year-of (fn ((c (ref car))) (println offset) (ref (:year c))))
  (let owned-year (fn ((c car)) (println offset) (ref (:year c))))
  (let pick (fn (maybe) (println offset) (unwrap-or maybe "none")))
  (let again first)
  (let more again)
  (let name (to-string "Ariya"))
  (println (first (ref years)))
  (println (longer "Nissan" (as-str name)))
  (println (year-of (ref leaf)))
  (println (owned-year leaf))
  (println (first (vec 2019 2021)))
  (println (pick (some (as-str name))))
  (println (more (ref years)))
  (let (fixed (fn ((option (ref str))) (ref str))) pick)
  (let third fixed)
  (println (third (some (as-str name)))))
