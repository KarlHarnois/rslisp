(defn main ()
  (let years (vec 2019 2021 2024))
  (let year-at (fn (index) (at years index)))
  (let first (fn ((items (ref (vec i64)))) (at items 0)))
  (let pick (fn ((items (ref (vec i64))) (index usize)) (at items index)))
  (let longer (fn ((a (ref str)) (b (ref str))) (if (> (len a) (len b)) a b)))
  (let fallback (fn ((key (ref str))) (let built (vec 2019 2021)) (at built 0)))
  (let remember (fn ((items (ref (vec i64)))) (let kept (at items 0))))
  (let (second (fn ((ref (vec i64))) (ref i64))) (fn (items) (at items 1)))
  (let name (to-string "Ariya"))
  (println (first years))
  (println (first (ref years)))
  (println (pick years 1))
  (println (longer "Nissan" (as-str name)))
  (println (second years))
  (println (year-at 1))
  (println (fallback (as-str name)))
  (println (first (vec 2019 2021)))
  (remember years))
