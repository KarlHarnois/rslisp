(defn main ()
  (local years (vec 2019 2021 2024))
  (local year-at
    (fn (index) (at years index)))
  (local first
    (fn ((items (ref (vec i64))))
      (at items 0)))
  (local pick
    (fn ((items (ref (vec i64))) (index usize))
      (at items index)))
  (local longer
    (fn ((a (ref str)) (b (ref str)))
      (if (> (len a) (len b)) a b)))
  (local fallback
    (fn ((key (ref str)))
      (local built (vec 2019 2021))
      (at built 0)))
  (local remember
    (fn ((items (ref (vec i64))))
      (local kept (at items 0))))
  (local (second (fn ((ref (vec i64))) (ref i64)))
    (fn (items) (at items 1)))
  (local name (str "Ariya"))
  (println (first years))
  (println (first (ref years)))
  (println (pick years 1))
  (println (longer "Nissan" (as-str name)))
  (println (second years))
  (println (year-at 1))
  (println (fallback (as-str name)))
  (println (first (vec 2019 2021)))
  (remember years))
