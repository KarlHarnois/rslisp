(defn main ()
  (local years (vec 2019 2021 2024))
  (local tally (fn (it) (count it)))
  (println (tally (iter years)))
  (local offset-tally
    (fn (it) (+ 1 (count it))))
  (println (offset-tally (iter years)))
  (local alias-tally
    (fn (it) (local items it) (count items)))
  (println (alias-tally (iter years)))
  (local nested-alias-tally
    (fn (it)
      (+ 1
         (do (local items it) (count items)))))
  (println (nested-alias-tally (iter years))))
