(defn main ()
  (let years (vec 2019 2021 2024))
  (let tally (fn (it) (count it)))
  (println (tally (iter years)))
  (let offset-tally (fn (it) (+ 1 (count it))))
  (println (offset-tally (iter years)))
  (let alias-tally (fn (it) (let items it) (count items)))
  (println (alias-tally (iter years)))
  (let nested-alias-tally (fn (it) (+ 1 (do (let items it) (count items)))))
  (println (nested-alias-tally (iter years))))
