(defstruct tally :counter (fn ((iterator (ref i64))) usize))

(enum survey
  (counted (option (fn ((option (iterator i64))) usize)))
  skipped)

(defn tally-years (counter years) (counter (iter years)))

(defn counter-of ()
  (println "counting")
  count)

(type tally-signed (fn ((fn ((iterator (ref i64))) usize) (ref (vec i64))) usize))

(defn tally-signed (counter years) (counter (iter years)))

(type counter-signed (fn () (fn ((iterator (ref i64))) usize)))

(defn counter-signed () count)

(defn main ()
  (let years (vec 2019 2021 2024))
  (println (tally-years count years))
  (println (tally-signed count years))
  (println ((:counter (->tally count)) (iter years)))
  (println ((counter-of) (iter years)))
  (println ((counter-signed) (iter years))))
