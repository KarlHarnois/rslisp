(defstruct car :make str :model str :year u16)
(defstruct garage :name str :cars (vec car))

(defn open-garage (cars) (->garage :name "Downtown" :cars cars))

(def cars
  (vec
    (->car :make "Nissan" :model "Leaf" :year 2024)
    (->car :make "Honda" :model "Civic" :year 2019)))

(defn main ()
  (prn (len (:cars (open-garage cars)))))
