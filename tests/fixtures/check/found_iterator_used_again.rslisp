(defn both (values)
  (local first
    (find values
          (fn (value) (> (deref value) 5))))
  (and (some? first)
       (any? values (fn (value) (> value 50)))))

(defn main ()
  (prn (both (range 0 100)))
  (prn (both (range 0 10)))
  (local steps (range 0 10))
  (prn (find steps
             (fn (step) (> (deref step) 2))))
  (prn (find steps
             (fn (step) (> (deref step) 2)))))
