(use prelude/macros defmacro template)
(use code keyword-field)

(defstruct car :model str :year u16)

(defmacro with-field (value key item)
  (template (new _ (unquote value) ((unquote (keyword-field key)) (unquote item)))))

(defn main ()
  (let leaf (->car "Leaf" 2024))
  (println (:year (with-field leaf :yer 2025))))
