(use prelude/macros defmacro template)

(defstruct car
  :model str
  :year u16)

(defmacro with-field (value key item)
  (template (new _
              (unquote value)
              ((unquote key) (unquote item)))))

(defn main ()
  (local leaf (->car "Leaf" 2024))
  (println (:year (with-field leaf :yer 2025))))
