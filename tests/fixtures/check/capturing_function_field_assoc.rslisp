(defstruct user
  :name str
  :age u16)

(defstruct sorter
  :key (fn ((ref user)) u16)
  :label str)

(defn age (someone) (:age someone))

(defn main ()
  (local bonus 2)
  (local by-age
    (assoc (->sorter age "by age")
           :key (fn ((someone (ref user)))
                  (+ (:age someone) bonus))))
  (println (:label by-age)))
