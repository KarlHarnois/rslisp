(defn run (record)
  (local f5 (fn (n) n))
  (f5 1)
  (do
    (local f4 (fn (n) n))
    (f4 1)
    (do
      (local f3 (fn (n) n))
      (f3 1)
      (do
        (local f2 (fn (n) n))
        (f2 1)
        (do
          (local f1 (fn (n) n))
          (f1 1)
          (do
            (local f0 (fn (n) n))
            (f0 1)
            (do (record 1))))))))

(defn main ()
  (run (fn (x) (println x))))
