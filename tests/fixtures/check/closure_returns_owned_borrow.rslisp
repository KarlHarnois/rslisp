(defn first-through-closure (years)
  (let first (fn (items) (at items 0)))
  (first years))

(type first-owned (fn ((vec i64)) (ref i64)))
(defn first-owned (items) (at items 0))

(defn local-through-closure ()
  (let first (fn () (let years (vec 2019 2021 2024)) (at years 0)))
  (first))

(defn picked-through-closure (flag)
  (let fallback (vec 2019 2021 2024))
  (let first
    (fn (picked)
      (if flag
        (match picked
          ((some year) (do (let years (vec year 2024)) (at years 0)))
          (none (at fallback 0)))
        (at fallback 0))))
  (println (first (some 2019))))

(def first-year
  (do
    (let first (fn (items) (at items 0)))
    (deref (first (vec 2019 2021)))))

(defn main ()
  (println first-year)
  (println (first-through-closure (vec 2019 2021 2024)))
  (println (first-owned (vec 2019 2021 2024)))
  (println (local-through-closure))
  (picked-through-closure true))
