(defn first-through-closure (years)
  (local first (fn (items) (at items 0)))
  (first years))

(type first-owned
  (fn ((vec i64)) (ref i64)))

(defn first-owned (items) (at items 0))

(defn local-through-closure ()
  (local first
    (fn ()
      (local years (vec 2019 2021 2024))
      (at years 0)))
  (first))

(defn picked-through-closure (flag)
  (local fallback (vec 2019 2021 2024))
  (local first
    (fn (picked)
      (if flag
        (match picked
          ((some year)
           (do
             (local years (vec year 2024))
             (at years 0)))
          (none (at fallback 0)))
        (at fallback 0))))
  (println (first (some 2019))))

(def first-year
  (do
    (local first (fn (items) (at items 0)))
    (deref (first (vec 2019 2021)))))

(defn main ()
  (println first-year)
  (println (first-through-closure (vec 2019 2021 2024)))
  (println (first-owned (vec 2019 2021 2024)))
  (println (local-through-closure))
  (picked-through-closure true))
