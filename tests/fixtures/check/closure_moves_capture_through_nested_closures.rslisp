(defn twice (action)
  (action)
  (action))

(defn keep (model) model)

(defn main ()
  (local model (str "Leaf"))
  (local make (str "Nissan"))
  (local describe
    (fn ()
      ((fn (year)
         ((fn (trim) ((fn () (keep model))))
          "SV"))
       2024)))
  (twice describe)
  (println make))
