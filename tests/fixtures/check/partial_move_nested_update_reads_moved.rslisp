(defstruct badge
  :text string
  :size u16)

(defstruct garage
  :name string
  :badge badge)

(defn main ()
  (local g
    (->garage (str "Leaf Garage")
              (->badge (str "open") 12)))
  (local h (assoc-in g (:badge :size) 3))
  (println (:size (:badge h))
           " "
           (:text (:badge g))))
