(defstruct badge
  :text string
  :size u16)

(defstruct garage
  :name string
  :badge badge)

(defn main ()
  (let g
    (->garage (str "Leaf Garage")
              (->badge (str "open") 12)))
  (for-each (range 0 2)
            (fn (i)
              (let b (assoc (:badge g) :size 14))
              (println i " " (:size b)))))
