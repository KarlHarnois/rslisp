(rust-trait addable "std::ops::Add"
  (associated (output left) "Output")
  (where () (with i64 i64) (output i64)))

(def add-values (rust "{0} + {1}" (where ((a (addable b)) b) (fn (a b) (output a)))))

(type total (fn (i64 i64) (output i64)))

(defn total (left right)
  (add-values left right))

(defn main ()
  (println (total 2 3)))
