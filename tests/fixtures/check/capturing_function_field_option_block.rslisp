(defstruct spare
  :maker (option (fn () i64)))

(defn count-doors () 4)

(defn main ()
  (local base 4)
  (local backup
    (->spare :maker (some (do
                            (println "making")
                            (fn () (+ base 1))))))
  (match backup
    ((spare (some maker)) (println (maker)))
    ((spare none) (println "no spare"))))
