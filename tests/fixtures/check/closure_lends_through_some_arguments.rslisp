(defn first-year ((years (ref (vec i64))))
  (local first
    (fn ((items (ref (vec i64))))
      (at items 0)))
  (first years))

(defn main ()
  (local name (str "Ariya"))
  (local years (vec 2019 2021 2024))
  (local pick
    (fn (maybe) (unwrap-or maybe "none")))
  (local first
    (fn ((items (ref (vec i64))))
      (at items 0)))
  (local again first)
  (println (pick (some (as-str name))))
  (println (first years))
  (println (again years))
  (println (first-year (ref years)))
  (local (fixed (fn ((option (ref str))) (ref str)))
    pick)
  (local third fixed)
  (println (third (some (as-str name))))
  (local more again)
  (println (more years)))
