(use code list concat number-sub number-le)

(def doubled
  (fn (items times)
    (if (number-le times 0) items (doubled (concat items items) (number-sub times 1)))))

(def dropped
  (macro (form) (template 0)))

(defmacro pad ()
  (template (dropped (splice (doubled (list 0) 16)))))

(def first-helper (fn () (pad) 1))

(def second-helper (fn () (pad) 2))

(defmacro defines-main ()
  (first-helper)
  (second-helper)
  (template (defn main () (do))))

(defines-main)
