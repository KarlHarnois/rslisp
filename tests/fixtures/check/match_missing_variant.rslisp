(enum shape (circle f64) point)
(enum other (square i64))

(type area (fn (shape) f64))

(defn area (s)
  (match s
    ((circle _) 0.0)
    (point 0.0)
    ((square _) 0.0)))

(type other-area (fn (shape) f64))

(defn other-area (s)
  (match s
    ((other/square _) 0.0)))

(defn main ()
  (println (other-area (shape/circle 1.0))))
