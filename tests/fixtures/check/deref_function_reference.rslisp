(defstruct car :make str :model str)
(defstruct spare :maker (option (fn () car)))

(defn build-leaf ()
  (->car :make "Nissan" :model "Leaf"))

(type call-through (fn ((ref (fn () car))) car))
(defn call-through (maker)
  (let copied (deref maker))
  (copied))

(defn main ()
  (let (maker (fn () car)) build-leaf)
  (println (:model (call-through (ref maker))))
  (prn (->spare :maker (some build-leaf))))
